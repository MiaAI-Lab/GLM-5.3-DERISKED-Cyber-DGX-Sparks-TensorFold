+/// TF_GLM_PROMPT_OWNER_PROJ (default 0: off), a prompt chunk's replicated projections on their row owners, read
+/// at each chunk (the one place this switch is read; the request policy's bit 4 replaces it): a mask of 1, [q_a | kv_a] of the next
+/// layer's rows on each row owner inside the ffn exchange, gathered with the residual rows (one NCCL group);
+/// 2, the same projection on the owners after the exchange, gathered alone on the main stream (1 wins over 2);
+/// 4, the indexer's queries (ix.qb) only for the rows this rank selects (a split selection, TF_GLM_INDEX_SPLIT).
+/// Every switch leaves each row's bytes as the replicated path makes them (qmmf's sums do not depend on the row count).
+pub const Owner = struct { publish: Publish = .off, qb: bool = false };
+pub const Publish = enum { off, fused, separate };
+
+pub fn ownerPolicy() Owner {
+    return parseOwner(if (std.c.getenv("TF_GLM_PROMPT_OWNER_PROJ")) |e| std.mem.span(e) else null);
+}
+
+pub fn parseOwner(text: ?[]const u8) Owner {
+    const t = text orelse return .{};
+    const m = std.fmt.parseInt(u32, t, 10) catch return .{};
+    return .{ .publish = if (m & 1 != 0) .fused else if (m & 2 != 0) .separate else .off, .qb = m & 4 != 0 };
+}
+
+/// Whether a layer's [q_a | kv_a] can run on its row owners: a lane projection (block FP8 or MXFP8) whose calls hold
+/// no slice partials (the owner call runs on the exchange stream, beside the main stream's mm_part).
+pub fn ownerProjects(l: Layer) bool {
+    return switch (l.proj) {
+        .fp8g, .mxfp8 => true,
+        .bf16 => false,
+    };
+}
+
+/// The owner's share of a layer's [q_a | kv_a]: `n` rows of residual `h` (bf16 [n][dims], rows `h_stride` apart)
+/// normed by `norm` into `normed` (and `xs`), projected into `dp` ([n][q_lora + rowW] bf16): the replicated path's
+/// rmsnormBy and matmul on these rows alone. The lane's part buffer is never read (ownerProjects).
+pub fn ownerRows(set: glue.Set, stream: cuda.Stream, l: Layer, norm: glue.Norm, eps: f32, h: u64, h_stride: usize, normed: u64, xs: u64, dp: u64, n: usize) !void {
+    if (n == 0) return;
+    if (!ownerProjects(l)) return error.OwnerProj;
+    try glue.rmsnormBy(set, stream, h, h_stride, norm, normed, l.dims, xs, eps, n, l.dims);
+    try projection.matmul(set, stream, l.proj, normed, l.dims, dp, 0, n, l.q_lora + l.rowW(), l.dims, false);
+}
+
+test "GLM owner proj: TF_GLM_PROMPT_OWNER_PROJ is off unless set, a mask of fused (1), separate (2) and qb (4); fused wins" {
+    try std.testing.expectEqual(Owner{}, parseOwner(null));
+    try std.testing.expectEqual(Owner{}, parseOwner("0"));
+    try std.testing.expectEqual(Owner{}, parseOwner("on"));
+    try std.testing.expectEqual(Owner{ .publish = .fused }, parseOwner("1"));
+    try std.testing.expectEqual(Owner{ .publish = .separate }, parseOwner("2"));
+    try std.testing.expectEqual(Owner{ .publish = .fused }, parseOwner("3"));
+    try std.testing.expectEqual(Owner{ .qb = true }, parseOwner("4"));
+    try std.testing.expectEqual(Owner{ .publish = .fused, .qb = true }, parseOwner("5"));
+    try std.testing.expectEqual(Owner{ .publish = .separate, .qb = true }, parseOwner("6"));
 }
 
