+//! `glm-owner-proj <ckpt> <layers> [reps]`: TF_GLM_PROMPT_OWNER_PROJ's rows against the replicated prompt path's, byte
+//! for byte, on a checkpoint's own block-FP8 [q_a | kv_a] and indexer wq_b (packed as the loader packs them).
+//! Each TP4 rank's owner rows (dsa_block.ownerRows from its summed residual rows: the fused publish; projection.matmul
+//! from the normed rows: the separate gather) land where the in-place all-gather puts them, and must equal the
+//! replicated call's rows; then the q/kv norms over them, the indexer's queries of each rank's split rows, and the
+//! DSA picks (sparse.dsaSelect) over those queries. Two controls show the comparison catches a changed byte and a
+//! shifted row. With reps > 0, the GEMMs' times at the full and quarter row counts (warm and with L2 flushed).
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+const reference = @import("quant_ref_tests.zig");
+const Rig = reference.RigT;
+const fp8pb = glm.weights.formats.fp8pb;
+const dsa_block = glm.dsa_block;
+const sparse = glm.sparse;
+const proj = glm.proj;
+
+const world = 4;
+
+/// The replicated path's halves and whole chunks at TP4: a full chunk (4096), its halves (2048), the halves of a
+/// 2049-row tail (1088 / 961: the owners' quarters straddle the lane's fused-rows threshold of 256), of 3841 (1984 /
+/// 1857) and a short chunk (300: quarters of 75 rows, the cluster tiles).
+const shapes = [_]usize{ 4096, 2048, 1088, 961, 1984, 1857, 300 };
+
+fn lane(r: *Rig, ck: *core.Checkpoint, mods: []const []const u8) !cuda.qmmf.Weight {
+    var stored: [2]fp8pb.Fp8pb = undefined;
+    var shares: [2]fp8pb.Share = undefined;
+    for (mods, 0..) |m, j| {
+        stored[j] = try fp8pb.Fp8pb.read(r.a, ck, m);
+        shares[j] = .{ .p = &stored[j], .lo = 0, .hi = stored[j].n, .klo = 0, .khi = stored[j].k };
+    }
+    const z = try fp8pb.sizes(shares[0..mods.len]);
+    const codes = try r.a.alloc(u8, z.codes);
+    const tiles = try r.a.alloc(f32, z.scales);
+    try fp8pb.pack(r.a, shares[0..mods.len], codes, tiles); // cuda_formats.fp8g's packing
+    return cuda.fp8.weight(try r.dev(codes), try r.dev(std.mem.sliceAsBytes(tiles)), z.n, z.k);
+}
+
+fn tensor(r: *Rig, ck: *core.Checkpoint, comptime fmt: []const u8, args: anytype) !u64 {
+    var buf: [160]u8 = undefined;
+    return r.dev((try ck.get(try std.fmt.bufPrint(&buf, fmt, args))).bytes);
+}
+
+fn owners(R: usize, rank: usize) [3]usize {
+    const per = (R + world - 1) / world;
+    const lo = @min(R, rank * per);
+    return .{ per, lo, @min(R, lo + per) - lo };
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, layers_s: []const u8, reps_s: ?[]const u8) !void {
+    const reps = if (reps_s) |v| try std.fmt.parseInt(usize, v, 10) else 0;
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, try std.fs.path.join(a, &.{ dir, "config.json" }), a, .limited(1 << 24));
+    const c = try glm.config.parse(gpu.gpa, text);
+    var ck = try core.Checkpoint.openModel(gpu.gpa, gpu.io, dir);
+    defer ck.close();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0x0e_a3e5);
+    var r: Rig = .{ .gpu = gpu, .a = a, .s = s, .rng = prng.random() };
+    defer {
+        cuda.completion.drain(gpu.d, s, "owner projection buffers released before completion");
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var ln = try cuda.qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+    defer ln.unload();
+    var glue_mod = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer glue_mod.unload();
+    var ops = try cuda.Module.load(gpu.d, cuda.kernels.glm_ops);
+    defer ops.unload();
+    const ks = try glm.glue.Kernels.load(glue_mod);
+    const set: glm.glue.Set = .{ .glue = &ks, .prompt = true, .linear = .{ .lane = &ln } };
+
+    const D: usize = c.hidden;
+    const W: usize = c.q_lora + c.kv_lora + c.rope;
+    const QI: usize = c.i_heads * c.i_dim;
+    const Rmax = shapes[0];
+    // the rope frequencies dsa_scores reads (theta^(-2i / 64))
+    var inv: [32]f32 = undefined;
+    for (&inv, 0..) |*v, i| v.* = @floatCast(std.math.pow(f64, 1e6, -@as(f64, @floatFromInt(2 * i)) / 64.0));
+    const d_inv = try r.dev(std.mem.sliceAsBytes(&inv));
+
+    var compared: usize = 0;
+    var it = std.mem.splitScalar(u8, layers_s, ',');
+    while (it.next()) |ls| {
+        const li = try std.fmt.parseInt(u32, ls, 10);
+        var nb: [2][96]u8 = undefined;
+        const mods = [_][]const u8{ try std.fmt.bufPrint(&nb[0], "model.layers.{d}.self_attn.q_a_proj", .{li}), try std.fmt.bufPrint(&nb[1], "model.layers.{d}.self_attn.kv_a_proj_with_mqa", .{li}) };
+        const wq = try lane(&r, &ck, &mods);
+        var qb_buf: [96]u8 = undefined;
+        const qb_name = try std.fmt.bufPrint(&qb_buf, "model.layers.{d}.self_attn.indexer.wq_b", .{li});
+        var qb_w: ?cuda.qmmf.Weight = null;
+        var wtest: [128]u8 = undefined;
+        if (ck.has(try std.fmt.bufPrint(&wtest, "{s}.weight", .{qb_name}))) qb_w = try lane(&r, &ck, &.{qb_name});
+        const in_norm: glm.glue.Norm = .{ .bf16 = try tensor(&r, &ck, "model.layers.{d}.input_layernorm.weight", .{li}) };
+        const q_norm = try tensor(&r, &ck, "model.layers.{d}.self_attn.q_a_layernorm.weight", .{li});
+        const kv_norm = try tensor(&r, &ck, "model.layers.{d}.self_attn.kv_a_layernorm.weight", .{li});
+        const none: glm.proj.Proj = .{ .bf16 = 0 };
+        const l: dsa_block.Layer = .{
+            .proj = .{ .fp8g = wq },
+            .q_norm = q_norm,
+            .kv_norm = kv_norm,
+            .q_b = none,
+            .wk = 0,
+            .wv = 0,
+            .o = none,
+            .index = .{ .kw = none, .gate = 0, .ln_w = 0, .ln_b = 0, .ape = 0, .qb = none, .heads = c.i_heads, .d = c.i_dim },
+            .heads = 0,
+            .qk = 0,
+            .dv = 0,
+            .lw = c.kv_lora,
+            .q_lora = c.q_lora,
+            .dims = D,
+            .eps = c.eps,
+            .dense_limit = 0,
+            .rope = c.rope,
+        };
+        try check.expect(dsa_block.ownerProjects(l) and wq.n == W and wq.k == D, "glm-owner-proj: layer {d}'s [q_a | kv_a] is not a {d} x {d} lane weight", .{ li, W, D });
+
+        // the residual rows (as the ffn exchange leaves them in every rank's hidden) and the replicated path's buffers
+        const hidden = try r.dev(std.mem.sliceAsBytes(try r.bfs(Rmax * D, 2.0)));
+        const normed = try r.zeros(Rmax * D * 2);
+        const xs = try r.zeros(Rmax * (D / 64) * 4);
+        const dp = try r.zeros(Rmax * W * 2);
+        const qr = try r.zeros(Rmax * c.q_lora * 2);
+        const xs_qr = try r.zeros(Rmax * (c.q_lora / 64) * 4);
+        const lat = try r.zeros(Rmax * W * 2);
+        const xs_lat = try r.zeros(Rmax * (c.kv_lora / 64) * 4);
+        const qi = try r.zeros(Rmax * QI * 2);
+        // the owners' (rank-major rows: the in-place all-gather's layout) and the exchange stream's scratch
+        const dp_own = try r.zeros((Rmax + world) * W * 2);
+        const dp_sep = try r.zeros((Rmax + world) * W * 2);
+        const qr_own = try r.zeros(Rmax * c.q_lora * 2);
+        const lat_own = try r.zeros(Rmax * W * 2);
+        const qi_own = try r.zeros(Rmax * QI * 2);
+        const o_normed = try r.zeros(Rmax * D * 2);
+        const o_xs = try r.zeros(Rmax * (D / 64) * 4);
+
+        for (shapes) |R| {
+            // the replicated path (dsa_block.prepareRows' first part, wholeDsaHalves' norm before it)
+            try glm.glue.rmsnormBy(set, s, hidden, D, in_norm, normed, D, xs, c.eps, R, D);
+            try proj.matmul(set, s, l.proj, normed, D, dp, 0, R, W, D, false);
+            try glm.glue.rmsnorm(set, s, dp, W, q_norm, qr, c.q_lora, xs_qr, c.eps, R, c.q_lora);
+            try glm.glue.rmsnorm(set, s, dp + c.q_lora * 2, W, kv_norm, lat, W, xs_lat, c.eps, R, c.kv_lora);
+            // each rank's owner rows, where the in-place all-gather puts them (rank x per)
+            for (0..world) |rank| {
+                const o = owners(R, rank);
+                try dsa_block.ownerRows(set, s, l, in_norm, c.eps, hidden + o[1] * D * 2, D, o_normed, o_xs, dp_own + rank * o[0] * W * 2, o[2]);
+                if (o[2] > 0) try proj.matmul(set, s, l.proj, normed + o[1] * D * 2, D, dp_sep + rank * o[0] * W * 2, 0, o[2], W, D, false);
+            }
+            try glm.glue.rmsnorm(set, s, dp_own, W, q_norm, qr_own, c.q_lora, xs_qr, c.eps, R, c.q_lora);
+            try glm.glue.rmsnorm(set, s, dp_own + c.q_lora * 2, W, kv_norm, lat_own, W, xs_lat, c.eps, R, c.kv_lora);
+            const want = try r.back(dp, R * W * 2);
+            var label: [128]u8 = undefined;
+            try check.sameBytes(try std.fmt.bufPrint(&label, "layer {d} R {d}: fused owners' [q_a | kv_a] rows", .{ li, R }), try r.back(dp_own, R * W * 2), want);
+            try check.sameBytes(try std.fmt.bufPrint(&label, "layer {d} R {d}: separate owners' [q_a | kv_a] rows", .{ li, R }), try r.back(dp_sep, R * W * 2), want);
+            try check.sameBytes(try std.fmt.bufPrint(&label, "layer {d} R {d}: q_norm rows", .{ li, R }), try r.back(qr_own, R * c.q_lora * 2), try r.back(qr, R * c.q_lora * 2));
+            try check.sameBytes(try std.fmt.bufPrint(&label, "layer {d} R {d}: kv_norm rows", .{ li, R }), try r.back(lat_own, R * W * 2), try r.back(lat, R * W * 2));
+            compared += 4;
+
+            // controls: one changed byte, and an owner whose rows start one row late, must both be caught
+            {
+                const bad = try r.a.dupe(u8, try r.back(dp_own, R * W * 2));
+                bad[bad.len / 2] ^= 0x01;
+                if (check.sameBytes("control: one byte changed (expected FAIL line)", bad, want)) |_| return error.ControlNotCaught else |_| {}
+                const o = owners(R, 1);
+                try dsa_block.ownerRows(set, s, l, in_norm, c.eps, hidden + (o[1] + 1) * D * 2, D, o_normed, o_xs, dp_own + o[0] * W * 2, o[2]);
+                if (check.sameBytes("control: rank 1's rows one late (expected FAIL line)", try r.back(dp_own, R * W * 2), want)) |_| return error.ControlNotCaught else |_| {}
+            }
+
+            const qbw = qb_w orelse continue;
+            // the indexer's queries: the replicated call, then each rank's split rows alone (dsa_block.prepareRows)
+            try proj.matmul(set, s, .{ .fp8g = qbw }, qr, c.q_lora, qi, 0, R, QI, c.q_lora, false);
+            var any = false;
+            for (0..world) |rank| {
+                const sp: sparse.Split = .{ .lib = undefined, .comm = null, .rank = rank, .world = world };
+                const qr_rows = sparse.splitRows(sp, R) orelse break;
+                any = true;
+                if (qr_rows[1] > qr_rows[0]) try proj.matmul(set, s, .{ .fp8g = qbw }, qr + qr_rows[0] * c.q_lora * 2, c.q_lora, qi_own + qr_rows[0] * QI * 2, 0, qr_rows[1] - qr_rows[0], QI, c.q_lora, false);
+            }
+            if (!any) continue; // under 64 rows a rank: every rank selects every row (the replicated qb stays)
+            try check.sameBytes(try std.fmt.bufPrint(&label, "layer {d} R {d}: indexer query rows of each rank's split", .{ li, R }), try r.back(qi_own, R * QI * 2), try r.back(qi, R * QI * 2));
+            compared += 1;
+            // the picks over those queries: random index keys and head weights, a chunk at position 4096
+            const host_pos: usize = 4096;
+            const np = host_pos + R;
+            const ik = try r.dev(std.mem.sliceAsBytes(try r.bfs(np * c.i_dim, 1.0)));
+            const ikr = try r.dev(std.mem.sliceAsBytes(try r.bfs(R * (c.i_dim + c.i_heads), 1.0)));
+            const pos = try r.dev(std.mem.asBytes(&@as(i32, @intCast(host_pos))));
+            const sel: sparse.Scratch = .{ .scores = try r.zeros(sparse.select_rows * np * 4), .ls = 0, .li = 0, .pools = 0, .at = try r.zeros(16) };
+            var picks: [2][2][]u8 = undefined;
+            for ([_]u64{ qi, qi_own }, 0..) |q, v| {
+                const tokens = try r.zeros(R * sparse.dsa_width * 4);
+                const counts = try r.zeros(R * 4);
+                try sparse.dsaSelect(set, ops, s, q, ikr + c.i_dim * 2, d_inv, ik, pos, host_pos, R, c.i_heads, c.i_dim, sel, tokens, counts, null, null);
+                picks[v] = .{ try r.back(tokens, R * sparse.dsa_width * 4), try r.back(counts, R * 4) };
+            }
+            try check.sameBytes(try std.fmt.bufPrint(&label, "layer {d} R {d}: DSA picks", .{ li, R }), picks[1][0], picks[0][0]);
+            try check.sameBytes(try std.fmt.bufPrint(&label, "layer {d} R {d}: DSA pick counts", .{ li, R }), picks[1][1], picks[0][1]);
+            compared += 2;
+        }
+        check.pass("glm-owner-proj: layer {d}: [q_a | kv_a] {d} x {d}, indexer qb {s}: owner rows equal the replicated rows at R {any}", .{ li, W, D, if (qb_w != null) "yes" else "none (shared layer)", shapes });
+        if (reps > 0) try bench(&r, set, l, qb_w, in_norm, c, hidden, normed, xs, dp, qr, qi, o_normed, o_xs, reps);
+    }
+    check.pass("glm-owner-proj: {d} byte comparisons equal, 2 controls per shape caught", .{compared});
+}
+
+const Timed = struct { warm: f64, cold: f64 };
+
+/// Mean ms of `call` over `reps` runs, back to back (warm) and with a 96 MiB write between runs (L2 flushed).
+fn timed(r: *Rig, reps: usize, flush: u64, ctx: anytype, comptime call: fn (@TypeOf(ctx)) anyerror!void) !Timed {
+    var e0 = try cuda.Event.init(r.gpu.d, true);
+    defer e0.deinit();
+    var e1 = try cuda.Event.init(r.gpu.d, true);
+    defer e1.deinit();
+    try call(ctx);
+    try e0.record(r.s);
+    for (0..reps) |_| try call(ctx);
+    try e1.record(r.s);
+    try e1.synchronize();
+    const warm = @as(f64, try cuda.Event.elapsedMs(e0, e1)) / @as(f64, @floatFromInt(reps));
+    var cold: f64 = 0;
+    for (0..reps) |_| {
+        const fb: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = flush, .len = 96 << 20 };
+        try fb.fill8(0x5a, r.s.handle);
+        try e0.record(r.s);
+        try call(ctx);
+        try e1.record(r.s);
+        try e1.synchronize();
+        cold += try cuda.Event.elapsedMs(e0, e1);
+    }
+    return .{ .warm = warm, .cold = cold / @as(f64, @floatFromInt(reps)) };
+}
+
+fn bench(r: *Rig, set: glm.glue.Set, l: dsa_block.Layer, qb_w: ?cuda.qmmf.Weight, in_norm: glm.glue.Norm, c: glm.config.Config, hidden: u64, normed: u64, xs: u64, dp: u64, qr: u64, qi: u64, o_normed: u64, o_xs: u64, reps: usize) !void {
+    const D: usize = c.hidden;
+    const W: usize = c.q_lora + c.kv_lora + c.rope;
+    const QI: usize = c.i_heads * c.i_dim;
+    const flush = try r.zeros(96 << 20);
+    const Mm = struct {
+        set: glm.glue.Set,
+        w: glm.proj.Proj,
+        x: u64,
+        out: u64,
+        m: usize,
+        n: usize,
+        k: usize,
+        s: cuda.Stream,
+        fn go(q: @This()) anyerror!void {
+            try glm.proj.matmul(q.set, q.s, q.w, q.x, q.k, q.out, 0, q.m, q.n, q.k, false);
+        }
+    };
+    const Own = struct {
+        set: glm.glue.Set,
+        l: dsa_block.Layer,
+        norm: glm.glue.Norm,
+        h: u64,
+        normed: u64,
+        xs: u64,
+        dp: u64,
+        m: usize,
+        s: cuda.Stream,
+        fn go(q: @This()) anyerror!void {
+            try dsa_block.ownerRows(q.set, q.s, q.l, q.norm, q.l.eps, q.h, q.l.dims, q.normed, q.xs, q.dp, q.m);
+        }
+    };
+    const Norm = struct {
+        set: glm.glue.Set,
+        norm: glm.glue.Norm,
+        h: u64,
+        normed: u64,
+        xs: u64,
+        m: usize,
+        eps: f32,
+        d: usize,
+        s: cuda.Stream,
+        fn go(q: @This()) anyerror!void {
+            try glm.glue.rmsnormBy(q.set, q.s, q.h, q.d, q.norm, q.normed, q.d, q.xs, q.eps, q.m, q.d);
+        }
+    };
+    for ([_]usize{ 4096, 2048, 1024, 512, 256 }) |m| {
+        const t = try timed(r, reps, flush, Mm{ .set = set, .w = l.proj, .x = normed, .out = dp, .m = m, .n = W, .k = D, .s = r.s }, Mm.go);
+        const tf = 2.0 * @as(f64, @floatFromInt(m * W * D)) / 1e9;
+        std.debug.print("RESULT owner-proj [q_a|kv_a] rows {d}: warm {d:.3} ms ({d:.1} TFLOPS), cold {d:.3} ms ({d:.1} TFLOPS)\n", .{ m, t.warm, tf / t.warm, t.cold, tf / t.cold });
+        const o = try timed(r, reps, flush, Own{ .set = set, .l = l, .norm = in_norm, .h = hidden, .normed = o_normed, .xs = o_xs, .dp = dp, .m = m, .s = r.s }, Own.go);
+        std.debug.print("RESULT owner-proj ownerRows (norm + [q_a|kv_a]) rows {d}: warm {d:.3} ms, cold {d:.3} ms\n", .{ m, o.warm, o.cold });
+        const n = try timed(r, reps, flush, Norm{ .set = set, .norm = in_norm, .h = hidden, .normed = normed, .xs = xs, .m = m, .eps = c.eps, .d = D, .s = r.s }, Norm.go);
+        std.debug.print("RESULT owner-proj rmsnorm 6144 rows {d}: warm {d:.3} ms, cold {d:.3} ms\n", .{ m, n.warm, n.cold });
+        if (qb_w) |qbw| {
+            const q = try timed(r, reps, flush, Mm{ .set = set, .w = .{ .fp8g = qbw }, .x = qr, .out = qi, .m = m, .n = QI, .k = c.q_lora, .s = r.s }, Mm.go);
+            const qf = 2.0 * @as(f64, @floatFromInt(m * QI * c.q_lora)) / 1e9;
+            std.debug.print("RESULT owner-proj indexer qb rows {d}: warm {d:.3} ms ({d:.1} TFLOPS), cold {d:.3} ms\n", .{ m, q.warm, qf / q.warm, q.cold });
+        }
+    }
+}
