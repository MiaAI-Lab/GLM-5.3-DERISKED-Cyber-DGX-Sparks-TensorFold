+/// of `wq`), and the exchange stream's normed rows and their sums for one owner's per rows. Byte offsets from the
+/// room's start; null when they do not fit before the second half's position (room - 256): the replicated path.
+pub const OwnRoom = struct { dp: [2]usize, normed: usize, xs: usize, end: usize };
+
+pub fn ownRoom(R: usize, cap: usize, world: usize, D: usize, wq: usize) ?OwnRoom {
+    const RA = halfRows(R)[0];
+    const per = (RA + world - 1) / world; // the longer half's (the second is never longer: halfRows)
+    const span = std.mem.alignForward(usize, scatterRoom(RA, world, D), 256);
+    const dp_bytes = std.mem.alignForward(usize, per * world * wq * 2, 256);
+    const at = 2 * span;
+    const normed = at + 2 * dp_bytes;
+    const xs = normed + std.mem.alignForward(usize, per * D * 2, 256);
+    const end = xs + std.mem.alignForward(usize, per * (D / 64) * 4, 256);
+    if (end + 256 > world * cap * D * 4) return null;
+    return .{ .dp = .{ at, at + dp_bytes }, .normed = normed, .xs = xs, .end = end };
+}
+
+/// wholeDsaHalves' owner projections (TF_GLM_PROMPT_OWNER_PROJ): `ready[h]`, half h's dp[h] holds the next mixer's
+/// [q_a | kv_a], published by the ffn exchange before it (fused) or gathered at the mixer (separate).
+const OwnHalves = struct {
+    f: *const Forward,
+    pol: dsa_block.Owner,
+    on: bool = false,
+    dp: [2]u64 = .{ 0, 0 },
+    normed: u64 = 0,
+    xs: u64 = 0,
+    ready: [2]bool = .{ false, false },
+
+    fn init(f: *const Forward, R: usize) OwnHalves {
+        const pol = dsa_block.ownerPolicy();
+        var o: OwnHalves = .{ .f = f, .pol = pol };
+        if (pol.publish == .off) return o;
+        const r = f.ranks[0];
+        const c = &r.w.config;
+        const room = ownRoom(R, r.b.rows, r.w.share.world, c.hidden, c.q_lora + c.kv_lora + c.rope) orelse return o;
+        o.dp = .{ r.b.gathered + room.dp[0], r.b.gathered + room.dp[1] };
+        o.normed = r.b.gathered + room.normed;
+        o.xs = r.b.gathered + room.xs;
+        o.on = true;
+        return o;
+    }
+
+    /// The ffn exchange of layer j's half h: the next layer's projection to make on the owners (fused), or null.
+    fn next(o: *OwnHalves, j: usize, h: usize) ?Forward.OwnNext {
+        o.ready[h] = false;
+        if (!o.on or o.pol.publish != .fused) return null;
+        const layers = o.f.ranks[0].w.layers;
+        if (j + 1 >= layers.len) return null;
+        const nl = layers[j + 1];
+        const a = switch (nl.mixer) {
+            .mla => |a| a,
+            .kda => return null,
+        };
+        if (!dsa_block.ownerProjects(a) or a.q_lora + a.rowW() != o.f.ranks[0].w.config.q_lora + o.f.ranks[0].w.config.kv_lora + o.f.ranks[0].w.config.rope) return null;
+        o.ready[h] = true;
+        return .{ .l = a, .norm = nl.in_norm, .eps = o.f.ranks[0].w.config.eps, .dp = o.dp[h], .normed = o.normed, .xs = o.xs };
+    }
+
+    /// Layer j's mixer of half h (its rows normed at `normed`): whether dp[h] holds their [q_a | kv_a] now. Separate:
+    /// this rank's rows projected from the normed rows and gathered on the main stream.
+    fn mixer(o: *OwnHalves, j: usize, h: usize, a: dsa_block.Layer, normed: u64, rows: usize) !bool {
+        _ = j;
+        if (!o.on) return false;
+        switch (o.pol.publish) {
+            .off => return false,
+            .fused => {
+                const was = o.ready[h];
+                o.ready[h] = false;
+                return was;
+            },
+            .separate => {
+                const f = o.f;
+                const r = f.ranks[0];
+                const c = &r.w.config;
+                if (!dsa_block.ownerProjects(a) or a.q_lora + a.rowW() != c.q_lora + c.kv_lora + c.rope) return false;
+                const n = f.exchange.nccl;
+                const world = r.w.share.world;
+                const rank = r.w.share.rank;
+                const w = a.q_lora + a.rowW();
+                const per = (rows + world - 1) / world;
+                const lo = @min(rows, rank * per);
+                const mine = @min(rows, lo + per) - lo;
+                if (mine > 0) try projection.matmul(f.set(), f.stream, a.proj, normed + lo * c.hidden * 2, c.hidden, o.dp[h] + rank * per * w * 2, 0, mine, w, a.dims, false);
+                try n.lib.check(n.lib.api.ncclAllGather(o.dp[h] + rank * per * w * 2, o.dp[h], per * w, .bf16, n.comm, f.stream.handle), "ncclAllGather");
+                return true;
+            },
+        }
+    }
+};
+
