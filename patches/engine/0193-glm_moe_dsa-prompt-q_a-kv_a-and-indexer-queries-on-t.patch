+/// The rows [lo, hi) of a pass's `rows` this rank selects for under `split` (dsaSelect's rule: two ranks or more and
+/// 64 rows a rank); null when the pass does not split (every rank picks every row).
+pub fn splitRows(split: ?Split, rows: usize) ?[2]usize {
+    const x = split orelse return null;
+    if (x.world <= 1 or rows < 64 * x.world) return null;
+    const per = cdiv(rows, x.world);
+    const lo = @min(rows, x.rank * per);
+    return .{ lo, @min(rows, lo + per) };
+}
