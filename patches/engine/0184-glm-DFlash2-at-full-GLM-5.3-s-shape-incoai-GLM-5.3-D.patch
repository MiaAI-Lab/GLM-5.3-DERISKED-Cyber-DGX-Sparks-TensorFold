diff --git a/zig/glm_dflash_host.zig b/zig/glm_dflash_host.zig
index d59d55d18..3cdc4698f 100644
--- a/zig/glm_dflash_host.zig
+++ b/zig/glm_dflash_host.zig
@@ -121,3 +121,69 @@ test "glm dflash: every loaded symbol has a measured launch record" {
         try t.expect(found);
     }
 }
+
+const flash_config =
+    \\{"dflash_config":{"block_size":8,"conv_group_size":16,"conv_kernel_size":2,"mask_token_id":154856,"selector_rank":256,
+    \\"selector_top_k":16,"target_layer_ids":[5,14,24,33,42]},"head_dim":128,"hidden_size":4096,"intermediate_size":12288,
+    \\"num_attention_heads":32,"num_hidden_layers":5,"num_key_value_heads":8,"num_target_layers":45,
+    \\"rope_parameters":{"rope_theta":10000.0,"rope_type":"default"},"sliding_window":2048,"vocab_size":154880}
+;
+const full_config =
+    \\{"dflash_config":{"block_size":8,"conv_group_size":16,"conv_kernel_size":2,"mask_token_id":154856,"selector_rank":256,
+    \\"selector_top_k":16,"target_layer_ids":[5,19,33,47,61,75]},"head_dim":128,"hidden_size":6144,"intermediate_size":12288,
+    \\"num_attention_heads":64,"num_hidden_layers":6,"num_key_value_heads":8,"num_target_layers":78,
+    \\"rope_parameters":{"rope_theta":1000000,"rope_type":"default"},"sliding_window":2048,"vocab_size":154880}
+;
+
+fn shapeFrom(text: []const u8) !glm.dflash.Shape {
+    const p = try std.json.parseFromSlice(std.json.Value, t.allocator, text, .{});
+    defer p.deinit();
+    return glm.dflash_load.shapeOf(p.value);
+}
+
+test "glm dflash: the two checkpoints' configs pick their shapes; a mixed one is refused" {
+    const df = glm.dflash;
+    const a = try shapeFrom(flash_config);
+    try t.expectEqual(df.D, a.d);
+    try t.expectEqual(df.LAYERS, a.layers);
+    try t.expectEqual(df.QH, a.qh);
+    try t.expect(!a.dsa);
+    try t.expectEqual(df.QKV, a.qkv()); // the Flash shape is the constants it always had
+    try t.expectEqual(df.TAP_ROW, a.tapRow());
+    try t.expectEqual(df.ring_bytes, a.ringBytes());
+    try t.expectEqual(df.KVW, a.dynw()); // its conv projection's 1024 rows
+    const b = try shapeFrom(full_config);
+    try t.expectEqual(@as(usize, 6144), b.d);
+    try t.expectEqual(@as(usize, 6), b.layers);
+    try t.expectEqual(@as(usize, 8192), b.qw()); // 64 heads x 128: wider than D
+    try t.expectEqual(@as(usize, 8192 + 2048), b.qkv());
+    try t.expectEqual(@as(usize, 1536), b.dynw()); // kernel_projection [1536, 6144]
+    try t.expectEqual(@as(usize, 6 * 6144 * 2), b.tapRow()); // fc [6144, 36864]
+    try t.expect(b.dsa);
+    try t.expectEqualSlices(usize, &.{ 5, 19, 33, 47, 61, 75 }, b.taps);
+    try t.expect(b.ringBytes() <= df.max_ring_bytes);
+    // the full shape's fields with the Flash taps, or 32 heads: refused
+    const bad = [_][2][]const u8{ .{ "[5,19,33,47,61,75]", "[5,14,24,33,42]" }, .{ "\"num_attention_heads\":64", "\"num_attention_heads\":32" }, .{ "1000000", "10000.0" } };
+    for (bad) |r| {
+        const text = try std.mem.replaceOwned(u8, t.allocator, full_config, r[0], r[1]);
+        defer t.allocator.free(text);
+        try t.expectError(error.DrafterConfigUnexpected, shapeFrom(text));
+    }
+}
+
+test "glm dflash: the full shape's raw scratch holds its 4-bit linears (fc 6 x 6144 wide, qkv 10240 rows, o 8192 wide)" {
+    const df = glm.dflash;
+    const s = df.full;
+    for (1..17) |world| {
+        const ff = df.mlpSplit(world).ff;
+        const linears = [_][2]usize{ .{ s.qkv(), s.d }, .{ 2 * df.KVW, s.d }, .{ s.d, s.qw() }, .{ 2 * ff, s.d }, .{ s.dynw(), s.d }, .{ s.d, s.taps.len * s.d } };
+        for (linears) |shape| {
+            const nk = shape[0] * shape[1];
+            const need = std.mem.alignForward(usize, nk / 2, 256) + std.mem.alignForward(usize, nk / 32, 256) + nk / 32;
+            try t.expect(need <= df.rawBytesFor(s, 4, world));
+            // the 32-group scratch (TF_GLM_DFLASH2_Q32): scales and biases twice as many
+            const need32 = std.mem.alignForward(usize, nk / 2, 256) + std.mem.alignForward(usize, nk / 16, 256) + nk / 16;
+            try t.expect(need32 <= df.rawBytesFor(s, 4, world));
+        }
+    }
+}
