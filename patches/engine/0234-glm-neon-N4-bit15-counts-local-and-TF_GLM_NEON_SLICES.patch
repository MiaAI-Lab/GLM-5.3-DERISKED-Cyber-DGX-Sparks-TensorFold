+                    try glue.rmsnormBy(f.set(), f.stream, hidden[s], D, l.post_norm, normed[s], D, xs[s], c.eps, rows[s], D);
+                    if (fused) try moe.sharedOnly(f.moeKernels(), f.stream, m, b.moe, b.normed, D, lo[s], lo[s] + rows[s]) else try moe.sharedSlot(f.moeKernels(), f.stream, m, b.moe, b.normed, D, lo[s], lo[s] + rows[s]);
+                }
+                try f.stream.wait(p.gathered[last]);
+                try glue.rmsnormBy(f.set(), f.stream, hidden[last], D, l.post_norm, normed[last], D, xs[last], c.eps, rows[last], D);
+                if (fused) {
+                    // every slice's rows into its partial (one array, part[0] on); the first slices' shared slots summed in
+                    try moe.bodyFusedRows(f.moeKernels(), f.stream, m, b.moe, b.normed, D, R, part[0], lo[last]);
+                    for (0..last) |s| try f.sideExchangeAt(p, s, side_comm, part[s], scr[s], end[s], hidden[s], rows[s], if (f.taps) |t| .{ .t = t, .j = j, .x = b.hidden, .lo = lo[s] } else null, null);
+                } else {
