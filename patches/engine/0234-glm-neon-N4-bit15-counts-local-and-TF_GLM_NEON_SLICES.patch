+test "GLM neon slices: TP4's rooms (4,096 rows a rank, D 6144): disjoint partials in row order, scratch apart, clear of the positions" {
+    const world = 4;
+    const D = 6144;
+    const cap = prefill_rows;
+    const rows = sliceRows(prefill_rows).?;
+    const o = sliceRoom(rows, cap, world, D) orelse return error.TestUnexpectedResult;
+    const room = world * cap * D * 4;
+    var regions: [2 * slice_count][2]usize = undefined;
+    for (0..slice_count) |s| {
+        const per = rows[s] / world;
+        try std.testing.expectEqual(per * world, rows[s]); // no padded rows: scatterRowsAt reads only this slice's partial
+        try std.testing.expectEqual(o.lo[s] * D * 4, o.part[s]);
+        try std.testing.expect(o.part[s] % 256 == 0 and o.scratch[s] % 256 == 0); // the fused down's 16-byte stores, NCCL's buffers
+        if (s + 1 < slice_count) try std.testing.expectEqual(o.part[s] + rows[s] * D * 4, o.part[s + 1]); // one array: the fused down's out
+        const end = if (s + 1 < slice_count) o.scratch[s + 1] else o.end;
+        // scatterRowsAt's bound: the scattered sums then the gathered bf16 rows inside [scratch, end)
+        try std.testing.expect(o.scratch[s] + per * D * 4 + per * world * D * 2 <= end);
+        regions[2 * s] = .{ o.part[s], o.part[s] + rows[s] * D * 4 };
+        regions[2 * s + 1] = .{ o.scratch[s], o.scratch[s] + per * D * 4 + rows[s] * D * 2 };
+        if (s > 0) {
+            try std.testing.expect(o.pos[s] >= o.end and o.pos[s] + 4 <= room and o.pos[s] % 4 == 0 and o.pos[s] >= room - 256);
+            if (s > 1) try std.testing.expect(o.pos[s] >= o.pos[s - 1] + 4);
+        }
+    }
+    for (regions, 0..) |x, i| for (regions[i + 1 ..]) |y| try std.testing.expect(x[1] <= y[0] or y[1] <= x[0]); // no bytes shared
+    try std.testing.expect(o.end + 256 <= room);
+    // the whole fits beside the halves' (2 x span + 256) in the same room, no new allocation
+    try std.testing.expect(halvesFit(prefill_rows, cap, world, D));
+    std.debug.print("GLM neon slices: TP4 room {d} MiB, slices take {d} MiB (halves {d} MiB)\n", .{ room >> 20, o.end >> 20, (2 * std.mem.alignForward(usize, scatterRoom(2048, world, D), 256)) >> 20 });
+}
+
+test "GLM neon slices: rooms refuse slices that are not a multiple of the ranks or past the rows cap" {
+    const rows = sliceRows(prefill_rows).?;
+    try std.testing.expectEqual(@as(?SliceRoom, null), sliceRoom(rows, prefill_rows, 6, 6144)); // 1,280 rows over 6 ranks pad
+    try std.testing.expectEqual(@as(?SliceRoom, null), sliceRoom(rows, prefill_rows, 3, 6144));
+    try std.testing.expect(sliceRoom(rows, prefill_rows, 8, 6144) != null);
+    // two ranks: the partials (R x D x 4) and the gathered bf16 rows (R x D x 2) and sums fill the 2 x cap x D x 4
+    // room to its last byte, no room for the positions: null (the scatter path needs three ranks anyway)
+    try std.testing.expectEqual(@as(?SliceRoom, null), sliceRoom(rows, prefill_rows, 2, 6144));
+    try std.testing.expectEqual(@as(?SliceRoom, null), sliceRoom(rows, 2048, 4, 6144)); // more rows than the buffer's
+    try std.testing.expectEqual(@as(?SliceRoom, null), sliceRoom(.{ 768, 1280, 1280, 700 }, prefill_rows, 4, 6144));
+    // a room too small for the slices' bytes (one rank's room is cap rows of fp32, the slices take ~10 bytes a value): null
+    try std.testing.expectEqual(@as(?SliceRoom, null), sliceRoom(rows, prefill_rows, 1, 6144));
+}
