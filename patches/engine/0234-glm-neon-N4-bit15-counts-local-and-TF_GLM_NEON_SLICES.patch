+// neon rank #12 (GLM policy bit 15): a split selection's counts for all `rows` rows from the position alone, as
+// tf_glm_dsa_topk / tf_glm_dsa_tmerge write them (k past the all-visible prefix, 0 within): every rank's gathered counts
+// without the gather.
+extern "C" __global__ void tf_glm_dsa_counts(const int* pos, int k, int* counts, int rows) {
+  for (int r = blockIdx.x * blockDim.x + threadIdx.x; r < rows; r += gridDim.x * blockDim.x) {
+    const int64_t n = (int64_t)pos[0] + r + 1;
+    counts[r] = n > k ? k : 0;
+  }
+}
