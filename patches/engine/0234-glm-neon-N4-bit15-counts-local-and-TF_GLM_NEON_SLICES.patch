+    /// TF_GLM_NEON_SLICES: wholeDsaHalves over slice_count slices of rows (sliceRows), each site's exchange of a slice
+    /// on the side stream under the main stream's later work. Slice s attends to the keys slices before it wrote of the
+    /// same layer (on this stream, before it). The same ops on the same rows as the halves: every op split by rows is
+    /// row-independent (rmsnorm, the mixer's projections on glm_mm's one-slice prompt kernels in 64-row multiples, the
+    /// DSA select and attention a row at a time, the shared expert), and the routed experts still run once over all R
+    /// rows. Every slice owns its partial rows and exchange scratch in the room (sliceRoom), so the halves' event
+    /// protocol holds per slice: the main stream writes slice s's partial only after waiting p.gathered[s] (its last
+    /// exchange done), the side stream reads it only after p.filled[s]; hidden's rows of slice s are written by that
+    /// slice's exchanges alone (one side stream, in order) and read on the main stream after p.gathered[s].
+    fn wholeDsaSlices(f: *const Forward, R: usize, sr: SliceRoom) !void {
+        const r = f.ranks[0];
+        const c = &r.w.config;
+        const D: usize = c.hidden;
+        const b = r.b;
+        const st = r.st;
+        const p = f.pieces.?;
+        const side_comm = f.exchange.nccl.side_comm;
+        const rows = sliceRows(R) orelse return error.ScatterRoom;
+        const n_s = slice_count;
+        const lo = sr.lo;
+        if (sr.end + 256 > r.w.share.world * b.rows * D * 4) return error.ScatterRoom;
+        var pos_dev: [n_s]u64 = undefined;
+        var part: [n_s]u64 = undefined;
+        var scr: [n_s]u64 = undefined;
+        var end: [n_s]u64 = undefined;
+        var normed: [n_s]u64 = undefined;
+        var xs: [n_s]u64 = undefined;
+        var hidden: [n_s]u64 = undefined;
+        var dsa: [n_s]dsa_block.Scratch = @splat(b.dsa);
+        for (0..n_s) |s| {
+            pos_dev[s] = if (s == 0) st.pos_dev else b.gathered + sr.pos[s];
+            if (s > 0) { // slice s's device position: the chunk's plus lo[s]
+                var add: cuda.Args = .{};
+                add.add(st.pos_dev);
+                add.add(@as(c_int, @intCast(lo[s])));
+                add.add(pos_dev[s]);
+                try cuda.launch.launch(try f.m.ops().function("tf_glm_add_i32"), .{ .grid = .{ .x = 1 }, .block = .{ .x = 32 } }, f.stream, &add);
+            }
+            part[s] = b.gathered + sr.part[s];
+            scr[s] = b.gathered + sr.scratch[s];
+            end[s] = if (s + 1 < n_s) b.gathered + sr.scratch[s + 1] else b.gathered + sr.end;
+            normed[s] = b.normed + lo[s] * D * 2;
+            xs[s] = b.xs + lo[s] * (D / 64) * 4;
+            hidden[s] = b.hidden + lo[s] * D * 2;
+            // each slice's token lists after the slices' before it (the shared layers reuse each slice's own)
+            dsa[s].tokens += lo[s] * sparse.dsa_width * 4;
+            dsa[s].counts += lo[s] * 4;
+        }
+        const pol = OwnHalves.init(f, R).pol; // its qb bit only: slicesFor refused the owner rooms
+        var di: usize = 0;
+        for (r.w.layers, 0..) |l, j| {
+            prof_mod.context(f.prof, j, null, .mixer);
+            const a = l.mixer.mla;
+            const k: dsa_block.Kernels = .{ .set = f.set(), .ops = f.m.ops(), .prof = f.prof, .split = f.indexSplit(r) };
+            for (0..n_s) |s| {
+                if (j > 0) try f.stream.wait(p.gathered[s]); // this slice's ffn exchange of the layer before
+                try glue.rmsnormBy(f.set(), f.stream, hidden[s], D, l.in_norm, normed[s], D, xs[s], c.eps, rows[s], D);
+                const nch = @min(latent.chunksFor(st.pos + lo[s] + rows[s]), b.nch);
+                const qi_rows = if (pol.qb and a.rope != 0) sparse.splitRows(k.split, rows[s]) else null;
+                try dsa_block.bodyRows(k, f.stream, a, st.caches[di], dsa[s], normed[s], D, rows[s], pos_dev[s], st.pos + lo[s], nch, b.part_rows, null, false, qi_rows);
+                try dsa_block.fill(f.set(), f.stream, a, dsa[s], 0, rows[s], part[s]);
+                try f.sideExchangeAt(p, s, side_comm, part[s], scr[s], end[s], hidden[s], rows[s], null, null);
+            }
+            prof_mod.context(f.prof, j, null, .ffn);
+            const last = n_s - 1;
+            if (l.ffn == .moe and l.ffn.moe.exl3 != null and wholeExperts()) { // (EXL3) the routed experts once over every slice
+                const m = l.ffn.moe;
+                const fused = moe.fusedDown(f.moeKernels(), m, R);
+                // the first slices' shared experts, each under the later slices' mixer exchanges
+                for (0..last) |s| {
