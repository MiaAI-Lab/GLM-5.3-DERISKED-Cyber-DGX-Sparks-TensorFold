+/// TF_GLM_NEON_SLICES=1 (default off): a prompt chunk's slices of rows, short tails about long middles so each
+/// exchange has more compute to hide under (the first slice's ffn exchange under the last slice's shared expert, the
+/// last slice's mixer exchange under the first three's). Only a full 4,096-row chunk; null: the two halves' path.
+pub const slice_count = 4;
+pub const neon_slices = [slice_count]usize{ 768, 1280, 1280, 768 };
+
+pub fn sliceRows(R: usize) ?[slice_count]usize {
+    return if (R == neon_slices[0] + neon_slices[1] + neon_slices[2] + neon_slices[3]) neon_slices else null;
+}
+
+/// wholeDsaSlices' exchange rooms, byte offsets from the gathered room's start. `part[s]`: slice s's fp32 partial
+/// rows, every slice's in row order (part[s] = lo[s] x D x 4), so one fused down writes all of them as one array;
+/// `scratch[s]`: slice s's own scattered sums and gathered bf16 rows (scatterRowsAt). Every slice has its own bytes
+/// (nothing recycled): a slice's rows a multiple of the ranks (no padded rows past its partial, which would read the
+/// next slice's), and the whole below the slices' device positions in the room's last 256 bytes (`pos[s]`, s >= 1).
+pub const SliceRoom = struct { lo: [slice_count]usize, part: [slice_count]usize, scratch: [slice_count]usize, end: usize, pos: [slice_count]usize };
+
+pub fn sliceRoom(rows: [slice_count]usize, cap: usize, world: usize, D: usize) ?SliceRoom {
+    var o: SliceRoom = undefined;
+    var R: usize = 0;
+    for (rows, 0..) |n, s| {
+        if (n == 0 or n % 64 != 0 or n % world != 0) return null;
+        o.lo[s] = R;
+        o.part[s] = R * D * 4;
+        R += n;
+    }
+    if (R > cap) return null;
+    var at = std.mem.alignForward(usize, R * D * 4, 256);
+    for (rows, 0..) |n, s| {
+        const per = n / world;
+        o.scratch[s] = at;
+        at = std.mem.alignForward(usize, at + per * D * 4 + n * D * 2, 256); // scattered fp32 sums, then the bf16 rows
+    }
+    o.end = at;
+    const room = world * cap * D * 4;
+    if (o.end + 256 > room) return null;
+    for (0..slice_count) |s| o.pos[s] = room - 256 + 16 * s; // pos[0] unused (the state's own position)
+    return o;
+}
