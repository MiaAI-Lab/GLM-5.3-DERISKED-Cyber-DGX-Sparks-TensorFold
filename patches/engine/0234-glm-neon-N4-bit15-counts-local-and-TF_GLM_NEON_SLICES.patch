+    /// The slices' rooms for a chunk of R rows the two-halves path takes, or null (that path): the switch on, a full
+    /// chunk, rooms that fit (a slice's rows a multiple of the ranks), and no owner projections (OwnHalves' rooms and
+    /// ready flags are two halves'; logged once). DSpark taps take each slice's rows (taps.at of rows lo..lo + n).
+    fn slicesFor(f: *const Forward, R: usize) ?SliceRoom {
+        if (!neonSlicesOn()) return null;
+        const rows = sliceRows(R) orelse return null;
+        const r = f.ranks[0];
+        const S = struct {
+            var room_logged = false;
+            var owner_logged = false;
