+                    for (0..last) |s| {
+                        try moe.combineRows(f.moeKernels(), f.stream, m, b.moe, lo[s], lo[s] + rows[s], part[s]);
+                        try f.sideExchangeAt(p, s, side_comm, part[s], scr[s], end[s], hidden[s], rows[s], if (f.taps) |t| .{ .t = t, .j = j, .x = b.hidden, .lo = lo[s] } else null, null);
+                    }
+                }
+                // the last slice's shared expert and sum under the first slices' exchanges
+                if (fused) {
+                    try moe.sharedOnly(f.moeKernels(), f.stream, m, b.moe, b.normed, D, lo[last], R);
