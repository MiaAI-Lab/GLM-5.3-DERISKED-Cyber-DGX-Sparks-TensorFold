+    /// TF_GLM_NEON_SLICES=1 (default off), read once.
+    fn neonSlicesOn() bool {
+        const S = struct {
+            var once: ?bool = null;
+        };
+        if (S.once) |v| return v;
+        const v = if (std.c.getenv("TF_GLM_NEON_SLICES")) |e| std.mem.eql(u8, std.mem.span(e), "1") else false;
+        if (v) std.log.info("TF_GLM_NEON_SLICES=1: full prompt chunks of the two-halves path run as slices of {d}, {d}, {d}, {d} rows", .{ neon_slices[0], neon_slices[1], neon_slices[2], neon_slices[3] });
+        S.once = v;
