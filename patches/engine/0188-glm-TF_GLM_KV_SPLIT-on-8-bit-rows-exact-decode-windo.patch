+// ---- exact decode windows: the window's picked keys gathered, the unchanged attention on them ----
+
+namespace glm_kvs {
+// an exclusive scan of one int a thread over a 1,024-thread block (sh: 1,024 ints); returns this thread's offset
+__device__ __forceinline__ int block_scan(int v, int* sh, int* total) {
+  const int t = threadIdx.x;
+  sh[t] = v;
+  __syncthreads();
+  for (int o = 1; o < 1024; o <<= 1) {
+    const int x = t >= o ? sh[t - o] : 0;
+    __syncthreads();
+    sh[t] += x;
+    __syncthreads();
+  }
+  const int incl = sh[t];
+  if (total) *total = sh[1023];
+  __syncthreads();
+  return incl - v;
+}
+}  // namespace glm_kvs
+
+// The window's picks (rows' lists, counts) as one ascending union of positions below npos (ul), each position's index
+// among its owner's (uidx: its slot in the owner's share), and out[0] = |union|, out[1 + s] = rank s's share. One
+// block of 1,024 threads; bits: (npos + 31) / 32 words of scratch.
+extern "C" __global__ void __launch_bounds__(1024)
+    tf_glm_kvs_union(const int* tok, const int* cnt, int rows, int w, int64_t npos, int world, unsigned* bits, int* ul,
+                     int* uidx, int* out) {
+  __shared__ int sh[1024];
+  __shared__ int tot;
+  const int t = threadIdx.x;
+  const int64_t nw = (npos + 31) / 32;
+  for (int64_t i = t; i < nw; i += 1024) bits[i] = 0u;
+  __syncthreads();
+  for (int r = 0; r < rows; ++r)
+    for (int i = t; i < cnt[r]; i += 1024) {
+      const int p = tok[(int64_t)r * w + i];
+      atomicOr(&bits[p >> 5], 1u << (p & 31));
+    }
+  __syncthreads();
+  const int64_t per = (nw + 1023) / 1024, w0 = t * per, w1 = w0 + per < nw ? w0 + per : nw;
+  int mine = 0, own[glm_kvs::MAX_W] = {};
+  for (int64_t i = w0; i < w1; ++i) {
+    unsigned b = bits[i];
+    mine += __popc(b);
+    while (b) {
+      const int bit = __ffs(b) - 1;
+      b &= b - 1;
+      ++own[(i * 32 + bit) % world];
+    }
+  }
+  int at = glm_kvs::block_scan(mine, sh, &tot);
+  int oo[glm_kvs::MAX_W];
+  for (int s = 0; s < world; ++s) {
+    int all;
+    oo[s] = glm_kvs::block_scan(own[s], sh, &all);
+    if (t == 0) out[1 + s] = all;
+  }
+  if (t == 0) out[0] = tot;
+  for (int64_t i = w0; i < w1; ++i) {
+    unsigned b = bits[i];
+    while (b) {
+      const int bit = __ffs(b) - 1;
+      b &= b - 1;
+      const int p = (int)(i * 32 + bit);
+      ul[at] = p;
+      uidx[at] = oo[p % world]++;
+      ++at;
+    }
+  }
+}
+
+// This rank's share of the union: its rows (local row p div W of this layer's cache, `rb` bytes, and `sb` bytes of
+// scales when an 8-bit cache has them) into the send rows at their share index. Block (union element), 64 threads.
+extern "C" __global__ void __launch_bounds__(64)
+    tf_glm_kvs_pack(const unsigned char* lc, const unsigned char* ls, const int* ul, const int* uidx, int world,
+                    int rank, int64_t rb, int64_t sb, unsigned char* send, unsigned char* send_s) {
+  const int u = blockIdx.x, p = ul[u];
+  if (p % world != rank) return;
+  const int64_t j = p / world, at = uidx[u];
+  glm_kvs::copy_row(send + at * rb, lc + j * rb, rb);
+  if (sb) glm_kvs::copy_row(send_s + at * sb, ls + j * sb, sb);
+}
+
+// A window's lists (positions) as rows of the gathered shares: position p -> (p mod W) c + its share index. Block a
+// row, 1,024 threads; un the union's size.
+extern "C" __global__ void __launch_bounds__(1024)
+    tf_glm_kvs_remap(const int* tok, const int* cnt, int w, const int* ul, const int* uidx, int un, int world, int c,
+                     int* out) {
+  const int64_t r = blockIdx.x;
+  for (int i = threadIdx.x; i < cnt[r]; i += 1024) {
+    const int p = tok[r * w + i];
+    int lo = 0, hi = un;
+    while (lo < hi) {
+      const int mid = (lo + hi) >> 1;
+      if (ul[mid] < p) lo = mid + 1; else hi = mid;
+    }
+    out[r * w + i] = (p % world) * c + uidx[lo];
+  }
 }
