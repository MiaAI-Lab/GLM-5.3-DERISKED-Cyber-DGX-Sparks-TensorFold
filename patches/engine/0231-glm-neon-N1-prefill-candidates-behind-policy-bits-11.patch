index 3b09d6e50..875f8ce19 100644
--- a/zig/kernels/cuda/glm_glue_bmm.cuh
+++ b/zig/kernels/cuda/glm_glue_bmm.cuh
@@ -375,6 +375,115 @@ extern "C" __global__ void __launch_bounds__(128)
       }
 }
 
+// neon rank #13 (GLM policy bit 14): tf_glm_router_tile then tf_glm_slice_sum in one launch for prompt rows. A block of
+// 8 warps holds 128 rows x 64 experts; for each K slice s in order it runs that slice's MMA chain from zero over the
+// same 16-wide steps (32 inputs a stage, three stages) and adds it to the running total (s = 0 takes it as is):
+// router_tile's per-slice dots and slice_sum's adds in slice order, bit for bit, with no slice partials in memory.
+// Dynamic shared memory: 3 x (128 + 64) x 40 bf16 = 46,080 bytes.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_glm_router_fused(const __nv_bfloat16* x, const __nv_bfloat16* w, float* out, int64_t rows, int64_t x_stride,
+                        int64_t d, int64_t ne, int ks) {
+  glm_triton::pdl_trigger();
+  constexpr int KS = 32, STAGES = 3, BM = 128, BE = 64, LD = KS + 8, A = BM * LD, B = BE * LD, STAGE = (A + B) * 2;
+  constexpr int WN = 2, MT = 2, NT = 4, THREADS = 256, CH = KS / 8, RPI = THREADS / CH;
+  extern __shared__ __align__(16) __nv_bfloat16 rf_sm[];
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5, g = lane >> 2, q = lane & 3;
+  const int wm = warp / WN, wn = warp % WN;
+  const int64_t m0 = (int64_t)blockIdx.x * BM, e0 = (int64_t)blockIdx.y * BE, span = d / ks;
+  const int steps_per_s = static_cast<int>(span / KS), total_steps = steps_per_s * ks;
+  const int lr = tid / CH, lc = (tid % CH) * 8;
+  const __nv_bfloat16* ga[BM / RPI];
+  const __nv_bfloat16* gb[BE / RPI];
+  unsigned oka = 0, okb = 0;
+#pragma unroll
+  for (int i = 0; i < BM / RPI; ++i) {
+    const int64_t row = m0 + lr + i * RPI;
+    oka |= (row < rows ? 1u : 0u) << i;
+    ga[i] = x + (row < rows ? row : 0) * x_stride + lc;
+  }
+#pragma unroll
+  for (int i = 0; i < BE / RPI; ++i) {
+    const int64_t e = e0 + lr + i * RPI;
+    okb |= (e < ne ? 1u : 0u) << i;
+    gb[i] = w + (e < ne ? e : 0) * d + lc;
+  }
+  const unsigned sbase = static_cast<unsigned>(__cvta_generic_to_shared(rf_sm)), soff = (lr * LD + lc) * 2;
+  auto load = [&](int st, int step) {
+    const unsigned a = sbase + st * STAGE + soff;
+    const int64_t koff = (int64_t)step * KS;
+#pragma unroll
+    for (int i = 0; i < BM / RPI; ++i) glm_bmm::cp16s(a + i * RPI * LD * 2, ga[i] + koff, (oka >> i) & 1);
+#pragma unroll
+    for (int i = 0; i < BE / RPI; ++i) glm_bmm::cp16s(a + A * 2 + i * RPI * LD * 2, gb[i] + koff, (okb >> i) & 1);
+  };
+  const unsigned fa = sbase + ((wm * 32 + (lane & 15)) * LD + (lane >> 4) * 8) * 2;
+  const unsigned fb = sbase + A * 2 + ((wn * 32 + (lane >> 4) * 8 + (lane & 7)) * LD + ((lane >> 3) & 1) * 8) * 2;
+  float tot[MT][NT][4], cur[MT][NT][4];
+#pragma unroll
+  for (int i = 0; i < MT; ++i)
+#pragma unroll
+    for (int j = 0; j < NT; ++j)
+#pragma unroll
+      for (int e = 0; e < 4; ++e) tot[i][j][e] = 0.0f;
+#pragma unroll
+  for (int st = 0; st < STAGES - 1; ++st) {
+    if (st < total_steps) load(st, st);
+    glm_bmm::commit();
+  }
+  int step = 0;
+  for (int s = 0; s < ks; ++s) {
+#pragma unroll
+    for (int i = 0; i < MT; ++i)
+#pragma unroll
+      for (int j = 0; j < NT; ++j)
+#pragma unroll
+        for (int e = 0; e < 4; ++e) cur[i][j][e] = 0.0f;
+    for (int kt = 0; kt < steps_per_s; ++kt, ++step) {
+      const int nxt_step = step + STAGES - 1;
+      if (nxt_step < total_steps) load(nxt_step % STAGES, nxt_step);
+      glm_bmm::commit();
+      glm_bmm::wait<STAGES - 1>();
+      __syncthreads();
+      const unsigned st = (step % STAGES) * STAGE;
+#pragma unroll
+      for (int k16 = 0; k16 < KS; k16 += 16) {
+        uint32_t a[MT][4], b[NT][2];
+#pragma unroll
+        for (int i = 0; i < MT; ++i) glm_bmm::ldm4s(a[i], fa + st + (i * 16 * LD + k16) * 2);
+#pragma unroll
+        for (int j = 0; j < NT; j += 2) {
+          uint32_t r[4];
+          glm_bmm::ldm4s(r, fb + st + (j * 8 * LD + k16) * 2);
+          b[j][0] = r[0], b[j][1] = r[1], b[j + 1][0] = r[2], b[j + 1][1] = r[3];
+        }
+#pragma unroll
+        for (int i = 0; i < MT; ++i)
+#pragma unroll
+          for (int j = 0; j < NT; ++j) glm_router::mma16816(cur[i][j], a[i], b[j]);
+      }
+      __syncthreads();
+    }
+#pragma unroll
+    for (int i = 0; i < MT; ++i)
+#pragma unroll
+      for (int j = 0; j < NT; ++j)
+#pragma unroll
+        for (int e = 0; e < 4; ++e) tot[i][j][e] = (s == 0) ? cur[i][j][e] : (tot[i][j][e] + cur[i][j][e]);
+  }
+  glm_bmm::wait<0>();
+#pragma unroll
+  for (int i = 0; i < MT; ++i)
+#pragma unroll
+    for (int j = 0; j < NT; ++j)
+#pragma unroll
+      for (int h = 0; h < 2; ++h)
+#pragma unroll
+        for (int jj = 0; jj < 2; ++jj) {
+          const int64_t r = m0 + wm * 32 + i * 16 + g + h * 8, col = e0 + wn * 32 + j * 8 + q * 2 + jj;
+          if (r < rows && col < ne) out[r * ne + col] = tot[i][j][h * 2 + jj];
+        }
+}
+
 // Decode windows (under 128 rows): 16 x 64 a block of 4 warps, K 64 at a time, one K slice a block along z.
 extern "C" __global__ void __launch_bounds__(128)
     tf_glm_bmm_decode(const __nv_bfloat16* x, const __nv_bfloat16* w, void* out, float* part, int64_t m,
diff --git a/zig/kernels/cuda/glm_glue_msa.cuh b/zig/kernels/cuda/glm_glue_msa.cuh
index c245d409d..d8aa9da63 100644
--- a/zig/kernels/cuda/glm_glue_msa.cuh
+++ b/zig/kernels/cuda/glm_glue_msa.cuh
@@ -172,6 +172,61 @@ struct Cache8T {
 using Cache8 = Cache8T<Raw8>;
 using Cache8I = Cache8T<Raw8I>;
 
+// neon rank #9 (GLM policy bit 13): Cache8I's rows dequantized in bf16 pairs. lat_write_i8 stores power-of-two scales
+// (2^(e-127), e in 1..254), so with u = q ^ 0x80 the pair a = 0x4300 | (u & 127), c = (u & 128) ^ 0x4380 gives a - c
+// = q exactly in bf16 (as bpairs8_fast), and bf16(q) * bf16(s) is exact (or the same inf) as fmul_rn(q, s) then the
+// round to bf16 in deq2<true>: the same bits, fewer registers (tf_glm_msa_w576_i8_f3 runs three CTAs an SM).
+struct Raw8IF {
+    uint4 c[4];
+    uint2 r;
+    __nv_bfloat162 s, s2;  // the latent and rope planes' scales, as bf16 pairs
+};
+__device__ __forceinline__ uint32_t deq2_i8f(uint32_t two_xor80, __nv_bfloat162 s2) {
+    const uint32_t k43 = 0x43004300u, k438 = 0x43804380u;
+    const uint32_t t = __byte_perm(two_xor80, 0u, 0x4140);
+    uint32_t a, c;
+    asm("lop3.b32 %0, %1, 0x007F007F, %2, 0xea;" : "=r"(a) : "r"(t), "r"(k43));
+    asm("lop3.b32 %0, %1, 0x00800080, %2, 0x6a;" : "=r"(c) : "r"(t), "r"(k438));
+    const __nv_bfloat162 d = __hsub2(*reinterpret_cast<const __nv_bfloat162*>(&a), *reinterpret_cast<const __nv_bfloat162*>(&c));
+    const __nv_bfloat162 r = __hmul2(d, s2);
+    return *reinterpret_cast<const uint32_t*>(&r);
+}
+__device__ __forceinline__ uint4 deq8_i8f(uint32_t lo, uint32_t hi, __nv_bfloat162 s2) {
+    const uint32_t l = lo ^ 0x80808080u, h = hi ^ 0x80808080u;
+    return make_uint4(deq2_i8f(l, s2), deq2_i8f(l >> 16, s2), deq2_i8f(h, s2), deq2_i8f(h >> 16, s2));
+}
+__device__ __forceinline__ void put(const Raw8IF& x, __nv_bfloat16* __restrict__ krow, int h) {
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        *reinterpret_cast<uint4*>(krow + 64 * h + 16 * i) = deq8_i8f(x.c[i].x, x.c[i].y, x.s);
+        *reinterpret_cast<uint4*>(krow + 64 * h + 16 * i + 8) = deq8_i8f(x.c[i].z, x.c[i].w, x.s);
+    }
+    *reinterpret_cast<uint4*>(krow + WC + 8 * h) = deq8_i8f(x.r.x, x.r.y, x.s2);
+}
+struct Cache8IF {
+    const unsigned char* __restrict__ p;
+    const float* __restrict__ sc;
+    using R = Raw8IF;
+    __device__ __forceinline__ void load(Raw8IF& x, int tok, int w, int h) const {
+        if (tok < 0) {
+#pragma unroll
+            for (int i = 0; i < 4; ++i) x.c[i] = make_uint4(0u, 0u, 0u, 0u);
+            x.r = make_uint2(0u, 0u);
+            x.s = __float2bfloat162_rn(1.f);
+            x.s2 = x.s;
+            return;
+        }
+        const unsigned char* row = p + (long long)tok * ROW;
+        const uint4* src = reinterpret_cast<const uint4*>(row + WC * w + 64 * h);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) x.c[i] = __ldg(src + i);
+        x.r = __ldg(reinterpret_cast<const uint2*>(row + LW + WR * w + 8 * h));
+        const float2 sf = __ldg(reinterpret_cast<const float2*>(sc + 2 * (long long)tok));
+        x.s = __float2bfloat162_rn(sf.x);
+        x.s2 = __float2bfloat162_rn(sf.y);
+    }
+};
+
 // one tile of KT keys at t0: store the lane's raw values (then load the next tile's into them), the warp's partial
 // scores, their sum over the warps in warp order, the online softmax and the warp's columns of O += P V
 template <bool DENSE, class C>
@@ -380,6 +435,20 @@ extern "C" __global__ void __launch_bounds__(glm_msa::NT, 2)
     glm_msa::run<true>(qa, glm_msa::Cache8I{codes, scales}, nullptr, pos, out, H, 0, scale);
 }
 
+// neon rank #9 (policy bit 13): the int8 pair over Cache8IF, three CTAs an SM (168 registers, no spill)
+extern "C" __global__ void __launch_bounds__(glm_msa::NT, 3)
+    tf_glm_msa_w576_i8_f3(const __nv_bfloat16* __restrict__ qa, const unsigned char* __restrict__ codes,
+                          const float* __restrict__ scales, const int* __restrict__ tokens,
+                          const int* __restrict__ counts, __nv_bfloat16* __restrict__ out, int H, int W, float scale) {
+    glm_msa::run<false>(qa, glm_msa::Cache8IF{codes, scales}, tokens, counts, out, H, W, scale);
+}
+extern "C" __global__ void __launch_bounds__(glm_msa::NT, 3)
+    tf_glm_msa_w576_dense_i8_f3(const __nv_bfloat16* __restrict__ qa, const unsigned char* __restrict__ codes,
+                                const float* __restrict__ scales, const int* __restrict__ pos,
+                                __nv_bfloat16* __restrict__ out, int H, float scale) {
+    glm_msa::run<true>(qa, glm_msa::Cache8IF{codes, scales}, nullptr, pos, out, H, 0, scale);
+}
