diff --git a/zig/kernels/cuda/glm_dsa_scores_rows.cuh b/zig/kernels/cuda/glm_dsa_scores_rows.cuh
index 3391e0177..1f343e8fe 100644
--- a/zig/kernels/cuda/glm_dsa_scores_rows.cuh
+++ b/zig/kernels/cuda/glm_dsa_scores_rows.cuh
@@ -115,3 +115,126 @@ extern "C" __global__ void __launch_bounds__(128)
                          int64_t heads, int loop) {
   glm_dsa_rows::scores_rows<8>(qr, wts, w_stride, ik, out, pos, rows, np, nb, scale, wscale, heads, loop);
 }
+
+// tf_glm_dsa_scores_w8 (neon rank #1, GLM policy bit 11): the same scores as tf_glm_dsa_scores_r8 / _roped with the
+// layout turned round: 8 warps a CTA, one prompt row a warp, that row's 32 x 128 roped query fragments held in
+// registers for the whole key walk (staged through shared memory once), and all 8 warps sharing each double-buffered
+// 64-key block (2 x 64 x 128 x 2 = 32 KiB of dynamic shared memory: three CTAs an SM, no spill). The MMA chain, scale,
+// ReLU, head-weight FMAs and the reduction are tf_glm_dsa_scores_r8's per (row, key), so every score is the same bits;
+// blocks no row sees score -inf as there. 32-bit loop coordinates (keys, rows and blocks fit easily); the stores index
+// in 64 bits.
+namespace glm_dsa_rows {
+__device__ __forceinline__ void scores_w8(const __nv_bfloat16* __restrict__ qr, const __nv_bfloat16* __restrict__ wts,
+                                          int w_stride, const __nv_bfloat16* __restrict__ ik, float* __restrict__ out,
+                                          const int* __restrict__ pos, int rows, int np, int nb, float scale, float wscale,
+                                          int heads, int loop) {
+  constexpr int RB = 8, D = 128, HP = 32, BP = 64, THREADS = RB * 32, QSLOTS = (2 * BP) / HP;
+  extern __shared__ __align__(16) unsigned char dsw_smem[];
+  __nv_bfloat16* sm = reinterpret_cast<__nv_bfloat16*>(dsw_smem);
+  auto at = [](int row, int u) { return row * D + ((u ^ (row & 7)) << 3); };
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5, g = lane >> 2, q = lane & 3;
+  const int r0 = (int)blockIdx.x * RB;
+  const int nr = min(rows - r0, RB);
+  const int my_r = r0 + warp;
+  const bool row_ok = warp < nr;
+  const int p0_pos = pos[0];
+  const int n = p0_pos + (row_ok ? my_r : r0) + 1;
+  const int nmax = p0_pos + r0 + nr;  // the last row's visible keys
+  uint32_t aq[D / 16][2][4];
+  for (int wb = 0; wb < RB; wb += QSLOTS) {  // QSLOTS rows' queries at a time through the key buffers
+    const int wend = min(RB, wb + QSLOTS), nq = wend - wb;
+    for (int idx = tid; idx < nq * HP * (D / 8); idx += THREADS) {
+      const int rw = idx / (HP * (D / 8)), hh = (idx / (D / 8)) % HP, u = idx % (D / 8);
+      const int rr = wb + rw;
+      const bool ok = rr < nr && hh < heads;
+      glm_attn::cp16(sm + rw * HP * D + at(hh, u), qr + ((int64_t)(r0 + (ok ? rr : 0)) * heads + (ok ? hh : 0)) * D + u * 8, ok);
+    }
+    glm_attn::commit();
+    glm_attn::wait<0>();
+    __syncthreads();
+    if (warp >= wb && warp < wend) {
+      const __nv_bfloat16* my_q = sm + (warp - wb) * HP * D;
+#pragma unroll
+      for (int kq = 0; kq < D / 16; ++kq)
+#pragma unroll
+        for (int i = 0; i < 2; ++i) glm_attn::ldm4<false>(aq[kq][i], my_q + at(i * 16 + (lane & 15), kq * 2 + (lane >> 4)));
+    }
+    __syncthreads();
+  }
+  float wv[4];
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const int hh = g + 8 * i;
+    wv[i] = (row_ok && hh < heads) ? glm_triton::fmul(__bfloat162float(wts[(int64_t)my_r * w_stride + hh]), wscale) : 0.0f;
+  }
+  auto stage = [&](int buf, int k0) {
+    __nv_bfloat16* dst = sm + buf * BP * D;
+    constexpr int PER = BP * (D / 8) / THREADS;
+    const __nv_bfloat16* src = ik + (int64_t)(k0 < nmax ? k0 : 0) * D;
+#pragma unroll
+    for (int t = 0; t < PER; ++t) {
+      const int idx = tid + t * THREADS, row = idx / (D / 8), u = idx % (D / 8);
+      const bool ok = (k0 + row) < nmax;
+      glm_attn::cp16(dst + at(row, u), src + (int64_t)(ok ? row : 0) * D + u * 8, ok);
+    }
+  };
+  const int first = (int)blockIdx.y * loop;
+  const int total = min(loop, nb - first);
+  auto live = [&](int t) { return t < total && (first + t) * BP < nmax; };
+  float* my_out = out + (int64_t)my_r * np;
+  if (live(0)) stage(0, first * BP);
+  glm_attn::commit();
+  for (int t = 0; t < total; ++t) {
+    const int k0 = (first + t) * BP;
+    if (!live(t)) {  // no row sees this block: -inf, as the one-row kernel writes it
+      if (row_ok)
+        for (int e = lane; e < BP; e += 32)
+          if (k0 + e < np) my_out[k0 + e] = -INFINITY;
+      continue;
+    }
+    if (live(t + 1)) stage((t + 1) & 1, k0 + BP);
+    glm_attn::commit();
+    glm_attn::wait<1>();
+    __syncthreads();
+    if (row_ok) {
+      const __nv_bfloat16* keys = sm + (t & 1) * BP * D;
+      for (int kg = 0; kg < BP / 16; ++kg) {
+        const int p0 = k0 + kg * 16;
+        const __nv_bfloat16* kp = keys + kg * 16 * D;
+        float acc[2][2][4] = {};
+#pragma unroll
+        for (int kq = 0; kq < D / 16; ++kq) {
+          uint32_t b[4];
+          glm_attn::ldm4<false>(b, kp + at((lane >> 4) * 8 + (lane & 7), kq * 2 + ((lane >> 3) & 1)));
+#pragma unroll
+          for (int nt = 0; nt < 2; ++nt)
+#pragma unroll
+            for (int i = 0; i < 2; ++i) glm_router::mma16816(acc[i][nt], aq[kq][i], b + 2 * nt);
+        }
+#pragma unroll
+        for (int nt = 0; nt < 2; ++nt)
+#pragma unroll
+          for (int e = 0; e < 2; ++e) {
+            const float v0 = fmaxf(__fmul_rn(acc[0][nt][e], scale), 0.0f), v1 = fmaxf(__fmul_rn(acc[0][nt][e + 2], scale), 0.0f);
+            const float v2 = fmaxf(__fmul_rn(acc[1][nt][e], scale), 0.0f), v3 = fmaxf(__fmul_rn(acc[1][nt][e + 2], scale), 0.0f);
+            float s = glm_triton::fmul(wv[1], v1);
+            s = __fmaf_rn(wv[0], v0, s);
+            s = __fmaf_rn(wv[2], v2, s);
+            s = __fmaf_rn(wv[3], v3, s);
+            for (int o = 16; o >= 4; o >>= 1) s = s + __shfl_xor_sync(0xffffffffu, s, o);
+            const int p = p0 + nt * 8 + q * 2 + e;
+            if (g == 0 && p < np) my_out[p] = p < n ? s : -INFINITY;
+          }
+      }
+    }
+    __syncthreads();
+  }
+}
+}  // namespace glm_dsa_rows
+
+extern "C" __global__ void __launch_bounds__(256, 2)
+    tf_glm_dsa_scores_w8(const __nv_bfloat16* qr, const __nv_bfloat16* wts, int w_stride, const __nv_bfloat16* ik,
+                         float* out, const int* pos, int rows, int np, int nb, float scale, float wscale, int heads,
+                         int loop) {
+  glm_dsa_rows::scores_w8(qr, wts, w_stride, ik, out, pos, rows, np, nb, scale, wscale, heads, loop);
+}
