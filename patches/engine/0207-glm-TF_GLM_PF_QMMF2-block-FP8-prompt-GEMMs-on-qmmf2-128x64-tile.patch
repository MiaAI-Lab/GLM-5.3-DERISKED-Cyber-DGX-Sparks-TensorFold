+        const xs = r.bfs(sh.m * ldx, 2.0);
+        if (specials) for (0..sh.m) |row| {
+            if (row % 7 == 0) @memset(xs[row * ldx ..][0..sh.k], if (row % 14 == 0) 0x0000 else 0x8000); // +0 / -0 rows
+            if (row % 11 == 3) for (0..sh.k / 97) |c| {
+                // NaN payloads, infinities, subnormals and the largest finite bf16 in the activations
+                xs[row * ldx + c * 97] = ([_]u16{ 0x7FC1, 0xFF81, 0x7F80, 0xFF80, 0x0001, 0x807F, 0x7F7F })[c % 7];
+            };
+        };
+        const x = try r.dev(std.mem.sliceAsBytes(xs));
+        const part = try r.out(@max(16, lane.partBytes(sh.m, w)));
+        const takes = cuda.qmmf.pf2Takes(sh.m, w);
+        if (takes) taken += 1;
+        var ms: [2]f64 = .{ 0, 0 };
+        inline for (.{ cuda.qmmf.Out.f32, cuda.qmmf.Out.bf16 }) |out| {
+            const bytes = sh.m * sh.n * (if (out == .f32) @as(usize, 4) else 2);
+            const ys = [2]u64{ try r.out(bytes + 16) + 4, try r.out(bytes + 16) + 4 }; // 4 mod 8: scalar fp32 stores
+            for (0..2) |on| {
+                var l = lane;
+                l.pf2 = if (on == 1) pf2 else null;
+                try l.matmulOut(r.s, x, ldx, sh.m, w, ys[on], out, part);
+                try r.s.synchronize();
+            }
+            try check.sameBytes(sh.what, try r.back(u8, ys[1], bytes), try r.back(u8, ys[0], bytes));
+            compared += 1;
+            if (out == .f32) for (0..2) |on| {
+                var l = lane;
+                l.pf2 = if (on == 1) pf2 else null;
+                const reps = 20;
+                for (0..2) |_| try l.matmulOut(r.s, x, ldx, sh.m, w, ys[on], out, part);
+                try r.s.synchronize();
+                const t0 = check.now(gpu.io);
+                for (0..reps) |_| try l.matmulOut(r.s, x, ldx, sh.m, w, ys[on], out, part);
+                try r.s.synchronize();
+                ms[on] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6 / reps;
+            };
+        }
+        const tf = 2.0 * @as(f64, @floatFromInt(sh.m * sh.n * sh.k)) / 1e9;
+        std.debug.print("lane-pf2 {s} m={d} n={d} k={d}{s}: lane {d:.3} ms ({d:.1} TFLOPS), {s} {d:.3} ms ({d:.1} TFLOPS), bytes equal (bf16, f32)\n", .{ sh.what, sh.m, sh.n, sh.k, if (specials) " specials" else "", ms[0], tf / ms[0], if (takes) "qmmf2" else "not taken", ms[1], tf / ms[1] });
+    }
+    try check.expect(taken == 11 and compared == 2 * shapes.len, "qmmf2 takes the 11 prompt shapes ({d}) and every output was compared ({d})", .{ taken, compared });
+    // qmmf2's running total starts at -0: its proof over every fp32 input (qmmf2.cu, tf_qmmf2_neg0_check)
+    {
+        const f = try pf2.mod.function("tf_qmmf2_neg0_check");
+        const zero = [2]u32{ 0, 0 };
+        const bad = try r.dev(std.mem.sliceAsBytes(&zero));
+        var base: u64 = 0;
+        while (base <= 0xFFFFFFFF) : (base += 1 << 30) {
+            var args: cuda.launch.Args = .{};
+            args.add(base);
+            args.add(bad);
+            try cuda.launch.launch(f, .{ .grid = .{ .x = (1 << 30) / 256, .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, r.s, &args);
+        }
+        const got = try r.back(u32, bad, 2);
+        try check.expect(got[0] == 0 and got[1] == 0, "-0 + x is x (NaN: 0x7FFFFFFF) and FFMA NaNs are canonical over all 2^32 inputs ({d}, {d} bad)", .{ got[0], got[1] });
+    }
+    check.pass("lane-pf2: qmmf2's bytes equal the lane's on {d} shapes x 2 outputs ({d} taken by qmmf2)", .{ shapes.len, taken });
+}
