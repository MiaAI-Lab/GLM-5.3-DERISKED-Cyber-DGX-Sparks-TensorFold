diff --git a/zig/src/cuda/qmmf.zig b/zig/src/cuda/qmmf.zig
index 0b4774e55..f41ac6841 100644
--- a/zig/src/cuda/qmmf.zig
+++ b/zig/src/cuda/qmmf.zig
@@ -116,6 +116,37 @@ pub const reduce_symbols = [2][:0]const u8{
 };
 const row_tiles = [_]u32{ 16, 32, 64 };
 
+/// TF_GLM_PF_QMMF2=1 (default off; read once, at Lane.load): block-FP8 prompt calls of at least `pf2_rows` rows and
+/// `pf2_min_k` inputs run qmmf2.cu's 128x64 tile (2 x 2 warps, two stages) instead of the 64-row lane tile. Its bytes
+/// are the lane's: the same MMA chains, scale fma and K-slice sum order (qmmf2.cu), so a row's bits still do not
+/// depend on the row count or on which kernel ran. Off, the qmmf2 image is never loaded and every call is unchanged.
+pub const pf2_env = "TF_GLM_PF_QMMF2";
+pub const pf2_rows = fused_rows; // prompt rows: the lane's fused-slice plan, every row count above it alike
+pub const pf2_min_k = 1024; // below 16 groups the 64-row tile is as fast (measured on GB10: K 512 is 10% slower)
+pub const pf2_bm = 128;
+const pf2_threads = 128; // WM 2 x WN 2 warps
+
+pub const pf2_symbols = [2][:0]const u8{ // by Out: bf16, f32
+    "_ZN8tf_qmmf210qmmf2_fp8gILi128ELi64ELi2ELi2ELi2ELb0EEEvPK13__nv_bfloat16PKhS5_fPviiiiii",
+    "_ZN8tf_qmmf210qmmf2_fp8gILi128ELi64ELi2ELi2ELi2ELb1EEEvPK13__nv_bfloat16PKhS5_fPviiiiii",
+};
+
+/// qmmf2.cu's Tile<128, 64, 2, 2, 2>::SMEM: two stages of 128 input rows, 64 columns of codes and their scales.
+pub fn pf2Shared() u32 {
+    const stage: u32 = (pf2_bm * group * 2 + bn * group + bn * 4 + 127) / 128 * 128;
+    return 2 * stage;
+}
+
+/// Whether a call of `m` rows on `w` takes the qmmf2 tile (when loaded).
+pub fn pf2Takes(m: usize, w: Weight) bool {
+    return w.mode == .fp8g and m >= pf2_rows and w.k >= pf2_min_k and w.k % group == 0;
+}
+
+fn pf2On() bool {
+    const v = std.c.getenv(pf2_env) orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
 /// What a call writes: bf16 rows, or the fp32 sums unrounded (a tensor-parallel rank's partial rows).
 pub const Out = enum { bf16, f32 };
 
@@ -139,6 +170,9 @@ pub const Lane = struct {
     half: [2][2][2]Function, // by halfModeIndex, Out, then plain / cluster
