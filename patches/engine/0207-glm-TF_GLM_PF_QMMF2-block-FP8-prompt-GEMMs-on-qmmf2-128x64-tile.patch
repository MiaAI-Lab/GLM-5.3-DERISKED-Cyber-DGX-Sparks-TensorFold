new file mode 100644
index 000000000..606c774fb
--- /dev/null
+++ b/zig/kernels/cuda/qmmf2.cu
@@ -0,0 +1,243 @@
+// Block-FP8 prompt matmul (TF_GLM_PF_QMMF2): qmmf.cu's FP8G lane sums, bit for bit, on a 128 x 64 tile with fewer
+// instructions and fewer bytes moved a flop. Every output element keeps qmmf_kernel<FP8G, 64, 64, 1, 4, 4, *, *, *>'s
+// arithmetic exactly:
+//   per K slice s (K/64/SK groups each, ascending): acc = 0; per group g: d = the four m16n8k16 bf16 MMAs over k16
+//   steps 0..3 (the first from zero) on the same A and B fragments; acc = fma(d, scale[col][g], acc);
+//   then ((acc_0 + acc_1) + acc_2) + ..., the order of the fused kernel's running total (and of the cluster and
+//   memory sums); times the tensor scale; bf16 (round to nearest even) or fp32 out.
+// Only the schedule changes: a CTA holds BM x BN outputs on WM x WN warps (a staged input row feeds BN columns, a
+// staged weight column BM rows), a warp widens each group's e4m3 codes to bf16 once and walks its m16 row tiles one
+// at a time (the four-step chains of its n8 tiles in flight together), and the stage copies run from addresses
+// computed once.
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+#include "common/qmm_frag.cuh"
+
+namespace tf_qmmf2 {
+
+using namespace qmm_frag;
+
+constexpr int GS = 64; // inputs a stage holds (one column scale each)
+
+// qmmf.cu's fp8pair on the two halves of a word: lo from bytes 0 and 1, hi from bytes 2 and 3, the same bf16x2 bits.
+// fp8pair builds t = ((b & 0x7F) << 4) | ((b & 0x80) << 8) in each half of byte b and multiplies by 2^120 (the bf16x2
+// fma with -0); here the bytes move to bits 8..15 of each half by a byte permute and t follows in two logic ops.
+__device__ __forceinline__ uint32_t widen(uint32_t y) { // y: halves (b << 8)
+    const uint32_t t = ((y & 0x7F007F00u) >> 4) | (y & 0x80008000u);
+    uint32_t r;
+    asm("fma.rn.bf16x2 %0, %1, %2, %3;\n" : "=r"(r) : "r"(t), "r"(0x7B807B80u), "r"(0x80008000u));
+    return r;
+}
+__device__ __forceinline__ void fp8pairs(uint32_t w, uint32_t& lo, uint32_t& hi) {
+    lo = widen(__byte_perm(w, 0u, 0x1404u));
+    hi = widen(__byte_perm(w, 0u, 0x3424u));
+}
+
+template <int BM, int BN, int WM, int WN, int STAGES>
+struct Tile {
+    static constexpr int THREADS = WM * WN * 32;
+    static constexpr int MT = BM / WM / 16;  // m16 tiles a warp
+    static constexpr int NT = BN / WN / 8;   // n8 tiles a warp
+    static constexpr int TB = BN / 64;       // packed 64-column tiles a CTA
+    static constexpr int ROW = GS * 2;       // bytes of one input row a stage
+    static constexpr int CHUNKS = ROW / 16;
+    static constexpr int X = BM * ROW;
+    static constexpr int W = BN * GS;        // e4m3 codes
+    static constexpr int S = BN * 4;         // fp32 column scales
+    static constexpr int STAGE = (X + W + S + 127) / 128 * 128;
+    static constexpr int SMEM = STAGES * STAGE;
+    static constexpr int XC = BM * CHUNKS / THREADS; // 16-byte input copies a thread a stage
+    static constexpr int WC = W / 16 / THREADS;      // and weight copies
+    static_assert(THREADS % 64 == 0 && 256 % THREADS == 0 && BM % (THREADS / CHUNKS) == 0 && W / 16 % THREADS == 0 && S / 16 <= THREADS,
+                  "whole copies a thread, the swizzle kept by the row step");
+};
+
+// y [M, N] = x [M, K] (rows ldx apart) . w, K in SK slices of K/64/SK groups each (SK from the shape, qmmf.splitK).
+template <int BM, int BN, int WM, int WN, int STAGES, bool F32>
+__global__ void __launch_bounds__(WM * WN * 32) qmmf2_fp8g(
+        const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ w, const uint8_t* __restrict__ bs,
+        float scale, void* __restrict__ out, int M, int N, int K, int SK, int ldx, int group) {
+    using T = Tile<BM, BN, WM, WN, STAGES>;
+    static_assert(BN % 64 == 0 && BM % (16 * WM) == 0 && BN % (8 * WN) == 0, "whole packed tiles, whole fragments");
+    extern __shared__ __align__(128) unsigned char buf[];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int wm = warp / WN, wn = warp % WN;
+    const int KG = K / GS, slice_groups = KG / SK, ntiles = (N + 63) / 64;
+    const int2 at = tile_of(blockIdx.x, M, N, BM, BN, group);
+    const int m0 = at.x, n0 = at.y;
+
+    // copy plan: thread tid copies input chunk tid % 8 of rows tid / 8 + u * RP (u < XC), and 16-byte words
+    // tid + u * THREADS of the stage's weight tiles; every source advances by one group (64 inputs) a stage
+    constexpr int RP = T::THREADS / T::CHUNKS;
+    const int xr0 = tid / T::CHUNKS, xch = tid % T::CHUNKS;
+    const __nv_bfloat16* xsrc = x + static_cast<size_t>(m0 + xr0) * ldx + xch * 8;
+    const size_t xstep = static_cast<size_t>(RP) * ldx;
+    const uint32_t xd0 = xr0 * T::ROW + swz<T::CHUNKS>(xr0, xch) * 16; // + u * RP rows: RP % 8 == 0 keeps the swizzle
+    const int xrows = M - m0 - xr0;                                      // copies u with u * RP < xrows read rows
+    const size_t wtile = static_cast<size_t>(KG) * 4096;                 // bytes of one packed 64-column tile
+    const unsigned char* wsrc = w + (n0 / 64) * wtile + tid * 16;
+    const int wtiles = ntiles - n0 / 64;                                 // packed tiles of this CTA that hold columns
+    const bool sr = tid < T::S / 16 && tid / 16 < wtiles;
+    const uint8_t* ssrc = bs + static_cast<size_t>(n0 / 64 + tid / 16) * KG * 256 + (tid % 16) * 16;
+
+    auto stage = [&](int s) { return buf + s * T::STAGE; };
+    auto load = [&](int s, int g) {
+        unsigned char* p = stage(s);
+#pragma unroll
+        for (int u = 0; u < T::XC; ++u) {
+            const bool in = u * RP < xrows;
+            cp16z(p + xd0 + u * RP * T::ROW, in ? xsrc + u * xstep + g * GS : x, in);
+        }
+#pragma unroll
+        for (int u = 0; u < T::WC; ++u) {
+            const int t = u * T::THREADS / 256, off = u * T::THREADS % 256; // THREADS divides 256
+            if (t < wtiles) cp16(p + T::X + (tid + u * T::THREADS) * 16, wsrc + t * wtile + off * 16 + static_cast<size_t>(g) * 4096);
+        }
+        if (sr) cp16(p + T::X + T::W + tid * 16, ssrc + static_cast<size_t>(g) * 256);
+    };
+
+    float acc[T::MT][T::NT][4];
+#pragma unroll
+    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+            for (int e = 0; e < 4; ++e) acc[i][j][e] = 0.0f;
+    // the slices' running total, as the fused kernel keeps it (tot = s_0, then tot + s_k at each later slice end), with
+    // the copy done as -0 + s_0: one register set fewer live at the boundary (no select), the same bytes. -0 + x == x
+    // for every non-NaN x (signed zeros included, subnormals kept: no flush), and a NaN s_0 is already the canonical
+    // 0x7FFFFFFF (an FFMA result) that FADD returns for any NaN; checked exhaustively over all 2^32 inputs on GB10
+    // (tf-cuda-test lane-pf2, fadd_neg0_kernel).
+    float tot[T::MT][T::NT][4];
+#pragma unroll
+    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+            for (int e = 0; e < 4; ++e) tot[i][j][e] = -0.0f;
+#pragma unroll
+    for (int s = 0; s < STAGES - 1; ++s) {
+        if (s < KG) load(s, s);
+        commit();
+    }
+    // ldmatrix rows and chunk of this lane, per m16 tile i: row r0 + i * 16, chunk kt * 2 + (lane >> 4); i * 16 rows
+    // keep r0's swizzle, so the four k16 steps' byte offsets are fixed for the whole kernel
+    const int r0 = wm * (BM / WM) + (lane & 7) + ((lane >> 3) & 1) * 8;
+    uint32_t aoff[4];
+#pragma unroll
+    for (int kt = 0; kt < 4; ++kt) aoff[kt] = r0 * T::ROW + swz<T::CHUNKS>(r0, kt * 2 + (lane >> 4)) * 16;
+    const uint32_t boff = ((wn * T::NT) * 32 + lane) * 16, soff = (wn * (BN / WN) + (lane & 3) * 2) * 4;
+    for (int it = 0; it < KG; ++it) {
+        if (it > 0 && it % slice_groups == 0) { // a slice ends: into the running total, then a fresh slice sum
+#pragma unroll
+            for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+                for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                    for (int e = 0; e < 4; ++e) {
+                        tot[i][j][e] = __fadd_rn(tot[i][j][e], acc[i][j][e]);
+                        acc[i][j][e] = 0.0f;
+                    }
+        }
+        wait<STAGES - 2>();
+        __syncthreads();
+        const int next = it + STAGES - 1;
+        if (next < KG) load(next % STAGES, next);
+        commit();
+        const unsigned char* p = stage(it % STAGES);
+        const unsigned char* pw = p + T::X;
+        const uint8_t* ps = p + T::X + T::W;
+        // this warp's columns of the group, widened once: b[j][kt] = the lane's (b0, b1) of n8 tile j at k16 step kt
+        uint32_t b[T::NT][4][2];
+        float2 sv[T::NT];
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j) {
+            const uint4 q = *reinterpret_cast<const uint4*>(pw + boff + j * 512);
+            const uint32_t words[4] = {q.x, q.y, q.z, q.w};
+#pragma unroll
+            for (int kt = 0; kt < 4; ++kt) fp8pairs(words[kt], b[j][kt][0], b[j][kt][1]);
+            sv[j] = *reinterpret_cast<const float2*>(ps + soff + j * 32);
+        }
+#pragma unroll
+        for (int i = 0; i < T::MT; ++i) {
+            uint32_t a[4][4];
+#pragma unroll
+            for (int kt = 0; kt < 4; ++kt) ldmatrix4(a[kt], p + aoff[kt] + i * 16 * T::ROW);
+            float d[T::NT][4];
+#pragma unroll
+            for (int kt = 0; kt < 4; ++kt)
+#pragma unroll
+                for (int j = 0; j < T::NT; ++j) {
+                    if (kt == 0) mma0(d[j], a[kt], b[j][kt][0], b[j][kt][1]);
+                    else mma(d[j], a[kt], b[j][kt][0], b[j][kt][1]);
+                }
+#pragma unroll
+            for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) acc[i][j][e] = __fmaf_rn(d[j][e], (e & 1) ? sv[j].y : sv[j].x, acc[i][j][e]);
+        }
+    }
+    wait<0>();
+    if (SK > 1) {
+#pragma unroll
+        for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+            for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) acc[i][j][e] = __fadd_rn(tot[i][j][e], acc[i][j][e]);
+    }
+#pragma unroll
+    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j) {
+            const int col = n0 + wn * (BN / WN) + j * 8 + (lane & 3) * 2;
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int row = m0 + wm * (BM / WM) + i * 16 + (lane >> 2) + h * 8;
+                if (row >= M) continue;
+                const float v0 = __fmul_rn(acc[i][j][2 * h], scale), v1 = __fmul_rn(acc[i][j][2 * h + 1], scale);
+                if (F32) {
+                    float* dst = reinterpret_cast<float*>(out) + static_cast<size_t>(row) * N + col;
+                    if (col < N) dst[0] = v0; // scalar stores, as the lane's: any 4-byte aligned output
+                    if (col + 1 < N) dst[1] = v1;
+                } else {
+                    __nv_bfloat16* dst = reinterpret_cast<__nv_bfloat16*>(out) + static_cast<size_t>(row) * N + col;
+                    if (col + 1 < N && (N & 1) == 0)
+                        *reinterpret_cast<__nv_bfloat162*>(dst) = __floats2bfloat162_rn(v0, v1);
+                    else {
+                        if (col < N) dst[0] = __float2bfloat16_rn(v0);
+                        if (col + 1 < N) dst[1] = __float2bfloat16_rn(v1);
+                    }
+                }
+            }
+        }
+}
+
+// The -0 copy's proof, over every fp32 bit pattern: bad[0] counts x whose -0 + x bytes differ from x (non-NaN) or
+// from 0x7FFFFFFF (NaN); bad[1] counts NaN payloads an FFMA (d * s + acc, NaN in any operand) does not return as
+// 0x7FFFFFFF, so the total's NaN inputs are canonical before the add.
+extern "C" __global__ void tf_qmmf2_neg0_check(unsigned long long base, unsigned int* bad) {
+    const unsigned long long i = base + static_cast<unsigned long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i > 0xFFFFFFFFull) return;
+    const uint32_t u = static_cast<uint32_t>(i);
+    const float x = __uint_as_float(u);
+    const bool nan = (u & 0x7FFFFFFFu) > 0x7F800000u;
+    const uint32_t r = __float_as_uint(__fadd_rn(-0.0f, x));
+    if (r != (nan ? 0x7FFFFFFFu : u)) atomicAdd(&bad[0], 1u);
+    if (nan) {
+        const uint32_t f0 = __float_as_uint(__fmaf_rn(x, 1.5f, 2.0f)), f1 = __float_as_uint(__fmaf_rn(1.5f, x, 2.0f));
+        const uint32_t f2 = __float_as_uint(__fmaf_rn(1.5f, 2.0f, x));
+        if (f0 != 0x7FFFFFFFu || f1 != 0x7FFFFFFFu || f2 != 0x7FFFFFFFu) atomicAdd(&bad[1], 1u);
+    }
+}
+
+#ifndef QMMF2_NO_INSTANCES
+// The instances qmmf.zig loads by name: 128 x 64 outputs on 2 x 2 warps, two stages (two CTAs an SM), bf16 / fp32 out.
+template __global__ void qmmf2_fp8g<128, 64, 2, 2, 2, false>(const __nv_bfloat16* __restrict__, const unsigned char* __restrict__, const uint8_t* __restrict__, float, void* __restrict__, int, int, int, int, int, int);
+template __global__ void qmmf2_fp8g<128, 64, 2, 2, 2, true>(const __nv_bfloat16* __restrict__, const unsigned char* __restrict__, const uint8_t* __restrict__, float, void* __restrict__, int, int, int, int, int, int);
+#endif
+
+} // namespace tf_qmmf2
