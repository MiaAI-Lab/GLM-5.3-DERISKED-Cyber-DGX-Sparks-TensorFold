+//! `lane-pf2`: TF_GLM_PF_QMMF2's qmmf2 tile against the lane's 64-row tile on block-FP8 prompt calls: equal bytes
+//! (bf16 and fp32 out) on GLM-5.3's TP4 dense shapes, partial row and column tiles and special values, the calls it
+//! must leave to the lane, and the two kernels' times.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+/// `pad`: inputs past k in each activation row (ldx = k + pad); every call writes 4 bytes past an 8-byte boundary.
+const Shape = struct { m: usize, n: usize, k: usize, what: []const u8, pad: usize = 0 };
+
+/// GLM-5.3 TP4 rank shapes (a 4,096-row chunk runs as two 2,048-row halves), then edges.
+const shapes = [_]Shape{
+    .{ .m = 2048, .n = 6144, .k = 4096, .what = "o_proj" },
+    .{ .m = 2048, .n = 2624, .k = 6144, .what = "[q_a | kv_a]" },
+    .{ .m = 2048, .n = 4096, .k = 2048, .what = "q_b / indexer q_b" },
+    .{ .m = 2048, .n = 1024, .k = 6144, .what = "shared gate|up" },
+    .{ .m = 2048, .n = 160, .k = 6144, .what = "indexer k|w" },
+    .{ .m = 2048, .n = 6144, .k = 3072, .what = "dense down" },
+    .{ .m = 4096, .n = 2624, .k = 6144, .what = "whole chunk" },
+    .{ .m = 1000, .n = 6144, .k = 4096, .what = "partial row tile, strided rows", .pad = 192 },
+    .{ .m = 256, .n = 4096, .k = 2048, .what = "fewest rows" },
+    .{ .m = 777, .n = 2689, .k = 1024, .what = "odd columns" },
+    .{ .m = 512, .n = 12288, .k = 1024, .what = "one slice (SK 1)" },
+    .{ .m = 2048, .n = 6144, .k = 512, .what = "shared down (lane)" },
+    .{ .m = 255, .n = 6144, .k = 4096, .what = "under 256 rows (lane)" },
+    .{ .m = 16, .n = 2624, .k = 6144, .what = "decode rows (lane)" },
+};
+
+const Built = struct { w: cuda.qmmf.Weight };
+
+/// A random block-FP8 weight packed as GLM's loader packs it; `specials`: some NaN / -0 codes and 0 / inf scales.
+fn build(r: *rig.Rig, a: std.mem.Allocator, rng: std.Random, n: usize, k: usize, specials: bool) !cuda.qmmf.Weight {
+    const codes = try a.alloc(u8, n * k);
+    for (codes, 0..) |*c, i| {
+        c.* = rng.int(u8);
+        if (c.* & 0x7F == 0x7F) c.* ^= 1; // finite unless placed below
+        if (specials and i % 4099 == 0) c.* = if (i % 3 == 0) 0x7F else 0x80;
+    }
+    const kb = (k + 127) / 128;
+    const inv = try a.alloc(f32, ((n + 127) / 128) * kb);
+    for (inv, 0..) |*s, i| {
+        s.* = std.math.ldexp(@as(f32, 1) + rng.float(f32), -@as(i32, @intCast(rng.uintLessThan(u32, 12))) - 4);
+        if (specials and i % 37 == 5) s.* = if (i % 2 == 0) 0 else std.math.inf(f32);
+    }
+    const pc = try a.alloc(u8, cuda.fp8.padded(n) * k);
+    cuda.fp8.packCodes(pc, codes, n, k);
+    const ps = try a.alloc(f32, cuda.fp8.padded(n) * (k / cuda.fp8.group));
+    cuda.fp8.packScales(ps, inv, n, k);
+    var w = cuda.fp8.weight(try r.dev(pc), try r.dev(std.mem.sliceAsBytes(ps)), n, k);
+    if (specials) w.scale = 0.73; // a tensor scale on half the shapes
+    return w;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(0x9b2f);
+    const rng = prng.random();
+    var r = try rig.Rig.init(gpu, a, rng);
+    defer r.deinit();
+    var lane = try cuda.qmmf.Lane.load(gpu.d, @intCast(try gpu.ctx.capability() / 10));
+    defer lane.unload();
+    if (lane.pf2 != null) return check.expect(false, "lane-pf2 runs with {s} unset (it loads the image itself)", .{cuda.qmmf.pf2_env});
+    var pf2 = try cuda.qmmf.Lane.loadPf2(gpu.d);
+    defer pf2.mod.unload();
