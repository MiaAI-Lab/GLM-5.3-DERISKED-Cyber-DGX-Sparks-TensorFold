+test "GLM X8: the scratch a projection needs covers both halves of a [gate | up] stack and its widest call" {
+    var most: Most = .{};
+    const g: Mat = .{ .t = 0, .suh = 0, .svh = 0, .k = 6144, .n = 512, .bits = 4 };
+    const d: Mat = .{ .t = 0, .suh = 0, .svh = 0, .k = 512, .n = 6144, .bits = 4 };
+    mostOf(&most, .{ .a = g, .b = g });
+    mostOf(&most, .{ .a = d });
+    try std.testing.expectEqual(@as(usize, 6144), most.k);
+    try std.testing.expectEqual(@as(usize, 6144), most.n);
+    try std.testing.expectEqual(@as(usize, 1024 * 6144), most.nk);
+    try std.testing.expect(most.z >= Linear.zBytes(g.weight(), call_rows));
+    try std.testing.expect(most.counters >= Linear.counterBytes(d.weight()));
+    try std.testing.expectEqual(@as(usize, 1024), (Proj{ .a = g, .b = g }).n());
+    try std.testing.expectEqual(@as(usize, 2 * (6144 * 512 / 2)), (Proj{ .a = g, .b = g }).bytes()); // 4 bits: half a byte a weight
+}
