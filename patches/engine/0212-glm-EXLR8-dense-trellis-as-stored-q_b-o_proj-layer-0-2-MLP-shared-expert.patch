diff --git a/zig/kernels/cuda/exlr8_recon.cu b/zig/kernels/cuda/exlr8_recon.cu
new file mode 100644
index 000000000..696bc71a9
--- /dev/null
+++ b/zig/kernels/cuda/exlr8_recon.cu
@@ -0,0 +1,95 @@
+// EXLR8 trellis matrices (kindlingai's exlr8-v2 format: EXL3 16x16 tiles whose mcg values are rounded to E4M3) rebuilt
+// as bf16 rows for the prompt GEMMs (patch 0205b): W[o][i] = bf16(suh[i] svh[o] (H T H)[i][o] / 128), H the 128-point
+// Sylvester transform on each side. The tile values are E4M3, so 512 T is an integer (|512 T| <= 229,376): both
+// transforms run in integers (exact), the scales in f64 (exact while the transformed integer stays under 2^31), and
+// the one rounding to bf16 is nearest even, the value X8's converter wrote (night/gr8x/x8/exlr8_dense.py to_bf16).
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <stdint.h>
+
+// The tile decode: TensorFold's EXLR8 CUDA kernels' (exlr8.cu, ashhart/TensorFold), the format's values bit for bit.
+#include "exlr8.cu"
+
+// One matrix as stored: trellis int16 [k/16][n/16][16 bits] (tile (tk, tn) at tk * n/16 + tn), fp16 suh [k], svh [n];
+// out bf16 rows [n][ldw] starting at row `row0` (a [gate | up] stack writes its second matrix at row0 = gate's n).
+struct TfX8Recon {
+  const uint8_t* t;
+  const __half* suh;
+  const __half* svh;
+  __nv_bfloat16* w;
+  unsigned k, n, bits, ldw, row0, pad0;
+};
+
+// The unnormalized Sylvester transform of 128 values held as lane + 32 q (exlr8.cu's tf_exlr8_fwht), in integers.
+template <typename T>
+__device__ __forceinline__ void tf_x8_fwht(T (&v)[4], unsigned lane) {
+  for (unsigned d = 1; d < 32; d <<= 1) {
+    for (int q = 0; q < 4; ++q) {
+      const T other = __shfl_xor_sync(TF_FULL, v[q], d);
+      v[q] = (lane & d) ? other - v[q] : v[q] + other;
+    }
+  }
+  const T a0 = v[0] + v[1], a1 = v[0] - v[1], a2 = v[2] + v[3], a3 = v[2] - v[3];
+  v[0] = a0 + a2;
+  v[1] = a1 + a3;
+  v[2] = a0 - a2;
+  v[3] = a1 - a3;
+}
+
+// bf16 nearest even of a double: to fp32 toward zero with a sticky low bit (round to odd), then nearest even.
+__device__ __forceinline__ unsigned short tf_x8_bf16(double d) {
+  float f = __double2float_rz(d);
+  if ((double)f != d) f = __uint_as_float(__float_as_uint(f) | 1u);
+  return __bfloat16_as_ushort(__float2bfloat16_rn(f));
+}
+
+#define TF_X8_LD 129  // int words a row of the block in shared memory (padded: column reads hit 32 banks)
+
+// One 128 x 128 block (inputs ib, outputs ob) a CTA of 8 warps; dynamic shared memory 128 * 129 ints.
+extern "C" __global__ void __launch_bounds__(256) tf_x8_recon(const TfX8Recon a) {
+  extern __shared__ int tblk[];
+  const unsigned ob = blockIdx.x, ib = blockIdx.y, tid = threadIdx.x, warp = tid / 32, lane = tid % 32;
+  const unsigned tb = 32 * a.bits, tiles_n = a.n / 16;
+  for (unsigned t = warp; t < 64; t += 8) {
+    const unsigned tr = t / 8, tc = t % 8;
+    const uint32_t* tile = reinterpret_cast<const uint32_t*>(a.t + ((uint64_t)(8 * ib + tr) * tiles_n + 8 * ob + tc) * tb);
+    __half w[8];
+    switch (a.bits) {
+      case 2: tf_exlr8_decode<2>(tile, lane, w); break;
+      case 3: tf_exlr8_decode<3>(tile, lane, w); break;
+      default: tf_exlr8_decode<4>(tile, lane, w); break;
+    }
+    for (unsigned q = 0; q < 8; ++q) {  // exlr8.cu's tf_exlr8_tile_codes placement: rows are inputs, columns outputs
+      const unsigned row = 16 * tr + 2 * (lane % 4) + (q & 1) + 8 * ((q >> 1) & 1);
+      const unsigned col = 16 * tc + lane / 4 + 8 * (q >> 2);
+      tblk[row * TF_X8_LD + col] = (int)__fmul_rn(__half2float(w[q]), 512.0f);  // exact: E4M3 values are k 2^-9
+    }
+  }
+  __syncthreads();
+  for (unsigned r = warp; r < 128; r += 8) {  // along the outputs, each input row (|sum| < 2^25: int)
+    int v[4];
+    for (int q = 0; q < 4; ++q) v[q] = tblk[r * TF_X8_LD + lane + 32 * q];
+    tf_x8_fwht(v, lane);
+    for (int q = 0; q < 4; ++q) tblk[r * TF_X8_LD + lane + 32 * q] = v[q];
+  }
+  __syncthreads();
+  for (unsigned c = warp; c < 128; c += 8) {  // along the inputs, each output column (long long), then the scales
+    long long v[4];
+    for (int q = 0; q < 4; ++q) v[q] = tblk[(lane + 32 * q) * TF_X8_LD + c];
+    tf_x8_fwht(v, lane);
+    const double so = (double)__half2float(a.svh[128 * ob + c]) * 0x1p-16;  // / 128 (the transforms) / 512 (the ints)
+    for (int q = 0; q < 4; ++q) {
+      const unsigned i = lane + 32 * q;
+      const double val = (double)v[q] * (double)__half2float(a.suh[128 * ib + i]) * so;
+      tblk[i * TF_X8_LD + c] = tf_x8_bf16(val);  // the column is this warp's alone: written back in place
+    }
+  }
+  __syncthreads();
+  for (unsigned e = tid; e < 128 * 128; e += 256) {  // row o of W: 128 inputs contiguous
+    const unsigned o = e / 128, i = e % 128;
+    reinterpret_cast<unsigned short*>(a.w)[(uint64_t)(a.row0 + 128 * ob + o) * a.ldw + 128 * ib + i] = (unsigned short)tblk[i * TF_X8_LD + o];
+  }
+}
+
+// Shared memory one block takes.
+#define TF_X8_RECON_SMEM (128 * TF_X8_LD * 4)
