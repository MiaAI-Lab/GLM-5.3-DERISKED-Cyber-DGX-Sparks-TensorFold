@@ -0,0 +1,494 @@
+//! kindlingai's EXLR8 dense trellis matrices (format exlr8-v2: q_b and o_proj, the dense MLP of layers 0-2 and the
+//! shared expert's halves) on CUDA as they are stored (patch 0205b), not rounded to bf16 at conversion. EXLR8 trellis
+//! tiles are EXL3 tiles whose mcg values are rounded to E4M3 (patch 0205), so night/gr8x/x8b/exlr8_native.py writes each
+//! matrix as one EXL3 trellis [K/16][N/16][16 bits] with fp16 suh [K] and svh [N] and the marker `mcg_e4m3`.
+//! Decode windows run TensorFold's EXL3 linear (kernels/cuda/exl3_linear.cu) on its E4M3 image (exl3_linear_e4m3);
+//! prompt chunks rebuild the matrix as bf16 rows (kernels/cuda/exlr8_recon.cu, exact before one rounding: the bf16 X8's
+//! converter wrote) for the tiled bf16 GEMM. Only a checkpoint whose config says codebook "mcg_e4m3" probes for these.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const glue = @import("cuda_glue.zig");
+const b16 = @import("cuda_b16.zig");
+const mm_mod = @import("cuda_mm.zig");
+const exl3 = @import("cuda_exl3.zig");
+
+const Linear = cuda.exl3.Linear;
+
+/// EXLR8's marker on a converted matrix: the mcg multiplier, under its own name (no EXL3 build carries it).
+pub const marker_value: u32 = core.exl3_load.markers[0].value;
+
+/// One matrix on the device: trellis int16 [k/16][n/16][16 bits] (tile (tk, tn) at tk * n/16 + tn), fp16 suh, svh.
+pub const Mat = struct {
+    t: u64,
+    suh: u64,
+    svh: u64,
+    k: usize,
+    n: usize,
+    bits: u32,
+
+    /// TensorFold's EXL3 linear's view: the "stored" layout, mcg codebook (the E4M3 image rounds it).
+    pub fn weight(m: Mat) cuda.exl3.Weight {
+        const st = cuda.exl3.strides(m.k, m.n, 2 * m.bits, false);
+        return .{ .trellis = m.t, .suh = m.suh, .svh = m.svh, .k = @intCast(m.k), .n = @intCast(m.n), .halves = 2 * m.bits, .codebook = .mcg, .stride_k = st.k, .stride_nb = st.nb };
+    }
+
+    pub fn trellisBytes(m: Mat) usize {
+        return m.k / 16 * (m.n / 16) * 32 * @as(usize, m.bits);
+    }
+};
+
+/// A rank's projection: one matrix, or [gate | up]: two over the same inputs (each its own rotations), outputs side by
+/// side. `side`: it runs on the decode window's second stream (the shared expert), so it keeps its own scratch.
+pub const Proj = struct {
+    a: Mat,
+    b: ?Mat = null,
+    side: bool = false,
+
+    pub fn n(p: Proj) usize {
+        return p.a.n + if (p.b) |b| b.n else 0;
+    }
+    pub fn k(p: Proj) usize {
+        return p.a.k;
+    }
+    pub fn bytes(p: Proj) usize {
+        return p.a.trellisBytes() + if (p.b) |b| b.trellisBytes() else 0;
+    }
+};
+
+/// Rows a decode call takes at most in one EXL3 linear launch (linear.cu's 1..128).
+pub const call_rows = 128;
+/// Prompt calls of more rows than this rebuild the matrix as bf16 rows; fewer (a prompt's tail) take the decode kernels.
+pub const recon_rows = 16;
+
+/// The scratch of one stream's calls (main, and the shared expert's second stream).
+const Lane = struct { xc: u64 = 0, xh: u64 = 0, z: u64 = 0, counters: u64 = 0, ya: u64 = 0, yb: u64 = 0 };
+
+/// What the largest projection needs, gathered at load (reserve).
+pub const Most = struct { k: usize = 0, n: usize = 0, nk: usize = 0, z: usize = 0, counters: usize = 0 };
+
+pub fn mostOf(most: *Most, p: Proj) void {
+    for ([_]?Mat{ p.a, p.b }) |om| if (om) |m| {
+        most.k = @max(most.k, m.k);
+        most.n = @max(most.n, m.n);
+        most.z = @max(most.z, Linear.zBytes(m.weight(), call_rows));
+        most.counters = @max(most.counters, Linear.counterBytes(m.weight()));
+    };
+    most.nk = @max(most.nk, p.n() * p.k());
+}
+
+/// The kernels and their scratch: the E4M3 EXL3 linear, the bf16 rebuild, and buffers sized by `reserve`.
+pub const Run = struct {
+    d: *const cuda.Driver,
+    gpa: std.mem.Allocator = std.heap.page_allocator, // reserve's: the buffer list's
+    lin: Linear,
+    mod: cuda.Module,
+    recon: cuda.Function,
+    bufs: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    lanes: [2]Lane = .{ .{}, .{} },
+    w: u64 = 0, // a rebuilt matrix's bf16 rows [n][k]
+    wt: u64 = 0, // and the same tiled for glm_mm
+    most: Most = .{},
+    /// The projection whose rows `w` / `wt` hold (one stream writes them: prompt chunks never fork).
+    cached: ?*const Proj = null,
+    cached_tiled: bool = false,
+
+    pub fn load(d: *const cuda.Driver) !Run {
+        var lin = try Linear.loadE4m3(d);
+        errdefer lin.unload();
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(d, cuda.kernels.exlr8_recon);
+        errdefer mod.unload();
+        const f = try mod.function("tf_x8_recon");
+        try f.allowDynamicShared(recon_smem);
+        return .{ .d = d, .lin = lin, .mod = mod, .recon = f };
+    }
+
+    pub fn deinit(r: *Run) void {
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(r.gpa);
+        r.mod.unload();
+        r.lin.unload();
+    }
+
+    fn buf(r: *Run, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(r.d, @max(bytes, 256));
+        errdefer b.free();
+        try r.bufs.append(r.gpa, b);
+        return b.ptr;
+    }
+
+    /// Every buffer the calls use, for the largest projection `most` gathered (before any window, outside any graph).
+    pub fn reserve(r: *Run, gpa: std.mem.Allocator, most: Most) !void {
+        if (r.bufs.items.len != 0) return error.X8Reserved;
+        r.gpa = gpa;
+        r.most = most;
+        if (most.nk == 0) return;
+        for (&r.lanes) |*l| {
+            l.xc = try r.buf(call_rows * most.k * 2);
+            l.xh = try r.buf(call_rows * most.k * 2);
+            l.z = try r.buf(most.z);
+            l.counters = try r.buf(most.counters);
+            l.ya = try r.buf(call_rows * most.n * 4);
+            l.yb = try r.buf(call_rows * most.n * 4);
+        }
+        r.w = try r.buf(most.nk * 2);
+        r.wt = try r.buf(most.nk * 2);
+    }
+
+    /// Device bytes reserve takes for `most`.
+    pub fn reserveBytes(most: Most) usize {
+        if (most.nk == 0) return 0;
+        return 2 * (2 * call_rows * most.k * 2 + most.z + most.counters + 2 * call_rows * most.n * 4) + 2 * most.nk * 2;
+    }
+};
+
+/// tf_x8_recon's dynamic shared memory: a 128 x 128 block of ints, rows padded to 129.
+pub const recon_smem: u32 = 128 * 129 * 4;
+
+/// exlr8_recon.cu's TfX8Recon, passed by value.
+pub const ReconArgs = extern struct { t: u64, suh: u64, svh: u64, w: u64, k: u32, n: u32, bits: u32, ldw: u32, row0: u32, pad0: u32 = 0 };
+
+/// Matrix `m` as bf16 rows [row0, row0 + n) of `w` ([*][ldw]): exact values, rounded once.
+pub fn rebuild(r: *const Run, s: cuda.Stream, m: Mat, w: u64, ldw: usize, row0: usize) !void {
+    if (m.k % 128 != 0 or m.n % 128 != 0 or m.bits < 2 or m.bits > 4) return error.X8Shape;
+    var a: cuda.Args = .{};
+    a.add(ReconArgs{ .t = m.t, .suh = m.suh, .svh = m.svh, .w = w, .k = @intCast(m.k), .n = @intCast(m.n), .bits = m.bits, .ldw = @intCast(ldw), .row0 = @intCast(row0) });
+    try cuda.launch.launch(r.recon, .{ .grid = .{ .x = @intCast(m.n / 128), .y = @intCast(m.k / 128) }, .block = .{ .x = 256 }, .shared = recon_smem }, s, &a);
+}
+
+/// `height` rows of `width` bytes from `src` (`spitch` apart) to `dst` (`dpitch` apart), glm_ops' tf_glm_copy_rows.
+fn copyRows(set: glue.Set, s: cuda.Stream, src: u64, spitch: usize, dst: u64, dpitch: usize, height: usize, width: usize) !void {
+    const f = set.copy_rows orelse return error.X8NoCopy;
+    var a: cuda.Args = .{};
+    a.add(src);
+    a.add(@as(c_longlong, @intCast(spitch)));
+    a.add(dst);
+    a.add(@as(c_longlong, @intCast(dpitch)));
+    a.add(@as(c_int, @intCast(height)));
+    a.add(@as(c_int, @intCast(width)));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast((height * width + 255) / 256) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+/// One matrix of up to 128 rows through the E4M3 EXL3 linear: y [m][mat.n] contiguous, bf16 or fp32.
+fn linear(r: *const Run, s: cuda.Stream, l: Lane, mx: Mat, x: u64, m: usize, y: u64, wide: bool) !void {
+    const w = mx.weight();
+    try s.d.check(s.d.api.cuMemsetD32Async(l.counters, 0, Linear.counterBytes(w) / 4, s.handle), "cuMemsetD32Async");
+    try r.lin.matmul(s, w, x, .bf16, m, y, if (wide) .f32 else .bf16, l.xh, l.z, l.counters);
+}
+
+/// x [m][k] (rows `x_stride` apart, bf16) through `p` into out [m][n]: bf16, or fp32 with `wide`; `part`: the bf16
+/// GEMM's K slices (a prompt chunk's rebuilt rows), as the caller sized them for a bf16 projection of this shape.
+pub fn matmul(set: glue.Set, s: cuda.Stream, p: *const Proj, x: u64, x_stride: usize, out: u64, part: u64, m: usize, n: usize, k: usize, wide: bool) !void {
+    if (n != p.n() or k != p.k()) return error.ShapeMismatch;
+    if (p.b) |b| if (b.k != p.a.k) return error.ShapeMismatch;
+    const r = set.x8 orelse return error.FormatNotLoaded;
+    if (m == 0) return;
+    if (set.prompt and m > recon_rows) return prompt(set, r, s, p, x, x_stride, out, part, m, wide);
+    const l = r.lanes[@intFromBool(p.side)];
+    const eb: usize = if (wide) 4 else 2;
+    var at: usize = 0;
+    while (at < m) : (at += call_rows) {
+        const rows = @min(call_rows, m - at);
+        var xi = x + at * x_stride * 2;
+        if (x_stride != k) { // the linear reads its rows contiguous
+            if (k > r.most.k) return error.X8Scratch;
+            try copyRows(set, s, xi, x_stride * 2, l.xc, k * 2, rows, k * 2);
+            xi = l.xc;
+        }
+        const o = out + at * n * eb;
+        const b = p.b orelse {
+            try linear(r, s, l, p.a, xi, rows, o, wide);
+            continue;
+        };
+        if (rows == 1) { // one row: its two halves are contiguous already
+            try linear(r, s, l, p.a, xi, 1, o, wide);
+            try linear(r, s, l, b, xi, 1, o + p.a.n * eb, wide);
+            continue;
+        }
+        if (p.a.n > r.most.n or b.n > r.most.n) return error.X8Scratch;
+        try linear(r, s, l, p.a, xi, rows, l.ya, wide);
+        try linear(r, s, l, b, xi, rows, l.yb, wide);
+        try copyRows(set, s, l.ya, p.a.n * eb, o, n * eb, rows, p.a.n * eb);
+        try copyRows(set, s, l.yb, b.n * eb, o + p.a.n * eb, n * eb, rows, b.n * eb);
+    }
+}
+
+/// A prompt chunk: `p` rebuilt as bf16 rows (once while it stays the cached one), tiled when glm_mm runs, then the bf16
+/// GEMM a bf16 projection of this shape takes.
+fn prompt(set: glue.Set, r: *const Run, s: cuda.Stream, p: *const Proj, x: u64, x_stride: usize, out: u64, part: u64, m: usize, wide: bool) !void {
+    const n = p.n();
+    const k = p.k();
+    if (n * k > r.most.nk) return error.X8Scratch;
+    const tiled = set.mm != null;
+    const rw: *Run = @constCast(r); // the cache is host state of the one stream that runs prompt chunks
+    if (rw.cached != p or rw.cached_tiled != tiled) {
+        rw.cached = null;
+        try rebuild(r, s, p.a, r.w, k, 0);
+        if (p.b) |b| try rebuild(r, s, b, r.w, k, p.a.n);
+        if (tiled) try mm_mod.tile(set.mm.?, s, r.w, r.wt, n, k);
+        rw.cached = p;
+        rw.cached_tiled = tiled;
+    }
+    if (set.mm) |mk| return mm_mod.matmul(mk, s, x, x_stride, .{ .w = r.wt, .n = n, .k = k }, out, part, m, wide, set.prompt);
+    var plain = set;
+    plain.mm = null;
+    return b16.matmul(plain, s, x, x_stride, r.w, out, part, m, n, k, wide);
+}
+
+/// Forget the cached rebuild (the scratch is about to be reused or freed).
+pub fn forget(r: *Run) void {
+    r.cached = null;
+}
+
+// ---- loading ------------------------------------------------------------------------------------------------------
+
+/// Which part of a stored matrix a rank keeps: all of it, outputs [lo, hi) (columns of W[in][out], q_b's heads and
+/// gate / up's rows), or inputs [lo, hi) (o_proj's and down's columns). Bounds in whole 128-blocks.
+pub const Cut = union(enum) { whole, outs: [2]usize, ins: [2]usize };
+
+/// Whether layer `i`'s shared expert is served from its rank pieces as stored: the pieces are declared AND the layer's q_b is
+/// trellis as stored. The checkpoint the recipe serves by default (X8's ~/exlr8-up1) carries the pieces too (its shared expert is
+/// bf16 in the dense file, as before 0205b) and must stay on that path: its q_b has no marker.
+pub fn sharedAsStored(L: anytype, i: u32) !bool {
+    return try L.has("layers.{d}.mlp.shared_experts.pieces", .{i}) and try present(L, "layers.{d}.self_attn.q_b_proj", .{i});
+}
+
+/// Whether `module` (under the loader's prefix and the layer) is an EXLR8 matrix: its mcg_e4m3 marker is present.
+pub fn present(L: anytype, comptime module: []const u8, args: anytype) !bool {
+    return L.has(module ++ ".mcg_e4m3", args);
+}
+
+/// Stored matrix `module` cut to this rank as `cut`, uploaded: trellis, suh, svh (each its own buffer). A refusal is
+/// logged as a warning naming the tensor; the load then fails with error.UnreadableExlr8.
+pub fn mat(L: anytype, comptime module: []const u8, args: anytype, cut: Cut) !Mat {
+    const mk = try L.get(module ++ ".mcg_e4m3", args);
+    if (mk.dtype != .i32 or mk.numel() != 1 or mk.bytes.len != 4 or std.mem.readInt(u32, mk.bytes[0..4], .little) != marker_value) {
+        std.log.warn("{s}: an EXLR8 matrix's marker is int32 0x{x}", .{ L.last, marker_value });
+        return error.UnreadableExlr8;
+    }
+    const suh = try L.get(module ++ ".suh", args);
+    const svh = try L.get(module ++ ".svh", args);
+    if (suh.dtype != .f16 or svh.dtype != .f16 or suh.rank != 1 or svh.rank != 1) return error.UnreadableExlr8;
+    const K = suh.numel();
+    const N = svh.numel();
+    const t = try L.get(module ++ ".trellis", args);
+    if (exl3.refusal(t, K, N)) |why| {
+        std.log.warn("{s}: {s} (shape {any})", .{ L.last, why, t.shape[0..t.rank] });
+        return error.UnreadableExlr8;
+    }
+    const k2 = exl3.halves(t.dim(2)).?;
+    const bits = k2 / 2;
+    if (bits < 2 or bits > 4 or K % 128 != 0 or N % 128 != 0) {
+        std.log.warn("{s}: EXLR8 matrices of 2-4 bits over whole 128-blocks ({d} bits, {d} x {d})", .{ L.last, bits, K, N });
+        return error.UnreadableExlr8;
+    }
+    const tile = exl3.tileBytes(k2);
+    var lo: usize = 0;
+    var hi: usize = 0;
+    switch (cut) {
+        .whole => {},
+        .outs, .ins => |b| {
+            lo = b[0];
+            hi = b[1];
+            const total = if (cut == .outs) N else K;
+            if (lo % 128 != 0 or hi % 128 != 0 or lo >= hi or hi > total) {
+                std.log.warn("{s}: this rank's share [{d}, {d}) of {d} is not whole 128-blocks; EXLR8 matrices split by 128", .{ L.last, lo, hi, total });
+                return error.UnreadableExlr8;
+            }
+        },
+    }
+    const k = if (cut == .ins) hi - lo else K;
+    const n = if (cut == .outs) hi - lo else N;
+    // trellis
+    switch (cut) {
+        .whole => try L.host.appendSlice(L.gpa, t.bytes[0 .. K / 16 * (N / 16) * tile]),
+        .ins => try L.host.appendSlice(L.gpa, t.bytes[lo / 16 * (N / 16) * tile ..][0 .. k / 16 * (N / 16) * tile]),
+        .outs => for (0..K / 16) |r| try L.host.appendSlice(L.gpa, t.bytes[(r * (N / 16) + lo / 16) * tile ..][0 .. n / 16 * tile]),
+    }
+    const tp = try L.put("x8." ++ module ++ ".trellis", args);
+    try L.host.appendSlice(L.gpa, if (cut == .ins) suh.bytes[lo * 2 .. hi * 2] else suh.bytes);
+    const sp = try L.put("x8." ++ module ++ ".suh", args);
+    try L.host.appendSlice(L.gpa, if (cut == .outs) svh.bytes[lo * 2 .. hi * 2] else svh.bytes);
+    const vp = try L.put("x8." ++ module ++ ".svh", args);
+    return .{ .t = tp, .suh = sp, .svh = vp, .k = k, .n = n, .bits = bits };
+}
+
+/// A projection kept for the weights' lifetime (Weights.x8s owns it).
+pub fn keep(L: anytype, p: Proj) !*const Proj {
+    const q = try L.gpa.create(Proj);
+    errdefer L.gpa.destroy(q);
+    q.* = p;
+    try L.w.x8s.append(L.gpa, q);
+    return q;
+}
+
+// ---- host tests -----------------------------------------------------------------------------------------------------
+
+/// A host loader over in-memory tensors for the tests: get/has by name, put records the bytes uploaded.
+const Fake = struct {
+    gpa: std.mem.Allocator,
+    names: []const []const u8,
+    tensors: []const core.checkpoint.Tensor,
+    host: std.ArrayList(u8) = .empty,
+    puts: std.ArrayList([]u8) = .empty,
+    last: []const u8 = "",
+    name_buf: [192]u8 = undefined,
+    w: struct { x8s: std.ArrayList(*Proj) = .empty } = .{},
+
+    fn find(f: *Fake, name: []const u8) ?core.checkpoint.Tensor {
+        for (f.names, f.tensors) |n, t| if (std.mem.eql(u8, n, name)) return t;
+        return null;
+    }
+    pub fn get(f: *Fake, comptime fmt: []const u8, args: anytype) !core.checkpoint.Tensor {
+        f.last = try std.fmt.bufPrint(&f.name_buf, fmt, args);
+        return f.find(f.last) orelse error.MissingTensor;
+    }
+    pub fn has(f: *Fake, comptime fmt: []const u8, args: anytype) !bool {
+        var buf: [192]u8 = undefined;
+        return f.find(try std.fmt.bufPrint(&buf, fmt, args)) != null;
+    }
+    pub fn put(f: *Fake, comptime fmt: []const u8, args: anytype) !u64 {
+        _ = fmt;
+        _ = args;
+        try f.puts.append(f.gpa, try f.host.toOwnedSlice(f.gpa));
+        return f.puts.items.len; // a handle: the index of the upload, from 1
+    }
+    fn deinit(f: *Fake) void {
+        for (f.puts.items) |b| f.gpa.free(b);
+        f.puts.deinit(f.gpa);
+        f.host.deinit(f.gpa);
+        for (f.w.x8s.items) |p| f.gpa.destroy(p);
+        f.w.x8s.deinit(f.gpa);
+    }
+};
+
+fn tensor(dtype: core.checkpoint.DType, shape: []const usize, bytes: []const u8) core.checkpoint.Tensor {
+    var t: core.checkpoint.Tensor = undefined;
+    t.dtype = dtype;
+    t.rank = @intCast(shape.len);
+    t.shape = @splat(0);
+    for (shape, 0..) |d, i| t.shape[i] = d;
+    t.bytes = bytes;
+    return t;
+}
