+test "GLM X8: an EXLR8 matrix keeps a rank's tile columns for an output cut and its tile rows for an input cut" {
+    const a = std.testing.allocator;
+    const K = 256;
+    const N = 384;
+    const bits = 4;
+    const tile = 32 * bits;
+    // each tile's bytes say where it sits: (tile row, tile column)
+    const tb = try a.alloc(u8, K / 16 * (N / 16) * tile);
+    defer a.free(tb);
+    for (0..K / 16) |r| for (0..N / 16) |c| @memset(tb[(r * (N / 16) + c) * tile ..][0..tile], @intCast((r * 31 + c * 7) % 251));
+    var suh: [K * 2]u8 = undefined;
+    for (&suh, 0..) |*b, i| b.* = @intCast((i + i / 256 * 5 + 1) % 256); // not periodic in 256: a cut at the wrong offset reads other bytes
+    var svh: [N * 2]u8 = undefined;
+    for (&svh, 0..) |*b, i| b.* = @intCast((i * 3 + i / 256 * 11 + 7) % 256);
+    const mk = std.mem.toBytes(@as(u32, marker_value));
+    const names = [_][]const u8{ "m.trellis", "m.suh", "m.svh", "m.mcg_e4m3" };
+    const ts = [_]core.checkpoint.Tensor{ tensor(.i16, &.{ K / 16, N / 16, 16 * bits }, tb), tensor(.f16, &.{K}, &suh), tensor(.f16, &.{N}, &svh), tensor(.i32, &.{}, &mk) };
+    {
+        var f: Fake = .{ .gpa = a, .names = &names, .tensors = &ts };
+        defer f.deinit();
+        try std.testing.expect(try present(&f, "m", .{}));
+        const m = try mat(&f, "m", .{}, .{ .outs = .{ 128, 384 } });
+        try std.testing.expectEqual(@as(usize, K), m.k);
+        try std.testing.expectEqual(@as(usize, 256), m.n);
+        try std.testing.expectEqual(@as(u32, 4), m.bits);
+        const t = f.puts.items[m.t - 1];
+        try std.testing.expectEqual(K / 16 * (256 / 16) * tile, t.len);
+        var checked: usize = 0;
+        for (0..K / 16) |r| for (0..256 / 16) |c| {
+            try std.testing.expectEqual(@as(u8, @intCast((r * 31 + (c + 8) * 7) % 251)), t[(r * 16 + c) * tile]);
+            checked += 1;
+        };
+        try std.testing.expectEqual(@as(usize, 256), checked);
+        try std.testing.expectEqualSlices(u8, &suh, f.puts.items[m.suh - 1]);
+        try std.testing.expectEqualSlices(u8, svh[256..768], f.puts.items[m.svh - 1]);
+    }
+    {
+        var f: Fake = .{ .gpa = a, .names = &names, .tensors = &ts };
+        defer f.deinit();
+        const m = try mat(&f, "m", .{}, .{ .ins = .{ 128, 256 } });
+        try std.testing.expectEqual(@as(usize, 128), m.k);
+        try std.testing.expectEqual(@as(usize, N), m.n);
+        const t = f.puts.items[m.t - 1];
+        try std.testing.expectEqual(128 / 16 * (N / 16) * tile, t.len);
+        for (0..128 / 16) |r| for (0..N / 16) |c| try std.testing.expectEqual(@as(u8, @intCast(((r + 8) * 31 + c * 7) % 251)), t[(r * (N / 16) + c) * tile]);
+        try std.testing.expectEqualSlices(u8, suh[256..512], f.puts.items[m.suh - 1]);
+        try std.testing.expectEqualSlices(u8, &svh, f.puts.items[m.svh - 1]);
+    }
+    { // shares off the 128 grid, a wrong marker and an unread width are refused
+        var f: Fake = .{ .gpa = a, .names = &names, .tensors = &ts };
