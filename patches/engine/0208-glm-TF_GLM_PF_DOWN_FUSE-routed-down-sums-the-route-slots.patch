@@ -44,6 +44,17 @@ extern "C" __global__ void tf_glm_put_slot(const float* __restrict__ src, void*
     else reinterpret_cast<float*>(dst)[at] = src[i];
 }
 
+// TF_GLM_PF_DOWN_FUSE: tf_glm_combine's last slot on rows the fused down kernel summed without it: out = fma(the bf16
+// slot value tf_glm_put_slot would store, wts[r][slot], out), the combine's own last step (bf16 slot rows only).
+extern "C" __global__ void tf_glm_fold_slot(const float* __restrict__ src, const float* __restrict__ wts, float* __restrict__ out,
+                                            int rows, int d, int slots, int slot) {
+    const long long i = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i >= static_cast<long long>(rows) * d) return;
+    const long long r = i / d;
+    const float v = __bfloat162float(__float2bfloat16_rn(src[i]));
+    out[i] = __fmaf_rn(v, wts[r * slots + slot], out[i]);
+}
