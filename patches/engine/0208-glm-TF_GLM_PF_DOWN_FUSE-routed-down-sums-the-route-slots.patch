 // The item's main loop and epilogue compiled for its 8-member column blocks (exl3_prompt.cuh TF_EXL3_PROMPT_NBA).
 template <int K2, bool B16 = false>
@@ -452,6 +536,40 @@ extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_down_k6_b16(
     prompt_down<6, true>(Xd, Td, svh_d, y, K, D, ys, yrow, smem_raw, rows_sh, cb, e, cnt, warp, lane);
 }
 
+// TF_GLM_PF_DOWN_FUSE (see DownFuse): tf_exl3_prompt_down_b16 / _k6_b16 with the route combine in the epilogue, a 1-D
+// launch of (D / 256) * f.items blocks in band order.
+template <int K2>
+__device__ __forceinline__ void prompt_down_fuse(const half* __restrict__ Xd, const uint64_t* __restrict__ Td, const int* __restrict__ items,
+        const int* __restrict__ counts, const int* __restrict__ members, const half* __restrict__ svh_d, float* __restrict__ y, int K, int D,
+        int ys, int yrow, const DownFuse& f, unsigned char* smem_raw, int* rows_sh) {
+    const int per = f.band * f.items, at = (int)blockIdx.x % per;
+    const int cb = (int)blockIdx.x / per * f.band + at % f.band, item = at / f.band;
+    if (item >= counts[0]) return;
+    const int e = items[3 * item], first = items[3 * item + 1], cnt = items[3 * item + 2];
+    if (threadIdx.x < TPM) rows_sh[threadIdx.x] = (int)threadIdx.x < cnt ? members[first + threadIdx.x] : -1;
+    __syncthreads();
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+#define TF_EXL3_PROMPT_DNF(NBA) prompt_down_n<K2, NBA, true, true>(Xd, Td, svh_d, y, K, D, ys, yrow, smem_raw, rows_sh, cb, e, cnt, warp, lane, &f)
+    TF_EXL3_PROMPT_NBA(cnt, TF_EXL3_PROMPT_DNF)
+#undef TF_EXL3_PROMPT_DNF
+}
+extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_down_fuse(const half* __restrict__ Xd, const uint64_t* __restrict__ Td,
+        const int* __restrict__ items, const int* __restrict__ counts, const int* __restrict__ members, const half* __restrict__ svh_d,
+        float* __restrict__ y, int K, int D, int ys, int yrow, const DownFuse f) {
+
+    __shared__ __align__(16) unsigned char smem_raw[tsmem_bytes<8>()];
+    __shared__ int rows_sh[TPM];
+    prompt_down_fuse<8>(Xd, Td, items, counts, members, svh_d, y, K, D, ys, yrow, f, smem_raw, rows_sh);
+}
+extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_down_k6_fuse(const half* __restrict__ Xd, const uint64_t* __restrict__ Td,
+        const int* __restrict__ items, const int* __restrict__ counts, const int* __restrict__ members, const half* __restrict__ svh_d,
+        float* __restrict__ y, int K, int D, int ys, int yrow, const DownFuse f) {
+
+    __shared__ __align__(16) unsigned char smem_raw[tsmem_bytes<6>()];
+    __shared__ int rows_sh[TPM];
+    prompt_down_fuse<6>(Xd, Td, items, counts, members, svh_d, y, K, D, ys, yrow, f, smem_raw, rows_sh);
+}
