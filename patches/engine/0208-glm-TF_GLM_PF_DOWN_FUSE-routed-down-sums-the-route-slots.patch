+}
+/// Bytes of a fused launch's counters for `rows` rows of `dims` (256-aligned).
+pub fn fuseCountBytes(rows: usize, dims: usize) usize {
+    return std.mem.alignForward(usize, rows * (dims / 256) * 4, 256);
+}
+/// A band of column blocks that divides the launch's dims / 256 (else the whole width: the plain launch's order).
+pub fn fuseBand(band: usize, dims: usize) usize {
+    const ncb = dims / 256;
+    return if (band >= 1 and band <= ncb and ncb % band == 0) band else ncb;
+}
