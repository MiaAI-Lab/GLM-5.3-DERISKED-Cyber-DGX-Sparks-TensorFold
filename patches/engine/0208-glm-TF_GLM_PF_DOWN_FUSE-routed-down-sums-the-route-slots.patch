index c5a8350e5..b22dcf2b7 100644
--- a/zig/kernels/cuda/exl3_experts.cu
+++ b/zig/kernels/cuda/exl3_experts.cu
@@ -374,11 +374,94 @@ extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_gu_k6(const
     if (threadIdx.x < TPM) rows_sh[threadIdx.x] = (int)threadIdx.x < cnt ? members[first + threadIdx.x] : -1;            \
     __syncthreads();                                                                                                     \
     const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+// TF_GLM_PF_DOWN_FUSE: the route combine in the down kernel's epilogue (bf16 slot rows only). After a warp has written
+// a pair's 256-column slice it counts the pair in cnt[row][cb]; the warp whose count completes the row's ys routed pairs
+// sums them as tf_glm_combine does (fp32 fma from +0 over the slots in order, the bf16 slot values times wts[row][slot]),
+// then, for rows below sy_rows, the shared expert's slot (bf16(sy) times wts[row][ys], tf_glm_put_slot's rounding), and
+// writes the fp32 row slice; rows from sy_rows on take the shared slot later (tf_glm_fold_slot), the same last fma.
+// Integer counters and a fixed order: the same bits as down + put_slot + combine. The fused launch is 1-D and takes its
+// (cb, item) from `band`: every item of `band` column blocks before the next band (band = D / 256: the plain launch's
+// order; smaller bands write a row's routes of a column block closer in time, so more partials are read from the L2).
+// The design follows the fused combine of kindlingai/gr8's expert-tile fc2 (GR8_PF_WT_FUSE / GR8_PF_WT_GMAJOR, by Matt
+// Mastracci); this code is written for TensorFold's kernels.
+struct DownFuse {
+    int* cnt;            // int32 [rows][D / 256], zero at launch
+    const float* wts;    // fp32 [rows][wstride]: slot k's weight at row * wstride + k (k = ys: the shared expert's)
+    const float* sy;     // fp32 [rows][D]: the shared expert's rows (read for rows < sy_rows)
+    float* out0;         // fp32 [split][D]: rows below split
+    float* out1;         // fp32 [rows - split][D]: rows from split on
+    int split, sy_rows, wstride, band, items, discard;
+};
+
+// The item's slices of column block cb are written: each warp counts its pairs (the members hf * TPH + i of the loop
+// above, i = warp + TNW m: warp + TNW l for lane l) once its stores are visible, and sums every row whose count it
+// completed (see DownFuse; GLM's 8 routed slots a row).
+constexpr int FUSE_YS = 8;
+static_assert(TPM == TNW * 8, "a warp's pairs of an item: one a lane of lanes 0..7");
+__device__ __forceinline__ void down_fuse_arrive(const DownFuse& f, const __nv_bfloat16* y, int D, int yrow, const int* rows_sh, int cnt,
+        int cb, int warp, int lane) {
+    __threadfence();   // this lane's slot stores of every pair before the counts (release)
+    __syncwarp();
+    const int j = warp + TNW * lane;
+    int row = -1;
+    bool done = false;
+    if (lane < 8 && j < cnt) {
+        row = rows_sh[j] / FUSE_YS;
+        done = atomicAdd(f.cnt + (size_t)row * (D >> 8) + cb, 1) == FUSE_YS - 1;
+    }
+    unsigned todo = __ballot_sync(0xffffffffu, done);
+    if (!todo) return;
+    __threadfence();   // every other pair's slot stores after the counts (acquire)
+    while (todo) {
+        const int l = __ffs(todo) - 1;
+        todo &= todo - 1;
+        const int r = __shfl_sync(0xffffffffu, row, l);
+        const __nv_bfloat16* yr = y + (size_t)r * yrow * D;
+        const float* w = f.wts + (size_t)r * f.wstride;
+        float* o = r < f.split ? f.out0 + (size_t)r * D : f.out1 + (size_t)(r - f.split) * D;
+        uint2 u[2][FUSE_YS];
+#pragma unroll
+        for (int blk = 0; blk < 2; ++blk)
+#pragma unroll
+            for (int k = 0; k < FUSE_YS; ++k)   // L2 loads (other SMs wrote these lines during this launch)
+                u[blk][k] = __ldcg(reinterpret_cast<const uint2*>(yr + (size_t)k * D + cb * 256 + blk * 128 + 4 * lane));
+        float wk[FUSE_YS + 1];
+#pragma unroll
+        for (int k = 0; k <= FUSE_YS; ++k) wk[k] = w[k];
+        const bool shared = r < f.sy_rows;
+#pragma unroll
+        for (int blk = 0; blk < 2; ++blk) {
+            const int n = cb * 256 + blk * 128 + 4 * lane;
+            float a[4] = {0.f, 0.f, 0.f, 0.f};
+#pragma unroll
+            for (int k = 0; k < FUSE_YS; ++k) {
+                const __nv_bfloat162 v01 = *reinterpret_cast<const __nv_bfloat162*>(&u[blk][k].x);
+                const __nv_bfloat162 v23 = *reinterpret_cast<const __nv_bfloat162*>(&u[blk][k].y);
+                const float v[4] = {__low2float(v01), __high2float(v01), __low2float(v23), __high2float(v23)};
+#pragma unroll
+                for (int q = 0; q < 4; ++q) a[q] = __fmaf_rn(v[q], wk[k], a[q]);
+            }
+            if (shared) {   // the shared expert's slot, last: put_slot's bf16 rounding, then combine's fma
+                const float4 s4 = *reinterpret_cast<const float4*>(f.sy + (size_t)r * D + n);
+                const float sv[4] = {s4.x, s4.y, s4.z, s4.w};
+#pragma unroll
+                for (int q = 0; q < 4; ++q) a[q] = __fmaf_rn(__bfloat162float(__float2bfloat16_rn(sv[q])), wk[FUSE_YS], a[q]);
+            }
+            *reinterpret_cast<float4*>(o + n) = make_float4(a[0], a[1], a[2], a[3]);
+        }
+        if (f.discard) {   // the row's slot lines of this column block are read: drop them from the L2 unwritten
+            __syncwarp();
+            const __nv_bfloat16* line = yr + (size_t)(lane >> 2) * D + cb * 256 + (lane & 3) * 64;   // 8 slots x 4 lines of 128 bytes
+            asm volatile("discard.global.L2 [%0], 128;" ::"l"(line) : "memory");
+        }
+    }
+}
