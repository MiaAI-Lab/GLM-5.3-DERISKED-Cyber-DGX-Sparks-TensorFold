+/// Whether the fused down takes `rows` rows: bf16 slot rows of 8 routed slots (the shared one after them), counters
+/// and outputs that fit the kernel's vector stores, and a grid within the launch limit.
+pub fn fusable(sc: Scratch, f: Fuse, rows: usize, dims: usize, experts: usize) bool {
+    if (!sc.y_bf16 or sc.slots != fuse_slots or sc.yrow <= sc.slots or f.wstride <= fuse_slots or dims % 256 != 0) return false;
+    if (f.cnt == 0 or f.wts == 0 or f.out0 == 0 or f.cnt % 4 != 0 or f.wts % 4 != 0) return false;
+    if (f.split > rows or f.sy_rows > rows or (f.sy_rows > 0 and (f.sy == 0 or f.sy % 16 != 0))) return false;
+    if (f.out0 % 16 != 0 or (f.split < rows and (f.out1 == 0 or f.out1 % 16 != 0))) return false;
+    const items = grouped.maxItems(rows * sc.slots, experts, tile);
+    return f.split <= std.math.maxInt(i32) and f.wstride <= std.math.maxInt(i32) and (dims / 256) * items <= std.math.maxInt(i32);
+}
