-pub const Scratch = struct { xg: u64, xu: u64, xd: u64, y: u64, rows: usize, slots: usize, yrow: usize = 0, y_bf16: bool = false, once: bool = false };
+pub const Scratch = struct { xg: u64, xu: u64, xd: u64, y: u64, rows: usize, slots: usize, yrow: usize = 0, y_bf16: bool = false, once: bool = false, fuse: ?Fuse = null };
+/// `fuse` (with bf16 slot rows, 8 slots): the down kernel also sums each row's routed slots (Fuse).
+/// The fused down kernel's routed slots a row (exl3_experts.cu FUSE_YS).
+pub const fuse_slots = 8;
+/// TF_GLM_PF_DOWN_FUSE's combine (exl3_experts.cu DownFuse): tf_exl3_prompt_down_fuse sums each row's routed bf16 slot
+/// rows with `wts` in slot order (tf_glm_combine's fma chain) and, for rows below `sy_rows`, the shared expert's row of
+/// `sy` (put_slot's bf16, weight wts[row][slots]) into fp32 rows: below `split` at out0, from `split` on at out1. `cnt`:
+/// int32 [rows][dims / 256] the launch zeroes first. `band`: column blocks a launch band (launch order only, same bits).
+pub const Fuse = struct { cnt: u64, wts: u64, wstride: usize, sy: u64, sy_rows: usize, out0: u64, out1: u64, split: usize, band: usize };
+/// The kernel's argument (DownFuse's layout).
+const FuseArgs = extern struct { cnt: u64, wts: u64, sy: u64, out0: u64, out1: u64, split: i32, sy_rows: i32, wstride: i32, band: i32, items: i32, discard: i32 };
+comptime {
