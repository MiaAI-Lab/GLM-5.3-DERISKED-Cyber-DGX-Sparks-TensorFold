diff --git a/zig/tests/cuda/glm_exl3_fuse_tests.zig b/zig/tests/cuda/glm_exl3_fuse_tests.zig
new file mode 100644
index 000000000..f495f5b68
--- /dev/null
+++ b/zig/tests/cuda/glm_exl3_fuse_tests.zig
@@ -0,0 +1,179 @@
+//! TF_GLM_PF_DOWN_FUSE: cuda_exl3.runFused (the routed down summing the slots) + tf_glm_fold_slot against the default
+//! path (cuda_exl3.run's bf16 slot rows, tf_glm_put_slot, tf_glm_combine), byte for byte. Run with
+//! TF_GLM_PF_DOWN_FUSE=1 (and any TF_GLM_PF_DOWN_FUSE_BAND: the bands are launch order only).
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+const qr = @import("quant_ref_tests.zig");
+const Gpu = check.Gpu;
+const Rig = qr.RigT;
+
+const E = 12; // routed experts (the shared one is id E)
+const D = 512; // dims: two 256-column blocks
+const N = 256; // the rank's width of each expert
+const slots = glm.exl3.top_k + 1;
+const limit: f32 = 7.0;
+
+/// Random trellis words and sign scales for `E` K x N matrices at `halves` half-bits: the per-expert pointer table.
+fn matrices(r: *Rig, k: usize, n: usize, halves: u16, suh: *u64, svh: *u64) !u64 {
+    const words = k / 16 * (n / 16) * 8 * @as(usize, halves);
+    const tr = try r.a.alloc(i16, E * words);
+    for (tr) |*v| v.* = r.rng.int(i16);
+    const su = try r.a.alloc(f16, E * k);
+    for (su) |*v| v.* = if (r.rng.boolean()) 1.0 else -1.0;
+    const sv = try r.a.alloc(f16, E * n);
+    for (sv) |*v| v.* = if (r.rng.boolean()) 0.02 else -0.02;
+    suh.* = try r.dev(std.mem.sliceAsBytes(su));
+    svh.* = try r.dev(std.mem.sliceAsBytes(sv));
+    const base = try r.dev(std.mem.sliceAsBytes(tr));
+    const ptrs = try r.a.alloc(u64, E);
+    for (ptrs, 0..) |*p, e| p.* = base + e * words * 2;
+    return r.dev(std.mem.sliceAsBytes(ptrs));
+}
+
+fn weights(r: *Rig, halves: [3]u16) !glm.exl3.Experts {
+    var w: glm.exl3.Experts = undefined;
+    for ([_]*u64{ &w.k2, &w.k2_up, &w.k2_down }, halves) |t, hb| {
+        const k2: [E]i32 = @splat(hb);
+        t.* = try r.dev(std.mem.sliceAsBytes(&k2));
+    }
+    w.gt = try matrices(r, D, N, halves[0], &w.suh_g, &w.svh_g);
+    w.ut = try matrices(r, D, N, halves[1], &w.suh_u, &w.svh_u);
+    w.dt = try matrices(r, N, D, halves[2], &w.suh_d, &w.svh_d);
+    w.uniform_gu = if (halves[0] == halves[1]) halves[0] else 0;
+    w.uniform_d = halves[2];
+    w.shx = false;
+    w.codebook = .mcg;
+    return w;
+}
+
+/// Each row's 8 distinct routed picks, then the shared expert's id.
+fn picks(r: *Rig, rows: usize) ![]i32 {
+    const out = try r.a.alloc(i32, rows * slots);
+    for (0..rows) |row| {
+        var seen: [E]bool = @splat(false);
+        for (0..slots - 1) |j| {
+            var e = r.rng.uintLessThan(usize, E);
+            while (seen[e]) e = r.rng.uintLessThan(usize, E);
+            seen[e] = true;
+            out[row * slots + j] = @intCast(e);
+        }
+        out[row * slots + slots - 1] = E;
+    }
+    return out;
+}
+
+fn floats(r: *Rig, n: usize, lo: f32, hi: f32) ![]f32 {
+    const out = try r.a.alloc(f32, n);
+    for (out) |*v| v.* = lo + r.rng.float(f32) * (hi - lo);
+    return out;
+}
+
+fn plan(r: *Rig, rows: usize) !cuda.grouped.Plan {
+    const P = rows * glm.exl3.top_k;
+    const tile = glm.experts.staged_tile;
+    const wide = P > cuda.grouped.small;
+    return .{
+        .members = try r.zeros(P * 4),
+        .items = try r.zeros(cuda.grouped.maxItems(P, E, tile) * 12),
+        .counts = try r.zeros(8),
+        .rank = try r.zeros((if (wide) P else 1) * 4),
+        .hist = try r.zeros((if (wide) (P + 1023) / 1024 * E else 1) * 4),
+    };
+}
+
+fn scratch(r: *Rig, rows: usize, w: glm.exl3.Experts) !glm.exl3.Scratch {
+    const sz = glm.exl3.scratchFor(rows, D, N, true, w);
+    return .{ .picks = try r.zeros(sz[0]), .xg = try r.zeros(sz[1]), .xu = try r.zeros(sz[2]), .z = try r.zeros(sz[3]) };
+}
+
+const Fns = struct { put: cuda.Function, combine: cuda.Function, fold: cuda.Function };
+
+fn rowsLaunch(f: cuda.Function, s: cuda.Stream, n: usize, values: anytype) !void {
+    var a: cuda.Args = .{};
+    inline for (values) |v| a.add(v);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast((n * D + 255) / 256) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+pub fn run(gpu: Gpu) !void {
+    try check.expect(glm.exl3.downFuse(), "glm-exl3-fuse runs with TF_GLM_PF_DOWN_FUSE=1", .{});
+    try check.expect(glm.exl3.bf16Slots(), "glm-exl3-fuse needs bf16 slot rows (TF_GLM_EXL3_BF16_SLOTS unset)", .{});
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var prng = std.Random.DefaultPrng.init(0x9c);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = stream, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var pm = try cuda.Module.load(gpu.d, cuda.kernels.experts);
+    defer pm.unload();
+    var ops = try cuda.Module.load(gpu.d, cuda.kernels.glm_ops);
+    defer ops.unload();
+    var gl = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer gl.unload();
+    const fns: Fns = .{ .put = try ops.function("tf_glm_put_slot"), .combine = try gl.function("tf_glm_combine"), .fold = try ops.function("tf_glm_fold_slot") };
+    var k = try glm.exl3.Kernels.load(gpu.d);
+    defer k.unload();
+    var ek = try glm.experts.Kernels.load(gpu.d, pm, @intCast(try gpu.ctx.attribute(.multiprocessor_count)));
+    defer ek.unload();
+    var cases: usize = 0;
+    // 4-bit (the K4 checkpoint), 3-bit down (the fused k6 kernel), mixed gate/up
+    for ([_][3]u16{ .{ 8, 8, 8 }, .{ 6, 6, 6 }, .{ 6, 6, 8 } }) |halves| {
+        const w = try weights(&r, halves);
+        for ([_]usize{ 1, 64, 200, 2048, glm.exl3.chunk_rows }) |rows| {
+            const x = try r.bfs(rows * D, 1.0);
+            const pk = try picks(&r, rows);
+            const wts = try floats(&r, rows * slots, 0.02, 0.6);
+            const sy = try floats(&r, rows * D, -0.8, 0.8);
+            const dx = try r.dev(std.mem.sliceAsBytes(x));
+            const dpk = try r.dev(std.mem.sliceAsBytes(pk));
+            const dwts = try r.dev(std.mem.sliceAsBytes(wts));
+            const dsy = try r.dev(std.mem.sliceAsBytes(sy));
+            // the default path: bf16 slot rows, the shared slot, the combine
+            const ey = try r.zeros(rows * slots * D * 2);
+            const want = try r.zeros(rows * D * 4);
+            try glm.exl3.run(&k, &ek, r.s, w, try scratch(&r, rows, w), try plan(&r, rows), dx, D, dpk, slots, rows, E, D, N, limit, true, ey, try r.zeros(16));
+            try rowsLaunch(fns.put, r.s, rows, .{ dsy, ey, @as(c_int, @intCast(rows)), @as(c_int, D), @as(c_int, slots), @as(c_int, slots - 1), @as(c_int, 1) });
+            {
+                var a: cuda.Args = .{};
+                inline for (.{ ey, @as(c_int, 0), dwts, want, @as(i64, D), @as(c_int, slots) }) |v| a.add(v);
+                try cuda.launch.launch(fns.combine, .{ .grid = .{ .x = @intCast(rows), .y = (D + 1023) / 1024 }, .block = .{ .x = 128 } }, r.s, &a);
+            }
+            const ref = try r.back(want, rows * D * 4);
+            for ([_]usize{ 0, rows / 2, rows }) |split| {
+                const ey2 = try r.zeros(rows * slots * D * 2);
+                const out0 = try r.zeros(split * D * 4);
+                const out1 = try r.zeros((rows - split) * D * 4);
+                try glm.exl3.runFused(&k, &ek, r.s, w, try scratch(&r, rows, w), try plan(&r, rows), dx, D, dpk, slots, rows, E, D, N, limit, true, ey2, try r.zeros(16), .{ .wts = dwts, .sy = dsy, .sy_rows = split, .out0 = out0, .out1 = out1, .split = split });
+                if (rows > split) try rowsLaunch(fns.fold, r.s, rows - split, .{ dsy + split * D * 4, dwts + split * slots * 4, out1, @as(c_int, @intCast(rows - split)), @as(c_int, D), @as(c_int, slots), @as(c_int, slots - 1) });
+                const got0 = try r.back(out0, split * D * 4);
+                const got1 = try r.back(out1, (rows - split) * D * 4);
+                const ok = std.mem.eql(u8, got0, ref[0 .. split * D * 4]) and std.mem.eql(u8, got1, ref[split * D * 4 ..]);
+                var diff: usize = 0;
+                if (!ok) for (0..rows * D) |i| {
+                    const g = if (i < split * D) got0[4 * i ..][0..4] else got1[4 * (i - split * D) ..][0..4];
+                    diff += @intFromBool(!std.mem.eql(u8, g, ref[4 * i ..][0..4]));
+                };
+                std.debug.print("RESULT glm-exl3-fuse {d}/{d}/{d}-bit rows {d} split {d}: {s} ({d} of {d} words differ)\n", .{ halves[0], halves[1], halves[2], rows, split, if (ok) "byte-equal" else "DIFFERENT", diff, rows * D });
+                try check.expect(ok, "glm-exl3-fuse: the fused down + fold equals down + put_slot + combine ({d} rows, split {d})", .{ rows, split });
+                cases += 1;
+            }
+        }
+    }
+    // a run the fused kernel refuses: split past the rows
+    {
+        const w = try weights(&r, .{ 8, 8, 8 });
+        const rows: usize = 64;
+        const x = try r.bfs(rows * D, 1.0);
+        const pk = try picks(&r, rows);
+        const o = try r.zeros(rows * D * 4);
+        const res = glm.exl3.runFused(&k, &ek, r.s, w, try scratch(&r, rows, w), try plan(&r, rows), try r.dev(std.mem.sliceAsBytes(x)), D, try r.dev(std.mem.sliceAsBytes(pk)), slots, rows, E, D, N, limit, true, try r.zeros(rows * slots * D * 2), try r.zeros(16), .{ .wts = o, .sy = o, .sy_rows = rows + 1, .out0 = o, .out1 = o, .split = rows + 1 });
+        try check.expect(std.meta.isError(res), "glm-exl3-fuse: a split past the rows is refused", .{});
+        try r.s.synchronize();
+    }
+    check.pass("glm-exl3-fuse: {d} cases byte-equal to the default path (band {d})", .{ cases, glm.exl3.downFuseBand() });
+}
