diff --git a/zig/src/native/cuda_glm_tools.zig b/zig/src/native/cuda_glm_tools.zig
new file mode 100644
index 00000000..770c67cd
--- /dev/null
+++ b/zig/src/native/cuda_glm_tools.zig
@@ -0,0 +1,79 @@
+//! GLM-5.3's tool list for its drafter (families/glm/tool_draft.zig): each request's prompt is read for its
+//! `<tools>` block, every tool's name and parameter keys tokenized as the model writes them after a tag, and the
+//! schema rides on the request's copy proposer (tool_carrier.zig). Rank 0 only: it selects the drafts.
+//! A prompt with no tool list, or one this does not read, drafts as before. TF_GLM_TOOL_DRAFTS=0: off.
+const std = @import("std");
+const core = @import("core");
+const lanes = @import("lanes");
+const glm = @import("glm_cuda");
+const Allocator = std.mem.Allocator;
+const tool_draft = glm.tool_draft;
+const Carrier = glm.tool_carrier.Carrier;
+
+const max_tools = 256;
+const head_tokens = 32768; // the prompt's first tokens read for the block (a tool list sits in the system part)
+
+pub const Tools = struct {
+    gpa: Allocator,
+    tok: core.tokenizer.Tokenizer,
+    min_match: i64 = 4, // the lane host's copy threshold, as its own SuffixLookup takes it
+
+    /// The tokenizer of `dir`, or null: switched off, a follower rank, or no tokenizer.json this reads.
+    pub fn open(gpa: Allocator, io: std.Io, dir: []const u8) ?*Tools {
+        if (!tool_draft.wanted()) return null;
+        if (std.c.getenv("TF_GLM_RANK")) |r| if (!std.mem.eql(u8, std.mem.span(r), "0")) return null;
+        const t = gpa.create(Tools) catch return null;
+        t.* = .{ .gpa = gpa, .tok = core.tokenizer.loadTokenizer(io, gpa, dir) catch |e| {
+            std.log.warn("glm tool drafts: no tokenizer from {s} ({s}); tool calls draft as before", .{ dir, @errorName(e) });
+            gpa.destroy(t);
+            return null;
+        } };
+        // the tags tool_draft.zig names must be this tokenizer's: another vocabulary keeps its tool calls as they were
+        const tags = [_]struct { text: []const u8, id: u32 }{
+            .{ .text = "<tool_call>", .id = tool_draft.tool_call },   .{ .text = "</tool_call>", .id = tool_draft.tool_call_end },
+            .{ .text = "<arg_key>", .id = tool_draft.arg_key },       .{ .text = "</arg_key>", .id = tool_draft.arg_key_end },
+            .{ .text = "<arg_value>", .id = tool_draft.arg_value },   .{ .text = "</arg_value>", .id = tool_draft.arg_value_end },
+        };
+        for (tags) |g| if (t.tok.specialTokenId(g.text) != g.id) {
+            std.log.info("glm tool drafts: off, this tokenizer's {s} is not token {d}", .{ g.text, g.id });
+            t.close();
+            return null;
+        };
+        std.log.info("glm tool drafts: a request's <tools> names and keys are drafted where they are forced (TF_GLM_TOOL_DRAFTS=0: off)", .{});
+        return t;
+    }
+
+    pub fn close(t: *Tools) void {
+        t.tok.deinit();
+        t.gpa.destroy(t);
+    }
+
+    pub fn make(ctx: *anyopaque, gpa: Allocator, prompt: []const u32, eos: []const u32) anyerror!lanes.proposer.Proposer {
+        _ = eos;
+        const t: *Tools = @ptrCast(@alignCast(ctx));
+        const w = try gpa.create(Carrier);
+        errdefer gpa.destroy(w);
+        w.* = .{ .gpa = gpa, .arena = std.heap.ArenaAllocator.init(gpa), .inner = try lanes.SuffixLookup.init(gpa, .{ .min_match = t.min_match }) };
+        w.schema = t.read(w.arena.allocator(), prompt) catch .{};
+        return w.proposer();
+    }
+
+    pub fn free(ctx: *anyopaque, p: lanes.proposer.Proposer) void {
+        _ = ctx;
+        const w: *Carrier = @ptrCast(@alignCast(p.ptr));
+        const gpa = w.gpa;
+        w.deinit();
+        gpa.destroy(w);
+    }
+
+    /// The prompt's tool list as token sequences (empty: none found), allocated in `a`.
+    fn read(t: *const Tools, a: Allocator, prompt: []const u32) !tool_draft.Schema {
+        const text = try t.tok.decode(a, prompt[0..@min(prompt.len, head_tokens)], false);
+        return tool_draft.schemaOf(a, text, .{ .ctx = @constCast(t), .encode = encode });
+    }
+
+    fn encode(ctx: *anyopaque, a: Allocator, text: []const u8) anyerror![]const u32 {
+        const t: *const Tools = @ptrCast(@alignCast(ctx));
+        return t.tok.encodePlain(a, text);
+    }
+};
