+test "GLM DSpark: the request's tool list forces a name's rest, the key and the tags, and the chain carries on from them" {
+    const t = std.testing;
+    const gpa = t.allocator;
+    const td = @import("tool_draft.zig");
+    const V: usize = 154880; // the tags' ids index the Markov tables
+    var sp: Spark = .{ .module = undefined, .k = undefined, .weights = undefined, .vocab = V };
+    sp.w1 = try gpa.alloc(u16, V * RANK);
+    defer gpa.free(sp.w1);
+    sp.w2 = try gpa.alloc(u16, V * RANK);
+    defer gpa.free(sp.w2);
+    @memset(sp.w1, 0);
+    @memset(sp.w2, 0);
+    sp.conf_h = try gpa.alloc(f32, D);
+    defer gpa.free(sp.conf_h);
+    @memset(sp.conf_h, 0);
+    sp.h_hn = try gpa.alloc(u16, df.MAX_M * D);
+    defer gpa.free(sp.h_hn);
+    @memset(sp.h_hn, 0);
+    sp.conf_m = @splat(0);
+    sp.conf_b = 0;
+    const world: usize = 1;
+    const M: usize = df.BLOCK;
+    const cand = try gpa.alloc(i32, world * M * CW);
+    defer gpa.free(cand);
+    @memset(cand, -1);
+    for (0..M) |r| { // every slot's best candidate is token 1
+        cand[r * CW] = 1;
+        cand[r * CW + TOPK] = @bitCast(@as(f32, 2.0));
+    }
+    var dr: df.Drafter = .{ .gpa = gpa, .d = undefined, .module = undefined, .k = undefined, .weights = undefined, .split = false, .ff = FF, .rank = 0, .world = world, .spark = &sp };
+    dr.cand = cand;
+    // read_file(path) and run_shell(command): after `<tool_call> read` only read_file is left
+    const read = [_]u32{ 878, 2458 };
+    const run = [_]u32{ 6108, 48634 };
+    const path = [_]u32{2343};
+    const command = [_]u32{5631};
+    const schema: td.Schema = .{ .tools = &.{
+        .{ .name = &read, .params = &.{.{ .key = &path, .required = true }} },
+        .{ .name = &run, .params = &.{.{ .key = &command, .required = true }} },
+    } };
+    var out: [df.BLOCK - 1]u32 = undefined;
+    var probs: [df.BLOCK - 1]f64 = undefined;
+    select(&dr, 0, M, .{ .slot = 0, .pos = 100, .n = 0, .anchor = 878, .out = &out, .probs = &probs, .tools = schema.cursor(&.{ 5, td.tool_call, 878 }) });
+    // _file, <arg_key>, path, </arg_key>, <arg_value> forced; the value's tokens are DSpark's own (token 1, chance 0.5)
+    try t.expectEqualSlices(u32, &.{ 2458, td.arg_key, 2343, td.arg_key_end, td.arg_value, 1, 1 }, &out);
+    for ([_]f64{ 0.97, 0.95, 0.9, 0.97, 0.99, 0.5, 0.5 }, probs) |want, got| try t.expectApproxEqAbs(want, got, 1e-12);
+    // without the list the chain is DSpark's alone
+    select(&dr, 0, M, .{ .slot = 0, .pos = 100, .n = 0, .anchor = 878, .out = &out, .probs = &probs });
+    try t.expectEqualSlices(u32, &.{ 1, 1, 1, 1, 1, 1, 1 }, &out);
+}
diff --git a/zig/src/families/glm/tool_carrier.zig b/zig/src/families/glm/tool_carrier.zig
new file mode 100644
index 00000000..739fdf28
--- /dev/null
+++ b/zig/src/families/glm/tool_carrier.zig
@@ -0,0 +1,51 @@
+//! A request's tool schema on its stream: the copy proposer the lane host makes for it (tool_draft.zig's drafts).
+const std = @import("std");
+const lanes = @import("lanes");
+const tool_draft = @import("tool_draft.zig");
+const Allocator = std.mem.Allocator;
+const Schema = tool_draft.Schema;
+
+/// A request's copy proposer (the core's SuffixLookup, every call passed through) that also carries its tool schema:
+/// the drafter's rank 0 finds it on the stream and reads the cursor from it.
+pub const Carrier = struct {
+    gpa: Allocator,
+    arena: std.heap.ArenaAllocator, // the schema's token sequences
+    inner: lanes.SuffixLookup,
+    schema: Schema = .{},
+
+    pub fn proposer(w: *Carrier) lanes.proposer.Proposer {
+        return .{ .ptr = w, .vtable = &vtable };
+    }
+
+    /// The carrier behind a stream's proposer (null: another proposer).
+    pub fn of(p: lanes.proposer.Proposer) ?*const Carrier {
+        return if (p.vtable == &vtable) @ptrCast(@alignCast(p.ptr)) else null;
+    }
+
+    pub fn deinit(w: *Carrier) void {
+        w.inner.deinit();
+        w.arena.deinit();
+    }
+
+    const In = lanes.SuffixLookup;
+    pub const vtable: lanes.proposer.Proposer.VTable = .{ .propose = proposeFn, .propose_after = afterFn, .last_match = lastMatchFn, .last_end = lastEndFn, .observe = observeFn };
+
+    fn self(ptr: *anyopaque) *Carrier {
+        return @ptrCast(@alignCast(ptr));
+    }
+    fn proposeFn(ptr: *anyopaque, context: []const u32, max_draft: i64) anyerror![]const u32 {
+        return In.vtable.propose(&self(ptr).inner, context, max_draft);
+    }
+    fn afterFn(ptr: *anyopaque, history: []const u32, tail: []const u32, max_draft: i64) anyerror![]const u32 {
+        return In.vtable.propose_after.?(&self(ptr).inner, history, tail, max_draft);
+    }
+    fn lastMatchFn(ptr: *anyopaque) i64 {
+        return In.vtable.last_match(&self(ptr).inner);
+    }
+    fn lastEndFn(ptr: *anyopaque) usize {
+        return In.vtable.last_end.?(&self(ptr).inner);
+    }
+    fn observeFn(ptr: *anyopaque, proposed: i64, accepted: i64) void {
+        In.vtable.observe.?(&self(ptr).inner, proposed, accepted);
+    }
+};
diff --git a/zig/src/families/glm/tool_draft.zig b/zig/src/families/glm/tool_draft.zig
new file mode 100644
index 00000000..30ee57f2
--- /dev/null
+++ b/zig/src/families/glm/tool_draft.zig
@@ -0,0 +1,415 @@
+//! Tool-call drafts the request's own tool list forces (TF_GLM_TOOL_DRAFTS=0: off).
+//!
+//! GLM-5.3 writes a call as `<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value>...</tool_call>`. The names and
+//! parameter keys come from the prompt's `<tools>` block, so once a name or key has started and only one of the listed
+//! ones continues it, the next tokens are known, as are the tags around them. DSpark drafts these positions poorly
+//! (its first draft lands on 61% of them on the parity set's tool replies against 86% on words), so its chain takes
+//! the forced token there and carries on from it. Drafts only propose: the verify keeps every reply exact.
+//!
+//! The schema is token sequences (the host tokenizes the names and keys once a request); this file reads no text
+//! and needs no lane core (tool_carrier.zig holds a request's schema on its stream).
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// GLM-5.3's tool-call tags (added tokens of its tokenizer; dspark.zig's fixed tag rules name the same ids).
+pub const tool_call: u32 = 154843;
+pub const tool_call_end: u32 = 154844;
+pub const arg_key: u32 = 154847;
+pub const arg_key_end: u32 = 154848;
+pub const arg_value: u32 = 154849;
+pub const arg_value_end: u32 = 154850;
+
+pub const max_params = 64; // a tool's parameters a cursor tracks (its used set is one u64)
+const max_tools = 256;
+const max_piece = 24; // a name's or key's tokens a cursor holds; a longer one forces nothing until its closing tag
+const look_back = 4096; // a stream's last tokens searched for the open <tool_call>
+
+pub const Param = struct { key: []const u32, required: bool };
+pub const Tool = struct { name: []const u32, params: []const Param };
+
+/// A request's tools: every name and key as the tokenizer writes it after a tag.
+pub const Schema = struct {
+    tools: []const Tool = &.{},
+
+    /// The state after `tokens` (a stream's prompt and reply so far, its last token the draft anchor).
+    pub fn cursor(s: *const Schema, tokens: []const u32) Cursor {
+        var c: Cursor = .{ .schema = s };
+        if (s.tools.len == 0) return c;
+        const from = tokens.len -| look_back;
+        var open: ?usize = null;
+        var i = tokens.len;
+        while (i > from) {
+            i -= 1;
+            if (tokens[i] == tool_call_end) break; // the last call closed: outside
+            if (tokens[i] == tool_call) {
+                open = i;
+                break;
+            }
+        }
+        const at = open orelse return c;
+        for (tokens[at..]) |t| c.advance(t);
+        return c;
+    }
+};
+
+pub const Forced = struct { id: u32, conf: f64 };
+pub const St = enum { outside, name, key, after_key, value, after_value };
+
+/// Where a reply stands inside a tool call, and what its schema forces next.
+pub const Cursor = struct {
+    schema: *const Schema,
+    st: St = .outside,
+    tool: u32 = 0,
+    used: u64 = 0,
+    piece: [max_piece]u32 = undefined, // the name's or key's tokens so far
+    n: u32 = 0,
+    over: bool = false, // the piece outgrew `piece`
+
+    fn sofar(c: *const Cursor) []const u32 {
+        return c.piece[0..c.n];
+    }
+
+    /// The token the schema forces next (null: the model's choice).
+    pub fn forced(c: *const Cursor) ?Forced {
+        const tools = c.schema.tools;
+        switch (c.st) {
+            .outside, .value => return null,
+            .name => {
+                if (c.over) return null;
+                var only: ?usize = null;
+                for (tools, 0..) |t, i| {
+                    if (!std.mem.startsWith(u32, t.name, c.sofar())) continue;
+                    if (only != null) return null; // two names continue it
+                    only = i;
+                }
+                const t = tools[only orelse return null];
+                if (c.n < t.name.len) return .{ .id = t.name[c.n], .conf = 0.97 };
+                return .{ .id = if (t.params.len > 0) arg_key else tool_call_end, .conf = 0.95 };
+            },
+            .key => {
+                if (c.over or c.tool >= tools.len) return null;
+                const ps = tools[c.tool].params;
+                if (c.n == 0) { // no token of the key yet: the next unused parameter in the schema's order, if required
+                    for (ps, 0..) |p, i| {
+                        if (i >= max_params or c.used >> @intCast(i) & 1 != 0) continue;
+                        return if (p.required and p.key.len > 0) .{ .id = p.key[0], .conf = 0.9 } else null;
+                    }
+                    return null;
+                }
+                var only: ?usize = null;
+                for (ps, 0..) |p, i| {
+                    if (i >= max_params or c.used >> @intCast(i) & 1 != 0) continue;
+                    if (!std.mem.startsWith(u32, p.key, c.sofar())) continue;
+                    if (only != null) return null;
+                    only = i;
+                }
+                const p = ps[only orelse return null];
+                return if (c.n < p.key.len) .{ .id = p.key[c.n], .conf = 0.97 } else .{ .id = arg_key_end, .conf = 0.97 };
+            },
+            .after_key => return .{ .id = arg_value, .conf = 0.99 },
+            .after_value => {
+                if (c.tool >= tools.len) return null;
+                var left = false;
+                for (tools[c.tool].params, 0..) |p, i| {
+                    if (i >= max_params or c.used >> @intCast(i) & 1 != 0) continue;
+                    if (p.required) return .{ .id = arg_key, .conf = 0.95 };
+                    left = true;
+                }
+                // every required parameter written: the call closes (an optional one may still follow)
+                return .{ .id = tool_call_end, .conf = if (left) 0.85 else 0.95 };
+            },
+        }
+    }
+
+    /// The state after token `t`.
+    pub fn advance(c: *Cursor, t: u32) void {
+        if (t == tool_call) {
+            c.* = .{ .schema = c.schema, .st = .name };
+            return;
+        }
+        switch (c.st) {
+            .outside => {},
+            .name => {
+                if (t == arg_key) {
+                    c.tool = c.match(null) orelse std.math.maxInt(u32);
+                    c.used = 0;
+                    c.open(.key);
+                } else if (t == tool_call_end) {
+                    c.st = .outside;
+                } else c.push(t);
+            },
+            .key => {
+                if (t == arg_key_end) {
+                    if (c.tool < c.schema.tools.len) if (c.match(c.tool)) |i| {
+                        if (i < max_params) c.used |= @as(u64, 1) << @intCast(i);
+                    };
+                    c.open(.after_key);
+                } else if (t == tool_call_end) {
+                    c.st = .outside;
+                } else c.push(t);
+            },
+            .after_key => c.st = if (t == arg_value) .value else .outside,
+            .value => {
+                if (t == arg_value_end) c.st = .after_value;
+                if (t == tool_call_end) c.st = .outside;
+            },
+            .after_value => {
+                if (t == arg_key) c.open(.key) else c.st = .outside;
+            },
+        }
+    }
+
+    fn open(c: *Cursor, st: St) void {
+        c.st = st;
+        c.n = 0;
+        c.over = false;
+    }
+
+    fn push(c: *Cursor, t: u32) void {
+        if (c.n == max_piece) {
+            c.over = true;
+            return;
+        }
+        c.piece[c.n] = t;
+        c.n += 1;
+    }
+
+    /// The tool (`of` null) or `of`'s parameter whose tokens are exactly the piece.
+    fn match(c: *const Cursor, of: ?u32) ?u32 {
+        if (c.over) return null;
+        if (of) |tool| {
+            for (c.schema.tools[tool].params, 0..) |p, i| if (std.mem.eql(u32, p.key, c.sofar())) return @intCast(i);
+            return null;
+        }
+        for (c.schema.tools, 0..) |t, i| if (std.mem.eql(u32, t.name, c.sofar())) return @intCast(i);
+        return null;
+    }
+};
+
+/// TF_GLM_TOOL_DRAFTS=0 turns the schema's drafts off (the fixed tag rules of dspark.zig stay).
+pub fn wanted() bool {
+    const v = std.c.getenv("TF_GLM_TOOL_DRAFTS") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(v), "0");
+}
+
+pub const Encoder = struct { ctx: *anyopaque, encode: *const fn (ctx: *anyopaque, a: Allocator, text: []const u8) anyerror![]const u32 };
+
+/// The tools between `<tools>` and `</tools>` in a rendered prompt: one JSON object a line, a function's `name` and its
+/// `parameters.properties` keys in their written order (`required` marks which must appear); an OpenAI-style
+/// `{"type": "function", "function": {...}}` wrapper is read through. Lines that are not such objects are skipped.
+pub fn schemaOf(a: Allocator, text: []const u8, enc: Encoder) !Schema {
+    // the first <tools> ... </tools> pair that lists a tool: GLM-5.3's template names the tags in a sentence first
+    // ("within <tools></tools> XML tags:"), an empty pair, before the block itself
+    var from: usize = 0;
+    while (std.mem.indexOfPos(u8, text, from, "<tools>")) |open| {
+        const body_at = open + "<tools>".len;
+        const close = std.mem.indexOfPos(u8, text, body_at, "</tools>") orelse return .{};
+        const s = try schemaIn(a, text[body_at..close], enc);
+        if (s.tools.len > 0) return s;
+        from = close + "</tools>".len;
+    }
+    return .{};
+}
+
+fn schemaIn(a: Allocator, body: []const u8, enc: Encoder) !Schema {
+    var tools: std.ArrayList(Tool) = .empty;
+    var lines = std.mem.splitScalar(u8, body, '\n');
+    while (lines.next()) |raw| {
+        const line = std.mem.trim(u8, raw, " \t\r");
+        if (line.len == 0 or line[0] != '{' or tools.items.len == max_tools) continue;
+        const doc = std.json.parseFromSliceLeaky(std.json.Value, a, line, .{}) catch continue;
+        if (doc != .object) continue;
+        const f = if (doc.object.get("function")) |x| (if (x == .object) x else doc) else doc;
+        const name = f.object.get("name") orelse continue;
+        if (name != .string or name.string.len == 0) continue;
+        var params: std.ArrayList(Param) = .empty;
+        if (f.object.get("parameters")) |ps| if (ps == .object) {
+            const required: ?std.json.Value = ps.object.get("required");
+            if (ps.object.get("properties")) |props| if (props == .object) {
+                var it = props.object.iterator();
+                while (it.next()) |kv| {
+                    const key = kv.key_ptr.*;
+                    if (key.len == 0) continue;
+                    var must = false;
+                    if (required) |rq| if (rq == .array) for (rq.array.items) |r| {
+                        if (r == .string and std.mem.eql(u8, r.string, key)) must = true;
+                    };
+                    try params.append(a, .{ .key = try enc.encode(enc.ctx, a, key), .required = must });
+                }
+            };
+        };
+        try tools.append(a, .{ .name = try enc.encode(enc.ctx, a, name.string), .params = params.items });
+    }
+    return .{ .tools = tools.items };
+}
+
+const testing = std.testing;
+
+// read_file(path), run_shell(command, timeout_s?), edit_file(path, old, new), search(pattern, glob?) as the parity
+// set's tool prompts list them; token ids as GLM-5.3's tokenizer writes the names and keys.
+const t_read = [_]u32{ 878, 2458 };
+const t_run = [_]u32{ 6108, 48634 };
+const t_edit = [_]u32{ 7001, 2458 };
+const t_search = [_]u32{1836};
+const k_path = [_]u32{2343};
+const k_command = [_]u32{5631};
+const k_timeout = [_]u32{ 9001, 9002 };
+const k_old = [_]u32{9003};
+const k_new = [_]u32{9004};
+const k_pattern = [_]u32{14329};
+const k_glob = [_]u32{9005};
+const test_schema: Schema = .{ .tools = &.{
+    .{ .name = &t_read, .params = &.{.{ .key = &k_path, .required = true }} },
+    .{ .name = &t_run, .params = &.{ .{ .key = &k_command, .required = true }, .{ .key = &k_timeout, .required = false } } },
+    .{ .name = &t_edit, .params = &.{ .{ .key = &k_path, .required = true }, .{ .key = &k_old, .required = true }, .{ .key = &k_new, .required = true } } },
+    .{ .name = &t_search, .params = &.{ .{ .key = &k_pattern, .required = true }, .{ .key = &k_glob, .required = false } } },
+} };
+
+fn expectForced(c: Cursor, want: ?u32) !void {
+    const f = c.forced();
+    try testing.expectEqual(want, if (f) |x| x.id else null);
+}
+
+test "GLM tool drafts: a call's forced tokens: the rest of a unique name, its keys in order, the tags between, the close" {
+    const s = &test_schema;
+    // prose, then <tool_call>: four names may follow, nothing forced
+    var c = s.cursor(&.{ 11, 12, tool_call });
+    try expectForced(c, null);
+    // `read` continues only read_file: its second token, then <arg_key>, its one key, </arg_key>, <arg_value>
+    c.advance(878);
+    try expectForced(c, 2458);
+    c.advance(2458);
+    try expectForced(c, arg_key);
+    c.advance(arg_key);
+    try expectForced(c, 2343);
+    c.advance(2343);
+    try expectForced(c, arg_key_end);
+    c.advance(arg_key_end);
+    try expectForced(c, arg_value);
+    c.advance(arg_value);
+    try expectForced(c, null); // the value is the model's
+    c.advance(500);
+    c.advance(501);
+    try expectForced(c, null);
+    c.advance(arg_value_end);
+    try expectForced(c, tool_call_end); // every parameter written
+    try testing.expectEqual(@as(f64, 0.95), c.forced().?.conf);
+    c.advance(tool_call_end);
+    try expectForced(c, null);
+}
+
+test "GLM tool drafts: the cursor from a stream's tokens equals the one advanced token by token, and a closed call is outside" {
+    const s = &test_schema;
+    const reply = [_]u32{ 7, tool_call, 6108, 48634, arg_key, 5631, arg_key_end, arg_value, 40, 41, arg_value_end };
+    for (0..reply.len + 1) |n| {
+        var step: Cursor = .{ .schema = s };
+        for (reply[0..n]) |t| step.advance(t);
+        const got = s.cursor(reply[0..n]);
+        try testing.expectEqual(step.st, got.st);
+        const a = step.forced();
+        const b = got.forced();
+        try testing.expectEqual(if (a) |x| x.id else null, if (b) |x| x.id else null);
+    }
+    // run_shell's command written, timeout_s optional: the close at the lower chance
+    const c = s.cursor(&reply);
+    try expectForced(c, tool_call_end);
+    try testing.expectEqual(@as(f64, 0.85), c.forced().?.conf);
+    // a second call after a closed one starts again; after its close nothing is forced
+    try expectForced(s.cursor(&(reply ++ [_]u32{ tool_call_end, tool_call, 1836 })), arg_key);
+    try expectForced(s.cursor(&(reply ++ [_]u32{tool_call_end})), null);
+}
+
+test "GLM tool drafts: several required keys go in the schema's order; a started key picks its own; unknown names and keys force nothing wrong" {
+    const s = &test_schema;
+    var c = s.cursor(&.{ tool_call, 7001, 2458, arg_key });
+    try expectForced(c, 2343); // edit_file: path first
+    for ([_]u32{ 2343, arg_key_end, arg_value, 1, arg_value_end }) |t| c.advance(t);
+    try expectForced(c, arg_key); // old and new still required
+    c.advance(arg_key);
+    try expectForced(c, 9003);
+    c.advance(9004); // the model wrote `new` first: that key is complete, its end tag follows
+    try expectForced(c, arg_key_end);
+    for ([_]u32{ arg_key_end, arg_value, 2, arg_value_end, arg_key }) |t| c.advance(t);
+    try expectForced(c, 9003); // old is the one left
+    // a name no tool has: nothing until the tags, and its keys are unknown
+    var u = s.cursor(&.{ tool_call, 31337 });
+    try expectForced(u, null);
+    u.advance(arg_key);
+    try expectForced(u, null);
+    u.advance(77);
+    try expectForced(u, null);
+    u.advance(arg_key_end);
+    try expectForced(u, arg_value);
+    // an empty schema forces nothing
+    const none: Schema = .{};
+    try expectForced(none.cursor(&.{ tool_call, 878 }), null);
+}
+
+test "GLM tool drafts: two names sharing a prefix force nothing until one is left, and a longer name keeps a shorter one open" {
+    const a = [_]u32{ 10, 11 };
+    const b = [_]u32{ 10, 12 };
+    const short = [_]u32{20};
+    const long = [_]u32{ 20, 21 };
+    const s: Schema = .{ .tools = &.{
+        .{ .name = &a, .params = &.{} },
+        .{ .name = &b, .params = &.{} },
+        .{ .name = &short, .params = &.{} },
+        .{ .name = &long, .params = &.{} },
+    } };
+    try expectForced(s.cursor(&.{ tool_call, 10 }), null);
+    try expectForced(s.cursor(&.{ tool_call, 10, 11 }), tool_call_end); // no parameters: the call closes
+    try expectForced(s.cursor(&.{ tool_call, 20 }), null); // `20` alone or `20 21`
+    try expectForced(s.cursor(&.{ tool_call, 20, 21 }), tool_call_end);
+}
+
+test "GLM tool drafts: a piece longer than the cursor holds forces nothing and the call still parses after it" {
+    const s = &test_schema;
+    var c = s.cursor(&.{tool_call});
+    for (0..max_piece + 3) |i| c.advance(@intCast(60000 + i));
+    try expectForced(c, null);
+    c.advance(arg_key);
+    try expectForced(c, null);
+    c.advance(5);
+    c.advance(arg_key_end);
+    try expectForced(c, arg_value);
+}
+
+// a stand-in tokenizer: one token a byte (the real one is checked on the model's tokenizer.json where it is present)
+fn bytesEncode(_: *anyopaque, a: Allocator, text: []const u8) anyerror![]const u32 {
+    const out = try a.alloc(u32, text.len);
+    for (out, text) |*o, c| o.* = c;
+    return out;
+}
+
+test "GLM tool drafts: a rendered prompt's tool list: names, keys in written order, required ones marked, wrappers read through" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var dummy: u8 = 0;
+    const enc: Encoder = .{ .ctx = &dummy, .encode = bytesEncode };
+    const prompt =
+        \\<|system|>
+        \\# Tools
+        \\You are provided with function signatures within <tools></tools> XML tags:
+        \\<tools>
+        \\{"name": "read_file", "description": "Read a file.", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}
+        \\{"type": "function", "function": {"name": "run_shell", "parameters": {"type": "object", "properties": {"command": {"type": "string"}, "timeout_s": {"type": "integer"}}, "required": ["command"]}}}
+        \\not json
+        \\{"name": "now"}
+        \\</tools>
+        \\<|user|>hi
+    ;
+    const s = try schemaOf(a, prompt, enc);
+    try testing.expectEqual(@as(usize, 3), s.tools.len);
+    try testing.expectEqualSlices(u32, &.{ 'r', 'e', 'a', 'd', '_', 'f', 'i', 'l', 'e' }, s.tools[0].name);
+    try testing.expectEqual(@as(usize, 1), s.tools[0].params.len);
+    try testing.expect(s.tools[0].params[0].required);
+    try testing.expectEqual(@as(usize, 2), s.tools[1].params.len);
+    try testing.expectEqualSlices(u32, &.{ 'c', 'o', 'm', 'm', 'a', 'n', 'd' }, s.tools[1].params[0].key);
+    try testing.expect(s.tools[1].params[0].required);
+    try testing.expect(!s.tools[1].params[1].required);
+    try testing.expectEqual(@as(usize, 0), s.tools[2].params.len);
+    // no block, or one left open: no tools
+    try testing.expectEqual(@as(usize, 0), (try schemaOf(a, "<|user|>hi", enc)).tools.len);
+    try testing.expectEqual(@as(usize, 0), (try schemaOf(a, "<tools>\n{\"name\": \"x\"}", enc)).tools.len);
+}
