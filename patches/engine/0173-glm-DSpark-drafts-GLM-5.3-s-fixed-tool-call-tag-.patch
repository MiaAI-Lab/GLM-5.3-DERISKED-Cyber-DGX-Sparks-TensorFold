From 0f2919cfabb6db741dc8da0d7c984550c2851106 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <MiaAI-Lab@users.noreply.github.com>
Date: Sun, 15 Nov 2026 09:30:20 +0200
Subject: [PATCH] glm: DSpark drafts GLM-5.3's fixed tool-call tag successors
 (</arg_key> -> <arg_value>, </arg_value> -> </tool_call>, </tool_call> ->
 <|observation|>; TF_GLM_DSPARK_TAGS=0: off)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UQVvNktFCvQrvpNUbqtqBX
---
 zig/src/families/glm/dspark.zig | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/zig/src/families/glm/dspark.zig b/zig/src/families/glm/dspark.zig
index d7b1b24..12f29ae 100644
--- a/zig/src/families/glm/dspark.zig
+++ b/zig/src/families/glm/dspark.zig
@@ -470,6 +470,21 @@ pub fn pass(dr: *df.Drafter, e: anytype, S: usize) !void {
 
 const Cand = struct { v: f32, id: u32 };
 
+/// GLM-5.3's tool-call tags whose successor is (nearly) fixed: DSpark rarely drafts them (its first draft lands on 47% of
+/// tag positions against 86% of words on the parity set's tool replies), so after these the draft is the tag the format
+/// puts next (TF_GLM_DSPARK_TAGS=0: off). Drafts only propose: the verify keeps replies exact either way.
+const Tag = struct { after: u32, next: u32, conf: f64 };
+const tags = [_]Tag{
+    .{ .after = 154848, .next = 154849, .conf = 0.99 }, // </arg_key> -> <arg_value> (14 of 14 on the parity replies)
+    .{ .after = 154850, .next = 154844, .conf = 0.9 }, // </arg_value> -> </tool_call> (13 of 14)
+    .{ .after = 154844, .next = 154829, .conf = 0.6 }, // </tool_call> -> <|observation|> (8 of 13)
+};
+
+fn tagRules() bool {
+    const v = std.c.getenv("TF_GLM_DSPARK_TAGS") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(v), "0");
+}
+
 fn better(_: void, a: Cand, b: Cand) bool {
     return if (a.v != b.v) a.v > b.v else a.id < b.id;
 }
@@ -523,9 +538,15 @@ pub fn select(dr: *const df.Drafter, i: usize, M: usize, q: df.Req) void {
             }
             return;
         }
-        prev = c[best].id;
+        var pick: u32 = c[best].id;
+        var chance = conf;
+        if (tagRules()) for (tags) |g| if (prev == g.after) {
+            pick = g.next;
+            chance = @max(conf, g.conf);
+        };
+        prev = pick;
         out[t] = @intCast(prev);
-        if (q.probs) |p| p[t] = conf;
+        if (q.probs) |p| p[t] = chance;
     }
 }
 
