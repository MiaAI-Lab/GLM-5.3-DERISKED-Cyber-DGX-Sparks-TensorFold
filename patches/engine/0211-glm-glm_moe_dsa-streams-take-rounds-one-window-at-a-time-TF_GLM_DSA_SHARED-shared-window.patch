diff --git a/zig/src/families/glm/cuda_shared.zig b/zig/src/families/glm/cuda_shared.zig
index 874cdc5d5..e2ffa41f8 100644
--- a/zig/src/families/glm/cuda_shared.zig
+++ b/zig/src/families/glm/cuda_shared.zig
@@ -34,6 +34,10 @@ fn segsKind(r: fw.Rank, a: dsa_block.Layer, di: usize) ?dsa_block.SegsKind {
 }
 
 /// Checks a shared window's segments (a prompt buffer's: whole prompts) against its `rows` rows; each holds its own.
+/// Whether mixer below runs glm_moe_dsa's layers over several streams' segments (dsaSegs). Rank 0's lanes still give
+/// glm_moe_dsa's streams their rounds one window at a time unless TF_GLM_DSA_SHARED=1 (cuda_lanes.Lanes.aloneAtStart).
+pub const dsa_built = true;
+
 pub fn begin(r: fw.Rank, rows: usize, stream: cuda.Stream) !void {
     const most: usize = if (r.b.prefill) fw.prefill_rows else fw.window_rows;
     if (r.b.prefill and r.segs.len > @import("cuda_state.zig").prompt_heads) return error.BadWindow;
@@ -124,7 +128,10 @@ pub fn mixer(f: *const fw.Forward, r: fw.Rank, l: weights.Layer, li: usize, di:
             if (out) |o| try kda_block.fill(f.set(), f.stream, k, s, 0, rows, o);
         },
         .mla => |a| {
-            if (a.rope != 0) return error.DsaSharedWindow; // glm_moe_dsa serves one stream until its graph lands (patch 0303)
+            if (a.rope != 0) { // glm_moe_dsa (TF_GLM_DSA_SHARED=1): every segment's attention on its own rows and caches
+                if (!dsa_built) return error.DsaSharedWindow;
+                return dsaSegs(f, r, a, di, rows, out);
+            }
             if (@import("cuda_kv_shard_attn.zig").wanted(f, r)) { // TF_GLM_KV_SHARD: a segment one rank holds alone
                 try @import("cuda_kv_shard_attn.zig").shared(f, r, a, di, rows);
                 if (out) |o| try dsa_block.fill(f.set(), f.stream, a, b.dsa, 0, rows, o);
@@ -186,3 +193,26 @@ pub fn mixer(f: *const fw.Forward, r: fw.Rank, l: weights.Layer, li: usize, di:
         },
     }
 }
+
+/// glm_moe_dsa's layer over a shared window: every row's projections in one pass (prepare: [q_a | kv_a], the norms,
+/// q_b, the indexer's keys and queries, the absorbed query; their sums do not depend on the row count, qmmf.splitK),
+/// then each segment's attention in turn exactly as its stream alone runs it (dsa_block.attend at the segment's first
+/// row: its latent and index-key writes at its own positions, its roped query, its top-2048 over its own index ring,
+/// its dense or sparse attention), then o_proj's expand for every row. Segments run one after another on the stream,
+/// each with its own token lists (attend offsets them by its first row), so a shared layer (no indexer) reuses its own
+/// segment's last full-layer list. No owner-row or split-selection paths: the window is replicated on every rank.
+fn dsaSegs(f: *const fw.Forward, r: fw.Rank, a: dsa_block.Layer, di: usize, rows: usize, out: ?u64) !void {
+    const b = r.b;
+    const c = &r.w.config;
+    if (b.prefill) return error.DsaSharedWindow; // prompts never share a pass (cuda_lanes.Lanes.batchesPrompts)
+    var sparse_any = false;
+    for (r.segs) |g| sparse_any = sparse_any or dsa_block.sparseRows(a, g.st.pos, g.rows);
+    try dsa_block.prepare(f.set(), f.stream, a, b.dsa, b.normed, c.hidden, rows, sparse_any);
+    const kk: dsa_block.Kernels = .{ .set = f.set(), .ops = f.m.ops() };
+    for (r.segs) |g| {
+        const nch = @min(latent.chunksFor(g.st.pos + g.rows), b.nch);
+        try dsa_block.attend(kk, f.stream, a, g.st.caches[di], b.dsa, g.row0, g.rows, g.st.pos_dev, g.st.pos, nch, b.part_rows);
+    }
+    try latent.expandV(f.set(), f.stream, b.dsa.ol, a.wv, b.dsa.vn, rows, a.heads, a.dv, a.lw);
+    if (out) |o| try dsa_block.fill(f.set(), f.stream, a, b.dsa, 0, rows, o);
+}
diff --git a/zig/tests/cuda/glm_conc_rows_tests.zig b/zig/tests/cuda/glm_conc_rows_tests.zig
