+
+test "GLM dsa shared: glm_moe_dsa's streams take rounds one window at a time unless its shared window is built" {
+    // the truth table: TF_GLM_SHARED=0 stops sharing for every model; glm_moe_dsa shares only when asked and built
+    try std.testing.expect(Lanes.sharesForward(false, false, false)); // Flash and the rest: shared windows as before
+    try std.testing.expect(Lanes.sharesForward(false, false, true));
+    try std.testing.expect(!Lanes.sharesForward(true, false, false)); // TF_GLM_SHARED=0
+    try std.testing.expect(!Lanes.sharesForward(true, true, true));
+    try std.testing.expect(!Lanes.sharesForward(false, true, false)); // glm_moe_dsa: alone (error.DsaSharedWindow otherwise)
+    try std.testing.expect(Lanes.sharesForward(false, true, true)); // glm_moe_dsa with its shared window
+}
+
+test "GLM dsa shared: an alone lane set tells the core one stream a round, a sharing one up to max_shared" {
+    var e: engine.Engine = undefined;
+    e.drafts = true;
+    e.drafter = null;
+    const alone: Lanes = .{ .x = .{ .e = &e, .link = undefined }, .alone = Lanes.aloneAtStart(true, false, false) }; // not asked
+    try std.testing.expect(alone.alone); // glm_moe_dsa without TF_GLM_DSA_SHARED=1 never asks the core for a shared forward
+    const fa = alone.facts();
+    try std.testing.expectEqual(@as(@TypeOf(fa.max_streams), 1), fa.max_streams);
+    try std.testing.expect(!fa.hidden_rows);
+    try std.testing.expectEqual(@as(@TypeOf(fa.batch_rows), 0), fa.batch_rows);
+    const sharing: Lanes = .{ .x = .{ .e = &e, .link = undefined }, .alone = Lanes.aloneAtStart(false, false, false) };
+    const fs = sharing.facts();
+    try std.testing.expectEqual(@as(@TypeOf(fs.max_streams), engine.max_shared), fs.max_streams);
+    try std.testing.expect(fs.hidden_rows);
+}
+
+test "GLM dsa shared: the startup rule and prompt batching keep glm_moe_dsa's prompts off shared.mixer" {
+    try std.testing.expect(Lanes.aloneAtStart(true, false, false)); // glm_moe_dsa, nothing asked
+    try std.testing.expectEqual(@import("cuda_shared.zig").dsa_built, !Lanes.aloneAtStart(true, false, true)); // asked: shared (built)
+    try std.testing.expect(Lanes.aloneAtStart(true, true, true)); // TF_GLM_SHARED=0 wins
+    try std.testing.expect(!Lanes.aloneAtStart(false, false, false)); // Flash: shared as before
+    try std.testing.expect(Lanes.aloneAtStart(false, true, false)); // TF_GLM_SHARED=0
+    try std.testing.expect(!Lanes.batchesPrompts(true));
+    try std.testing.expect(Lanes.batchesPrompts(false));
+}
+
+test "GLM dsa shared: glm_moe_dsa never batches queued prompts into one segmented pass" {
+    var e: engine.Engine = undefined;
+    e.c.dsa = true;
+    e.m.tiled = true; // the path that would otherwise batch
+    var self: Lanes = .{ .x = .{ .e = &e, .link = undefined } };
+    var a: lanes.Stream = undefined;
+    var b: lanes.Stream = undefined;
+    const ss = [_]*lanes.Stream{ &a, &b };
+    // false before any stream is read or any slot opened (the streams are undefined here)
+    try std.testing.expect(!try Lanes.prefillManyFn(@ptrCast(&self), &ss));
+}
+
+test "GLM dsa shared: a segment's scratch from its first row keeps its own token lists on glm_moe_dsa only" {
+    const dsa_block = @import("cuda_dsa_block.zig");
+    const sparse = @import("cuda_sparse.zig");
+    var l: dsa_block.Layer = undefined;
+    l.index.d = 128;
+    l.index.heads = 32;
+    l.heads = 16;
+    l.lw = 512;
+    l.rope = 64;
+    var s: dsa_block.Scratch = undefined;
+    s.lat = 1 << 20;
+    s.ikr = 2 << 20;
+    s.igr = 3 << 20;
+    s.qa = 4 << 20;
+    s.ol = 5 << 20;
+    s.qi = 6 << 20;
+    s.tokens = 7 << 20;
+    s.counts = 8 << 20;
+    const r0: usize = 5;
+    const v = dsa_block.attendScratch(l, s, r0);
+    try std.testing.expectEqual(s.tokens + r0 * sparse.dsa_width * 4, v.tokens); // [rows][dsa_width] i32, its rows
+    try std.testing.expectEqual(s.counts + r0 * 4, v.counts);
+    try std.testing.expectEqual(s.qa + r0 * l.heads * l.rowW() * 2, v.qa);
+    try std.testing.expectEqual(s, dsa_block.attendScratch(l, s, 0)); // a lone stream (row 0): the scratch as before
+    l.rope = 0; // Flash: its shared path passes each segment's lists itself; attendScratch leaves them
+    const f = dsa_block.attendScratch(l, s, r0);
+    try std.testing.expectEqual(s.tokens, f.tokens);
+    try std.testing.expectEqual(s.counts, f.counts);
+}
