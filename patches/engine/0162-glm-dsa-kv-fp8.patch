diff --git a/zig/src/families/glm/cuda_kv8_ref.zig b/zig/src/families/glm/cuda_kv8_ref.zig
index e8625ad..c65f5c9 100644
--- a/zig/src/families/glm/cuda_kv8_ref.zig
+++ b/zig/src/families/glm/cuda_kv8_ref.zig
@@ -51,3 +51,56 @@ test "GLM FP8 KV: reference handles every finite BF16 magnitude and round-even t
     var q: [1]u8 = undefined;
     try std.testing.expectError(error.NonFiniteRow, pack(&.{0x7fc0}, &q));
