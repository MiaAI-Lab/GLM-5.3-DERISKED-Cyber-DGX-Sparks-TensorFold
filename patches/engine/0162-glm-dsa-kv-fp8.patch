diff --git a/zig/kernels/cuda/glm_glue_latent.cuh b/zig/kernels/cuda/glm_glue_latent.cuh
index ab2ad0c..aafa683 100644
--- a/zig/kernels/cuda/glm_glue_latent.cuh
+++ b/zig/kernels/cuda/glm_glue_latent.cuh
@@ -189,3 +189,39 @@ extern "C" __global__ void __launch_bounds__(512)
                                const int* pos, const int* pt, int64_t ps) {
   glm_latw::write_fp8_paged(lat, stride, cache, scales, pos, pt, ps, blockIdx.x);
 }
+
+// KV=fp8 on glm_moe_dsa: one 576-wide row (512 latent + the 64 roped key) as E4M3 codes and one fp32 scale, the
+// format of the owner's 3x recipe patch 0038 (kv8.py, MiaAI-Lab/GLM-5.3-EXL3-3x-DGX-Sparks-TensorFold): the scale is
+// 2^(ceil(log2 amax) - 8) (biased exponent held to 1..254; a zero row gets 2^-126), so the row's largest value codes
+// to (128, 256] under e4m3's 448 and nothing saturates, and codes times scale are exact in bf16. A row's bytes are a
+// function of its bf16 row alone: prompt chunks and decode windows store the same bytes. 576 threads, a row a block.
+namespace glm_kv8 {
+__device__ __forceinline__ float pow2_scale(float amax, float* inv) {
+  const int bits = __float_as_int(amax);
+  int e = ((bits >> 23) & 0xFF) + ((bits & 0x7FFFFF) != 0 ? 1 : 0);
+  e = min(max(e - 8, 1), 254);
+  *inv = __int_as_float((254 - e) << 23);
+  return __int_as_float(e << 23);
+}
+}  // namespace glm_kv8
+extern "C" __global__ void __launch_bounds__(576)
+    tf_glm_lat_write_fp8_w576(const __nv_bfloat16* lat, int64_t stride, unsigned char* cache, float* scales,
+                              const int* pos) {
+  constexpr int W = 576;
+  const int64_t r = blockIdx.x, at = (int64_t)pos[0] + r;
+  const int d = threadIdx.x;
+  __shared__ float red[W / 32];
+  const float x = __bfloat162float(lat[r * stride + d]);
+  float amax = fabsf(x);
+#pragma unroll
+  for (int o = 16; o > 0; o /= 2) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+  if ((d & 31) == 0) red[d >> 5] = amax;
+  __syncthreads();
+  amax = red[0];
+#pragma unroll
+  for (int i = 1; i < W / 32; ++i) amax = fmaxf(amax, red[i]);
+  float inv;
+  const float s = glm_kv8::pow2_scale(amax, &inv);
+  cache[at * W + d] = __nv_cvt_float_to_fp8(__fmul_rn(x, inv), __NV_SATFINITE, __NV_E4M3);
+  if (d == 0) scales[at] = s;
+}
