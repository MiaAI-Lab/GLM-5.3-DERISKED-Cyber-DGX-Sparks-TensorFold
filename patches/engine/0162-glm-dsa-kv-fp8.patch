+
+/// KV=fp8 on glm_moe_dsa (tf_glm_lat_write_fp8_w576, the owner's 3x recipe patch 0038's kv8 format): a row's scale is
+/// 2^(ceil(log2 amax) - 8), its biased exponent held to 1..254, and the reciprocal its exact inverse.
+pub fn pow2Scale(amax: f32) struct { scale: f32, inv: f32 } {
+    const bits: u32 = @bitCast(amax);
+    var e: i32 = @intCast((bits >> 23) & 0xff);
+    if (bits & 0x7fffff != 0) e += 1;
+    e = std.math.clamp(e - 8, 1, 254);
+    return .{ .scale = @bitCast(@as(u32, @intCast(e)) << 23), .inv = @bitCast(@as(u32, @intCast(254 - e)) << 23) };
+}
+
+/// A bf16 row's E4M3 codes as the w576 writer stores them; returns the row's power-of-two scale.
+pub fn packPow2(row: []const u16, out: []u8) !f32 {
+    if (row.len == 0 or row.len != out.len) return error.BadRow;
+    var amax: f32 = 0;
+    for (row) |x| {
+        const v = bf(x);
+        if (!std.math.isFinite(v)) return error.NonFiniteRow;
+        amax = @max(amax, @abs(v));
+    }
+    const s = pow2Scale(amax);
+    for (row, out) |x, *slot| slot.* = code(bf(x) * s.inv);
+    return s.scale;
+}
+
+test "GLM FP8 KV: DSA power-of-two row scales code the row's max within (128, 256] and dequantize exactly in bf16" {
+    var prng = std.Random.DefaultPrng.init(0x0038);
+    const rnd = prng.random();
+    var row: [576]u16 = undefined;
+    var q: [576]u8 = undefined;
+    for (0..2000) |it| {
+        const mag: f32 = std.math.pow(f32, 2.0, @as(f32, @floatFromInt(@as(i32, @intCast(it % 40)) - 20)));
+        for (&row) |*x| x.* = bfBits((rnd.float(f32) * 2 - 1) * mag);
+        const s = try packPow2(&row, &q);
+        // a power of two
+        try std.testing.expectEqual(@as(u32, 0), @as(u32, @bitCast(s)) & 0x7fffff);
+        var amax: f32 = 0;
+        for (row) |x| amax = @max(amax, @abs(bf(x)));
+        if (amax > 0) {
+            const top = amax / s;
+            try std.testing.expect(top > 128 and top <= 256);
+        }
+        for (q) |c| {
+            const v: f32 = @floatCast(fp8.e4m3(c));
+            // codes times the scale are exact in bf16 (no rounding in the readers' dequantization)
+            try std.testing.expectEqual(v * s, bf(bfBits(v * s)));
+            try std.testing.expect(@abs(v) <= 256);
+        }
+    }
+    try std.testing.expectEqual(@as(f32, 0x1p-126), pow2Scale(0).scale);
+    try std.testing.expectEqual(@as(f32, 1.0), pow2Scale(256).scale);
+    try std.testing.expectEqual(@as(f32, 2.0), pow2Scale(256.5).scale);
+}
