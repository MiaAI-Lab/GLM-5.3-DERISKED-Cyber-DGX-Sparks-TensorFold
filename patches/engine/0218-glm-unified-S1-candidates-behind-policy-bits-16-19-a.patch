diff --git a/zig/kernels/cuda/glm_glue_l2.cuh b/zig/kernels/cuda/glm_glue_l2.cuh
new file mode 100644
index 000000000..646868c9d
--- /dev/null
+++ b/zig/kernels/cuda/glm_glue_l2.cuh
@@ -0,0 +1,51 @@
+// tf_glm_l2_paced_stop: TF_GLM_L2PF's paced site (dsv41_l2pace's paced_kernel, the same table and pacing) that also
+// stops once the main stream has written `epoch` (or later) to `stop` (U1, policy bit 16): the gather beside it has
+// ended, so the rest of the site would only contend with the window's next matmuls. Wrap-safe epoch compare.
+// Exactness: reads weight memory into L2 (cp.async.bulk.prefetch.L2) and writes nothing.
+#pragma once
+#include <stdint.h>
+
+namespace tf_glm_l2 {
+__device__ __forceinline__ uint64_t now_ns() {
+  uint64_t t;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+  return t;
+}
+__device__ __forceinline__ bool stopped(const volatile uint32_t* stop, uint32_t epoch) {
+  return static_cast<int32_t>(*stop - epoch) >= 0;
+}
+__device__ __forceinline__ void bulk_prefetch(const void* p, uint32_t bytes) {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+  asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" ::"l"(p), "r"(bytes) : "memory");
+#else
+  for (uint32_t o = 0; o < bytes; o += 128) asm volatile("prefetch.global.L2 [%0];" ::"l"((const char*)p + o));
+#endif
+}
+}  // namespace tf_glm_l2
+
+extern "C" __global__ void __launch_bounds__(32)
+    tf_glm_l2_paced_stop(const int64_t* table, int n, uint32_t chunk, uint64_t ns_per_piece, const uint32_t* stop,
+                         uint32_t epoch) {
+  if (threadIdx.x != 0) return;
+  const volatile uint32_t* st = stop;
+  const uint64_t c = blockIdx.x, g = gridDim.x;
+  const uint64_t t0 = tf_glm_l2::now_ns();
+  uint64_t k = 0;
+  for (int s = 0; s < n; s++) {
+    const uint8_t* p = reinterpret_cast<const uint8_t*>(static_cast<uintptr_t>(table[2 * s]));
+    const uint64_t bytes = static_cast<uint64_t>(table[2 * s + 1]);
+    for (uint64_t off = 0; off < bytes; off += chunk, k++) {
+      if (k % g != c) continue;
+      const uint64_t due = t0 + k * ns_per_piece;
+      while (true) {
+        if (tf_glm_l2::stopped(st, epoch)) return;
+        const uint64_t t = tf_glm_l2::now_ns();
+        if (t >= due) break;
+        const uint64_t left = due - t;
+        __nanosleep(static_cast<unsigned>(left > 2000u ? 1000u : (left > 64u ? left / 2u : 32u)));
+      }
+      const uint64_t left = bytes - off;
+      tf_glm_l2::bulk_prefetch(p + off, static_cast<uint32_t>(left < chunk ? left : chunk));
+    }
+  }
+}
diff --git a/zig/kernels/cuda/glm_mm.cu b/zig/kernels/cuda/glm_mm.cu
index 3ba5748ce..66b8cb9ed 100644
--- a/zig/kernels/cuda/glm_mm.cu
+++ b/zig/kernels/cuda/glm_mm.cu
@@ -437,6 +437,36 @@ GLM_MM_DECODE_ALL(6)
 GLM_MM_DECODE_ALL(8)
 GLM_MM_DECODE_ALL(16)
 
+// Policy bit 18 (U3a, night/unified): the 8-bit decode windows as P2 (bpairs8_fast and the stage pointers worked out
+// once a block). bpairs8_fast gives the same bf16 pairs as bpairs<8> (see it), and the loads, MMAs and FMAs are the
+// same in the same order, so every output is the same bits; only the instruction count changes.
+template <int B, int BM, int WM, int S>
+__device__ __forceinline__ void mm_two_sp(const MmTwo& p) {
+    const int b = (int)blockIdx.x, z = b >= p.blocks0 ? 1 : 0, l = b - (z ? p.blocks0 : 0), c = p.cols[z];
+    mm_kernel<B, BM, WM, S, false, true>(p.x[z], p.ldx[z], p.w[z], p.s[z], p.out[z], p.part[z], p.f32, p.M, p.N[z], p.K[z],
+                                         p.SK[z], l / c, l % c);
+}
+#define GLM_MM_DECODE_P2(S)                                                                                             \
+    extern "C" __global__ void __launch_bounds__(128) glm_mm8_16s##S##p(const __nv_bfloat16* __restrict__ x,           \
+        long long ldx, const uint32_t* __restrict__ w, const __half* __restrict__ s, void* __restrict__ out,          \
+        float* __restrict__ part, int f32, int M, int N, int K, int SK) {                                              \
+        mm_kernel<8, 16, 1, S, false, true>(x, ldx, w, s, out, part, f32, M, N, K, SK);                                \
+    }                                                                                                                  \
+    extern "C" __global__ void __launch_bounds__(128) glm_mm8_32s##S##p(const __nv_bfloat16* __restrict__ x,           \
+        long long ldx, const uint32_t* __restrict__ w, const __half* __restrict__ s, void* __restrict__ out,          \
+        float* __restrict__ part, int f32, int M, int N, int K, int SK) {                                              \
+        mm_kernel<8, 32, 1, S, false, true>(x, ldx, w, s, out, part, f32, M, N, K, SK);                                \
+    }                                                                                                                  \
+    extern "C" __global__ void __launch_bounds__(128) glm_mm8_16x2s##S##p(const MmPair p) {                            \
+        const int z = blockIdx.z;                                                                                      \
+        mm_kernel<8, 16, 1, S, false, true>(p.x[z], p.ldx, p.w[z], p.s[z], p.out[z], nullptr, p.f32, p.M, p.N, p.K, 1, 0); \
+    }                                                                                                                  \
+    extern "C" __global__ void __launch_bounds__(128) glm_mm8_16ts##S##p(const MmTwo p) { mm_two_sp<8, 16, 1, S>(p); }  \
+    extern "C" __global__ void __launch_bounds__(128) glm_mm8_32ts##S##p(const MmTwo p) { mm_two_sp<8, 32, 1, S>(p); }
+GLM_MM_DECODE_P2(5)
+GLM_MM_DECODE_P2(6)
+GLM_MM_DECODE_P2(8)
+
 // Both problems' K slices added in slice order, then rounded once: glm_mm_reduce's sums for each (x: problem 0's
 // blocks, then problem 1's; a problem of one slice has none). Dependent launch (TF_GLM_PDL_CHAIN's reduce, as
 // glm_mm_reduce): it may start while the two-problem matmul that writes `part` runs, so every thread waits for that
