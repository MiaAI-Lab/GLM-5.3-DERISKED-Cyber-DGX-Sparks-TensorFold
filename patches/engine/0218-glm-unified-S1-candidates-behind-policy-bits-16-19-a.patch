+        const f = if (skip_dead_y and wts != 0) (e.down_combine_nd orelse e.down_combine) else e.down_combine;
+        try launch_.launch(f, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(g.d / 128), .z = 1 }, .block = .{ .x = @intCast(32 * g.slots), .y = 1, .z = 1 } }, s, &cb);
