+fn fixtureProjection(plan: *Plan, layer: usize, module: []const u8, n: usize, k: usize, native: bool) !void {
+    var buf: [160]u8 = undefined;
+    const name = try std.fmt.bufPrint(&buf, "layers.{d}.{s}.", .{ layer, module });
+    if (!native) {
+        const key = try std.fmt.bufPrint(buf[name.len..], "weight", .{});
+        plan.add(buf[0 .. name.len + key.len], entry(.bf16, n, k, n * k * 2));
+        return;
+    }
+    for ([_][]const u8{ "mcg_e4m3", "trellis", "suh", "svh" }, [_]usize{ 4, n * k / 2, k * 2, n * 2 }) |part, size| {
+        @memcpy(buf[name.len..][0..part.len], part);
+        plan.add(buf[0 .. name.len + part.len], entry(.i16, n, k, size));
