+/// Walks `layers` layers' calls through the ring with a model of the device bytes (one u32 owner a 4 KiB unit): every call must find
+/// its tiles intact; returns the rebuilds. `weights_differ`: each layer has its own weights (keys), else the layers share them.
+fn walk(a: std.mem.Allocator, layers: usize, same_weights: bool, misses_per_layer: *[2]usize) !usize {
+    const unit = 4096;
+    var most: Most = .{};
+    const dense = [4][3]usize{ .{ 4096, 2048, 0 }, .{ 6144, 4096, 0 }, .{ 6144, 6144, 1 }, .{ 6144, 3072, 0 } };
+    const moe = [4][3]usize{ .{ 4096, 2048, 0 }, .{ 6144, 4096, 0 }, .{ 1024, 6144, 1 }, .{ 6144, 512, 0 } };
+    for (dense) |s| mostOf(&most, fakeProj(1, s[0], s[1], s[2] == 1));
+    for (moe) |s| mostOf(&most, fakeProj(1, s[0], s[1], s[2] == 1));
+    var ring: Ring = .{ .cap = most.ringBytes() };
+    const owner = try a.alloc(u64, ring.cap / unit + 2);
+    defer a.free(owner);
+    @memset(owner, 0);
+    var rebuilds: usize = 0;
+    for (0..layers) |l| {
+        const shapes = if (l < 3) dense else moe;
+        const before = rebuilds;
+        // q_b(h0) o(h0) q_b(h1) o(h1), shared gate|up(h0) down(h0) gate|up(h1) down(h1)
+        for ([_]usize{ 0, 1, 0, 1, 2, 3, 2, 3 }) |pi| {
+            const s = shapes[pi];
+            const id: u64 = (if (same_weights) 0 else 100 * @as(u64, l)) + pi + 1;
+            const p = fakeProj(id, s[0], s[1], s[2] == 1);
+            const key = keyOf(&p);
+            const len = entryBytes(s[0], s[1]);
+            const tag = id * 1_000_003 + p.n();
+            const off = ring.find(key, 7) orelse blk: {
+                const o = try ring.place(len);
+                for (owner[o / unit ..][0 .. len / unit]) |*u| u.* = tag; // "the rebuild writes the tiles"
+                ring.commit(key, 7, o, len);
+                rebuilds += 1;
+                break :blk o;
+            };
+            try std.testing.expect(off + len <= ring.cap);
+            for (owner[off / unit ..][0 .. len / unit]) |u| try std.testing.expectEqual(tag, u); // the tiles the GEMM reads are this projection's
+        }
+        if (l == 0) misses_per_layer[0] = rebuilds - before;
+        if (l == 5) misses_per_layer[1] = rebuilds - before;
+    }
+    return rebuilds;
+}
