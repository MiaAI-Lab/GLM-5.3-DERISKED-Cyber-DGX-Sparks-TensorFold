diff --git a/zig/src/families/glm/cuda_weight_formats.zig b/zig/src/families/glm/cuda_weight_formats.zig
new file mode 100644
index 000000000..5053b89a9
--- /dev/null
+++ b/zig/src/families/glm/cuda_weight_formats.zig
@@ -0,0 +1,111 @@
+//! Rank agreement on the effective dense weight formats of a loaded EXLR8 model.
+const std = @import("std");
+const mm = @import("cuda_mm.zig");
+const weights = @import("cuda_weights.zig");
+const Proj = @import("cuda_proj.zig").Proj;
+const X8 = @import("cuda_x8.zig").Proj;
+
+const Key = struct {
+    hash: std.hash.Wyhash,
+    packs: *const mm.Packed,
+
+    fn bf16(k: *Key, ptr: u64) void {
+        k.hash.update(&.{if (ptr == 0) 0 else k.packs.tiled(ptr, 0, 0).bits});
+    }
+
+    fn trellis(k: *Key, p: *const X8) void {
+        k.hash.update(&.{ @intCast(p.a.bits), if (p.b) |b| @intCast(b.bits) else 0 });
+    }
+
+    fn proj(k: *Key, p: Proj) void {
+        k.hash.update(&.{@backingInt(std.meta.activeTag(p))});
+        switch (p) {
+            .bf16 => |ptr| k.bf16(ptr),
+            .x8 => |x| k.trellis(x),
+            .fp8g, .mxfp8 => {}, // their format fixes the bit width
+        }
+    }
+
+    fn layer(k: *Key, l: *const weights.Layer) void {
+        k.hash.update(std.mem.asBytes(&l.index));
+        k.hash.update(&.{@backingInt(std.meta.activeTag(l.mixer))});
+        switch (l.mixer) {
+            .mla => |m| for ([_]Proj{ m.proj, m.proj_dec, m.q_b, m.o, m.index.kw, m.index.qb }) |p| k.proj(p),
+            .kda => |m| {
+                k.hash.update(&.{@backingInt(std.meta.activeTag(m.proj))});
+                k.proj(m.o);
+            },
+        }
+        k.hash.update(&.{@backingInt(std.meta.activeTag(l.ffn))});
+        switch (l.ffn) {
+            .dense => |f| {
+                k.hash.update(&.{@backingInt(std.meta.activeTag(f.w))});
+                switch (f.w) {
+                    .bf16 => |p| {
+                        k.bf16(p.gu);
+                        k.bf16(p.down);
+                    },
+                    .x8 => |p| {
+                        k.trellis(p.gu);
+                        k.trellis(p.down);
+                    },
+                    .nvfp4, .mxfp8, .fp8g => {},
+                }
+            },
+            .moe => |f| {
+                k.proj(f.shared_gu);
+                k.proj(f.shared_down);
+            },
+        }
+    }
+};
+
+/// Use layer and projection order, keeping the gate/up widths in order and ignoring rank-local addresses and sizes.
+pub fn fingerprint(w: *const weights.Weights, packs: *const mm.Packed, q8: bool) u64 {
+    var key: Key = .{ .hash = .init(0), .packs = packs };
+    key.hash.update(&.{ @intFromBool(q8), @intFromBool(w.mtp != null), @intFromBool(w.draft_head != null) });
+    key.proj(w.head);
+    for (w.layers) |*layer| key.layer(layer);
+    if (w.mtp) |*mtp| key.layer(&mtp.layer);
+    return key.hash.final();
+}
+
+fn testLayer(index: u32, shared: Proj) weights.Layer {
+    var l: weights.Layer = undefined;
+    l.index = index;
+    l.mixer = .{ .mla = undefined };
+    const m = &l.mixer.mla;
+    m.proj = .{ .bf16 = 1 };
+    m.proj_dec = .{ .bf16 = 0 };
+    m.q_b = .{ .bf16 = 1 };
+    m.o = .{ .bf16 = 1 };
+    m.index.kw = .{ .bf16 = 0 };
+    m.index.qb = .{ .bf16 = 0 };
+    l.ffn = .{ .moe = undefined };
+    l.ffn.moe.shared_gu = shared;
+    l.ffn.moe.shared_down = .{ .bf16 = 1 };
+    return l;
+}
+
+test "GLM X8: rank agreement distinguishes equal-sized formats swapped between layers or projections" {
+    const mat = @import("cuda_x8.zig").Mat;
+    const a: mat = .{ .t = 2, .suh = 3, .svh = 4, .n = 128, .k = 128, .bits = 2 };
+    var b = a;
+    b.bits = 4;
+    const x: X8 = .{ .a = a, .b = b };
+    const swapped: X8 = .{ .a = b, .b = a };
+    try std.testing.expectEqual(x.bytes(), swapped.bytes());
+
+    const dense: Proj = .{ .bf16 = 1 };
+    var layers = [_]weights.Layer{ testLayer(40, .{ .x8 = &x }), testLayer(77, dense) };
+    const w: weights.Weights = .{ .gpa = std.testing.allocator, .config = undefined, .share = undefined, .layers = &layers };
+    const p8: mm.Packed = .{ .ptrs = &.{1}, .bits = &.{8} };
+    const word = fingerprint(&w, &p8, true);
+    try std.testing.expect(word != fingerprint(&w, &p8, false));
+    try std.testing.expect(word != fingerprint(&w, &.{ .ptrs = &.{1}, .bits = &.{6} }, true));
+    layers[0].ffn.moe.shared_gu = .{ .x8 = &swapped };
+    try std.testing.expect(word != fingerprint(&w, &p8, true));
+    layers[0].ffn.moe.shared_gu = dense;
+    layers[1].ffn.moe.shared_gu = .{ .x8 = &x };
+    try std.testing.expect(word != fingerprint(&w, &p8, true));
+}
