+    ring.commit(k2, 1, 0, 500);
+    try std.testing.expectEqual(@as(usize, 500), try ring.place(500)); // fits exactly at the end
+    ring.commit(k3, 1, 500, 500);
+    try std.testing.expectEqual(@as(?usize, 0), ring.find(k2, 1));
+    try std.testing.expectEqual(@as(?usize, 500), ring.find(k3, 1));
+    try std.testing.expectError(error.X8Scratch, ring.place(1001));
+    ring.clear(); // forget: nothing stays
+    try std.testing.expectEqual(@as(?usize, null), ring.find(k2, 1));
+    try std.testing.expectEqual(@as(?usize, null), ring.find(k3, 1));
+    try std.testing.expectEqual(@as(usize, 0), try ring.place(10));
+}
+
+test "GLM X8: int8 prompt tiles only with the interim lane's packing: tiled GEMMs and 8-bit dense codes" {
+    try std.testing.expect(!q8Wanted(false, 8));
+    try std.testing.expect(!q8Wanted(true, 16));
+    try std.testing.expect(!q8Wanted(true, 4));
+    // (TF_GLM_X8_PROMPT_Q8=0 turns it off: read from the environment, not set in a test)
+    if (std.c.getenv("TF_GLM_X8_PROMPT_Q8") == null) try std.testing.expect(q8Wanted(true, 8));
+}
+
+test "GLM X8: a ring entry's bytes are the packed linear's codes and scales, 256-aligned" {
+    // glm_mm.packedBytes: codes n * k, scales n * k / 64 fp16
+    try std.testing.expectEqual(@as(usize, 6144 * 6144 + 6144 * 96 * 2), entryBytes(6144, 6144));
+    try std.testing.expectEqual(@as(usize, 0), entryBytes(6144, 6144) % 256);
+    try std.testing.expectEqual(@as(usize, 0), entryBytes(1024, 512) % 256);
+    try std.testing.expect(entryBytes(128, 64) >= 128 * 64 + 128 * 2);
+}
+
+test "GLM X8: more live entries than slots starts the ring over with the newest entry first (never a stale find)" {
+    var ring: Ring = .{ .cap = 1 << 20 };
+    var keys: [Ring.max_live + 1]Key = undefined;
+    for (&keys, 0..) |*k, i| {
+        k.* = keyOf(&fakeProj(i + 1, 128, 128, false));
+        const off = try ring.place(64);
+        ring.commit(k.*, 1, off, 64);
+        try std.testing.expectEqual(i * 64, off);
     }
+    try std.testing.expectEqual(@as(?usize, Ring.max_live * 64), ring.find(keys[Ring.max_live], 1)); // the newest kept, at its own offset
+    for (keys[0..Ring.max_live]) |k| try std.testing.expectEqual(@as(?usize, null), ring.find(k, 1));
+    try std.testing.expectEqual((Ring.max_live + 1) * 64, try ring.place(64)); // and the next entry goes after it
 }
