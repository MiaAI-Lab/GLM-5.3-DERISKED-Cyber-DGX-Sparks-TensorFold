diff --git a/zig/src/families/glm/cuda_weight_bytes.zig b/zig/src/families/glm/cuda_weight_bytes.zig
new file mode 100644
index 000000000..3b4cf7ebc
--- /dev/null
+++ b/zig/src/families/glm/cuda_weight_bytes.zig
@@ -0,0 +1,457 @@
+//! EXLR8 CUDA backbone and selected output heads sized from the same tensor headers the loader sees.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const Config = @import("config.zig").Config;
+const Share = @import("cuda_shard.zig").Share;
+const ranks = @import("cuda_ranks.zig");
+const Settings = ranks.Settings;
+const weights = @import("cuda_weights.zig");
+const mm = @import("cuda_mm.zig");
+const q4 = @import("cuda_q4.zig");
+const fp8pb = @import("cuda_fp8pb.zig");
+const Entry = core.safetensors.Entry;
+
+pub const Estimate = struct {
+    resident: u64 = 0,
+    uploaded: u64 = 0, // weights present before tiling and compaction
+    tile: u64 = 0, // the tiler's largest BF16 staging buffer, allocated before freeing any uploads
+
+    pub fn loadPeak(e: Estimate) u64 {
+        return e.uploaded + e.tile;
+    }
+
+    fn add(e: *Estimate, b: Estimate) void {
+        e.resident += b.resident;
+        e.uploaded += b.uploaded;
+        e.tile = @max(e.tile, b.tile);
+    }
+
+    fn fixed(e: *Estimate, bytes: u64) void {
+        e.add(.{ .resident = bytes, .uploaded = bytes });
+    }
+};
+
+pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, c: Config, s: Share, settings: Settings, heads: weights.Heads) !Estimate {
+    var ck = try core.Checkpoint.openModelPrefixes(gpa, io, dir, &.{ "model.language_model.", "model.", "lm_head." });
+    defer ck.close();
+    const prefix = try weights.modelPrefix(&ck);
+    const split = ranks.environment("TF_GLM_DSA_SPLIT_QKVA");
+    var plan: Plan = .init(c, s, settings, weights.embedShard(c, s.world) orelse c.hidden, !eq(split orelse "", "0"), heads);
+    var seen: std.StringHashMapUnmanaged(void) = .empty;
+    defer seen.deinit(gpa);
+    for (ck.files.items) |*file| {
+        for (file.names.keys(), file.names.values()) |name, t| {
+            // Checkpoint.get resolves a duplicate name to its first shard.
+            if ((try seen.getOrPut(gpa, name)).found_existing) continue;
+            if (eq(name, "lm_head.weight")) {
+                if (t.rank == 2) plan.head = Matrix.of(t);
+            } else if (strip(name, prefix)) |key| {
+                plan.add(key, t);
+            }
+        }
+    }
+    return plan.estimate();
+}
+
+fn eq(a: []const u8, b: []const u8) bool {
+    return std.mem.eql(u8, a, b);
+}
+
+fn strip(s: []const u8, prefix: []const u8) ?[]const u8 {
+    return if (std.mem.startsWith(u8, s, prefix)) s[prefix.len..] else null;
+}
+
+const Matrix = struct {
+    n: usize = 0,
+    k: usize = 0,
+    dtype: core.safetensors.DType = .bf16,
+
+    fn of(t: Entry) Matrix {
+        return .{ .n = t.dim(0), .k = t.dim(1), .dtype = if (t.dtype == .f16) .bf16 else t.dtype };
+    }
+
+    fn stack(a: Matrix, b: Matrix) !Matrix {
+        if (a.n == 0) return b;
+        if (b.n == 0) return a;
+        if (a.k != b.k or a.dtype != b.dtype) return error.MixedProjection;
+        return .{ .n = a.n + b.n, .k = a.k, .dtype = a.dtype };
+    }
+
+    fn size(m: Matrix, bits: u8, tiled: bool) !Estimate {
+        if (m.dtype == .f8_e4m3) {
+            const z = try fp8pb.packedSizes(m.n, m.k);
+            const bytes = z.codes + z.scales * @sizeOf(f32);
+            return .{ .resident = bytes, .uploaded = bytes };
+        }
+        const uploaded = m.n * m.k * @sizeOf(u16);
+        const sizes = mm.packedBytes(m.n, m.k, bits);
+        return .{
+            .resident = if (bits == 16) uploaded else sizes[0] + sizes[1],
+            .uploaded = uploaded,
+            .tile = if (tiled) uploaded else 0,
+        };
+    }
+};
+
+const Projection = struct {
+    dense: [3]Matrix = @splat(.{}), // primary or gate, optional up, optional down
+    native: u64 = 0,
+    marker: bool = false,
+
+    fn size(p: Projection, native: bool, bits: u8, tiled: bool) !Estimate {
+        var out: Estimate = .{};
+        if (native) {
+            out.fixed(p.native);
+        } else {
+            out.add(try (try p.dense[0].stack(p.dense[1])).size(bits, tiled));
+            out.add(try p.dense[2].size(bits, tiled));
+        }
+        return out;
+    }
+
+    fn hasDense(p: Projection) bool {
+        return p.dense[0].n != 0 or p.dense[1].n != 0 or p.dense[2].n != 0;
+    }
+};
+
+const Kind = enum { qb, o, gate, up, down, sh_gate, sh_up, sh_down };
+const kinds = std.StaticStringMap(Kind).initComptime(.{
+    .{ "self_attn.q_b_proj", .qb },
+    .{ "self_attn.o_proj", .o },
+    .{ "mlp.gate_proj", .gate },
+    .{ "mlp.up_proj", .up },
+    .{ "mlp.down_proj", .down },
+    .{ "mlp.shared_experts.gate_proj", .sh_gate },
+    .{ "mlp.shared_experts.up_proj", .sh_up },
+    .{ "mlp.shared_experts.down_proj", .sh_down },
+});
+
+const Layer = struct {
+    qb: Projection = .{},
+    o: Projection = .{},
+    mlp: Projection = .{},
+    shared: Projection = .{},
+    qkva: [2]Matrix = @splat(.{}),
+    wk: Matrix = .{},
+    iw: Matrix = .{},
+    iqb: Matrix = .{},
+    routed: [2]u64 = @splat(0), // whole and pre-sliced forms
+    routed_whole: bool = false,
+    fixed: u64 = 0,
+};
+
+const Plan = struct {
+    c: Config,
+    s: Share,
+    tiled: bool,
+    dense_bits: u8,
+    head_bits: u8,
+    heads: weights.Heads,
+    head: Matrix = .{},
+    embed_cols: usize,
+    dec: ?weights.QkvaSlice,
+    layers: [@import("config.zig").max_layers]Layer = @splat(.{}),
+    count: usize,
+    other: u64 = 0,
+
+    fn init(c: Config, s: Share, set: Settings, embed_cols: usize, split: bool, heads: weights.Heads) Plan {
+        return .{
+            .c = c,
+            .s = s,
+            .tiled = set.tiled,
+            .dense_bits = if (set.tiled) set.dense_bits else 16,
+            .head_bits = if (set.tiled) set.head_bits else 16,
+            .heads = heads,
+            .embed_cols = embed_cols,
+            .dec = if (split) weights.qkvaSlice(c.q_lora, c.q_lora + c.kv_lora + c.rope, s.world, s.rank) else null,
+            .count = if (set.layers == 0) c.layers else @min(set.layers, c.layers),
+        };
+    }
+
+    fn add(p: *Plan, key: []const u8, t: Entry) void {
+        if (eq(key, "embed_tokens.weight")) {
+            p.other += t.dim(0) * p.embed_cols * 2;
+            return;
+        }
+        if (eq(key, "norm.weight")) {
+            p.other += t.dim(0) * if (t.dtype == .f32) @as(usize, 4) else 2;
+            return;
+        }
+        const path = strip(key, "layers.") orelse return;
+        const dot = std.mem.indexOfScalar(u8, path, '.') orelse return;
+        const i = std.fmt.parseInt(u32, path[0..dot], 10) catch return;
+        if (i >= p.count) return; // An optional MTP layer only increases the load peak.
+        const name = path[dot + 1 ..];
+        const end = std.mem.lastIndexOfScalar(u8, name, '.') orelse return;
+        const field = name[end + 1 ..];
+        var module = name[0..end];
+        var pieced = false;
+        if (std.mem.lastIndexOfScalar(u8, module, '.')) |stem| {
+            if (strip(module[stem + 1 ..], "rank")) |r| {
+                const rank = std.fmt.parseInt(usize, r, 10) catch return;
+                if (rank != p.s.rank) return;
+                module = module[0..stem];
+                pieced = true;
+            }
+        }
+        const layer = &p.layers[i];
+        if (eq(name, "mlp.shared_experts.pieces")) {
+            layer.shared.marker = true;
+        } else if (strip(module, "mlp.experts.") != null) {
+            p.routed(layer, module, field, pieced, t);
+        } else if (kinds.get(module)) |kind| {
+            p.projection(layer, kind, field, pieced, t);
+        } else if (eq(name, "self_attn.kv_b_proj.weight") and t.rank == 2) {
+            // Absorb keeps both halves in BF16, including when the file holds block FP8.
+            layer.fixed += p.s.mla.len() * (p.c.nope + p.c.v_dim) * t.dim(1) * 2;
+        } else if (eq(name, "mlp.gate.weight") and p.c.isMoe(i)) {
+            layer.fixed += t.dim(0) * t.dim(1) * 2;
+        } else if (t.rank == 2 and eq(field, "weight")) {
+            if (eq(module, "self_attn.q_a_proj")) {
+                layer.qkva[0] = .of(t);
+            } else if (eq(module, "self_attn.kv_a_proj_with_mqa")) {
+                layer.qkva[1] = .of(t);
+            } else if (p.c.ifull.isSet(i)) {
+                if (eq(module, "self_attn.indexer.wk")) layer.wk = .of(t);
+                if (eq(module, "self_attn.indexer.weights_proj")) layer.iw = .of(t);
+                if (eq(module, "self_attn.indexer.wq_b")) layer.iqb = .of(t);
+            }
+        } else if (eq(name, "input_layernorm.weight") or eq(name, "post_attention_layernorm.weight")) {
+            layer.fixed += t.dim(0) * if (t.dtype == .f32) @as(usize, 4) else 2;
+        } else if (eq(name, "self_attn.q_a_layernorm.weight") or eq(name, "self_attn.kv_a_layernorm.weight") or
+            (p.c.ifull.isSet(i) and eq(module, "self_attn.indexer.k_norm")))
+        {
+            layer.fixed += t.dim(0) * 2;
+        } else if (eq(name, "mlp.gate.e_score_correction_bias") and p.c.isMoe(i)) {
+            layer.fixed += t.dim(0) * 4;
+        }
+    }
+
+    fn routed(p: *const Plan, l: *Layer, module: []const u8, field: []const u8, pieced: bool, t: Entry) void {
+        const expert = module["mlp.experts.".len..];
+        const dot = std.mem.indexOfScalar(u8, expert, '.') orelse return;
+        const id = std.fmt.parseInt(usize, expert[0..dot], 10) catch return;
+        if (id >= p.c.experts) return;
+        const proj = expert[dot + 1 ..];
+        const down = eq(proj, "down_proj");
+        if (!down and !eq(proj, "gate_proj") and !eq(proj, "up_proj")) return;
+        if (!pieced and id == 0 and eq(proj, "gate_proj") and eq(field, "trellis")) l.routed_whole = true;
+        if (eq(field, "trellis") or eq(field, "suh") or eq(field, "svh")) {
+            const sliced = eq(field, "trellis") or (if (down) eq(field, "suh") else eq(field, "svh"));
+            const bytes = t.end - t.begin;
+            l.routed[@intFromBool(pieced)] += if (pieced or !sliced) bytes else bytes * p.s.moe.len() / p.c.moe_inter;
+        }
+    }
+
+    fn projection(p: *const Plan, layer: *Layer, kind: Kind, field: []const u8, pieced: bool, t: Entry) void {
+        const f, const axis, const part, const whole = switch (kind) {
+            .qb => .{ &layer.qb, @as(usize, 0), p.s.mla.len(), p.c.mla_heads },
+            .o => .{ &layer.o, @as(usize, 1), p.s.mla.len(), p.c.mla_heads },
+            .gate, .up => .{ &layer.mlp, @as(usize, 0), p.s.dense.len(), p.c.dense_inter },
+            .down => .{ &layer.mlp, @as(usize, 1), p.s.dense.len(), p.c.dense_inter },
+            .sh_gate, .sh_up => .{ &layer.shared, @as(usize, 0), p.s.shared.len(), p.c.shared_inter },
+            .sh_down => .{ &layer.shared, @as(usize, 1), p.s.shared.len(), p.c.shared_inter },
+        };
+        if (whole == 0) return;
+        if (eq(field, "weight") and t.rank == 2 and !pieced) {
+            const at: usize = switch (kind) {
+                .up, .sh_up => 1,
+                .down, .sh_down => 2,
+                else => 0,
+            };
+            var m: Matrix = .of(t);
+            if (axis == 0) m.n = m.n * part / whole else m.k = m.k * part / whole;
+            f.dense[at] = m;
+        } else if (eq(field, "mcg_e4m3")) {
+            if (!pieced and (kind == .qb or kind == .o or kind == .gate)) f.marker = true;
+        } else if (eq(field, "trellis") or eq(field, "suh") or eq(field, "svh")) {
+            const shared = kind == .sh_gate or kind == .sh_up or kind == .sh_down;
+            if (shared != pieced) return;
+            const sliced = eq(field, "trellis") or (if (axis == 0) eq(field, "svh") else eq(field, "suh"));
+            const bytes = t.end - t.begin;
+            f.native += if (pieced or !sliced) bytes else bytes * part / whole;
+        }
+    }
+
+    fn estimate(p: *const Plan) !Estimate {
+        var e: Estimate = .{};
+        e.fixed(p.other);
+        const head = p.head;
+        if (head.n != 0) {
+            const n = p.s.vocab.len();
+            if (head.dtype == .f8_e4m3) {
+                const codes = cuda.mxfp8.padded(n) * head.k;
+                e.fixed(codes + codes / cuda.mxfp8.group);
+            } else {
+                e.add(try (Matrix{ .n = n, .k = head.k }).size(p.head_bits, p.tiled));
+            }
+            if (p.heads != .none) {
+                const draft = q4.bytes(n, head.k);
+                e.fixed(draft[0] + draft[1] + draft[2]);
+            }
+        }
+        for (p.layers[0..p.count], 0..) |l, i| {
+            e.fixed(l.fixed);
+            e.add(try l.qb.size(l.qb.marker, p.dense_bits, p.tiled));
+            e.add(try l.o.size(l.o.marker, p.dense_bits, p.tiled));
+            if (p.c.isMoe(@intCast(i))) {
+                e.fixed(l.routed[@intFromBool(!l.routed_whole)]);
+                e.add(try l.shared.size(l.shared.marker and !l.shared.hasDense(), p.dense_bits, p.tiled));
+            } else {
+                e.add(try l.mlp.size(l.mlp.marker, p.dense_bits, p.tiled));
+            }
+            e.add(try (try l.qkva[0].stack(l.qkva[1])).size(p.dense_bits, p.tiled));
+            if (p.dec) |dec| {
+                var m: Matrix = .{};
+                for (dec.parts[0..dec.n]) |part| {
+                    var cut = l.qkva[@intFromBool(part.kv)];
+                    cut.n = if (cut.n == 0) 0 else part.hi - part.lo;
+                    m = try m.stack(cut);
+                }
+                e.add(try m.size(p.dense_bits, p.tiled));
+            }
+            var wk = l.wk;
+            if (wk.dtype == .f8_e4m3) wk.dtype = .bf16; // the loader widens wk before stacking it with weights_proj
+            var iw = l.iw;
+            if (l.wk.dtype == .f8_e4m3) iw.dtype = .bf16;
+            e.add(try (try wk.stack(iw)).size(p.dense_bits, p.tiled));
+            e.add(try l.iqb.size(p.dense_bits, p.tiled));
+        }
+        return e;
