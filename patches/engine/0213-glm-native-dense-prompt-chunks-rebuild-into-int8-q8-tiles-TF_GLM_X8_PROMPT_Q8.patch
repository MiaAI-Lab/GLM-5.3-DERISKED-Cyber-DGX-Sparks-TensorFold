diff --git a/zig/kernels/cuda/exlr8_recon.cu b/zig/kernels/cuda/exlr8_recon.cu
index 696bc71a9..8b2f68217 100644
--- a/zig/kernels/cuda/exlr8_recon.cu
+++ b/zig/kernels/cuda/exlr8_recon.cu
@@ -93,3 +93,124 @@ extern "C" __global__ void __launch_bounds__(256) tf_x8_recon(const TfX8Recon a)
 
 // Shared memory one block takes.
 #define TF_X8_RECON_SMEM (128 * TF_X8_LD * 4)
+
+// ---- X17/X18: the same bf16 values without double arithmetic (tf_x8_recon_q8 below). GB10 runs FP64 at 1/64 of FP32, and tf_x8_bf16's value (v * suh * so, one nearest-even rounding)
+// took two DMULs, three conversions and a DSETP a weight. v (|v| < 2^33) * the two fp16 significands (11 bits each) is
+// an integer under 2^55: one 64-bit multiply, a clz and a nearest-even shift give the same bf16 bit for bit. Inputs
+// the integer path does not cover (a zero or non-finite scale, a result outside bf16's normal range) take the old
+// double expression, so the result is the old kernel's for every input.
+__device__ __forceinline__ unsigned short tf_x8_bf16_int(long long v, __half hs, __half hu) {
+  const unsigned bu = __half_as_ushort(hu), bs = __half_as_ushort(hs);
+  const unsigned eu = (bu >> 10) & 31, es = (bs >> 10) & 31;
+  if (eu == 0 || es == 0 || eu == 31 || es == 31 || v == 0) {  // subnormal / zero / inf / nan scales, v == 0: the old expression
+    return tf_x8_bf16((double)v * (double)__half2float(hu) * ((double)__half2float(hs) * 0x1p-16));
+  }
+  const unsigned long long mu = 1024u | (bu & 1023u), ms = 1024u | (bs & 1023u);  // value = m * 2^(e - 15 - 10)
+  const unsigned sign = ((v < 0) ? 1u : 0u) ^ (bu >> 15) ^ (bs >> 15);
+  const unsigned long long a = (unsigned long long)(v < 0 ? -v : v);
+  unsigned long long P = a * mu * ms;  // < 2^33 * 2^22
+  const int p = 63 - __clzll(P);       // leading bit
+  int e2 = (int)eu + (int)es - 30 - 20 - 16;  // value = P * 2^e2
+  unsigned long long q;
+  int shift = p - 7;
+  if (shift > 0) {
+    q = P >> shift;
+    const unsigned long long rem = P & ((1ull << shift) - 1), half = 1ull << (shift - 1);
+    if (rem > half || (rem == half && (q & 1))) ++q;
+    if (q == 256) { q = 128; ++shift; }
+  } else {
+    q = P << (-shift);
+    shift = 0 + shift;  // exact: shift <= 0 keeps every bit
+  }
+  // value = q * 2^(shift + e2), q in [128, 255]: bf16 exponent field = 127 + 7 + shift + e2
+  const int be = 127 + 7 + shift + e2;
+  if (be <= 0 || be >= 255) return tf_x8_bf16((double)v * (double)__half2float(hu) * ((double)__half2float(hs) * 0x1p-16));
+  return (unsigned short)((sign << 15) | ((unsigned)be << 7) | ((unsigned)q & 127u));
+}
+
+__device__ __forceinline__ unsigned short tf_x8_frag_k(int lane, int v) {
+  const int t = lane & 3, kt = v >> 2, j = v & 3;
+  return (unsigned short)(kt * 16 + 2 * t + (j & 1) + (j >> 1) * 8);
+}
+
+// ---- X18: prompt chunks' int8 tiles, straight from the trellis ---------------------------------------------------------
+// glm_mm8_128s2 (the interim lane's dense prompt kernel) reads a linear as int8 codes (value + 128) in glm_mm's tile order
+// with one fp16 scale per 64 inputs of an output row. The interim lane made them at load: X8's bf16 rows ->
+// cuda_qpack.quantize (fp16 absmax / 127 scale, fp32 divide, halves to even, clamp +-127) -> glm_mm_tile8. This kernel
+// writes the same bytes from the trellis in one pass: the block's 128 x 128 bf16 values are tf_x8_recon's (nearest even,
+// bit for bit), then each (output row, 64-input group) is quantised the way qpack does and stored in the tile order
+// (16 codes a lane's chunk = one 16-byte store). No bf16 rows, no second pass. The matrix may be one of a [gate | up]
+// stack: it writes rows row0.. of an n_total-row stack, row0 a multiple of 128.
+struct TfX8ReconQ { const uint8_t* t; const __half* suh; const __half* svh; uint8_t* q; __half* s; unsigned k, n, bits, row0, n_total, pad0; };
+
+#define TF_X8_Q_THREADS 512
+
+extern "C" __global__ void __launch_bounds__(TF_X8_Q_THREADS) tf_x8_recon_q8(const TfX8ReconQ a) {
+  extern __shared__ int tblk[];
+  __shared__ float scl[256];  // [group of the block][output]: the fp16 scale as fp32
+  const unsigned ob = blockIdx.x, ib = blockIdx.y, tid = threadIdx.x, warp = tid / 32, lane = tid % 32, NW = TF_X8_Q_THREADS / 32;
+  const unsigned tb = 32 * a.bits, tiles_n = a.n / 16;
+  for (unsigned t = warp; t < 64; t += NW) {
+    const unsigned tr = t / 8, tc = t % 8;
+    const uint32_t* tile = reinterpret_cast<const uint32_t*>(a.t + ((uint64_t)(8 * ib + tr) * tiles_n + 8 * ob + tc) * tb);
+    __half w[8];
+    switch (a.bits) {
+      case 2: tf_exlr8_decode<2>(tile, lane, w); break;
+      case 3: tf_exlr8_decode<3>(tile, lane, w); break;
+      default: tf_exlr8_decode<4>(tile, lane, w); break;
+    }
+    for (unsigned q = 0; q < 8; ++q) {
+      const unsigned row = 16 * tr + 2 * (lane % 4) + (q & 1) + 8 * ((q >> 1) & 1);
+      const unsigned col = 16 * tc + lane / 4 + 8 * (q >> 2);
+      tblk[row * TF_X8_LD + col] = (int)__fmul_rn(__half2float(w[q]), 512.0f);
+    }
+  }
+  __syncthreads();
+  for (unsigned r = warp; r < 128; r += NW) {
+    int v[4];
+    for (int q = 0; q < 4; ++q) v[q] = tblk[r * TF_X8_LD + lane + 32 * q];
+    tf_x8_fwht(v, lane);
+    for (int q = 0; q < 4; ++q) tblk[r * TF_X8_LD + lane + 32 * q] = v[q];
+  }
+  __syncthreads();
+  for (unsigned c = warp; c < 128; c += NW) {
+    long long v[4];
+    for (int q = 0; q < 4; ++q) v[q] = tblk[(lane + 32 * q) * TF_X8_LD + c];
+    tf_x8_fwht(v, lane);
+    const __half so = a.svh[128 * ob + c];
+    for (int q = 0; q < 4; ++q) {
+      const unsigned i = lane + 32 * q;
+      tblk[i * TF_X8_LD + c] = tf_x8_bf16_int(v[q], so, a.suh[128 * ib + i]);
+    }
+  }
+  __syncthreads();
+  const unsigned KG = a.k / 64;
+  // scales: absmax over each group of 64 inputs of an output row, fp16 of absmax / 127 (cuda_qpack.quantize)
+  for (unsigned e = tid; e < 256; e += TF_X8_Q_THREADS) {
+    const unsigned o = e & 127, gl = e >> 7;
+    float amax = 0.0f;
+    for (unsigned j = 0; j < 64; ++j) amax = fmaxf(amax, fabsf(__uint_as_float((unsigned)tblk[(gl * 64 + j) * TF_X8_LD + o] << 16)));
+    const __half s16 = __float2half_rn(__fdiv_rn(amax, 127.0f));
+    scl[e] = __half2float(s16);
+    const uint64_t row = (uint64_t)a.row0 + 128 * ob + o;
+    a.s[((row >> 3) * KG + (2 * ib + gl)) * 8 + (row & 7)] = s16;
+  }
+  __syncthreads();
+  // codes: glm_mm_tile8's chunks of this block: 16 row tiles of 8 x 2 groups of 64 x 32 lanes, 16 codes (+128) each
+  for (unsigned e = tid; e < 1024; e += TF_X8_Q_THREADS) {
+    const unsigned l = e & 31, tg = e >> 5, ttl = tg >> 1, gl = tg & 1;
+    const unsigned o = ttl * 8 + (l >> 2);
+    const float sc = scl[gl * 128 + o];
+    const uint64_t tt = (uint64_t)(a.row0 + 128 * ob) / 8 + ttl, g = 2 * ib + gl;
+    unsigned w[4] = {0, 0, 0, 0};
+#pragma unroll
+    for (int v = 0; v < 16; ++v) {
+      const float x = __uint_as_float((unsigned)tblk[(gl * 64 + tf_x8_frag_k(l, v)) * TF_X8_LD + o] << 16);
+      int c = 0;
+      if (sc != 0.0f) c = (int)fmaxf(-127.0f, fminf(127.0f, rintf(__fdiv_rn(x, sc))));
+      w[v >> 2] |= (unsigned)(c + 128) << (8 * (v & 3));
+    }
+    uint4 u; u.x = w[0]; u.y = w[1]; u.z = w[2]; u.w = w[3];
+    *reinterpret_cast<uint4*>(a.q + ((tt * KG + g) * 32 + l) * 16) = u;
+  }
+}
