diff --git a/zig/src/families/glm/cuda_start_floor.zig b/zig/src/families/glm/cuda_start_floor.zig
new file mode 100644
index 000000000..c6ba6f7b7
--- /dev/null
+++ b/zig/src/families/glm/cuda_start_floor.zig
@@ -0,0 +1,43 @@
+//! The raw host memory floor for EXLR8 startup allocations.
+const std = @import("std");
+const cuda = @import("cuda");
+const memAvailable = @import("cuda_seq_grow.zig").memAvailable;
+
+pub var bytes: u64 = 0;
+
+pub fn configured() !u64 {
+    const v = std.c.getenv("TF_GLM_START_FLOOR_MIB") orelse return 2304 << 20;
+    const n = std.fmt.parseInt(u64, std.mem.span(v), 10) catch return error.BadStartFloor;
+    return std.math.mul(u64, n, 1 << 20) catch return error.BadStartFloor;
+}
+
+pub fn availableFor(floor: u64, wanted: u64, available: ?u64) !void {
+    const free = available orelse return error.MemoryFloorUnreadable;
+    if (free < floor or wanted > free - floor) return error.MemoryFloor;
+}
+
+fn gib(n: u64) f64 {
+    return @as(f64, @floatFromInt(n)) / (1 << 30);
+}
+
+pub fn check(wanted: u64) !void {
+    if (bytes == 0 or wanted == 0) return;
+    const free = memAvailable();
+    availableFor(bytes, wanted, free) catch |err| {
+        if (free) |av| std.log.err("memory floor: {d:.2} GiB wanted, MemAvailable {d:.2} GiB, floor {d:.2} GiB", .{ gib(wanted), gib(av), gib(bytes) });
+        return err;
+    };
+}
+
+pub fn alloc(d: *const cuda.Driver, size: usize) !cuda.DeviceBuffer {
+    try check(size);
+    return cuda.DeviceBuffer.alloc(d, size);
+}
+
+test "GLM X8: raw floor counts the whole allocation and refuses a missing reading" {
+    try availableFor(2304, 4096, 6400);
+    try std.testing.expectError(error.MemoryFloor, availableFor(2304, 4096, 6399));
+    try std.testing.expectError(error.MemoryFloor, availableFor(2304, std.math.maxInt(u64), std.math.maxInt(u64)));
+    try std.testing.expectError(error.MemoryFloorUnreadable, availableFor(2304, 4096, null));
+    try check(1 << 60); // Off for other checkpoints.
+}
