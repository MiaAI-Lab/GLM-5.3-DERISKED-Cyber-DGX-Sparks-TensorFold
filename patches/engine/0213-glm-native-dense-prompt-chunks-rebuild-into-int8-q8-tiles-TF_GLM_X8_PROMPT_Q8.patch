diff --git a/zig/tests/cuda/glm_x8_q8_tests.zig b/zig/tests/cuda/glm_x8_q8_tests.zig
new file mode 100644
index 000000000..524e65a60
--- /dev/null
+++ b/zig/tests/cuda/glm_x8_q8_tests.zig
@@ -0,0 +1,456 @@
+//! X18: prompt chunks' int8 tiles built straight from the EXLR8 trellis (cuda_x8.zig promptQ8, exlr8_recon.cu tf_x8_recon_q8)
+//! against what the interim lane loads: X8's bf16 rows through cuda_qpack.quantize(8) and glm_mm_tile8, byte for byte (codes and
+//! fp16 scales), and the prompt GEMM's rows (glm_mm8_128s2) on both, byte for byte. `glm-x8-q8 DIR`: DIR from night/gr8x/x18/gpu_cases_q8.py
+//! (real rank-0 projections of layers 0, 2, 3, 40, 77). X18_RECON_CUBIN=path loads another build of exlr8_recon.cu (the mutation runs; with X18_MUTANT=1 the run also fails if every check passed).
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+const x8 = glm.x8;
+const qpack = glm.qpack;
+const mm = glm.mm;
+
+const row_counts = [_]usize{ 1, 16, 17, 557, 63, 65, 2048, 4096 }; // 1 and 16: tails the decode linear took before (finding r2-4)
+const max_rows = 4096;
+
+const Rig = struct {
+    gpu: check.Gpu,
+    s: cuda.Stream,
+    mk: *const mm.Kernels,
+    run: *x8.Run,
+    set: glm.glue.Set,
+    bufs: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    xbuf: u64 = 0,
+    x_rows: usize = 0,
+    x_k: usize = 0,
+    out: u64 = 0,
+    out2: u64 = 0,
+    part: u64 = 0,
+    compared: usize = 0, // bytes compared, all checks
+    checks: usize = 0,
+    controls: usize = 0,
+    sid: usize = 0,
+
+    fn put(r: *Rig, bytes: []const u8) !u64 {
+        const b = try cuda.DeviceBuffer.fromHost(r.gpu.d, bytes);
+        try r.bufs.append(r.gpu.gpa, b);
+        return b.ptr;
+    }
+    fn alloc(r: *Rig, len: usize) !u64 {
+        const b = try cuda.DeviceBuffer.alloc(r.gpu.d, @max(len, 256));
+        try r.bufs.append(r.gpu.gpa, b);
+        return b.ptr;
+    }
+    fn get(r: *Rig, ptr: u64, len: usize) ![]u8 {
+        try r.s.synchronize();
+        const out = try r.gpu.gpa.alloc(u8, len);
+        errdefer r.gpu.gpa.free(out);
+        const b: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = ptr, .len = len };
+        try b.download(0, out);
+        return out;
+    }
+    fn deinit(r: *Rig) void {
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(r.gpu.gpa);
+    }
+};
+
+const Case = struct {
+    name: []const u8,
+    proj: x8.Proj,
+    ref: []u16, // X8's bf16 rows [n][k] (empty for the synthetic cases)
+    n: usize,
+    k: usize,
+};
+
+fn mat(r: *Rig, t: []const u8, suh: []const u8, svh: []const u8, k: usize, n: usize) !x8.Mat {
+    const bits = t.len / (k / 16 * (n / 16) * 32);
+    return .{ .t = try r.put(t), .suh = try r.put(suh), .svh = try r.put(svh), .k = k, .n = n, .bits = @intCast(bits) };
+}
+
+fn readAll(io: std.Io, d: std.Io.Dir, a: std.mem.Allocator, name: []const u8) ![]u8 {
+    return d.readFileAlloc(io, name, a, .limited(2 << 30));
+}
+
+/// The interim lane's tiles of `ref` ([n][k] bf16): qpack.quantize(8) on the host, glm_mm_tile8 on the device. Returns the bytes (codes, scales).
+fn interim(r: *Rig, ref: []const u16, n: usize, k: usize) ![]u8 {
+    const a = r.gpu.gpa;
+    const words = try a.alloc(u32, n * k / 4);
+    defer a.free(words);
+    const scales = try a.alloc(u16, n * (k / 64));
+    defer a.free(scales);
+    qpack.quantize(8, ref, n, k, words, scales);
+    const pb = mm.packedBytes(n, k, 8);
+    const src = try r.alloc(n * k);
+    const ss = try r.alloc(n * (k / 64) * 2);
+    const dst = try r.alloc(x8.entryBytes(n, k));
+    try (cuda.DeviceBuffer{ .d = r.gpu.d, .ptr = src, .len = n * k }).upload(0, std.mem.sliceAsBytes(words));
+    try (cuda.DeviceBuffer{ .d = r.gpu.d, .ptr = ss, .len = scales.len * 2 }).upload(0, std.mem.sliceAsBytes(scales));
+    try mm.tilePacked(r.mk, r.s, 8, src, ss, dst, dst + pb[0], n, k);
+    const got = try r.get(dst, pb[0] + pb[1]);
+    return got;
+}
+
+/// x's first `rows` rows through proj by the native path (promptQ8 inside x8.matmul), into r.out.
+fn native(r: *Rig, p: *const x8.Proj, rows: usize, at: usize, wide: bool) !void {
+    try x8.matmul(r.set, r.s, p, r.xbuf + at * r.x_k * 2, r.x_k, r.out, r.part, rows, p.n(), p.k(), wide);
+}
+
+fn fillX(r: *Rig, k: usize, rows: usize, seed: u64) !void {
+    const a = r.gpu.gpa;
+    if (r.x_rows >= rows and r.x_k == k) return;
+    const h = try a.alloc(u16, rows * k);
+    defer a.free(h);
+    var prng = std.Random.DefaultPrng.init(seed);
+    for (h) |*v| v.* = @truncate(@as(u32, @bitCast(prng.random().floatNorm(f32))) >> 16);
+    if (r.xbuf == 0 or r.x_rows * r.x_k < rows * k) r.xbuf = try r.alloc(rows * k * 2);
+    try (cuda.DeviceBuffer{ .d = r.gpu.d, .ptr = r.xbuf, .len = rows * k * 2 }).upload(0, std.mem.sliceAsBytes(h));
+    r.x_rows = rows;
+    r.x_k = k;
+}
+
+/// The ring's entry for `p` (the tiles the last native call read), as bytes (codes, scales).
+fn ringBytes(r: *Rig, p: *const x8.Proj) ![]u8 {
+    const off = r.run.ring.find(x8.keyOf(p), r.sid) orelse {
+        try check.expect(false, "glm-x8-q8: no ring entry after a prompt call ({d} x {d})", .{ p.n(), p.k() });
+        unreachable;
+    };
+    const pb = mm.packedBytes(p.n(), p.k(), 8);
+    return r.get(r.run.ring_ptr + off, pb[0] + pb[1]);
+}
+
+fn sameBytes(r: *Rig, what: []const u8, name: []const u8, got: []const u8, want: []const u8) !void {
+    var buf: [200]u8 = undefined;
+    try check.sameBytes(try std.fmt.bufPrint(&buf, "glm-x8-q8 {s}: {s}", .{ name, what }), got, want);
+    r.compared += got.len;
+    r.checks += 1;
+}
+
+/// One projection: its tiles against the interim lane's, rows through both lanes.
+fn oneCase(r: *Rig, c: Case, ref_tiles: []const u8) !void {
+    const a = r.gpu.gpa;
+    const pb = mm.packedBytes(c.n, c.k, 8);
+    try fillX(r, c.k, max_rows, 18);
+    x8.forget(r.run);
+    try native(r, &c.proj, 2048, 0, false);
+    const got = try ringBytes(r, &c.proj);
+    defer a.free(got);
+    try sameBytes(r, "codes (int8 + 128, glm_mm tile order)", c.name, got[0..pb[0]], ref_tiles[0..pb[0]]);
+    try sameBytes(r, "fp16 scales", c.name, got[pb[0]..], ref_tiles[pb[0]..]);
+    // the interim lane's tiles as a Tiled linear: the same GEMM on both
+    const ref_dev = try r.alloc(x8.entryBytes(c.n, c.k));
+    try (cuda.DeviceBuffer{ .d = r.gpu.d, .ptr = ref_dev, .len = ref_tiles.len }).upload(0, ref_tiles);
+    const tiled: mm.Tiled = .{ .w = ref_dev, .n = c.n, .k = c.k, .s = ref_dev + pb[0], .bits = 8 };
+    for (row_counts) |rows| for ([_]bool{ false, true }) |wide| {
+        if (wide and rows != 2048 and rows != 65 and rows != 16) continue;
+        const sz: usize = if (wide) 4 else 2;
+        try native(r, &c.proj, rows, 0, wide);
+        const n_out = try r.get(r.out, rows * c.n * sz);
+        defer a.free(n_out);
+        try mm.matmul(r.mk, r.s, r.xbuf, c.k, tiled, r.out2, r.part, rows, wide, true);
+        const i_out = try r.get(r.out2, rows * c.n * sz);
+        defer a.free(i_out);
+        var buf: [64]u8 = undefined;
+        try sameBytes(r, try std.fmt.bufPrint(&buf, "{d} prompt rows, {s} out, native == interim lane", .{ rows, if (wide) "fp32" else "bf16" }), c.name, n_out, i_out);
+    };
+}
+
+fn load(r: *Rig, io: std.Io, d: std.Io.Dir, name: []const u8, k: usize, n_total: usize, nm: usize) !Case {
+    const a = r.gpu.gpa;
+    var mats: [2]x8.Mat = undefined;
+    for (0..nm) |i| {
+        var nb: [96]u8 = undefined;
+        const t = try readAll(io, d, a, try std.fmt.bufPrint(&nb, "{s}.m{d}.t.bin", .{ name, i }));
+        defer a.free(t);
+        const suh = try readAll(io, d, a, try std.fmt.bufPrint(&nb, "{s}.m{d}.suh.bin", .{ name, i }));
+        defer a.free(suh);
+        const svh = try readAll(io, d, a, try std.fmt.bufPrint(&nb, "{s}.m{d}.svh.bin", .{ name, i }));
+        defer a.free(svh);
+        mats[i] = try mat(r, t, suh, svh, k, n_total / nm);
+    }
+    var nb: [96]u8 = undefined;
+    const raw = try readAll(io, d, a, try std.fmt.bufPrint(&nb, "{s}.ref.bin", .{name}));
+    defer a.free(raw);
+    try check.expect(raw.len == n_total * k * 2, "glm-x8-q8 {s}: reference rows are {d} bytes, expected {d}", .{ name, raw.len, n_total * k * 2 });
+    const ref = try a.alloc(u16, n_total * k);
+    @memcpy(std.mem.sliceAsBytes(ref), raw);
+    return .{ .name = try a.dupe(u8, name), .proj = .{ .a = mats[0], .b = if (nm == 2) mats[1] else null }, .ref = ref, .n = n_total, .k = k };
+}
+
+/// A copy of `p` whose first matrix's trellis has one byte changed (the control: its tiles must differ from the reference's).
+fn mutated(r: *Rig, io: std.Io, d: std.Io.Dir, c: Case) !x8.Proj {
+    const a = r.gpu.gpa;
+    var nb: [96]u8 = undefined;
+    const t = try readAll(io, d, a, try std.fmt.bufPrint(&nb, "{s}.m0.t.bin", .{c.name}));
+    defer a.free(t);
+    t[t.len / 2 + 3] ^= 0x10;
+    var p = c.proj;
+    p.a.t = try r.put(t);
+    return p;
+}
+
+fn synthetic(r: *Rig, name: []const u8, n: usize, k: usize, stack: bool, special: bool, seed: u64) !Case {
+    const a = r.gpu.gpa;
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rnd = prng.random();
+    var mats: [2]x8.Mat = undefined;
+    const nm: usize = if (stack) 2 else 1;
+    for (0..nm) |i| {
+        const nn = n / nm;
+        const t = try a.alloc(u8, k / 16 * (nn / 16) * 128);
+        defer a.free(t);
+        rnd.bytes(t);
+        const suh = try a.alloc(u16, k);
+        defer a.free(suh);
+        const svh = try a.alloc(u16, nn);
+        defer a.free(svh);
+        for (suh) |*v| v.* = @as(u16, 0x2C00) + rnd.uintLessThan(u16, 0x1400) + (if (rnd.boolean()) @as(u16, 0x8000) else 0);
+        for (svh) |*v| v.* = @as(u16, 0x2800) + rnd.uintLessThan(u16, 0x1800) + (if (rnd.boolean()) @as(u16, 0x8000) else 0);
+        if (special) { // zero (either sign), subnormal, smallest and largest normal scales: tf_x8_bf16_int's fallbacks and the scale's overflow
+            const odd = [_]u16{ 0x0000, 0x8000, 0x0001, 0x03FF, 0x8200, 0x0400, 0x7BFF, 0xFBFF };
+            for (suh) |*v| if (rnd.uintLessThan(u8, 6) == 0) {
+                v.* = odd[rnd.uintLessThan(usize, odd.len)];
+            };
+            for (svh) |*v| if (rnd.uintLessThan(u8, 6) == 0) {
+                v.* = odd[rnd.uintLessThan(usize, odd.len)];
+            };
+        }
+        mats[i] = try mat(r, t, std.mem.sliceAsBytes(suh), std.mem.sliceAsBytes(svh), k, nn);
+    }
+    return .{ .name = name, .proj = .{ .a = mats[0], .b = if (stack) mats[1] else null }, .ref = &.{}, .n = n, .k = k };
+}
+
+/// The reference of a synthetic projection: the bf16 rebuild the native lane ran before X18 (exact, rounded once), through qpack and glm_mm_tile8.
+fn rebuiltBf16(r: *Rig, c: Case) ![]u16 {
+    const w = try r.alloc(c.n * c.k * 2);
+    try x8.rebuild(r.run, r.s, c.proj.a, w, c.k, 0);
+    if (c.proj.b) |b| try x8.rebuild(r.run, r.s, b, w, c.k, c.proj.a.n);
+    const bytes = try r.get(w, c.n * c.k * 2);
+    defer r.gpu.gpa.free(bytes);
+    const out = try r.gpu.gpa.alloc(u16, c.n * c.k);
+    @memcpy(std.mem.sliceAsBytes(out), bytes);
+    return out;
+}
+
+
+/// X18_TIME=1: the native lane's prompt linears of one layer, run in the order a 4,096-row chunk of two 2,048-row halves runs them
+/// (q_b, o_proj, q_b, o_proj | shared [gate | up], down, [gate | up], down), three ways back to back in this one process: the bf16 rebuild
+/// (TF_GLM_X8_PROMPT_Q8=0: a second Run), the int8 ring (this patch), and the interim lane's GEMM alone (glm_mm8_128s2 on the same bytes).
+/// Reports ms per layer pattern and the chunk's estimate (76 MoE-shaped layers + 3 dense MLPs).
+fn timing(r: *Rig, run_old: *x8.Run, projs: []const Case) !void {
+    const io = r.gpu.io;
+    const order = [_]usize{ 0, 1, 0, 1, 2, 3, 2, 3 };
+    var set_old = r.set;
+    set_old.x8 = run_old;
+    try fillX(r, 6144, max_rows, 18);
+    var res: [2][3]f64 = undefined; // [moe pattern, dense pattern][old, new, interim]
+    for ([2][]const usize{ &.{ 0, 1, 2, 3 }, &.{ 4, 5 } }, 0..) |idx, pat| {
+        const calls: []const usize = if (pat == 0) &order else &.{ 0, 1, 0, 1 };
+        var tiled: [4]mm.Tiled = undefined;
+        for (idx, 0..) |ci, j| { // the interim lane's tiles: the ring's bytes after one native call
+            const c = projs[ci];
+            x8.forget(r.run);
+            try x8.matmul(r.set, r.s, &c.proj, r.xbuf, c.k, r.out, r.part, 2048, c.n, c.k, false);
+            const base = r.run.ring_ptr + r.run.ring.find(x8.keyOf(&c.proj), r.sid).?;
+            const copy = try r.alloc(x8.entryBytes(c.n, c.k));
+            try r.s.d.check(r.s.d.api.cuMemcpyDtoDAsync_v2(copy, base, x8.entryBytes(c.n, c.k), r.s.handle), "cuMemcpyDtoDAsync");
+            tiled[j] = .{ .w = copy, .n = c.n, .k = c.k, .s = copy + mm.packedBytes(c.n, c.k, 8)[0], .bits = 8 };
+        }
+        res[pat] = .{ 1e30, 1e30, 1e30 };
+        for ([_]usize{ 2, 1, 0, 0, 1, 2 }) |kind| { // two rounds in opposite orders, the minimum of each: the GPU's clock ramps up in the first
+            const warm = 12;
+            const reps = 12;
+            var t0: i96 = 0;
+            for (0..warm + reps) |rep| {
+                if (rep == warm) {
+                    try r.s.synchronize();
+                    t0 = check.now(io);
+                }
+                if (kind == 1) x8.forget(r.run); // every layer has its own weights: the ring rebuilds each projection once per pattern (a ring left alone would hit)
+                for (calls, 0..) |ci, step| {
+                    const c = &projs[idx[ci]]; // (a pointer into the list: the bf16 rebuild's cache is keyed by the Proj's address)
+                    const x = r.xbuf + (step % 2) * 2048 * c.k * 2;
+                    switch (kind) {
+                        0 => try x8.matmul(set_old, r.s, &c.proj, x, c.k, r.out, r.part, 2048, c.n, c.k, false),
+                        1 => try x8.matmul(r.set, r.s, &c.proj, x, c.k, r.out, r.part, 2048, c.n, c.k, false),
+                        else => try mm.matmul(r.mk, r.s, x, c.k, tiled[ci], r.out2, r.part, 2048, false, true),
+                    }
+                }
+            }
+            try r.s.synchronize();
+            res[pat][kind] = @min(res[pat][kind], @as(f64, @floatFromInt(check.now(io) - t0)) / 1e6 / reps);
+        }
+        std.debug.print("TIME {s} pattern ({d} calls): bf16 rebuild per call {d:.1} ms, int8 ring {d:.1} ms, interim GEMM only {d:.1} ms\n", .{ if (pat == 0) "MoE layer" else "dense MLP", calls.len, res[pat][0], res[pat][1], res[pat][2] });
+    }
+    // 76 layers of the MoE pattern (layers 3-77 + q_b of the rest: 75-76), 3 dense MLP patterns
+    var tot: [3]f64 = undefined;
+    for (0..3) |k| tot[k] = 75 * res[0][k] + 3 * res[1][k];
+    std.debug.print("TIME per 4,096-row chunk of two halves (75 MoE-shaped layers + 3 dense MLPs, GEMMs and rebuilds only): bf16 rebuild {d:.0} ms, int8 ring {d:.0} ms, interim {d:.0} ms; native over interim: old +{d:.0} ms, new +{d:.0} ms (the x17 report's estimate +130-160)\n", .{ tot[0], tot[1], tot[2], tot[0] - tot[2], tot[1] - tot[2] });
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8) !void {
+    const a = gpu.gpa;
+    const io = gpu.io;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var mmod = try cuda.Module.load(gpu.d, cuda.kernels.glm_mm);
+    defer mmod.unload();
+    const mk = try mm.Kernels.load(mmod);
+    var image: []const u8 = cuda.kernels.exlr8_recon;
+    var mutant = false;
+    if (std.c.getenv("X18_RECON_CUBIN")) |p| {
+        image = try std.Io.Dir.cwd().readFileAlloc(io, std.mem.span(p), a, .limited(64 << 20));
+        mutant = if (std.c.getenv("X18_MUTANT")) |m| std.mem.eql(u8, std.mem.span(m), "1") else false;
+        std.debug.print("glm-x8-q8: exlr8_recon image {s}{s}\n", .{ std.mem.span(p), if (mutant) " (X18_MUTANT=1: a mutated build, the checks must FAIL)" else " (an nvcc-built image of the clean source: the checks must pass)" });
+    }
+    var runk = try x8.Run.loadWith(gpu.d, image);
+    defer runk.deinit();
+    runk.q8 = true;
+    var glue_dummy: glm.glue.Kernels = undefined; // the x8 prompt path reads none of it
+    var rig: Rig = .{ .gpu = gpu, .s = s, .mk = &mk, .run = &runk, .set = .{ .glue = &glue_dummy, .mm = &mk, .prompt = true, .x8 = &runk } };
+    defer rig.deinit();
+    rig.sid = @intFromPtr(s.handle);
+    const d = try std.Io.Dir.cwd().openDir(io, dir, .{});
+    const manifest = try readAll(io, d, a, "cases.txt");
+    defer a.free(manifest);
+    var cases: std.ArrayList(Case) = .empty;
+    defer cases.deinit(a);
+    var it = std.mem.tokenizeScalar(u8, manifest, '\n');
+    while (it.next()) |line| {
+        var f = std.mem.tokenizeScalar(u8, line, ' ');
+        const name = f.next().?;
+        const k = try std.fmt.parseInt(usize, f.next().?, 10);
+        const n = try std.fmt.parseInt(usize, f.next().?, 10);
+        const nm = try std.fmt.parseInt(usize, f.next().?, 10);
+        try cases.append(a, try load(&rig, io, d, name, k, n, nm));
+    }
+    // synthetic projections: TP4 rank shapes (q_b, o_proj, shared [gate | up], shared down, dense [gate | up], dense down) and two TP2 shapes
+    const S = struct { n: usize, k: usize, stack: bool, special: bool = false };
+    const syn = [_]S{
+        .{ .n = 4096, .k = 2048, .stack = false }, .{ .n = 6144, .k = 4096, .stack = false }, .{ .n = 1024, .k = 6144, .stack = true },
+        .{ .n = 6144, .k = 512, .stack = false },  .{ .n = 6144, .k = 6144, .stack = true },  .{ .n = 6144, .k = 3072, .stack = false },
+        .{ .n = 8192, .k = 2048, .stack = false }, .{ .n = 6144, .k = 8192, .stack = false },
+        .{ .n = 1024, .k = 1024, .stack = true, .special = true }, .{ .n = 512, .k = 384, .stack = false, .special = true },
+    };
+    var scases: std.ArrayList(Case) = .empty;
+    defer scases.deinit(a);
+    for (syn, 0..) |sh, i| try scases.append(a, try synthetic(&rig, "synthetic", sh.n, sh.k, sh.stack, sh.special, 1800 + i));
+    var most: x8.Most = .{};
+    for (cases.items) |c| x8.mostOf(&most, c.proj);
+    for (scases.items) |c| x8.mostOf(&most, c.proj);
+    try runk.reserve(a, most);
+    const max_n = blk: {
+        var m: usize = 0;
+        for (cases.items) |c| m = @max(m, c.n);
+        for (scases.items) |c| m = @max(m, c.n);
+        break :blk m;
+    };
+    rig.out = try rig.alloc(max_rows * max_n * 4);
+    rig.out2 = try rig.alloc(max_rows * max_n * 4);
+    rig.part = try rig.alloc(1 << 20);
+    var refs: std.ArrayList([]u8) = .empty;
+    defer refs.deinit(a);
+
+    // 1. real rank-0 projections: tiles and GEMM rows against the interim lane's
+    for (cases.items) |c| {
+        const ref_tiles = try interim(&rig, c.ref, c.n, c.k);
+        try refs.append(a, ref_tiles);
+        try oneCase(&rig, c, ref_tiles);
+        check.pass("glm-x8-q8 {s} ({d} x {d}{s}): int8 tiles + scales == the interim lane's, {d} row counts through glm_mm8_128s2 == interim", .{ c.name, c.n, c.k, if (c.proj.b != null) ", [gate | up]" else "", row_counts.len });
+    }
+    // 2. controls: a trellis byte changed -> the tiles differ from the interim's (the comparison can fail); a reference weight changed too
+    for (cases.items, 0..) |c, i| {
+        if (i % 3 != 0) continue;
+        const pb = mm.packedBytes(c.n, c.k, 8);
+        const mp = try mutated(&rig, io, d, c);
+        try fillX(&rig, c.k, max_rows, 18);
+        x8.forget(rig.run);
+        try native(&rig, &mp, 2048, 0, false);
+        const got = try ringBytes(&rig, &mp);
+        defer a.free(got);
+        try check.expect(!std.mem.eql(u8, got[0..pb[0]], refs.items[i][0..pb[0]]), "glm-x8-q8 control {s}: a changed trellis byte gave the interim lane's codes", .{c.name});
+        const ref2 = try a.dupe(u16, c.ref);
+        defer a.free(ref2);
+        ref2[ref2.len / 3] ^= 0x4000; // an exponent bit of one weight: its group's scale or code moves
+        const t2 = try interim(&rig, ref2, c.n, c.k);
+        defer a.free(t2);
+        try check.expect(!std.mem.eql(u8, t2, refs.items[i]), "glm-x8-q8 control {s}: a changed reference weight gave the same interim bytes", .{c.name});
+        rig.controls += 2;
+        check.pass("glm-x8-q8 control {s}: a changed trellis byte and a changed reference weight both fail the byte comparison", .{c.name});
+    }
+    // 3. the cache: layers 40 then 77 as a chunk of two halves runs them (q_b o q_b o | shared gu down gu down): four rebuilds a layer, every call
+    //    equal to its own interim result; a request boundary (forget) rebuilds; layers of the same shapes never read each other's tiles
+    {
+        const names = [_][]const u8{ "q_b", "o", "sh_gu", "sh_down" };
+        const suffix = [_][]const u8{ "_qb", "_o", "_sh_gu", "_sh_down" };
+        const order = [_]usize{ 0, 1, 0, 1, 2, 3, 2, 3 };
+        var before = rig.run.rebuilds;
+        x8.forget(rig.run);
+        for ([_]u32{ 40, 77, 40 }, 0..) |layer, pass_no| {
+            before = rig.run.rebuilds;
+            for (order, 0..) |pi, step| {
+                var nb: [32]u8 = undefined;
+                const want_name = try std.fmt.bufPrint(&nb, "l{d}{s}", .{ layer, suffix[pi] });
+                var ci: usize = 0;
+                while (!std.mem.eql(u8, cases.items[ci].name, want_name)) ci += 1;
+                const c = cases.items[ci];
+                const half = step % 2;
+                try fillX(&rig, c.k, max_rows, 18);
+                const pb = mm.packedBytes(c.n, c.k, 8);
+                const ref_dev = try rig.alloc(x8.entryBytes(c.n, c.k));
+                try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = ref_dev, .len = refs.items[ci].len }).upload(0, refs.items[ci]);
+                const tiled: mm.Tiled = .{ .w = ref_dev, .n = c.n, .k = c.k, .s = ref_dev + pb[0], .bits = 8 };
+                try native(&rig, &c.proj, 2048, half * 2048, false);
+                const n_out = try rig.get(rig.out, 2048 * c.n * 2);
+                defer a.free(n_out);
+                try mm.matmul(rig.mk, s, rig.xbuf + half * 2048 * c.k * 2, c.k, tiled, rig.out2, rig.part, 2048, false, true);
+                const i_out = try rig.get(rig.out2, 2048 * c.n * 2);
+                defer a.free(i_out);
+                try sameBytes(&rig, "chunk half through the per-layer cache == interim lane", want_name, n_out, i_out);
+            }
+            const made = rig.run.rebuilds - before;
+            // a layer's calls: at most four rebuilds (each projection once, however many halves); the layers after the first may find tiles
+            // another call left (the ring holds more than one MoE layer)
+            try check.expect(made <= 4, "glm-x8-q8: layer {d}: {d} rebuilds for 8 calls (at most 4 expected)", .{ layer, made });
+            if (pass_no < 2) try check.expect(made == 4, "glm-x8-q8: layer {d} (new weights): {d} rebuilds, expected 4", .{ layer, made });
+            check.pass("glm-x8-q8 cache: layer {d} {s}/{s}/{s}/{s} x2 halves: {d} rebuilds, all 8 calls == interim", .{ layer, names[0], names[1], names[2], names[3], made });
+        }
+        // another request: forget, then layer 77 again must rebuild its four
+        x8.forget(rig.run);
+        before = rig.run.rebuilds;
+        for (order, 0..) |pi, step| {
+            var nb: [32]u8 = undefined;
+            const want_name = try std.fmt.bufPrint(&nb, "l77{s}", .{suffix[pi]});
+            var ci: usize = 0;
+            while (!std.mem.eql(u8, cases.items[ci].name, want_name)) ci += 1;
+            try native(&rig, &cases.items[ci].proj, 2048, (step % 2) * 2048, false);
+        }
+        try check.expect(rig.run.rebuilds - before == 4, "glm-x8-q8: after forget: {d} rebuilds, expected 4", .{rig.run.rebuilds - before});
+        check.pass("glm-x8-q8 cache: after a request boundary (forget) layer 77's four projections rebuild once each", .{});
+    }
+    // 4. synthetic TP4 (and two TP2) shapes: the native lane's old bf16 rebuild (exact) through qpack and tile8 == the fused int8 tiles
+    for (scases.items) |c| {
+        const rows16 = try rebuiltBf16(&rig, c);
+        defer a.free(rows16);
+        const ref_tiles = try interim(&rig, rows16, c.n, c.k);
+        defer a.free(ref_tiles);
+        x8.forget(rig.run);
+        try fillX(&rig, c.k, max_rows, 18);
+        try native(&rig, &c.proj, 2048, 0, false);
+        const got = try ringBytes(&rig, &c.proj);
+        defer a.free(got);
+        var buf: [48]u8 = undefined;
+        const nm = try std.fmt.bufPrint(&buf, "synthetic {d}x{d}{s}", .{ c.n, c.k, if (c.proj.b != null) " [gate | up]" else "" });
+        try sameBytes(&rig, "random trellis and scales: fused tiles == bf16 rebuild + qpack + tile8", nm, got, ref_tiles[0..got.len]);
+        check.pass("glm-x8-q8 {s}: fused int8 tiles + scales == the bf16 rebuild's through qpack.quantize + glm_mm_tile8 ({d} bytes)", .{ nm, got.len });
+    }
+    if (std.c.getenv("X18_TIME") != null) {
+        var old = try x8.Run.loadWith(gpu.d, image);
+        defer old.deinit();
+        try old.reserve(a, most); // q8 false: the bf16 rows and tiles
+        try timing(&rig, &old, scases.items);
+    }
+    for (refs.items) |b| a.free(b);
+    try check.expect(!mutant, "glm-x8-q8: a MUTATED kernel image passed every check ({d} comparisons): the test cannot see the mutation", .{rig.checks});
+    check.pass("glm-x8-q8: {d} byte comparisons ({d} bytes) equal, {d} controls differ, {d} real projections + {d} synthetic shapes", .{ rig.checks, rig.compared, rig.controls, cases.items.len, scases.items.len });
+}
