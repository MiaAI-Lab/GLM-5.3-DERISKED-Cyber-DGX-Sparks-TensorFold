+        const head: Matrix = .{ .n = s.vocab.len(), .k = c.hidden };
+        const qkv = try (Matrix{ .n = 2624, .k = 6144 }).size(8, true);
+        const dec = try (Matrix{ .n = 704, .k = 6144 }).size(8, true);
+        const kw = try (Matrix{ .n = 160, .k = 6144 }).size(8, true);
+        const iqb = try (Matrix{ .n = 4096, .k = 2048 }).size(8, true);
+        plan.other = 94_743_811_584 - c.layers * (qkv.resident + dec.resident) -
+            21 * (kw.resident + iqb.resident) - (try head.size(8, true)).resident;
+        plan.head = head;
+        for (0..c.layers) |i| {
+            plan.layers[i].qkva = .{ .{ .n = 2048, .k = 6144 }, .{ .n = 576, .k = 6144 } };
+            if (i < 21) {
+                plan.layers[i].wk = .{ .n = 128, .k = 6144 };
+                plan.layers[i].iw = .{ .n = 32, .k = 6144 };
+                plan.layers[i].iqb = .{ .n = 4096, .k = 2048 };
+            }
+            try fixtureProjection(&plan, i, "self_attn.q_b_proj", 16384, 2048, case.native and i != 0 and i != 2);
+            try fixtureProjection(&plan, i, "self_attn.o_proj", 6144, 16384, case.native and i != 0 and i != 2 and i != 3);
+            if (i < c.dense_layers) {
