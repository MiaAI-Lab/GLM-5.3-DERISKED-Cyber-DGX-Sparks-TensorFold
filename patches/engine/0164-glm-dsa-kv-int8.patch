+// Two cache codes (little-endian u16) as floats: E4M3, or (I8, TF_GLM_KV8_INT8) two's-complement int8. Either way the
+// row's power-of-two scale times a code is exact in bf16.
+template <bool I8>
+__device__ __forceinline__ float2 codes2(uint16_t bits) {
+  if constexpr (I8) return make_float2((float)(int8_t)(bits & 0xff), (float)(int8_t)(bits >> 8));
+  else return __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(bits, __NV_E4M3)));
+}
