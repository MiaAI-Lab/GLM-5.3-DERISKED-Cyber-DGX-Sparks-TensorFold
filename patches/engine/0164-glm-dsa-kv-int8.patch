index aafa683..f12c9e2 100644
--- a/zig/kernels/cuda/glm_glue_latent.cuh
+++ b/zig/kernels/cuda/glm_glue_latent.cuh
@@ -225,3 +225,37 @@ extern "C" __global__ void __launch_bounds__(576)
   cache[at * W + d] = __nv_cvt_float_to_fp8(__fmul_rn(x, inv), __NV_SATFINITE, __NV_E4M3);
   if (d == 0) scales[at] = s;
 }
+
+// TF_GLM_KV8_INT8=1: the same rows as int8 codes, two scales a row ([cap][2] fp32: the 512 latent values', the 64 rope
+// values'; k_pe is not normalized and would otherwise set the latent's step), each 2^ceil(log2(amax / 127)) (biased
+// exponent held to 1..254): codes round(x / scale) within +-127, codes times scale exact in bf16 (7 significant bits).
+extern "C" __global__ void __launch_bounds__(576)
+    tf_glm_lat_write_i8_w576(const __nv_bfloat16* lat, int64_t stride, unsigned char* cache, float* scales,
+                             const int* pos) {
+  constexpr int W = 576;
+  const int64_t r = blockIdx.x, at = (int64_t)pos[0] + r;
+  const int d = threadIdx.x;
+  __shared__ float red[W / 32];
+  const float x = __bfloat162float(lat[r * stride + d]);
+  float amax = fabsf(x);
+#pragma unroll
+  for (int o = 16; o > 0; o /= 2) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+  if ((d & 31) == 0) red[d >> 5] = amax;
+  __syncthreads();
+  // two scales: the 512 latent values' (warps 0..15) and the 64 rope values' (warps 16, 17)
+  if (d < 512) {
+    amax = red[0];
+#pragma unroll
+    for (int i = 1; i < 16; ++i) amax = fmaxf(amax, red[i]);
+  } else {
+    amax = fmaxf(red[16], red[17]);
+  }
+  const int bits = __float_as_int(__fdiv_rn(amax, 127.0f));
+  int e = ((bits >> 23) & 0xFF) + ((bits & 0x7FFFFF) != 0 ? 1 : 0);
+  e = min(max(e, 1), 254);
+  const float s = __int_as_float(e << 23), inv = __int_as_float((254 - e) << 23);
+  const int q = max(-127, min(127, __float2int_rn(__fmul_rn(x, inv))));
+  cache[at * W + d] = (unsigned char)(int8_t)q;
+  if (d == 0) scales[2 * at] = s;
+  if (d == 512) scales[2 * at + 1] = s;
+}
