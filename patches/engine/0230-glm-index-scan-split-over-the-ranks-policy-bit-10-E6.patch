+        };
+    }
+    std.debug.print("GLM scan split GPU: {d} shapes, {d} splits identical (scores, lists, counts), {d} below bit 3's rule (scores only), {d} under the default rule, {d} rank scans on many CTAs\n", .{ cases, splits, below, ruled, scanned });
+    try std.testing.expect(cases == 160 and splits > 0 and ruled > 0 and scanned > 0);
+}
