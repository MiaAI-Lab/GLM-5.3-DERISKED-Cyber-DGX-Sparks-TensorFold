+                    return e;
+                };
+                try std.testing.expectEqualSlices(u8, ref_cnt[0 .. rows * 4], out_cnt[0 .. rows * 4]);
+                splits += 1;
+                const all = policy.bit(.rope_hoist) | policy.bit(.topk_multi_cta) | policy.bit(.index_scan_split);
