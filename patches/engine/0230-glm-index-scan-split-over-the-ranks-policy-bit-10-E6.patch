diff --git a/zig/kernels/cuda/glm_dsa_topk_multi.cuh b/zig/kernels/cuda/glm_dsa_topk_multi.cuh
index cdb9659d4..f7f28a40e 100644
--- a/zig/kernels/cuda/glm_dsa_topk_multi.cuh
+++ b/zig/kernels/cuda/glm_dsa_topk_multi.cuh
@@ -188,3 +188,241 @@ extern "C" __global__ void __launch_bounds__(glm_dsel::T2)
   }
   if (PATH != nullptr && t == 0) PATH[r] = path;
 }
+
+// Policy bit 10 (index_scan_split, with bits 2 and 3): a decode window's scan split over the ranks, the keys
+// replicated. Rank r of W scores only its 64-key blocks [kb0, kb1) (cuda_sparse.scanBlocks; tf_glm_dsa_scores_roped's
+// first block) and picks within them: each row's range [kb0 64, kb1 64) clipped to its NP (tf_glm_dsa_tscan's range).
+// tf_glm_dsa_rscan / tf_glm_dsa_rmerge are tf_glm_dsa_tscan / tf_glm_dsa_tmerge over that range (positions absolute:
+// the bit words at the same places, the floor sampled in the range) and write the range's best min(K, its keys) as the
+// rank's candidates: [rows][K] positions ascending, then [rows][K] their order keys, padded to K with position -1 and
+// key 0. tf_glm_dsa_smerge takes the W ranks' candidate blocks gathered in rank order (the ranges ascend with the rank,
+// so the lists meet in position order) and selects the K best by key, ties to the lower position: every pick of the
+// whole row is among its range's K best (fewer than K keys of the row come before it, so fewer of its range do), and
+// the K-th best of the candidates is the row's. The lists and counts are tf_glm_dsa_tmerge's, byte for byte.
+namespace glm_dsa_multi {
+
+// Row r's part of the range [kb0 64, kb1 64): [lo, hi) clipped to its NP (hi <= lo: none).
+__device__ __forceinline__ void row_range(int64_t np, const int* pos, int64_t r, int K, int64_t kb0, int64_t kb1,
+                                          int& lo, int& hi) {
+  const int NP = row_limit(np, pos, r, K);
+  lo = (int)min((int64_t)NP, kb0 * 64);
+  hi = (int)min((int64_t)NP, kb1 * 64);
+}
+
+// A row's scores from position `off`: RowSrc's keys, positions absolute.
+struct RowFrom {
+  glm_dsel::RowSrc s;
+  int off;
+  __device__ __forceinline__ void keys8(int i0, uint32_t (&u)[glm_dsel::PER]) const { s.keys8(i0, u); }
+  __device__ __forceinline__ int64_t pool(int i) const { return off + i; }
+};
+
+// Row r's candidates of the W gathered blocks (block b: [rows][K] positions, then [rows][K] keys), in block order.
+struct Gathered {
+  const int* g;
+  int64_t rows, r;
+  int K, n;
+  __device__ __forceinline__ int64_t at(int i) const { return (int64_t)(i / K) * 2 * rows * K + r * K + i % K; }
+  __device__ __forceinline__ void keys8(int i0, uint32_t (&u)[glm_dsel::PER]) const {
+#pragma unroll
+    for (int j = 0; j < glm_dsel::PER; ++j) u[j] = i0 + j < n ? (uint32_t)g[at(i0 + j) + rows * K] : 0u;
+  }
+  __device__ __forceinline__ int64_t pool(int i) const { return g[at(i)]; }
+};
+
+}  // namespace glm_dsa_multi
+
+// tf_glm_dsa_tscan over row r's range [lo, hi): grid (cdiv(the last row's hi - lo, SPAN), R); rows whose range holds
+// at most CAP keys mark nothing.
+extern "C" __global__ void __launch_bounds__(glm_dsel::T1)
+    tf_glm_dsa_rscan(const float* S, int64_t np, const int* pos, int K, int target, uint32_t* __restrict__ bits,
+                     int64_t words, int64_t kb0, int64_t kb1) {
+  glm_triton::pdl_enter();
+  using namespace glm_dsel;
+  __shared__ int hist[256];
+  __shared__ uint32_t sh_prefix;
+  __shared__ int sh_need;
+  const int64_t r = blockIdx.y;
+  int lo, hi;
+  glm_dsa_multi::row_range(np, pos, r, K, kb0, kb1, lo, hi);
+  const int M = hi - lo;
+  const int64_t p0 = lo + (int64_t)blockIdx.x * SPAN;
+  if (M <= glm_dsa_multi::CAP || p0 >= hi) return;
+  const float* row = S + r * np;
+  const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+  // The floor: the need-th largest of the range's sampled keys. Speed only: the merge's counts decide.
+  constexpr int PT = NS8 / T1;
+  uint32_t u[PT];
+#pragma unroll
+  for (int j = 0; j < PT; ++j) {
+    const int s = t + j * T1;
+    const int64_t i = lo + (int64_t)(s / 8) * M / (NS8 / 8) / 8 * 8 + s % 8;
+    u[j] = order_key(i < hi ? row[i] : 0.0f);
+  }
+  uint32_t prefix = 0, fixed = 0;
+  int need = max((int)((int64_t)target * NS8 / M), 1);
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    hist[t] = 0;  // T1 == 256 bins
+    __syncthreads();
+#pragma unroll
+    for (int j = 0; j < PT; ++j) hist_add(hist, (u[j] & fixed) == prefix ? (int)((u[j] >> shift) & 0xFF) : 256);
+    __syncthreads();
+    if (warp == 0) digit_of(hist, need, prefix, shift, &sh_prefix, &sh_need);
+    __syncthreads();
+    prefix = sh_prefix;
+    need = sh_need;
+    fixed |= 0xFFu << shift;
+  }
+  const uint32_t fl = prefix;
+  // The span's words (lo is a multiple of 64: whole words), a warp's every 8th: its tokens above and at the floor.
+  constexpr int WARPS = T1 / 32, WPW = SPAN / 32 / WARPS;
+  const int64_t w0 = p0 / 32;
+  const int nwc = (int)min((int64_t)(SPAN / 32), ((int64_t)hi + 31) / 32 - w0);
+  float v[WPW];
+#pragma unroll
+  for (int m = 0; m < WPW; ++m) {
+    const int wi = warp + m * WARPS;
+    const int64_t i = (w0 + wi) * 32 + lane;
+    v[m] = wi < nwc && i < hi ? row[i] : 0.0f;
+  }
+  uint32_t* gt = bits + r * 2 * words;
+#pragma unroll
+  for (int m = 0; m < WPW; ++m) {
+    const int wi = warp + m * WARPS;
+    const int64_t i = (w0 + wi) * 32 + lane;
+    const bool in = wi < nwc && i < hi;
+    const uint32_t k = order_key(v[m]);
+    const unsigned g = __ballot_sync(0xffffffffu, in && k > fl), e = __ballot_sync(0xffffffffu, in && k == fl);
+    if (lane == 0 && wi < nwc) {
+      gt[w0 + wi] = g;
+      gt[words + w0 + wi] = e;
+    }
+  }
+}
+
+// tf_glm_dsa_tmerge over row r's range [lo, hi), into this rank's candidates `cand` ([rows][K] positions, then
+// [rows][K] keys; see above); grid (R), dynamic shared memory sizeof(glm_dsa_multi::Merge).
+extern "C" __global__ void __launch_bounds__(glm_dsel::T2)
+    tf_glm_dsa_rmerge(const float* S, int* __restrict__ cand, int64_t np, const int* pos, int K, const uint32_t* bits,
+                      int64_t words, int64_t kb0, int64_t kb1, int64_t rows) {
+  glm_triton::pdl_enter();
+  using namespace glm_dsel;
+  extern __shared__ __align__(16) unsigned char dsm[];
+  glm_dsa_multi::Merge& sm = *reinterpret_cast<glm_dsa_multi::Merge*>(dsm);
+  constexpr int CAP = glm_dsa_multi::CAP;
+  const int64_t r = blockIdx.x;
+  int lo, hi;
+  glm_dsa_multi::row_range(np, pos, r, K, kb0, kb1, lo, hi);
+  const int M = max(hi - lo, 0), kk = min(K, M);
+  const float* row = S + r * np;
+  int* out = cand + r * K;
+  uint32_t* keys = reinterpret_cast<uint32_t*>(cand + rows * K) + r * K;
+  const int t = threadIdx.x;
+  const glm_dsa_multi::RowFrom whole{{row + lo, M, (reinterpret_cast<uintptr_t>(row + lo) & 15) == 0}, lo};
+  if (M <= CAP) {
+    if (M > 0) select_core<T2>(sm.sel, whole, M, K, out);
+  } else {
+    const uint32_t* gt = bits + r * 2 * words;
+    const uint32_t* eq = gt + words;
+    const int wlo = lo / 32, nw = (hi + 31) / 32 - wlo, per = (nw + T2 - 1) / T2;
+    const int wa = wlo + min(nw, t * per), wb = wlo + min(nw, (wa - wlo) + per);  // this thread's words, in order
+    int cg = 0, ce = 0;
+    for (int w = wa; w < wb; ++w) {
+      cg += __popc(gt[w]);
+      ce += __popc(eq[w]);
+    }
+    int n_gt, n_eq;
+    const int gt_before = block_scan<T2>(cg, sm.sel.wsum, 0, &n_gt);
+    const int eq_before = block_scan<T2>(ce, sm.sel.wsum, 1, &n_eq);
+    const int n_ge = n_gt + n_eq;
+    if (n_gt < K && K <= n_ge) {
+      // The K-th best key is the floor: every gt token, and the eq tokens of eq rank under K - n_gt, in position order.
+      const int need = K - n_gt;
+      int seen = eq_before, cs = 0;
+      for (int w = wa; w < wb; ++w) {
+        const uint32_t e = eq[w];
+        uint32_t take = 0, m = e;
+        for (int q = min(__popc(e), max(0, need - seen)); q > 0; --q) {
+          take |= m & (0u - m);
+          m &= m - 1;
+        }
+        cs += __popc(gt[w] | take);
+        seen += __popc(e);
+      }
+      int all;
+      int at = block_scan<T2>(cs, sm.sel.wsum, 0, &all);
+      seen = eq_before;
+      for (int w = wa; w < wb; ++w) {
+        const uint32_t e = eq[w];
+        uint32_t take = 0, m = e;
+        for (int q = min(__popc(e), max(0, need - seen)); q > 0; --q) {
+          take |= m & (0u - m);
+          m &= m - 1;
+        }
+        seen += __popc(e);
+        for (uint32_t s = gt[w] | take; s != 0; s &= s - 1) out[at++] = w * 32 + (__ffs(s) - 1);
+      }
+    } else if ((K <= n_ge && n_ge <= CAP) || (K <= n_gt && n_gt <= CAP)) {
+      // Every token at or above the floor (or above it, when those hold K) in position order: the K best are in them.
+      const bool with_eq = n_ge <= CAP;
+      const int n = with_eq ? n_ge : n_gt;
+      int at = with_eq ? gt_before + eq_before : gt_before;
+      for (int w = wa; w < wb; ++w)
+        for (uint32_t s = gt[w] | (with_eq ? eq[w] : 0u); s != 0; s &= s - 1) sm.idx[at++] = w * 32 + (__ffs(s) - 1);
+      __syncthreads();
+      for (int c = t; c < n; c += T2) sm.key[c] = order_key(row[sm.idx[c]]);
+      __syncthreads();
+      select_core<T2>(sm.sel, CandSrc{sm.key, sm.idx, n}, n, K, out);
+    } else {
+      select_core<T2>(sm.sel, whole, M, K, out);
+    }
+  }
+  __syncthreads();  // every pick written: then their keys, and the padding
+  for (int j = t; j < K; j += T2) {
+    const int p = j < kk ? out[j] : -1;
+    keys[j] = j < kk ? order_key(row[p]) : 0u;
+    out[j] = p;
+  }
+}
+
+// The W ranks' candidates (gathered: W blocks of tf_glm_dsa_rmerge's [rows][K] positions and keys, in rank order) of
+// row r into its list out [R][K] int32 ascending and counts [R] (tf_glm_dsa_tmerge's: K past the all-visible prefix, 0
+// within); grid (R), world <= 64. A row of at most K candidates (its NP under K: tf_glm_dsa_tmerge's whole select
+// writes NP picks and leaves the rest) takes them all in order; past K, the select over every slot: padding (key 0)
+// never outranks a key (order_key is never 0 for a score), so it is never picked.
+extern "C" __global__ void __launch_bounds__(glm_dsel::T2)
+    tf_glm_dsa_smerge(const int* gathered, int64_t rows, int K, int world, const int* pos, int* __restrict__ OUT,
+                      int* __restrict__ counts) {
+  glm_triton::pdl_enter();
+  using namespace glm_dsel;
+  __shared__ Sel<T2> sel;
+  __shared__ int held[64];  // each rank's candidates of the row: its list's length before the padding
+  const int64_t r = blockIdx.x;
+  const int t = threadIdx.x;
+  if (t == 0) {
+    const int64_t n = (int64_t)pos[0] + r + 1;
+    counts[r] = n > K ? K : 0;
+  }
+  const glm_dsa_multi::Gathered src{gathered, rows, r, K, world * K};
+  if (t < world) {
+    const int* p = gathered + (int64_t)t * 2 * rows * K + r * K;
+    int a = 0, b = K;
+    while (a < b) {
+      const int m = (a + b) >> 1;
+      if (p[m] >= 0) a = m + 1; else b = m;
+    }
+    held[t] = a;
+  }
+  __syncthreads();
+  int total = 0;
+  for (int b = 0; b < world; ++b) total += held[b];
+  if (total <= K) {
+    for (int i = t; i < total; i += T2) {
+      int b = 0, j = i;
+      while (j >= held[b]) j -= held[b++];
+      OUT[r * K + i] = gathered[(int64_t)b * 2 * rows * K + r * K + j];
+    }
+    return;
+  }
+  select_core<T2>(sel, src, world * K, K, OUT + r * K);
+}
diff --git a/zig/kernels/cuda/glm_glue_attn.cuh b/zig/kernels/cuda/glm_glue_attn.cuh
index 95a1555a0..337334510 100644
--- a/zig/kernels/cuda/glm_glue_attn.cuh
+++ b/zig/kernels/cuda/glm_glue_attn.cuh
@@ -1090,12 +1090,13 @@ extern "C" __global__ void __launch_bounds__(128)
 // here is that private scratch; `inv` unused, kept for the same arguments). Its code line for line but for the rope
 // block and its two barriers: the shared rows hold the same bf16 values the in-place rope leaves, so the fragments,
 // dots, scale, ReLU, head weights and reduction see the same values. (A copy, not a template: tf_glm_dsa_scores
-// keeps its own SASS.)
+// keeps its own SASS.) `kb0`: the first key block (0: every block; policy bit 10, index_scan_split: a rank's blocks
+// [kb0, nb), grid.y over them alone). A key's score does not depend on which CTA or loop step takes its block.
 extern "C" __global__ void __launch_bounds__(128)
     tf_glm_dsa_scores_roped(const __nv_bfloat16* qi, const __nv_bfloat16* wts, int64_t w_stride,
                             const __nv_bfloat16* ik,
                             float* out, const int* pos, int64_t np, int64_t nb, float scale, float wscale,
-                            int64_t heads, int loop, const float* inv) {
+                            int64_t heads, int loop, const float* inv, int64_t kb0) {
   glm_triton::pdl_enter();
   constexpr int D = 128, HP = 32, BP = 64;
   __shared__ __align__(16) __nv_bfloat16 sm[4 * 2 * 16 * D];  // q's 32 rows (roped), then each warp's two 16-key buffers
@@ -1124,7 +1125,7 @@ extern "C" __global__ void __launch_bounds__(128)
       glm_attn::cp16(sm + (warp * 2 + buf) * 16 * D + at(row, u), src + (ok ? row : 0) * D + u * 8, ok);
     }
   };
-  const int64_t first = (int64_t)blockIdx.y * loop;
+  const int64_t first = kb0 + (int64_t)blockIdx.y * loop;
   // Blocks that score: those under nb with visible keys (pb * BP < n); the rest only write -inf.
   auto live = [&](int j) { const int64_t pb = first + j; return j < loop && pb < nb && pb * BP < n; };
   glm_attn::wait<0>();
