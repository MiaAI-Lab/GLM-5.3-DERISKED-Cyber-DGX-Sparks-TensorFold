+/// TF_GLM_EXL3_BF16_SLOTS=1: a prompt chunk's fused EXL3 experts write bf16 slot rows (an NVFP4 chunk's form; half the
+/// slot-row bytes the down kernel writes and the combine reads), not fp32. Different numerics: opt-in.
+pub fn bf16Slots() bool {
+    const S = struct {
+        var once: ?bool = null;
+    };
+    if (S.once) |v| return v;
+    const v = if (std.c.getenv("TF_GLM_EXL3_BF16_SLOTS")) |e| std.mem.eql(u8, std.mem.span(e), "1") else false;
+    S.once = v;
+    return v;
+}
+/// Whether a prompt chunk of `w`'s experts leaves bf16 slot rows (the fused prompt kernels, under bf16Slots).
+pub fn promptBf16(w: Experts, count: usize, dims: usize, width: usize) bool {
+    return bf16Slots() and common.prompt.eligible(layer(w, count, dims, width, 0));
+}
 pub fn run(k: *const Kernels, ek: *const experts.Kernels, stream: cuda.Stream, w: Experts, sc: Scratch, plan_buf: cuda.grouped.Plan, x: u64, x_stride: usize, picks: u64, slots: usize, rows: usize, count: usize, dims: usize, width: usize, limit: f32, prompt: bool, ey: u64, xd: u64) !void {
