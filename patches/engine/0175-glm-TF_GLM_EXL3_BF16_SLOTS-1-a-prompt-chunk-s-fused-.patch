+/// The slot rows' form: bf16 in an NVFP4 prompt chunk (and an EXL3 one under TF_GLM_EXL3_BF16_SLOTS), else fp32.
+fn bf16Rows(l: Layer, prompt: bool) bool {
+    if (!prompt) return false;
+    const w = l.exl3 orelse return true;
+    return exl3.promptBf16(w, l.count, l.routed.dims, l.routed.width);
+}
