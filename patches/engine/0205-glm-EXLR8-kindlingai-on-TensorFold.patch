diff --git a/zig/tests/exl3_e4m3_sites_check.cu b/zig/tests/exl3_e4m3_sites_check.cu
new file mode 100644
index 000000000..54c8307fb
--- /dev/null
+++ b/zig/tests/exl3_e4m3_sites_check.cu
@@ -0,0 +1,44 @@
+// X8 (patch 0205 part 2): in a build with TF_EXL3_MCG_E4M3=1 (the exl3_experts_e4m3 image), every mcg decode site the
+// experts module uses gives EXLR8's values: decode2<CB_MCG> (exl3_decode.cuh, the generic and grouped paths),
+// decode2_mcg (exl3_grouped.cuh, the masked read-once path) and mcg2 (exl3_prompt.cuh, the prompt LOP3 path) each equal
+// exlr8.cu's tf_exlr8_pair for all 65,536 states in both slots (two partners a state). Build with
+// -DTF_EXL3_MCG_E4M3=1; built without it the same checks must fail (the control: the sites are then plain mcg).
+// nvcc -O2 -std=c++17 --expt-relaxed-constexpr -arch=sm_121 -I kernels/cuda [-DTF_EXL3_MCG_E4M3=1] tests/exl3_e4m3_sites_check.cu
+#include <cstdio>
+#include <cstdlib>
+#include "exl3_experts.cu"  // the experts module as built (its grouped and prompt headers in their context)
+#include "exlr8.cu"
+
+__global__ void sites(unsigned* bad) {
+    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= 65536) return;
+    const unsigned partners[2] = {i ^ 0xA5A5u, __brev(i) >> 16};
+    for (unsigned p : partners) {
+        for (int slot = 0; slot < 2; ++slot) {
+            const unsigned s0 = slot ? p : i, s1 = slot ? i : p;
+            const __half2 r = tf_exlr8_pair(s0, s1);
+            const uint32_t want = *reinterpret_cast<const uint32_t*>(&r);
+            if (tf_exl3::decode2<tf_exl3::CB_MCG>(s0, s1) != want) atomicAdd(&bad[0], 1u);
+            if (tf_exl3::decode2_mcg(s0, s1, 0x8FFF8FFFu) != want) atomicAdd(&bad[1], 1u);
+            if (tf_exl3_prompt::mcg2(s0, s1) != want) atomicAdd(&bad[2], 1u);
+        }
+    }
+}
+
+int main() {
+    unsigned* d;
+    unsigned h[3] = {0, 0, 0};
+    if (cudaMalloc(&d, sizeof h) != cudaSuccess) return 2;
+    cudaMemset(d, 0, sizeof h);
+    sites<<<256, 256>>>(d);
+    if (cudaDeviceSynchronize() != cudaSuccess) { printf("FAIL launch\n"); return 2; }
+    cudaMemcpy(h, d, sizeof h, cudaMemcpyDeviceToHost);
+    const char* names[3] = {"decode2<CB_MCG> (exl3_decode.cuh)", "decode2_mcg (exl3_grouped.cuh)", "mcg2 (exl3_prompt.cuh)"};
+    int fails = 0;
+    for (int k = 0; k < 3; ++k) {
+        printf("%s %s: %u of 262144 differ from tf_exlr8_pair\n", h[k] == 0 ? "PASS" : "FAIL", names[k], h[k]);
+        fails += h[k] != 0;
+    }
+    printf("TF_EXL3_MCG_E4M3=%d: %d of 3 sites differ\n", TF_EXL3_MCG_E4M3, fails);
+    return fails ? 1 : 0;
+}
