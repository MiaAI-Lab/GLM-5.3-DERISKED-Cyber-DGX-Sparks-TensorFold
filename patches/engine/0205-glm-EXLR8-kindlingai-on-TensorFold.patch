From 2f6e49b0ade3d2695d5c1403ad9ddcbefc8928f7 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <noreply@localhost>
Date: Tue, 17 Nov 2026 17:38:36 +0200
Subject: [PATCH 3/9] glm: EXLR8 expert pieces (mcg_e4m3 markers) detected as
 mcg + e4m3; refused until the E4M3 expert kernels (0205 part 2)

---
 zig/src/families/glm/cuda_exl3.zig      | 15 ++++++
 zig/src/families/glm/cuda_exl3_test.zig | 69 +++++++++++++++++++++++++
 zig/src/families/glm/cuda_weights.zig   |  4 ++
 3 files changed, 88 insertions(+)

diff --git a/zig/src/families/glm/cuda_exl3.zig b/zig/src/families/glm/cuda_exl3.zig
index dd04c9f1d..892d88cfe 100644
--- a/zig/src/families/glm/cuda_exl3.zig
+++ b/zig/src/families/glm/cuda_exl3.zig
@@ -101,6 +101,9 @@ pub const Experts = struct {
     uniform_d: u32 = 8,
     shx: bool, // every expert's gate and up share one input rotation: a prompt rotates a row once, not once a pick
     codebook: core.exl3_load.Codebook = .mcg, // the layer's (every expert and projection of it on the same one)
+    // EXLR8 (kindlingai's exlr8-e4m3-v2, as rank pieces from night/gr8x/x8/exlr8_pieces.py): mcg values rounded to E4M3,
+    // marked `mcg_e4m3` (the mcg multiplier) instead of `mcg`; codebook stays .mcg, the kernels take CB_MCG_E4M3 (0205)
+    e4m3: bool = false,
 
     /// The gate, up and down width tables.
     pub fn tables(w: Experts) [3]u64 {
@@ -182,6 +185,18 @@ pub fn load(L: anytype, i: u32, count: usize, dims: usize, inter: usize, cut: Sp
                     seen = mk.codebook;
                 }
             }
+            // EXLR8's marker: the mcg multiplier under its own name, so no EXL3 build can be read as EXLR8 or back
+            const e4 = (if (pieced) L.get("layers.{d}.mlp.experts.{d}." ++ proj ++ ".rank{d}.mcg_e4m3", .{ i, e, pr }) else L.get("layers.{d}.mlp.experts.{d}." ++ proj ++ ".mcg_e4m3", .{ i, e })) catch null;
+            if (e4) |marker| {
+                if (marker.dtype != .i32 or marker.numel() != 1 or marker.bytes.len != 4 or
+                    std.mem.readInt(u32, marker.bytes[0..4], .little) != core.exl3_load.markers[0].value or seen != null)
+                    return error.UnreadableExl3;
+                seen = .mcg;
+            }
+            if (pi == 0 and e == 0) out.e4m3 = e4 != null else if ((e4 != null) != out.e4m3) {
+                std.log.warn("layer {d}: EXLR8 (mcg_e4m3) and EXL3 experts mixed in one layer", .{i}); // refused below its caller's error
+                return error.UnreadableExl3;
+            }
             const cb = seen orelse return error.UnreadableExl3;
             if (pi == 0 and e == 0) out.codebook = cb else if (cb != out.codebook) {
                 std.log.err("layer {d}: experts on more than one EXL3 codebook; GLM's CUDA experts take one a layer", .{i});
diff --git a/zig/src/families/glm/cuda_exl3_test.zig b/zig/src/families/glm/cuda_exl3_test.zig
index baf76cc4b..c27f07cfc 100644
--- a/zig/src/families/glm/cuda_exl3_test.zig
+++ b/zig/src/families/glm/cuda_exl3_test.zig
@@ -359,3 +359,72 @@ test "GLM EXL3: scratch covers the path each layer takes: the prompt kernels' wh
         try testing.expectEqual([3]usize{ 4, 4, 4 }, most[1..4].*);
     }
 }
+
+/// Expert `e`'s marker of projection `p` renamed from `.mcg` to EXLR8's `.mcg_e4m3` (same value), or both kept (`both`).
+fn markE4m3(m: *Mock, i: u32, e: usize, p: usize, both: bool) !void {
+    var buf: [128]u8 = undefined;
+    const old = try std.fmt.bufPrint(&buf, "layers.{d}.mlp.experts.{d}.{s}.mcg", .{ i, e, projs[p] });
+    const t = m.tensors.get(old).?;
+    if (!both) _ = m.tensors.remove(old);
+    var nb: [128]u8 = undefined;
+    try m.add(try std.fmt.bufPrint(&nb, "layers.{d}.mlp.experts.{d}.{s}.mcg_e4m3", .{ i, e, projs[p] }), t.dtype, t.shape[0..t.rank], t.bytes);
+}
+
+test "GLM EXL3: EXLR8 pieces (mcg_e4m3 markers) load as mcg with e4m3 set, the same bytes; EXL3 layers keep e4m3 off" {
+    const gpa = testing.allocator;
+    var prng = std.Random.DefaultPrng.init(205);
+    const count = 3;
+    const k8: [count]u32 = @splat(8);
+    const k2s: [3][]const u32 = .{ &k8, &k8, &k8 };
+    const cut: Span = .{ .lo = 128, .hi = 256 };
+    {
+        var m0 = Mock.init(gpa);
+        defer m0.deinit();
+        var p0 = std.Random.DefaultPrng.init(205);
+        try synth(&m0, p0.random(), 6, count, 256, 256, k2s, false);
+        const plain = try x3.load(&m0, 6, count, 256, 256, cut);
+        try testing.expect(!plain.e4m3);
+    }
+    var m = Mock.init(gpa);
+    defer m.deinit();
+    try synth(&m, prng.random(), 6, count, 256, 256, k2s, false);
+    for (0..count) |e| for (0..3) |p| try markE4m3(&m, 6, e, p, false);
+    const w = try x3.load(&m, 6, count, 256, 256, cut);
+    try testing.expect(w.e4m3);
+    try testing.expectEqual(core.exl3_load.Codebook.mcg, w.codebook);
+    try expectUploads(&m, w, 6, count, 256, 256, cut, k2s);
+}
+
+test "GLM EXL3: a layer mixing EXLR8 and EXL3 experts, a projection with both markers, or a wrong EXLR8 value is refused" {
+    const gpa = testing.allocator;
+    var prng = std.Random.DefaultPrng.init(2051);
+    const count = 3;
+    const k8: [count]u32 = @splat(8);
+    const k2s: [3][]const u32 = .{ &k8, &k8, &k8 };
+    const cut: Span = .{ .lo = 0, .hi = 128 };
+    { // expert 1 alone EXLR8
+        var m = Mock.init(gpa);
+        defer m.deinit();
+        try synth(&m, prng.random(), 2, count, 256, 256, k2s, false);
+        for (0..3) |p| try markE4m3(&m, 2, 1, p, false);
+        try testing.expectError(error.UnreadableExl3, x3.load(&m, 2, count, 256, 256, cut));
+    }
+    { // both markers on expert 0's gate
+        var m = Mock.init(gpa);
+        defer m.deinit();
+        try synth(&m, prng.random(), 2, count, 256, 256, k2s, false);
+        for (0..count) |e| for (0..3) |p| try markE4m3(&m, 2, e, p, e == 0 and p == 0);
+        try testing.expectError(error.UnreadableExl3, x3.load(&m, 2, count, 256, 256, cut));
+    }
+    { // an EXLR8 marker with another value
+        var m = Mock.init(gpa);
+        defer m.deinit();
+        try synth(&m, prng.random(), 2, count, 256, 256, k2s, false);
+        for (0..count) |e| for (0..3) |p| try markE4m3(&m, 2, e, p, false);
+        const t = m.tensors.getPtr("layers.2.mlp.experts.2.down_proj.mcg_e4m3").?;
+        var bad: [4]u8 = undefined;
+        std.mem.writeInt(u32, &bad, core.exl3_load.markers[1].value, .little);
+        t.bytes = try m.arena.allocator().dupe(u8, &bad);
+        try testing.expectError(error.UnreadableExl3, x3.load(&m, 2, count, 256, 256, cut));
+    }
+}
diff --git a/zig/src/families/glm/cuda_weights.zig b/zig/src/families/glm/cuda_weights.zig
