diff --git a/zig/tests/exl3_e4m3_check.cu b/zig/tests/exl3_e4m3_check.cu
new file mode 100644
index 000000000..dc98ec1a3
--- /dev/null
+++ b/zig/tests/exl3_e4m3_check.cu
@@ -0,0 +1,97 @@
+// X8 (patch 0205): EXL3's tile decode with CB_MCG_E4M3 equals TensorFold's EXLR8 reference decode (exlr8.cu,
+// tf_exlr8_decode) bit for bit, on random tiles at K = 2, 3, 4 and on real tiles of kindlingai's EXLR8 release
+// (glm-5.3-exlr8-k2-k3-k4, layer 3, K4). Control: CB_MCG (unrounded) must differ from the reference, and most values
+// must be non-zero, so the comparison is not vacuous. Build: nvcc -O2 -std=c++17 -arch=sm_121 -I kernels/cuda
+// tests/exl3_e4m3_check.cu; run: exl3_e4m3_check [real_k4.bin] (two K4 halves of the release, e.g. layer 3).
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include "exl3_decode.cuh"
+#include "exlr8.cu"
+
+using namespace tf_exl3;
+
+// Each block: one tile, 32 lanes; out[tile][lane][8] fp16 bits of the EXL3 path (CB) and of the EXLR8 reference.
+template <int K, int CB>
+__global__ void both(const uint8_t* W, unsigned tiles, uint16_t* exl3, uint16_t* ref) {
+    const unsigned t = blockIdx.x, lane = threadIdx.x;
+    if (t >= tiles) return;
+    const uint32_t* tile = reinterpret_cast<const uint32_t*>(W + (uint64_t)t * 32 * K);
+    uint32_t w[lane_words<2 * K>()];
+    load_lane_words<2 * K>(tile, lane, w);
+    uint32_t b0[2], b1[2];
+    decode_lane<2 * K, CB>(w, lane, b0, b1);
+    const uint32_t v[4] = {b0[0], b0[1], b1[0], b1[1]};
+    uint16_t* o = exl3 + ((uint64_t)t * 32 + lane) * 8;
+    for (int i = 0; i < 4; ++i) { o[2 * i] = v[i] & 0xffffu; o[2 * i + 1] = v[i] >> 16; }
+    __half r[8];
+    tf_exlr8_decode<K>(tile, lane, r);
+    uint16_t* q = ref + ((uint64_t)t * 32 + lane) * 8;
+    for (int n = 0; n < 8; ++n) q[n] = __half_as_ushort(r[n]);
+}
+
+#define CK(x) do { cudaError_t e = (x); if (e != cudaSuccess) { printf("CUDA %s at %d\n", cudaGetErrorString(e), __LINE__); exit(2); } } while (0)
+
+template <int K, int CB>
+static long mismatches(const std::vector<uint8_t>& bytes, long* nonzero) {
+    const unsigned tiles = bytes.size() / (32 * K);
+    uint8_t* dW; uint16_t *dA, *dB;
+    CK(cudaMalloc(&dW, bytes.size()));
+    CK(cudaMalloc(&dA, (size_t)tiles * 256 * 2));
+    CK(cudaMalloc(&dB, (size_t)tiles * 256 * 2));
+    CK(cudaMemcpy(dW, bytes.data(), bytes.size(), cudaMemcpyHostToDevice));
+    both<K, CB><<<tiles, 32>>>(dW, tiles, dA, dB);
+    CK(cudaGetLastError());
+    CK(cudaDeviceSynchronize());
+    std::vector<uint16_t> a((size_t)tiles * 256), b((size_t)tiles * 256);
+    CK(cudaMemcpy(a.data(), dA, a.size() * 2, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(b.data(), dB, b.size() * 2, cudaMemcpyDeviceToHost));
+    cudaFree(dW); cudaFree(dA); cudaFree(dB);
+    long bad = 0, nz = 0;
+    for (size_t i = 0; i < a.size(); ++i) { bad += a[i] != b[i]; nz += (b[i] & 0x7fff) != 0; }
+    if (nonzero) *nonzero = nz;
+    return bad;
+}
+
+static std::vector<uint8_t> random_bytes(size_t n, unsigned seed) {
+    std::vector<uint8_t> v(n);
+    uint64_t x = 0x9E3779B97F4A7C15ull ^ seed;
+    for (auto& c : v) { x ^= x << 13; x ^= x >> 7; x ^= x << 17; c = (uint8_t)x; }
+    return v;
+}
+
+static int fails = 0, checks = 0;
+static void expect(bool ok, const char* what, long a, long b) {
+    ++checks;
+    printf("%s %s (%ld / %ld)\n", ok ? "PASS" : "FAIL", what, a, b);
+    if (!ok) ++fails;
+}
+
+int main(int argc, char** argv) {
+    long nz = 0, total;
+    // random tiles: 4096 a width, every state pattern the stream can make
+    auto r2 = random_bytes(4096 * 64, 2), r3 = random_bytes(4096 * 96, 3), r4 = random_bytes(4096 * 128, 4);
+    total = 4096L * 256;
+    expect(mismatches<2, CB_MCG_E4M3>(r2, &nz) == 0 && nz > total / 2, "K2 random: E4M3 path == EXLR8 reference", nz, total);
+    expect(mismatches<3, CB_MCG_E4M3>(r3, &nz) == 0 && nz > total / 2, "K3 random: E4M3 path == EXLR8 reference", nz, total);
+    expect(mismatches<4, CB_MCG_E4M3>(r4, &nz) == 0 && nz > total / 2, "K4 random: E4M3 path == EXLR8 reference", nz, total);
+    // controls: the unrounded mcg path differs (ignoring the variant would be caught)
+    expect(mismatches<4, CB_MCG>(r4, nullptr) > total / 4, "control: CB_MCG differs from the EXLR8 values", 0, total);
+    if (argc > 1) {
+        FILE* f = fopen(argv[1], "rb");
+        if (!f) { printf("FAIL cannot open %s\n", argv[1]); return 1; }
+        std::vector<uint8_t> real;
+        uint8_t buf[1 << 16];
+        size_t n;
+        while ((n = fread(buf, 1, sizeof buf, f)) > 0) real.insert(real.end(), buf, buf + n);
+        fclose(f);
+        const long tiles = real.size() / 128;
+        long bad = mismatches<4, CB_MCG_E4M3>(real, &nz);
+        expect(bad == 0 && nz > tiles * 128, "real EXLR8 K4 tiles (layer 3, two rank-0 halves): E4M3 path == reference", nz, tiles * 256);
+    } else {
+        printf("SKIP real tiles (no file)\n");
+    }
+    printf("%d checks, %d failed\n", checks, fails);
+    return fails ? 1 : 0;
+}
-- 
2.43.0


From 6f4f1b50c41c3d44a83bc1d6f7145f52f07d9744 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <noreply@localhost>
Date: Tue, 17 Nov 2026 17:27:08 +0200
Subject: [PATCH 2/9] exl3 E4M3 check: every state in both slots, the real
 halves' size and provenance

---
 zig/tests/exl3_e4m3_check.cu | 31 +++++++++++++++++++++++++++++--
 1 file changed, 29 insertions(+), 2 deletions(-)

diff --git a/zig/tests/exl3_e4m3_check.cu b/zig/tests/exl3_e4m3_check.cu
index dc98ec1a3..5bb37549a 100644
--- a/zig/tests/exl3_e4m3_check.cu
+++ b/zig/tests/exl3_e4m3_check.cu
@@ -2,7 +2,8 @@
 // tf_exlr8_decode) bit for bit, on random tiles at K = 2, 3, 4 and on real tiles of kindlingai's EXLR8 release
 // (glm-5.3-exlr8-k2-k3-k4, layer 3, K4). Control: CB_MCG (unrounded) must differ from the reference, and most values
 // must be non-zero, so the comparison is not vacuous. Build: nvcc -O2 -std=c++17 -arch=sm_121 -I kernels/cuda
-// tests/exl3_e4m3_check.cu; run: exl3_e4m3_check [real_k4.bin] (two K4 halves of the release, e.g. layer 3).
+// tests/exl3_e4m3_check.cu; run: exl3_e4m3_check [real_k4.bin]: two whole K4 halves of the release (layer 3: gate e0 h1,
+// down e7 h5), whose provenance night/gr8x/x8/verify_halves.py proves against the release index's xxhash64 checksums.
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
@@ -31,6 +32,23 @@ __global__ void both(const uint8_t* W, unsigned tiles, uint16_t* exl3, uint16_t*
     for (int n = 0; n < 8; ++n) q[n] = __half_as_ushort(r[n]);
 }
 
+// Every 16-bit state in both slots of a pair: decode2<CB_MCG_E4M3>(s0, s1) against tf_exlr8_pair(s0, s1), two partners
+// a state (s ^ 0xA5A5 and the reversed bits), so a defect limited to one state or one slot is caught.
+__global__ void states(unsigned* bad) {
+    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= 65536) return;
+    const unsigned partners[2] = {i ^ 0xA5A5u, __brev(i) >> 16};
+    for (unsigned p : partners) {
+        for (int slot = 0; slot < 2; ++slot) {
+            const unsigned s0 = slot ? p : i, s1 = slot ? i : p;
+            const uint32_t a = decode2<CB_MCG_E4M3>(s0, s1);
+            const __half2 r = tf_exlr8_pair(s0, s1);
+            const uint32_t b = *reinterpret_cast<const uint32_t*>(&r);
+            if (a != b) atomicAdd(bad, 1u);
+        }
+    }
+}
+
 #define CK(x) do { cudaError_t e = (x); if (e != cudaSuccess) { printf("CUDA %s at %d\n", cudaGetErrorString(e), __LINE__); exit(2); } } while (0)
 
 template <int K, int CB>
@@ -70,7 +88,15 @@ static void expect(bool ok, const char* what, long a, long b) {
 
 int main(int argc, char** argv) {
     long nz = 0, total;
-    // random tiles: 4096 a width, every state pattern the stream can make
+    {
+        unsigned* d; unsigned h = 0;
+        CK(cudaMalloc(&d, 4)); CK(cudaMemset(d, 0, 4));
+        states<<<256, 256>>>(d);
+        CK(cudaGetLastError()); CK(cudaDeviceSynchronize());
+        CK(cudaMemcpy(&h, d, 4, cudaMemcpyDeviceToHost)); cudaFree(d);
+        expect(h == 0, "all 65,536 states in both slots: decode2<CB_MCG_E4M3> == tf_exlr8_pair", (long)h, 4L * 65536);
+    }
+    // random tiles: 4096 a width (stream layout and lane placement; the states test above covers every value)
     auto r2 = random_bytes(4096 * 64, 2), r3 = random_bytes(4096 * 96, 3), r4 = random_bytes(4096 * 128, 4);
     total = 4096L * 256;
     expect(mismatches<2, CB_MCG_E4M3>(r2, &nz) == 0 && nz > total / 2, "K2 random: E4M3 path == EXLR8 reference", nz, total);
@@ -86,6 +112,7 @@ int main(int argc, char** argv) {
         size_t n;
         while ((n = fread(buf, 1, sizeof buf, f)) > 0) real.insert(real.end(), buf, buf + n);
         fclose(f);
+        if (real.size() != 2u * 3072 * 128) { printf("FAIL %s is %zu bytes, not two whole K4 halves (786,432)\n", argv[1], real.size()); return 1; }
         const long tiles = real.size() / 128;
         long bad = mismatches<4, CB_MCG_E4M3>(real, &nz);
         expect(bad == 0 && nz > tiles * 128, "real EXLR8 K4 tiles (layer 3, two rank-0 halves): E4M3 path == reference", nz, tiles * 256);
