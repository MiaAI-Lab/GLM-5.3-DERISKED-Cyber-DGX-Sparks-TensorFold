                                 __half2half2(__ushort_as_half(0xc931)));
         return *reinterpret_cast<const uint32_t*>(&r);
+    } else if constexpr (CB == CB_MCG_E4M3) {
+        // The mcg sum at 2^-8 (xor 0x1B60): E4M3 normals then map onto fp16 normals and E4M3 subnormals (steps of 2^-9)
+        // onto fp16 values whose bit 7 is E4M3's last mantissa bit, so nearest even at bit 7 is E4M3's rounding,
+        // subnormals included; times 2^8 back, exact. The same operations as exlr8.cu's tf_exlr8_pair.
+        uint32_t x0 = s0 * 0xCBAC1FEDu, x1 = s1 * 0xCBAC1FEDu;
