         try testing.expectError(error.UnreadableExl3, x3.load(&m, 2, count, 256, 256, cut));
     }
 }
+
+/// Layer `i` stored as one rank's pieces (EXLR8 files): every expert's projections as `.rank{rank}.*` with mcg_e4m3
+/// markers, piece width `w`, and the declaration [rank, ranks].
+fn synthPieces(m: *Mock, rng: std.Random, i: u32, count: usize, dims: usize, w: usize, rank: i32, ranks: i32) !void {
+    const a = m.arena.allocator();
+    for (projs, 0..) |proj, p| {
+        const k = if (p < 2) dims else w;
+        const n = if (p < 2) w else dims;
+        for (0..count) |e| {
+            var buf: [160]u8 = undefined;
+            const words = try a.alloc(u8, k / 16 * (n / 16) * 16 * 8);
+            rng.bytes(words);
+            try m.add(try std.fmt.bufPrint(&buf, "layers.{d}.mlp.experts.{d}.{s}.rank{d}.trellis", .{ i, e, proj, rank }), .i16, &.{ k / 16, n / 16, 64 }, words);
+            var marker: [4]u8 = undefined;
+            std.mem.writeInt(u32, &marker, core.exl3_load.markers[0].value, .little);
+            try m.add(try std.fmt.bufPrint(&buf, "layers.{d}.mlp.experts.{d}.{s}.rank{d}.mcg_e4m3", .{ i, e, proj, rank }), .i32, &.{}, &marker);
+            const suh = try a.alloc(u8, k * 2);
+            rng.bytes(suh);
+            try m.add(try std.fmt.bufPrint(&buf, "layers.{d}.mlp.experts.{d}.{s}.rank{d}.suh", .{ i, e, proj, rank }), .f16, &.{k}, suh);
+            const svh = try a.alloc(u8, n * 2);
+            rng.bytes(svh);
+            try m.add(try std.fmt.bufPrint(&buf, "layers.{d}.mlp.experts.{d}.{s}.rank{d}.svh", .{ i, e, proj, rank }), .f16, &.{n}, svh);
+        }
+    }
+    var decl: [8]u8 = undefined;
+    std.mem.writeInt(i32, decl[0..4], rank, .little);
+    std.mem.writeInt(i32, decl[4..8], ranks, .little);
+    var buf: [96]u8 = undefined;
+    try m.add(try std.fmt.bufPrint(&buf, "layers.{d}.mlp.experts.pieces", .{i}), .i32, &.{2}, &decl);
+}
+
+test "GLM EXL3: one rank's declared EXLR8 pieces load whole on that rank, and are refused on another rank" {
+    const gpa = testing.allocator;
+    var prng = std.Random.DefaultPrng.init(2052);
+    const count = 2;
+    { // rank 2 of 4, inter 512: the piece is 128 wide; cut [256, 384) is rank 2's share
+        var m = Mock.init(gpa);
+        defer m.deinit();
+        try synthPieces(&m, prng.random(), 3, count, 256, 128, 2, 4);
+        const w = try x3.load(&m, 3, count, 256, 512, .{ .lo = 256, .hi = 384 });
+        try testing.expect(w.e4m3);
+        const gt = m.find("layers.3.moe.exl3.gt").?;
+        var buf: [96]u8 = undefined;
+        const t0 = m.tensors.get(try std.fmt.bufPrint(&buf, "layers.3.mlp.experts.0.gate_proj.rank2.trellis", .{})).?;
+        try testing.expectEqualSlices(u8, t0.bytes, gt.bytes[0..t0.bytes.len]); // expert 0's piece, whole
+    }
+    { // the same file on rank 1's share
+        var m = Mock.init(gpa);
+        defer m.deinit();
+        try synthPieces(&m, prng.random(), 3, count, 256, 128, 2, 4);
+        try testing.expectError(error.UnreadableExl3, x3.load(&m, 3, count, 256, 512, .{ .lo = 128, .hi = 256 }));
+    }
+}
