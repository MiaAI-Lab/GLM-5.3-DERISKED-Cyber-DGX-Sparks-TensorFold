From 2b79c638cd0662a3874b59a36d05e7af48d4a37c Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <noreply@localhost>
Date: Tue, 17 Nov 2026 18:18:56 +0200
Subject: [PATCH 7/9] glm: EXLR8 checkpoints load (routed experts on the E4M3
 image; shared and dense converted); exlr8_x8_dump_test writes TensorFold's
 reference decode for the converter's checks

---
 zig/src/core/exlr8_x8_dump_test.zig   | 101 ++++++++++++++++++++++++++
 zig/src/families/glm/cuda_weights.zig |   6 +-
 2 files changed, 103 insertions(+), 4 deletions(-)
 create mode 100644 zig/src/core/exlr8_x8_dump_test.zig

diff --git a/zig/src/core/exlr8_x8_dump_test.zig b/zig/src/core/exlr8_x8_dump_test.zig
new file mode 100644
index 000000000..2a3a51da9
--- /dev/null
+++ b/zig/src/core/exlr8_x8_dump_test.zig
@@ -0,0 +1,101 @@
+//! X8 (patch 0205 part 4): TensorFold's EXLR8 reference decode (codec.reconstructF32, "exactly as the reference loader
+//! computes it", and exlr8_dense.Matrix.rows) for chosen expert halves and dense matrices, written as f32 files the
+//! converted checkpoint is compared against (night/gr8x/x8/oracle_compare.py). Not a regular test: it runs only with
+//!   TF_X8_ROOT  a release root (experts/ with the index and width files, dense/)
+//!   TF_X8_JOBS  a file of lines "half L E P H" (P gate|up|down, E 256 the shared expert) or "dense L NAME" (L -1: vocab)
+//!   TF_X8_OUT   the output directory (half-L-E-P-H.f32: W (rows, cols) as the half stores it; dense-L-NAME.f32: the HF
+//!               weight (out, in)); each file's shape goes to its .shape line.
+//! zig test -lc -O ReleaseFast zig/src/core/exlr8_x8_dump_test.zig
+const std = @import("std");
+const codec = @import("exlr8_codec.zig");
+const ex = @import("exlr8_experts.zig");
+const dense = @import("exlr8_dense.zig");
+const st = @import("safetensors.zig");
+
+const io = std.testing.io;
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    const v = std.c.getenv(name) orelse return null;
+    return std.mem.span(v);
+}
+
+fn writeF32(gpa: std.mem.Allocator, dir: []const u8, name: []const u8, rows: usize, cols: usize, data: []const f32) !void {
+    const path = try std.fmt.allocPrint(gpa, "{s}/{s}.f32", .{ dir, name });
+    defer gpa.free(path);
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = std.mem.sliceAsBytes(data) });
+    const sp = try std.fmt.allocPrint(gpa, "{s}/{s}.shape", .{ dir, name });
+    defer gpa.free(sp);
+    const text = try std.fmt.allocPrint(gpa, "{d} {d}\n", .{ rows, cols });
+    defer gpa.free(text);
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = sp, .data = text });
+}
+
+test "X8 dump: the reference decode of the listed halves and dense matrices" {
+    const root = env("TF_X8_ROOT") orelse return error.SkipZigTest;
+    const jobs_path = env("TF_X8_JOBS") orelse return error.SkipZigTest;
+    const out = env("TF_X8_OUT") orelse return error.SkipZigTest;
+    const gpa = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const book = try a.create(codec.Codebook);
+    book.init();
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, jobs_path, a, .limited(1 << 20));
+    var lines = std.mem.tokenizeScalar(u8, text, '\n');
+    var done: usize = 0;
+    while (lines.next()) |line| {
+        var f = std.mem.tokenizeScalar(u8, line, ' ');
+        const kind = f.next() orelse continue;
+        if (std.mem.eql(u8, kind, "half")) {
+            const L = try std.fmt.parseInt(u16, f.next().?, 10);
+            const e = try std.fmt.parseInt(u16, f.next().?, 10);
+            const pname = f.next().?;
+            const h = try std.fmt.parseInt(usize, f.next().?, 10);
+            const proj = std.meta.stringToEnum(ex.Proj, pname) orelse return error.BadJob;
+            var layer = try ex.Layer.open(gpa, io, root, L);
+            defer layer.close(io);
+            const k: u8 = for ([_]u8{ 4, 3, 2 }) |kk| {
+                if (layer.half(e, proj, h, kk)) |_| break kk else |_| {}
+            } else return error.NoWidth;
+            const hf = try layer.half(e, proj, h, k);
+            if (!hf.verify()) return error.HalfChecksum;
+            const rows = hf.rows();
+            const cols = hf.cols();
+            const codes = try a.alloc(u8, rows * cols);
+            try codec.decodeRun(book, hf.k, hf.order(), hf.trellis, rows, cols, codes);
+            const suh = try a.alloc(f32, rows);
+            const svh = try a.alloc(f32, cols);
+            hf.suh(suh);
+            hf.svh(svh);
+            const w = try a.alloc(f32, rows * cols);
+            try codec.reconstructF32(codes, rows, cols, suh, svh, w);
+            try writeF32(gpa, out, try std.fmt.allocPrint(a, "half-{d}-{d}-{s}-{d}", .{ L, e, pname, h }), rows, cols, w);
+        } else if (std.mem.eql(u8, kind, "dense")) {
+            const L = try std.fmt.parseInt(i32, f.next().?, 10);
+            const name = f.next().?;
+            const path = if (L < 0) try std.fmt.allocPrint(a, "{s}/dense/exlr8-vocab.safetensors", .{root}) else try std.fmt.allocPrint(a, "{s}/dense/exlr8-dense-{d:0>3}.safetensors", .{ root, @as(u32, @intCast(L)) });
+            var file = try st.File.open(gpa, io, path);
+            defer file.close(io);
+            const m = try dense.Matrix.get(&file, name);
+            if (!try m.verify()) return error.DenseChecksum;
+            const r = m.record;
+            const w = try a.alloc(f32, r.out * r.in);
+            if (r.format == .trellis) { // T (in, out), W (in, out) by the reference's fp32 order, then as HF (out, in)
+                const codes = try a.alloc(u8, r.in * r.out);
+                try m.trellisCodes(book, codes);
+                const suh = try a.alloc(f32, r.in);
+                const svh = try a.alloc(f32, r.out);
+                m.suh(suh);
+                m.svh(svh);
+                const wio = try a.alloc(f32, r.in * r.out);
+                try codec.reconstructF32(codes, r.in, r.out, suh, svh, wio);
+                for (0..r.out) |o| for (0..r.in) |i| {
+                    w[o * r.in + i] = wio[i * r.out + o];
+                };
+            } else try m.rows(0, r.out, w);
+            try writeF32(gpa, out, try std.fmt.allocPrint(a, "dense-{d}-{s}", .{ L, name }), r.out, r.in, w);
+        } else return error.BadJob;
+        done += 1;
+    }
+    try std.testing.expect(done > 0);
+}
