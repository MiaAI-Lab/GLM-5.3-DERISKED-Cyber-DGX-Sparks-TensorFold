diff --git a/zig/src/families/glm/cuda_ranks.zig b/zig/src/families/glm/cuda_ranks.zig
index 9e7637835..fff06f70f 100644
--- a/zig/src/families/glm/cuda_ranks.zig
+++ b/zig/src/families/glm/cuda_ranks.zig
@@ -446,3 +446,20 @@ pub fn mediaFingerprint(f: *Fingerprint, limits: @import("cuda_images.zig").Limi
 pub fn artifact(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) ![32]u8 {
     return @import("core").checkpoint_identity.fullIdentity(gpa, io, dir);
 }
+
+/// The digest an EXLR8 rank-piece checkpoint (patch 0205) sends instead: its shards differ by rank by design (each box
+/// holds its own pieces and shared-expert rows), so the ranks agree on the conversion they come from, exlr8-set.json
+/// (release, revision, profile, ranks, converter): identical on every box by construction, domain-separated from
+/// `artifact`'s digests. Each rank's own data is checked where it loads (the pieces' [rank, ranks] declaration).
+pub fn exlr8Set(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) ![32]u8 {
+    const path = try std.fs.path.join(gpa, &.{ dir, "exlr8-set.json" });
+    defer gpa.free(path);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+    defer gpa.free(text);
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    h.update("tensorfold exlr8 rank-piece set v1\x00");
+    h.update(text);
+    var out: [32]u8 = undefined;
+    h.final(&out);
+    return out;
+}
diff --git a/zig/src/families/glm/cuda_ranks_test.zig b/zig/src/families/glm/cuda_ranks_test.zig
index a73bf005e..017421428 100644
--- a/zig/src/families/glm/cuda_ranks_test.zig
+++ b/zig/src/families/glm/cuda_ranks_test.zig
@@ -454,3 +454,36 @@ test "TF_GLM_L2PF: read with the settings, carried in the fingerprint, and ranks
     all[1].l2pf[3] = 0; // rank 1 unpaced
     try std.testing.expectEqual(Mismatch{ .field = .l2pf, .rank = 1 }, mismatch(&all).?);
 }
+
+test "GLM EXL3: EXLR8 rank-piece checkpoints agree on their exlr8-set.json, whatever their shard bytes; a different set disagrees" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try digestFixture(io, tmp.dir, "r0/model", 1);
+    try digestFixture(io, tmp.dir, "r1/model", 2); // another rank's pieces: other bytes
+    try digestFixture(io, tmp.dir, "x/model", 2);
+    const set = "{\"release\": \"kindlingai/glm-5.3-exlr8-k2-k3-k4@a36ae468\", \"profile\": \"up1\", \"ranks\": 4}";
+    for ([_][]const u8{ "r0/model", "r1/model" }) |sub| {
+        var d = try tmp.dir.openDir(io, sub, .{});
+        defer d.close(io);
+        try d.writeFile(io, .{ .sub_path = "exlr8-set.json", .data = set });
+    }
+    {
+        var d = try tmp.dir.openDir(io, "x/model", .{});
+        defer d.close(io);
+        try d.writeFile(io, .{ .sub_path = "exlr8-set.json", .data = "{\"release\": \"another\"}" });
+    }
+    var paths: [3][:0]u8 = undefined;
+    for ([_][]const u8{ "r0/model", "r1/model", "x/model" }, &paths) |sub, *p| p.* = try tmp.dir.realPathFileAlloc(io, sub, a);
+    defer for (paths) |p| a.free(p);
+    const h: [32]u8 = @splat(7);
+    var all = [_]Fingerprint{ Fingerprint.of(2, 0, .{}, 8192, true, h, h, try ranks.exlr8Set(a, io, paths[0])), Fingerprint.of(2, 1, .{}, 8192, true, h, h, try ranks.exlr8Set(a, io, paths[1])) };
+    try std.testing.expect(mismatch(&all) == null);
+    all[1] = Fingerprint.of(2, 1, .{}, 8192, true, h, h, try ranks.exlr8Set(a, io, paths[2]));
+    try std.testing.expectEqual(Mismatch{ .field = .checkpoint, .rank = 1 }, mismatch(&all).?);
+    try std.testing.expect(!std.mem.eql(u8, &(try ranks.exlr8Set(a, io, paths[0])), &(try artifact(a, io, paths[0]))));
+    const root = try tmp.dir.realPathFileAlloc(io, ".", a); // no exlr8-set.json there
+    defer a.free(root);
+    try std.testing.expectError(error.FileNotFound, ranks.exlr8Set(a, io, root));
+}
