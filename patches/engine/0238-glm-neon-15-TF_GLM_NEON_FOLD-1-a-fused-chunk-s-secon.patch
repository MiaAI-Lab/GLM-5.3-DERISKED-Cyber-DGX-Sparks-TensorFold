+/// TF_GLM_NEON_FOLD=1 (neon #15, default off), read once.
+pub fn neonFold() bool {
+    const S = struct {
+        var once: ?bool = null;
+    };
+    if (S.once) |v| return v;
+    const v = if (std.c.getenv("TF_GLM_NEON_FOLD")) |e| std.mem.eql(u8, std.mem.span(e), "1") else false;
+    if (v) std.log.info("TF_GLM_NEON_FOLD=1: a fused chunk's second half folds its shared slot in the shared down epilogue", .{});
+    S.once = v;
+    return v;
+}
+
+/// neon #15: sharedOnly then foldRows for rows lo..hi in two launches fewer: the shared gate-up and SwiGLU as
+/// sharedRows runs them, then the 8-bit shared down on glm_mm8_p64x128_fold straight into `out` (glm_mm8's sums,
+/// then fold_slot's fma on each value: the same bytes, night/neon/gputest t7_fold.out). False: not taken (an
+/// unpacked or other-width shared down, no kernel): the caller runs sharedOnly + foldRows.
+pub fn sharedFoldRows(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, x: u64, x_stride: usize, lo: usize, hi: usize, out: u64) !bool {
+    if (hi <= lo or forks(k, true)) return false;
+    const mk = k.set.mm orelse return false;
+    const f = mk.prompt_fold orelse return false;
+    const pk = k.set.packs orelse return false;
+    const b = switch (l.shared_down) {
+        .bf16 => |b| b,
+        else => return false,
+    };
+    const d = l.routed.dims;
+    const t = pk.tiled(b, d, l.shared);
+    if (t.bits != 8 or l.shared % 64 != 0 or d % 8 != 0) return false;
+    const n = hi - lo;
+    const stamp = prof_mod.span(k.prof, stream, .shared_expert);
+    defer stamp.end();
+    try projection.matmul(k.set, stream, l.shared_gu, x + lo * x_stride * 2, x_stride, s.sgu + lo * 2 * l.shared * 2, s.mm_part, n, 2 * l.shared, d, false);
+    try glue.swiglu(k.set, stream, s.sgu + lo * 2 * l.shared * 2, s.sact + lo * l.shared * 2, s.sxs + lo * (l.shared / 64) * 4, l.routed.limit, n, l.shared);
+    var a: cuda.Args = .{};
+    a.add(s.sact + lo * l.shared * 2);
+    a.add(@as(c_longlong, @intCast(l.shared)));
+    a.add(t.w);
+    a.add(t.s);
+    a.add(out);
+    a.add(s.wts + lo * (l.top_k + 1) * 4);
+    for ([_]usize{ l.top_k + 1, l.top_k, n, d, l.shared }) |v| a.add(@as(c_int, @intCast(v)));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast((d + 127) / 128), .y = @intCast((n + 63) / 64) }, .block = .{ .x = 256 }, .shared = mm_mod.Kernels.prompt_tile_smem[1] }, stream, &a);
+    return true;
+}
+
 /// After bodyFused: rows lo..hi (the second half, lo = split) take their shared slot, out [hi - lo][dims] fp32 =
 /// fma(bf16(sy), wts[row][top_k], out): tf_glm_combine's last step on put_slot's value.
 pub fn foldRows(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, lo: usize, hi: usize, out: u64) !void {
