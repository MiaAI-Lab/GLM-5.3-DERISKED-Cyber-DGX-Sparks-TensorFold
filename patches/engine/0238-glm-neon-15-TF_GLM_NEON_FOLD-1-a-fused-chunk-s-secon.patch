+// neon rank #15 (TF_GLM_NEON_FOLD=1): the shared expert's down projection of a fused chunk's second half straight into its
+// fp32 partial rows: glm_mm8_p64x128's sums (glm_mm8_128s2's bits), then tf_glm_fold_slot's step on each value,
+// out = fma(bf16(v), wts[row][wslot], out), instead of storing sy and folding it in a second launch.
+extern "C" __global__ void __launch_bounds__(256, 2) glm_mm8_p64x128_fold(const __nv_bfloat16* __restrict__ x, long long ldx,
+        const uint32_t* __restrict__ w, const __half* __restrict__ s, float* __restrict__ out, const float* __restrict__ wts,
+        int wstride, int wslot, int M, int N, int K) {
+    mm8_tiled<64, 128, 2, 4, 3, 0, true>(x, ldx, w, s, out, 1, M, N, K, wts, wstride, wslot);
+}
 
