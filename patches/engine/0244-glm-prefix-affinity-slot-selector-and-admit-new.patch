-        if (seqs.len > slots.len) return false; // more slots than the check holds: refuse rather than guess
+        if (seqs.len > slots.len) return false;
         for (seqs, slots[0..seqs.len], 0..) |q, *x, slot| {
             const r = (q orelse {
                 x.* = null;
@@ -503,9 +570,7 @@ pub const Lanes = struct {
                 x.*.?.granted = @max(x.*.?.granted, l.grow_need);
