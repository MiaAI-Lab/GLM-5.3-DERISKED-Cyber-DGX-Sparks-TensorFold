     /// The stream's sequence bound, its last verify committed (`kept` rows, else all of them).
     fn bind(self: *Lanes, s: *const lanes.Stream, kept: ?usize) !*Lane {
         const l = self.lanes.getPtr(s) orelse return error.UnknownStream;
@@ -435,11 +501,12 @@ pub const Lanes = struct {
 
     /// The stream's slot, its pages, then its sequence: a slot past the paged ones waits before binding makes a window.
     pub fn seat(self: *Lanes, s: *const lanes.Stream, prompt: usize, max_new: usize) ![]const u32 {
-        // TF_GLM_SEQ_GROW: the pool must hold this stream's rows beside the other slots' (LaneMemory: the lane host
-        // requeues the request until a stream ends; alone, the slot it takes holds at most the pool)
-        const grow_need = if (self.lanes.getPtr(s) == null) self.growNeed(prompt, max_new) else 0;
-        if (!self.growFits(grow_need)) return error.LaneMemory;
-        const l = try self.claim(s);
+        // Choose slot with prefix affinity, then check shared VMM pool headroom when TF_GLM_SEQ_GROW is active.
+        const existing = self.lanes.getPtr(s);
+        const chosen = if (existing) |el| el.slot else self.chooseSlotFor(s);
+        const grow_need = if (existing == null) self.growNeed(prompt, max_new) else 0;
+        if (existing == null and !self.growFitsSlot(chosen, grow_need)) return error.LaneMemory;
+        const l = if (existing) |el| el else try self.claimSlot(s, chosen);
         l.grow_need = grow_need;
         l.pending_rows = null;
         l.held_n = 0;
@@ -472,23 +539,23 @@ pub const Lanes = struct {
         return snap.home;
     }
 
-    /// TF_GLM_SEQ_GROW (rank 0): the pool granules a stream of `prompt` + `max_new` rows needs, with a last window
-    /// and the margin State.ready maps past a pass (0: off). Every slot's sequence has the same fields as slot 0's.
+    /// TF_GLM_SEQ_GROW (rank 0): the pool granules a stream of `prompt` + `max_new` rows needs at admission,
+    /// using TF_GLM_SEQ_GROW_ADMIT_NEW so omitted max_tokens does not monopolize the whole shared pool.
     fn growNeed(self: *const Lanes, prompt: usize, max_new: usize) usize {
         if (seq_grow.pool == null) return 0;
         const q = self.x.e.seqs.items[0] orelse return 0;
         const r = q.st.grow orelse return 0;
-        return r.need(@min(self.x.e.capacity, prompt + max_new + max_rows + seq_grow.margin_rows));
+        const rows = seq_grow.admitRows(self.x.e.capacity, prompt, max_new, max_rows + seq_grow.margin_rows, seq_grow.admitNewAsked());
+        return r.need(rows);
     }
 
-    /// Whether the pool holds `need` more granules on the slot freeSlot gives, beside every other slot's: a live
-    /// stream's charge is the most of what it maps and what it was admitted with; an idle slot's, what it maps (slot
-    /// 0 keeps its last rows for slot resume until its next pass trims them).
-    fn growFits(self: *const Lanes, need: usize) bool {
+    /// Whether the pool holds `need` granules on `target_slot` beside every other slot's current charge.
+    fn growFitsSlot(self: *const Lanes, target_slot: u32, need: usize) bool {
         const pool = seq_grow.pool orelse return true;
+        if (target_slot >= seq_grow.max_streams) return false;
