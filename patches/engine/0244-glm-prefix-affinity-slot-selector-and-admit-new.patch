     /// Slot `slot`'s standing record (made on first use; null when it cannot be: nothing resumes there).
     fn standingOf(self: *Lanes, slot: u32) ?*slot_resume.Standing {
         const gpa = self.x.e.gpa;
@@ -235,11 +255,57 @@ pub const Lanes = struct {
     pub fn claimUsing(self: *Lanes, s: *const lanes.Stream, comptime choose: anytype) !*Lane {
         if (self.lanes.getPtr(s)) |existing| return existing;
         const slot = choose(self);
+        return self.claimSlot(s, slot);
+    }
+
+    fn claimSlot(self: *Lanes, s: *const lanes.Stream, slot: u32) !*Lane {
+        if (self.lanes.getPtr(s)) |existing| return existing;
         const gop = try self.lanes.getOrPut(self.x.e.gpa, s);
         gop.value_ptr.* = .{ .slot = slot };
+        self.touchSlot(slot);
         return gop.value_ptr;
     }
 
+    /// Standing prefix-resume match length for `s` on `slot` (0 when ineligible or no standing prefix).
+    pub fn standingMatch(self: *const Lanes, slot: u32, s: *const lanes.Stream) usize {
+        if (!self.slot_resume or s.images.len > 0 or s.prompt_logprobs != null or self.x.e.pages != null or s.reuse.saved != null) return 0;
+        if (slot >= self.standing.items.len or slot >= self.x.e.seqs.items.len) return 0;
+        const q = self.x.e.seqs.items[slot] orelse return 0;
+        const st = &self.standing.items[slot];
+        if (st.whole == 0) return 0;
+        const mask = self.policy.effective(s.policy);
+        const tail = policy_mod.retapRows(mask orelse 0, self.drafterTail());
+        return if (cutsOf(s, mask)) |cs| st.planCut(s.prompt(), q.begun, mask orelse 0, tail, cs, cut_slack) else st.plan(fw.prefill_rows, s.prompt(), q.begun, mask orelse 0, tail);
+    }
+
+    /// Prefix-affinity slot selector: (1) free slot with longest standing match, (2) lowest empty free slot, (3) LRU idle free slot.
+    pub fn chooseSlotFor(self: *const Lanes, s: *const lanes.Stream) u32 {
+        if (self.standing.items.len == 0 and seq_grow.pool == null) return self.freeSlot();
+        const limit: u32 = if (seq_grow.pool != null) @intCast(seq_grow.max_streams) else @intCast(@max(self.standing.items.len, self.x.e.seqs.items.len));
+        var best_match_slot: ?u32 = null;
+        var best_match_len: usize = 0;
+        var empty_slot: ?u32 = null;
+        var lru_slot: ?u32 = null;
+        var lru_age: u64 = std.math.maxInt(u64);
+        var slot: u32 = 0;
+        while (slot < limit) : (slot += 1) {
+            if (self.slotTaken(slot)) continue;
+            const m = self.standingMatch(slot, s);
+            if (m > best_match_len) {
+                best_match_len = m;
+                best_match_slot = slot;
+            }
+            const empty = slot >= self.standing.items.len or self.standing.items[slot].whole == 0;
+            if (empty and empty_slot == null) empty_slot = slot;
+            const age = self.slotUsed(slot);
+            if (lru_slot == null or age < lru_age) {
+                lru_slot = slot;
+                lru_age = age;
+            }
+        }
+        return best_match_slot orelse empty_slot orelse lru_slot orelse self.freeSlot();
+    }
