@@ -74,6 +74,8 @@ pub const Lanes = struct {
     costs: rule.Costs = undefined, // verify ms by rows, fit on lone windows
     slot_resume: bool = false, // TF_GLM_SLOT_RESUME (cuda_native reads it): a prompt resumes on its slot's own rows
     standing: std.ArrayList(slot_resume.Standing) = .empty, // by slot: what its last prompt pass left (rank 0)
+    slot_used: std.ArrayList(u64) = .empty, // by slot: recency clock for LRU idle slot eviction / trim
