diff --git a/zig/src/families/glm/cuda_lanes_test.zig b/zig/src/families/glm/cuda_lanes_test.zig
index d06aa0c..1e7acf5 100644
--- a/zig/src/families/glm/cuda_lanes_test.zig
+++ b/zig/src/families/glm/cuda_lanes_test.zig
@@ -139,3 +139,64 @@ test "GLM dsa shared: a segment's scratch from its first row keeps its own token
     try std.testing.expectEqual(s.tokens, f.tokens);
     try std.testing.expectEqual(s.counts, f.counts);
 }
+
+test "GLM slot resume: chooseSlotFor prefers longest standing prefix match, then empty slot, then LRU idle slot" {
+    const gpa = std.testing.allocator;
+    const types = @import("cuda_engine_types.zig");
+    var e: engine.Engine = undefined;
+    e.gpa = gpa;
+    e.pages = null;
+    e.drafter = null;
+    e.seqs = .empty;
+    defer e.seqs.deinit(gpa);
+    var q0: types.Seq = undefined;
+    var q1: types.Seq = undefined;
+    var q2: types.Seq = undefined;
+    q0.begun = 1;
+    q1.begun = 2;
+    q2.begun = 3;
+    try e.seqs.appendSlice(gpa, &.{ &q0, &q1, &q2 });
+
+    var self: Lanes = .{ .x = .{ .e = &e, .link = undefined }, .slot_resume = true };
+    defer self.deinit();
+
+    // Populate standing prefixes on slots 0 and 1, leave slot 2 empty
+    const grid = fw.prefill_rows;
+    const a_toks = try gpa.alloc(u32, grid + 10);
+    defer gpa.free(a_toks);
+    const b_toks = try gpa.alloc(u32, 2 * grid + 10);
+    defer gpa.free(b_toks);
+    const c_toks = try gpa.alloc(u32, grid + 10);
+    defer gpa.free(c_toks);
+    for (a_toks, 0..) |*t, i| t.* = @intCast(100 + i);
+    for (b_toks, 0..) |*t, i| t.* = @intCast(100000 + i);
+    for (c_toks, 0..) |*t, i| t.* = @intCast(200000 + i);
+
+    try self.standing.appendNTimes(gpa, .{}, 3);
+    self.standing.items[0].open(gpa, a_toks, 0, q0.begun, 0, true);
+    self.standing.items[0].ran(grid, 0);
+    self.standing.items[1].open(gpa, b_toks, 0, q1.begun, 0, true);
+    self.standing.items[1].ran(grid, 0);
+    // Recency: slot 1 older (1), slot 0 newer (2)
+    try self.slot_used.appendSlice(gpa, &.{ 2, 1, 0 });
+    self.slot_clock = 2;
+
+    var sb = try lanes.Stream.init(gpa, .{ .id = "b2", .prompt = b_toks, .max_new = 4 });
+    defer sb.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 1), self.chooseSlotFor(&sb)); // matches slot 1's standing prefix!
+
+    var sc = try lanes.Stream.init(gpa, .{ .id = "c", .prompt = c_toks, .max_new = 4 });
+    defer sc.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 2), self.chooseSlotFor(&sc)); // prefers empty slot 2 over warm slots 0 and 1!
+
+    // Once slot 2 also has standing rows (most recent), a brand-new prompt evicts LRU slot 1
+    self.standing.items[2].open(gpa, c_toks, 0, q2.begun, 0, true);
+    self.standing.items[2].ran(grid, 0);
+    self.slot_used.items[2] = 3;
+    const d_toks = try gpa.alloc(u32, grid + 10);
+    defer gpa.free(d_toks);
+    for (d_toks, 0..) |*t, i| t.* = @intCast(300000 + i);
+    var sd = try lanes.Stream.init(gpa, .{ .id = "d", .prompt = d_toks, .max_new = 4 });
+    defer sd.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 1), self.chooseSlotFor(&sd)); // LRU idle slot 1!
+}
diff --git a/zig/src/families/glm/cuda_seq_grow.zig b/zig/src/families/glm/cuda_seq_grow.zig
index 8a60338..4c051c3 100644
--- a/zig/src/families/glm/cuda_seq_grow.zig
+++ b/zig/src/families/glm/cuda_seq_grow.zig
@@ -198,6 +198,26 @@ pub const Region = struct {
     }
 };
 
+/// TF_GLM_SEQ_GROW_ADMIT_NEW: max output tokens reserved per stream at admission so omitted max_tokens (e.g. 1M)
+/// does not monopolize the shared VMM pool (0: legacy full max_new; default: 16384).
+pub fn admitNewAsked() usize {
+    return parseAdmitNew(if (std.c.getenv("TF_GLM_SEQ_GROW_ADMIT_NEW")) |v| std.mem.span(v) else null);
+}
+
+fn parseAdmitNew(v: ?[]const u8) usize {
+    const s = v orelse return 16384;
+    if (s.len == 0) return 16384;
+    const n = std.fmt.parseInt(usize, s, 10) catch return 16384;
+    if (n == 0) return 0;
+    return std.math.clamp(n, 256, 1024 * 1024);
+}
+
+/// Rows reserved at admission for `prompt` + `max_new` + `extra` (window + margin), bounded by `capacity`.
+pub fn admitRows(capacity: usize, prompt: usize, max_new: usize, extra: usize, cap_new: usize) usize {
+    const eff_new = if (cap_new == 0) max_new else @min(max_new, cap_new);
+    return @min(capacity, prompt +| eff_new +| extra);
+}
+
 /// A slot's hold on the pool: the granules it maps now, and a live stream's grant (what it was admitted with; 0 for an
 /// idle slot, whose rows wait for slot resume until its next pass trims them).
 pub const Slot = struct { mapped: usize, granted: usize = 0 };
@@ -733,3 +753,12 @@ test "GLM seq grow: the switch reads 1 and 0 and refuses anything else" {
     try T.expectError(error.BadSeqGrow, parse("on"));
     try T.expectError(error.BadSeqGrow, parse(""));
 }
+
+test "GLM seq grow: admitNewAsked and admitRows bound omitted max_tokens" {
+    try T.expectEqual(@as(usize, 16384), parseAdmitNew(null));
+    try T.expectEqual(@as(usize, 0), parseAdmitNew("0"));
+    try T.expectEqual(@as(usize, 8192), parseAdmitNew("8192"));
+    try T.expectEqual(@as(usize, 16000 + 8192 + 4128), admitRows(524352, 16000, 1_048_576, 4128, 8192));
+    try T.expectEqual(@as(usize, 16000 + 512 + 4128), admitRows(524352, 16000, 512, 4128, 8192));
+    try T.expectEqual(@as(usize, 524352), admitRows(524352, 16000, 1_048_576, 4128, 0));
+}
