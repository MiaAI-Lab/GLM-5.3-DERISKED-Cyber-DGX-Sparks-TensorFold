         if (self.bits) |*b| b.free();
         for (self.standing.items) |*st| st.deinit(self.x.e.gpa);
         self.standing.deinit(self.x.e.gpa);
+        self.slot_used.deinit(self.x.e.gpa);
         self.lanes.deinit(self.x.e.gpa);
     }
 
+    fn slotUsed(self: *const Lanes, slot: u32) u64 {
+        return if (slot < self.slot_used.items.len) self.slot_used.items[slot] else 0;
+    }
+
+    fn touchSlot(self: *Lanes, slot: u32) void {
+        const gpa = self.x.e.gpa;
+        if (slot >= self.slot_used.items.len) self.slot_used.appendNTimes(gpa, 0, slot + 1 - self.slot_used.items.len) catch return;
+        self.slot_clock += 1;
+        self.slot_used.items[slot] = self.slot_clock;
+    }
+
+    fn slotTaken(self: *const Lanes, slot: u32) bool {
+        var it = self.lanes.valueIterator();
+        while (it.next()) |l| if (l.slot == slot) return true;
+        return false;
+    }
