     stamp: u64 = 0, // the slot's begin stamp of that pass (Engine.begun); another begin since: nothing stands
     policy: u32 = 0,
     plain: bool = false, // text only (an image prompt's rows go by its images, not its ids)
+    cuts: std.ArrayList(u32) = .empty, // message-cut passes (policy bit 9): every point `whole` reached, in order
 
     pub fn deinit(st: *Standing, gpa: std.mem.Allocator) void {
