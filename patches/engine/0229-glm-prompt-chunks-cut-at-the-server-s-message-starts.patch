     }
 
+    /// A message-cut pass's step took `rows` rows from `start`, where its plan (the request's cuts, else the grid's
+    /// step) asked for `planned`: it extends what stands, and records the point, only as that planned chunk alone.
+    pub fn steppedCut(st: *Standing, gpa: std.mem.Allocator, start: usize, rows: usize, planned: usize) void {
+        if (!st.plain or start != st.whole or rows != planned or rows == 0) return;
+        if (start + rows >= st.tokens.items.len) return;
+        st.cuts.append(gpa, @intCast(start + rows)) catch return; // out of memory: the point is not offered
+        st.whole = start + rows;
+    }
+
+    /// Where a message-cut prompt `ids` resumes: the furthest point the last cut pass reached (or stood at) that is
+    /// within the shared tokens less `slack` (a message marker straddling the prefix's end cuts one pass only), short of
+    /// the drafter's re-tap, and a chunk start of the new prompt's own plan (`starts`), so every chunk below it was cut
+    /// from the shared tokens alone, as a cold pass of the new prompt cuts them.
+    pub fn planCut(st: *const Standing, ids: []const u32, stamp: u64, policy: u32, tail: usize, starts: []const u32, slack: usize) usize {
+        if (!st.plain or st.whole == 0 or stamp == 0 or stamp != st.stamp or policy != st.policy) return 0;
+        const same = commonPrefix(st.tokens.items[0..st.whole], ids);
+        const limit = @min(same -| slack, ids.len -| @max(tail, 1));
+        var best: usize = 0;
+        var i = st.cuts.items.len;
+        while (i > 0) : (i -= 1) {
+            const c: usize = st.cuts.items[i - 1];
+            if (c <= limit and std.mem.indexOfScalar(u32, starts, @intCast(c)) != null) {
+                best = c;
+                break;
+            }
+        }
+        return best;
+    }
+
     /// A whole pass (Engine.prefill: every chunk whole, one at a time) ran from `from` to the prompt's end.
     pub fn ran(st: *Standing, grid: usize, from: usize) void {
         const len = st.tokens.items.len;
@@ -99,6 +132,26 @@ fn pass(st: *Standing, ids: []const u32, at: usize) void {
     while (s < ids.len) : (s += G) st.stepped(G, s, @min(G, ids.len - s));
 }
 
+test "GLM slot resume: message cuts stand only on planned points both prompts share" {
+    var st: Standing = .{};
+    defer st.deinit(t.allocator);
+    const a = seq(20, 100);
+    st.open(t.allocator, &a, 0, 7, 512, true);
+    st.steppedCut(t.allocator, 0, 3, 3); // a cut at 3
+    st.steppedCut(t.allocator, 3, 4, 4); // the step's 4 rows: 7
+    st.steppedCut(t.allocator, 7, 2, 4); // a busy step's part: refused, nothing past 7 stands
+    try t.expectEqual(@as(usize, 7), st.whole);
+    const b = a ++ seq(5, 900);
+    try t.expectEqual(@as(usize, 7), st.planCut(&b, 7, 512, 0, &.{ 3, 7, 11 }, 0));
+    try t.expectEqual(@as(usize, 3), st.planCut(&b, 7, 512, 0, &.{ 3, 11 }, 0)); // 7 is no start of the new plan
+    try t.expectEqual(@as(usize, 3), st.planCut(&b, 7, 512, 0, &.{ 3, 7, 11 }, 2)); // a slack of 2: the limit is 5
+    var c = b;
+    c[5] = 1;
+    try t.expectEqual(@as(usize, 3), st.planCut(&c, 7, 512, 0, &.{ 3, 7 }, 0)); // shared only to 5
+    try t.expectEqual(@as(usize, 0), st.planCut(&c, 7, 0, 0, &.{ 3, 7 }, 0)); // another policy: nothing
+    try t.expectEqual(@as(usize, 3), st.planCut(&b, 7, 512, 22, &.{ 3, 7 }, 0)); // the re-tap of 22 rows: limit 3
+}
