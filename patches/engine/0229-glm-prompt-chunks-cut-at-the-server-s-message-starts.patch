     /// The rows the drafter re-taps at a prompt's end (a fresh pass ingests its last dflash.WIN rows), 0 without one.
+    /// Policy bit 9 (TF_GLM_MSG_CUTS=1): the stream's planned chunk starts (the server's message cuts, chunk_plan),
+    /// which its prompt steps end at and a slot resume may stand on; null for any other request.
+    fn cutsOf(s: *const lanes.Stream, mask: ?policy_mod.Mask) ?[]const u32 {
+        const m = mask orelse return null;
+        if (!policy_mod.on(m, .msg_cuts) or s.chunks.len == 0) return null;
