From 5622dff1eeffae0b929efc2c07ed09def61a7720 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <MiaAI-Lab@users.noreply.github.com>
Date: Sun, 15 Nov 2026 02:29:34 +0200
Subject: [PATCH] glm: DSpark host chain test (test-glm-dspark-host): rank
 merge, Markov alignment from the anchor, confidence

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UQVvNktFCvQrvpNUbqtqBX
---
 zig/build/glm_family_host.zig   |  1 +
 zig/src/families/glm/dspark.zig | 59 +++++++++++++++++++++++++++++++++
 2 files changed, 60 insertions(+)

diff --git a/zig/build/glm_family_host.zig b/zig/build/glm_family_host.zig
index f8cab27..469ee0a 100644
--- a/zig/build/glm_family_host.zig
+++ b/zig/build/glm_family_host.zig
@@ -20,6 +20,7 @@ pub fn steps(b: *std.Build, cuda: *std.Build.Module, glm: *std.Build.Module, mod
     index_emulated.expectExitCode(0);
     b.step("test-glm-index-emulate", "GLM's prompt indexer kernels as host C++ against a plain top-K and a model of tf_glm_scores").dependOn(&index_emulated.step);
     const kv8_run = b.addRunArtifact(b.addTest(.{ .root_module = glm, .filters = &.{ "GLM FP8 KV:", "GLM heads:" } }));
+    b.step("test-glm-dspark-host", "DSpark's host chain (candidate merge, Markov alignment, confidence) without devices").dependOn(&b.addRunArtifact(b.addTest(.{ .root_module = glm, .filters = &.{"GLM DSpark:"} })).step);
     b.step("test-glm-fp8-kv-host", "GLM latent cache layout, mode agreement and recorded CUDA launches without devices").dependOn(&kv8_run.step);
     step.dependOn(&kv8_run.step);
     const profile_run = b.addRunArtifact(b.addTest(.{ .root_module = glm, .filters = &.{"GLM prompt profile:"} }));
diff --git a/zig/src/families/glm/dspark.zig b/zig/src/families/glm/dspark.zig
index 2401264..b9227b2 100644
--- a/zig/src/families/glm/dspark.zig
+++ b/zig/src/families/glm/dspark.zig
@@ -502,3 +502,62 @@ pub fn select(dr: *const df.Drafter, i: usize, M: usize, q: df.Req) void {
         if (q.probs) |p| p[t] = conf;
     }
 }
+
+test "GLM DSpark: the chain merges ranks' candidates by value then id, biases by W2 . W1[prev] from the anchor, and scores confidence" {
+    const t = std.testing;
+    const gpa = t.allocator;
+    const V: usize = 64;
+    var sp: Spark = .{ .module = undefined, .k = undefined, .weights = undefined, .vocab = V };
+    sp.w1 = try gpa.alloc(u16, V * RANK);
+    defer gpa.free(sp.w1);
+    sp.w2 = try gpa.alloc(u16, V * RANK);
+    defer gpa.free(sp.w2);
+    @memset(sp.w1, 0);
+    @memset(sp.w2, 0);
+    sp.conf_h = try gpa.alloc(f32, D);
+    defer gpa.free(sp.conf_h);
+    @memset(sp.conf_h, 0);
+    sp.h_hn = try gpa.alloc(u16, df.MAX_M * D);
+    defer gpa.free(sp.h_hn);
+    @memset(sp.h_hn, 0);
+    sp.conf_m = @splat(0);
+    sp.conf_b = 0;
+    const one: u16 = 0x3f80; // 1.0
+    const ten: u16 = 0x4120; // 10.0
+    // after the anchor (7), candidate 9 gains 10; after 9, candidate 3 gains 10
+    sp.w1[7 * RANK + 0] = one;
+    sp.w2[9 * RANK + 0] = ten;
+    sp.w1[9 * RANK + 1] = one;
+    sp.w2[3 * RANK + 1] = ten;
+    // the confidence: w_m[1] = 2, so a draft after token 9 (W1[9][1] = 1) has logit 2
+    sp.conf_m[1] = 2;
+    const world: usize = 2;
+    const M: usize = df.BLOCK;
+    const cand = try gpa.alloc(i32, world * M * df.CW);
+    defer gpa.free(cand);
+    @memset(cand, -1);
+    // every slot: rank 0 offers ids 1 (value 2.0) and 9 (1.0); rank 1 offers 3 (0.5) and 2 (2.0, ties 1: lower id wins)
+    for (0..M) |r| {
+        const put = struct {
+            fn f(c: []i32, rk: usize, row: usize, j: usize, id: i32, v: f32) void {
+                const base = rk * M * df.CW + row * df.CW;
+                c[base + j] = id;
+                c[base + df.TOPK + j] = @bitCast(v);
+            }
+        }.f;
+        put(cand, 0, r, 0, 1, 2.0);
+        put(cand, 0, r, 1, 9, 1.0);
+        put(cand, 1, r, 0, 2, 2.0);
+        put(cand, 1, r, 1, 3, 0.5);
+    }
+    var dr: df.Drafter = .{ .gpa = gpa, .d = undefined, .module = undefined, .k = undefined, .weights = undefined, .split = false, .ff = FF, .rank = 0, .world = world, .spark = &sp };
+    dr.cand = cand;
+    var out: [df.BLOCK - 1]u32 = undefined;
+    var probs: [df.BLOCK - 1]f64 = undefined;
+    select(&dr, 0, M, .{ .slot = 0, .pos = 100, .n = 0, .anchor = 7, .out = &out, .probs = &probs });
+    // slot 0: prev 7 -> 9 scores 1 + 10 = 11 (best); slot 1: prev 9 -> 3 scores 0.5 + 10; slot 2: prev 3 -> no bias,
+    // values 2.0 (ids 1 and 2): id 1; then prev 1 -> 1 again
+    try t.expectEqualSlices(u32, &.{ 9, 3, 1, 1, 1, 1, 1 }, &out);
+    try t.expectApproxEqAbs(@as(f64, 0.5), probs[0], 1e-12); // after the anchor 7: z = 0
+    try t.expectApproxEqAbs(1.0 / (1.0 + @exp(-2.0)), probs[1], 1e-12); // after 9: z = 2
+}
