diff --git a/zig/kernels/cuda/exl3_experts.cu b/zig/kernels/cuda/exl3_experts.cu
index b215ff970..33e627962 100644
--- a/zig/kernels/cuda/exl3_experts.cu
+++ b/zig/kernels/cuda/exl3_experts.cu
@@ -92,6 +92,15 @@ extern "C" __global__ void tf_exl3_grouped_2_k8r8p(tf_exl3::GroupedArgs a) {
 extern "C" __global__ void tf_exl3_grouped_2_k8r16p(tf_exl3::GroupedArgs a) {
     tf_exl3::grouped_body_v2<2, 4, 4, GROUPED_SHFL_PDL, 8, 16>(a, blockIdx.x, blockIdx.y, blockIdx.z);
 }
+// neon rank #11 (GLM policy bit 28): the same two with the grid's x and y swapped (column blocks fastest, an expert's
+// blocks launched together): each block's (expert, column block, z) and its sums unchanged, the same bits
+// (night/neon/gputest t5_exl3.out: +0.4-8.2% gate/up, +3.9-4.7% down on GB10, cold weights)
+extern "C" __global__ void tf_exl3_grouped_2_k8r8p_uo(tf_exl3::GroupedArgs a) {
+    tf_exl3::grouped_body_v2<2, 4, 4, GROUPED_SHFL_PDL, 8, 8>(a, blockIdx.y, blockIdx.x, blockIdx.z);
+}
+extern "C" __global__ void tf_exl3_grouped_2_k8r16p_uo(tf_exl3::GroupedArgs a) {
+    tf_exl3::grouped_body_v2<2, 4, 4, GROUPED_SHFL_PDL, 8, 16>(a, blockIdx.y, blockIdx.x, blockIdx.z);
+}
 
 namespace tf_exl3 {
 
@@ -285,6 +294,12 @@ __device__ __forceinline__ void down_combine_body(const DownArgs& a) {
 }
 extern "C" __global__ void tf_exl3_down_combine(const DownArgs a) { down_combine_body<false>(a); }
 extern "C" __global__ void tf_exl3_down_combine_nd(const DownArgs a) { down_combine_body<true>(a); }
+// neon rank #11 (bit 28): tf_exl3_down_combine_nd as a dependent launch: it waits for the down projection before any
+// read (z, pick, y, wts, extra) or store, the same bits
+extern "C" __global__ void tf_exl3_down_combine_ndp(const DownArgs a) {
+    tf_exl3::pdl_wait();
+    down_combine_body<true>(a);
+}
 
 }  // namespace tf_exl3
 
diff --git a/zig/kernels/cuda/glm_glue_l2.cuh b/zig/kernels/cuda/glm_glue_l2.cuh
index 646868c9d..a71129cd2 100644
--- a/zig/kernels/cuda/glm_glue_l2.cuh
+++ b/zig/kernels/cuda/glm_glue_l2.cuh
@@ -49,3 +49,12 @@ extern "C" __global__ void __launch_bounds__(32)
     }
   }
 }
+
+// tf_glm_l2_epoch (neon #5, policy bit 29): stopV2's store as a dependent launch. It lets the window's next dependent
+// launch start at once, then waits for the gather before it (the grid ahead) and writes `epoch` to `stop`: the paced
+// sites end as with the memset, and the chain of dependent launches is not broken by a memset node. Writes no tensor.
+extern "C" __global__ void __launch_bounds__(32) tf_glm_l2_epoch(uint32_t* stop, uint32_t epoch) {
+  asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+  asm volatile("griddepcontrol.wait;" ::: "memory");
+  if (threadIdx.x == 0) *reinterpret_cast<volatile uint32_t*>(stop) = epoch;
+}
