diff --git a/zig/src/families/glm/cuda_seq_grow.zig b/zig/src/families/glm/cuda_seq_grow.zig
new file mode 100644
index 000000000..8a60338ec
--- /dev/null
+++ b/zig/src/families/glm/cuda_seq_grow.zig
@@ -0,0 +1,735 @@
+//! TF_GLM_SEQ_GROW=1: a sequence's rows take device memory as they grow, from one pool every stream shares.
+//!
+//! Without it each stream's State is one allocation sized for the whole window (--context), so --parallel N needs N
+//! whole windows and a TP4 K4 rank fits one. With it every State reserves virtual addresses for the whole window, as
+//! before, but its row-sized fields (each MLA layer's latent rows and their int8 scale planes, the indexer layers'
+//! index keys) are backed by physical granules only up to the rows its passes reach (State.ready), plus a margin. The
+//! granules come from a pool made at startup with exactly the granules one whole-window State needs, so a lone stream
+//! still reaches the full window, and several streams decode together while their rows fit the pool together.
+//!
+//! The addresses a kernel sees are the same kind as before (one contiguous range a field, the same offsets inside
+//! it), and no kernel reads a row past the rows its pass covers (State.reset: "the caches past it are never read"), so
+//! the bytes every kernel reads and writes are the same with the switch on or off. Newly mapped granules are zeroed, as
+//! the whole-window arena was at its allocation.
+//!
+//! Admission (rank 0, cuda_lanes): a request is admitted only if the pool holds the granules of its prompt + its
+//! max_tokens + a window + the margin beside what the other slots hold (a live stream: the most of what it maps and
+//! what it was admitted with; an idle slot: what it maps). Otherwise LaneMemory: the lane host requeues it until a
+//! stream ends. Every rank maps the same granules in the same order (the same passes on the same layouts), so the
+//! followers' pools, the same size, never run out where rank 0's does not.
+
+const std = @import("std");
+const cuda = @import("cuda");
+
+/// Rows mapped past a pass's last row: kernels that tile rows read whole tiles (one prompt chunk is ample).
+pub const margin_rows = 4096;
+
+/// One row-sized plane of a field: it starts `off` bytes into the field, row r at off + r * row.
+pub const Plane = struct { off: usize, row: usize };
+
+/// A State field backed by granules: `off` bytes into the region (granule aligned), `len` bytes long, its planes.
+pub const Field = struct {
+    off: usize,
+    len: usize,
+    planes: [2]Plane = .{ .{ .off = 0, .row = 0 }, .{ .off = 0, .row = 0 } },
+    np: u8 = 1,
+};
+
+/// The granules [lo, hi) of the region that hold field f's first `rows` rows (each plane's prefix, merged).
+fn spans(f: Field, g: usize, rows: usize, out: *[2][2]usize) usize {
+    var n: usize = 0;
+    for (f.planes[0..f.np]) |p| {
+        if (rows == 0 or p.row == 0) continue;
+        const a = f.off + p.off;
+        const b = @min(f.off + f.len, a + rows * p.row);
+        if (b <= a) continue;
+        const lo = a / g;
+        const hi = (b + g - 1) / g;
+        if (n > 0 and lo <= out[n - 1][1]) { // the planes are in order: a span that touches the last merges into it
+            out[n - 1][1] = @max(out[n - 1][1], hi);
+        } else {
+            out[n] = .{ lo, hi };
+            n += 1;
+        }
+    }
+    return n;
+}
+
+/// Granules the fields' first `rows` rows need (the admission's measure; Region.ensure maps exactly these).
+pub fn granulesFor(fields: []const Field, g: usize, rows: usize) usize {
+    var total: usize = 0;
+    for (fields) |f| {
+        var s: [2][2]usize = undefined;
+        const n = spans(f, g, rows, &s);
+        for (s[0..n]) |x| total += x[1] - x[0];
+    }
+    return total;
+}
+
+/// Where granules come from and how they are placed: the device pool, or a test's fake.
+pub const Mapper = struct {
+    ctx: *anyopaque,
+    granularity: usize,
+    take: *const fn (ctx: *anyopaque) ?u64, // a free granule's handle, null: the pool is empty
+    give: *const fn (ctx: *anyopaque, h: u64) void,
+    map: *const fn (ctx: *anyopaque, va: u64, h: u64) Mapped, // map, set access, zero
+    unmap: *const fn (ctx: *anyopaque, va: u64) bool, // false: still mapped (the handle must not go back)
+    reserve: *const fn (ctx: *anyopaque, len: usize) ?u64, // a virtual range of `len` (granule multiple) bytes
+    unreserve: *const fn (ctx: *anyopaque, va: u64, len: usize) void,
+};
+
+/// A map's outcome: ok; failed (nothing mapped: the handle may go back); stuck (the mapping could not be undone: the
+/// handle never goes back, its addresses stay reserved).
+pub const Mapped = enum { ok, failed, stuck };
+
+pub const Error = error{ LaneMemory, SeqGrowMap, SeqGrowReserve, OutOfMemory };
+
+/// One State's growable fields: their virtual range and the handle mapped at each granule (0: none).
+pub const Region = struct {
+    gpa: std.mem.Allocator,
+    m: Mapper,
+    va: u64,
+    len: usize,
+    fields: []Field,
+    handles: []u64,
+    mapped: usize = 0, // granules mapped now
+    covered: usize = 0, // rows every field holds mapped (ensure's fast path)
+    unmap_failed: usize = 0, // granules the driver would not unmap (kept mapped, never given back)
+    broken: bool = false, // a granule is mapped but unusable (access or zeroing failed, unmap too): every ensure fails
+
+    /// Lays `sizes` out granule aligned (zero sizes take no room) and reserves their range; `out[i]` gets field i's
+    /// address. `planes_of(i)` gives field i's planes. Nothing is mapped yet.
+    pub fn init(gpa: std.mem.Allocator, m: Mapper, sizes: []const usize, planes: []const ?[2]Plane, nplanes: []const u8, out: []u64) Error!Region {
+        const g = m.granularity;
+        var fields: std.ArrayList(Field) = .empty;
+        errdefer fields.deinit(gpa);
+        var off: usize = 0;
+        const at = try gpa.alloc(usize, sizes.len);
+        defer gpa.free(at);
+        for (sizes, planes, nplanes, 0..) |n, p, np, i| {
+            at[i] = off;
+            if (n == 0) continue;
+            const pl: [2]Plane = p orelse .{ Plane{ .off = 0, .row = 0 }, Plane{ .off = 0, .row = 0 } };
+            try fields.append(gpa, .{ .off = off, .len = n, .planes = pl, .np = np });
+            off += std.mem.alignForward(usize, n, g);
+        }
+        const len = @max(off, g);
+        const va = m.reserve(m.ctx, len) orelse return error.SeqGrowReserve;
+        errdefer m.unreserve(m.ctx, va, len);
+        const handles = try gpa.alloc(u64, len / g);
+        @memset(handles, 0);
+        for (out, at, sizes) |*o, a, n| o.* = if (n == 0) 0 else va + a;
+        return .{ .gpa = gpa, .m = m, .va = va, .len = len, .fields = try fields.toOwnedSlice(gpa), .handles = handles };
+    }
+
+    pub fn deinit(r: *Region) void {
+        r.trim(0);
+        // a granule still mapped keeps its addresses reserved (freeing them under a mapping is undefined); its
+        // handle is leaked with them rather than reused
+        if (r.mapped == 0) r.m.unreserve(r.m.ctx, r.va, r.len) else std.log.err("seq grow: {d} granules would not unmap; their range stays reserved", .{r.mapped});
+        r.gpa.free(r.handles);
+        r.gpa.free(r.fields);
+        r.* = undefined;
+    }
+
+    /// Every field's first `rows` rows mapped (and zeroed when newly mapped). LaneMemory: the pool ran out (the
+    /// granules mapped so far stay; admission keeps this from happening).
+    pub fn ensure(r: *Region, rows: usize) Error!void {
+        if (r.broken) return error.SeqGrowMap; // a stuck granule may not be read as mapped and zeroed
+        if (rows <= r.covered) return;
+        const g = r.m.granularity;
+        for (r.fields) |f| {
+            var s: [2][2]usize = undefined;
+            const n = spans(f, g, rows, &s);
+            for (s[0..n]) |x| for (x[0]..x[1]) |k| {
+                if (r.handles[k] != 0) continue;
+                const h = r.m.take(r.m.ctx) orelse return error.LaneMemory;
+                switch (r.m.map(r.m.ctx, r.va + k * g, h)) {
+                    .ok => {},
+                    .failed => {
+                        r.m.give(r.m.ctx, h);
+                        return error.SeqGrowMap;
+                    },
+                    .stuck => { // mapped but unusable: counted as this region's so it is never handed out again, and
+                        // the region refuses every pass from here (its rows are not all accessible and zeroed)
+                        r.handles[k] = h;
+                        r.mapped += 1;
+                        r.unmap_failed += 1;
+                        r.broken = true;
+                        return error.SeqGrowMap;
+                    },
+                }
+                r.handles[k] = h;
+                r.mapped += 1;
+            };
+        }
+        r.covered = rows;
+    }
+
+    /// Unmaps every granule the first `rows` rows do not need (the caller has drained the work that read them).
+    pub fn trim(r: *Region, rows: usize) void {
+        const g = r.m.granularity;
+        var keep = std.bit_set.DynamicBitSetUnmanaged.initEmpty(r.gpa, r.handles.len) catch {
+            return; // no room for the mask: keep everything (a trim only gives memory back)
+        };
+        defer keep.deinit(r.gpa);
+        for (r.fields) |f| {
+            var s: [2][2]usize = undefined;
+            const n = spans(f, g, rows, &s);
+            for (s[0..n]) |x| keep.setRangeValue(.{ .start = x[0], .end = x[1] }, true);
+        }
+        for (r.handles, 0..) |*h, k| if (h.* != 0 and !keep.isSet(k)) {
+            // a granule the driver would not unmap stays this region's (mapped, counted): it never goes back to the
+            // pool while an address still maps it
+            if (!r.m.unmap(r.m.ctx, r.va + k * g)) {
+                r.unmap_failed += 1;
+                continue;
+            }
+            r.m.give(r.m.ctx, h.*);
+            h.* = 0;
+            r.mapped -= 1;
+        };
+        r.covered = @min(r.covered, rows);
+    }
+
+    /// Granules the first `rows` rows of these fields need.
+    pub fn need(r: *const Region, rows: usize) usize {
+        return granulesFor(r.fields, r.m.granularity, rows);
+    }
+};
+
+/// A slot's hold on the pool: the granules it maps now, and a live stream's grant (what it was admitted with; 0 for an
+/// idle slot, whose rows wait for slot resume until its next pass trims them).
+pub const Slot = struct { mapped: usize, granted: usize = 0 };
+
+/// Whether a stream needing `need` granules fits on slot `f` beside the other slots (null: no sequence there). A slot's
+/// charge is the most of what it maps and what it was granted; slot `f`'s, the most of what it maps and `need` (its
+/// next pass trims what it does not keep).
+pub fn admits(total: usize, slots: []const ?Slot, f: usize, need: usize) bool {
+    var used: usize = 0;
+    var taken = false;
+    for (slots, 0..) |q, i| {
+        const x = q orelse continue;
+        var charge = @max(x.mapped, x.granted);
+        if (i == f) {
+            charge = @max(x.mapped, need);
+            taken = true;
+        }
+        used += charge;
+    }
+    if (!taken) used += need;
+    return used <= total;
+}
+
+/// The bytes the server's startup admission charges each stream past the first (its "stream_bytes").
+///
+/// Off: a stream's whole arena, as before. On: 0 (the bound is TF_GLM_SEQ_GROW_STREAMS, checked on every rank against
+/// MemAvailable at startup: headroomOk). The startup budget is the rank's room above its reserve after the
+/// engine loaded, and on a TP4 K4 rank at the release window that room is already below zero (the first sequence, made
+/// before the room is read, runs ~4.5-5 GiB into the 8.5 GiB reserve; x6c2's P2/P4 refusals measure it), so any
+/// charge, however small, refuses every --parallel above 1. With the switch on the window's rows are in the pool, made
+/// before the room is read exactly as the first sequence was; each further stream adds only its fixed parts (its small
+/// arena and its DFlash2 ring, ~48 MiB), made when it binds, as every stream past the first always was. Startup logs
+/// that figure; MEMGUARD's floor still watches the box.
+pub fn admittedStreamBytes(on: bool, real: u64) u64 {
+    return if (on) 0 else real;
+}
+
+/// TF_GLM_SEQ_GROW_STREAMS: the most streams that may hold a sequence at once with the pool (1..16, default 4). The
+/// lanes never seat a slot at or past it (LaneMemory: the request waits), whatever --parallel says, and every rank checks
+/// at startup that its real headroom holds the further streams' fixed parts (`headroomOk`).
+pub var max_streams: usize = 4;
+
+pub fn streamsAsked() !usize {
+    return parseStreams(if (std.c.getenv("TF_GLM_SEQ_GROW_STREAMS")) |v| std.mem.span(v) else null);
+}
+
+fn parseStreams(v: ?[]const u8) !usize {
+    const s = v orelse return 4;
+    const n = std.fmt.parseInt(usize, s, 10) catch return error.BadSeqGrowStreams;
+    if (n < 1 or n > 16) return error.BadSeqGrowStreams;
+    return n;
+}
+
+/// The floor a rank's MemAvailable must keep above the further streams' fixed parts: the stages' load abort level,
+/// above MEMGUARD's 2 GiB. The startup reserve (8.5 GiB at TP4) is not the bound here: the release window already
+/// runs inside it (admittedStreamBytes).
+pub const hard_floor: u64 = 3 << 30;
+
+/// Whether `available` bytes (MemAvailable, with the pool made) hold `streams - 1` further streams of `per` bytes
+/// each above hard_floor.
+pub fn headroomOk(available: u64, streams: usize, per: u64) bool {
+    return headroomAt(hard_floor, available, streams, per);
+}
+
+pub fn headroomAt(floor: u64, available: u64, streams: usize, per: u64) bool {
+    const need = std.math.mul(u64, streams -| 1, per) catch return false;
+    return available >= floor +| need;
+}
+
+/// TF_GLM_SEQ_GROW_FLOOR_MIB: the floor `headroomAt` keeps, default hard_floor (3072). A rank whose weights leave less
+/// than 3 GiB beside the pool at startup (EXLR8 up1 on TP4: spark1 idles at 2.7-3.1 GiB) lowers it, to no less than
+/// MEMGUARD's 2 GiB plus the check's own 256 MiB. Memory only: no kernel, no byte of a reply changes with it; unset, the
+/// check is exactly as before. It must read the same on every rank (every rank's verdict counts).
+pub const floor_min_mib: u64 = 2304;
+
+pub fn floorAsked() !u64 {
+    return parseFloorMib(if (std.c.getenv("TF_GLM_SEQ_GROW_FLOOR_MIB")) |v| std.mem.span(v) else null);
+}
+
+fn parseFloorMib(v: ?[]const u8) !u64 {
+    const s = v orelse return hard_floor;
+    const n = std.fmt.parseInt(u64, s, 10) catch return error.BadSeqGrowFloor;
+    if (n < floor_min_mib or n > 65535) return error.BadSeqGrowFloor;
+    return n << 20;
+}
+
+/// MemAvailable in bytes (null: /proc/meminfo unreadable).
+pub fn memAvailable() ?u64 {
+    var buf: [8192]u8 = undefined;
+    const fd = std.c.open("/proc/meminfo", .{ .ACCMODE = .RDONLY });
+    if (fd < 0) return null;
+    defer _ = std.c.close(fd);
+    const n = std.c.read(fd, &buf, buf.len);
+    if (n <= 0) return null;
+    return memAvailableOf(buf[0..@intCast(n)]);
+}
+
+fn memAvailableOf(text: []const u8) ?u64 {
+    var it = std.mem.splitScalar(u8, text, '\n');
+    while (it.next()) |line| {
+        if (!std.mem.startsWith(u8, line, "MemAvailable:")) continue;
+        var f = std.mem.tokenizeScalar(u8, line["MemAvailable:".len..], ' ');
+        const kb = std.fmt.parseInt(u64, f.next() orelse return null, 10) catch return null;
+        if (!std.mem.eql(u8, f.next() orelse return null, "kB")) return null;
+        return std.math.mul(u64, kb, 1024) catch null;
+    }
+    return null;
+}
+
+/// One rank's startup word for the agreement over the ranks (cuda_native): off (0), or on with its stream cap (0: not
+/// readable) and whether its headroom fits.
+pub const Verdict = struct {
+    on: bool,
+    cap: usize = 0,
+    fits: bool = false,
+    floor_mib: u64 = 0, // TF_GLM_SEQ_GROW_FLOOR_MIB as this rank read it (0: unreadable): every rank must agree on it
+
+    pub fn encode(v: Verdict) u64 {
+        if (!v.on) return 0;
+        return (@as(u64, @min(v.floor_mib, 0xffff)) << 40) | (1 << 32) | (@as(u64, @intCast(@min(v.cap, 0xffff))) << 8) | @intFromBool(v.fits);
+    }
+
+    pub const Agreed = union(enum) { off, on: usize, refuse: []const u8 };
+
+    /// Every rank's word: all off -> off; all on with one readable cap and every one fitting -> on(cap); else refuse.
+    pub fn agree(words: []const u64) Agreed {
+        if (words.len == 0) return .{ .refuse = "no ranks" };
+        var on: usize = 0;
+        for (words) |w| on += @intFromBool(w != 0);
+        if (on == 0) return .off;
+        if (on != words.len) return .{ .refuse = "TF_GLM_SEQ_GROW differs between the ranks" };
+        const cap = (words[0] >> 8) & 0xffff;
+        const floor = (words[0] >> 40) & 0xffff;
+        for (words) |w| {
+            if ((w >> 32) & 0xff != 1) return .{ .refuse = "a malformed word" };
+            if ((w >> 8) & 0xffff != cap) return .{ .refuse = "TF_GLM_SEQ_GROW_STREAMS differs between the ranks" };
+            if ((w >> 40) & 0xffff != floor) return .{ .refuse = "TF_GLM_SEQ_GROW_FLOOR_MIB differs between the ranks" };
+        }
+        if (floor == 0) return .{ .refuse = "TF_GLM_SEQ_GROW_FLOOR_MIB is not 2304..65535" };
+        if (cap == 0) return .{ .refuse = "TF_GLM_SEQ_GROW_STREAMS is not 1..16" };
+        for (words) |w| if (w & 1 == 0) return .{ .refuse = "a rank's MemAvailable cannot hold the streams' fixed parts above the floor (or /proc/meminfo is unreadable)" };
+        return .{ .on = @intCast(cap) };
+    }
+};
+
+/// The device pool: `total` granule handles made at startup (cuMemCreate), mapped and unmapped as rows grow.
+pub const Pool = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    lib: std.DynLib,
+    api: Api,
+    prop: Prop,
+    device: c_int,
+    granularity: usize,
+    free: std.ArrayList(u64) = .empty,
+    total: usize = 0,
+
+    const R = c_int;
+    const Api = struct {
+        reserve: *const fn (*u64, usize, usize, u64, c_ulonglong) callconv(.c) R,
+        addressFree: *const fn (u64, usize) callconv(.c) R,
+        create: *const fn (*u64, usize, *const Prop, c_ulonglong) callconv(.c) R,
+        release: *const fn (u64) callconv(.c) R,
+        map: *const fn (u64, usize, usize, u64, c_ulonglong) callconv(.c) R,
+        unmap: *const fn (u64, usize) callconv(.c) R,
+        setAccess: *const fn (u64, usize, *const AccessDesc, usize) callconv(.c) R,
+        granularity: *const fn (*usize, *const Prop, c_int) callconv(.c) R,
+    };
+    const Prop = extern struct { // CUmemAllocationProp, as cuda/arena.zig's Vmm
+        type: c_int = 1,
+        handle_types: c_int = 0,
+        loc_type: c_int = 1,
+        loc_id: c_int = 0,
+        win32: ?*anyopaque = null,
+        compression: u8 = 0,
+        rdma: u8 = 0,
+        usage: u16 = 0,
+        reserved: [4]u8 = .{ 0, 0, 0, 0 },
+    };
+    const AccessDesc = extern struct { loc_type: c_int = 1, loc_id: c_int, flags: c_int = 3 };
+
+    comptime {
+        std.debug.assert(@sizeOf(Prop) == 32 and @offsetOf(Prop, "compression") == 24 and @sizeOf(AccessDesc) == 12);
+    }
+
+    /// The driver's VMM calls and its granularity (at least 2 MiB); no granules yet.
+    pub fn open(gpa: std.mem.Allocator, d: *const cuda.Driver) !*Pool {
+        var dev: c_int = 0;
+        try d.check(d.api.cuCtxGetDevice(&dev), "cuCtxGetDevice");
+        var ok: c_int = 0;
+        if (d.api.cuDeviceGetAttribute(&ok, .virtual_memory_management_supported, dev) != 0 or ok == 0) return error.SeqGrowUnsupported;
+        var lib = std.DynLib.open("libcuda.so.1") catch return error.SeqGrowUnsupported;
+        errdefer lib.close();
+        var api: Api = undefined;
+        const names = .{ .{ "reserve", "cuMemAddressReserve" }, .{ "addressFree", "cuMemAddressFree" }, .{ "create", "cuMemCreate" }, .{ "release", "cuMemRelease" }, .{ "map", "cuMemMap" }, .{ "unmap", "cuMemUnmap" }, .{ "setAccess", "cuMemSetAccess" }, .{ "granularity", "cuMemGetAllocationGranularity" } };
+        inline for (names) |n| @field(api, n[0]) = lib.lookup(@FieldType(Api, n[0]), n[1]) orelse return error.SeqGrowUnsupported;
+        const prop: Prop = .{ .loc_id = dev };
+        var g: usize = 0;
+        if (api.granularity(&g, &prop, 1) != 0 or g == 0) return error.SeqGrowUnsupported; // RECOMMENDED
+        g = std.mem.alignForward(usize, @max(g, 2 << 20), g);
+        const p = try gpa.create(Pool);
+        p.* = .{ .gpa = gpa, .d = d, .lib = lib, .api = api, .prop = prop, .device = dev, .granularity = g };
+        return p;
+    }
+
+    /// Makes `n` more granules (physical memory now: the pool's whole size is held from startup on).
+    pub fn grow(p: *Pool, n: usize) !void {
+        try p.free.ensureUnusedCapacity(p.gpa, n);
+        for (0..n) |_| {
+            var h: u64 = 0;
+            if (p.api.create(&h, p.granularity, &p.prop, 0) != 0) return error.OutOfMemory;
+            p.free.appendAssumeCapacity(h);
+            p.total += 1;
+        }
+    }
+
+    pub fn close(p: *Pool) void {
+        for (p.free.items) |h| _ = p.api.release(h);
+        p.free.deinit(p.gpa);
+        p.lib.close();
+        p.gpa.destroy(p);
+    }
+
+    pub fn mapper(p: *Pool) Mapper {
+        return .{ .ctx = p, .granularity = p.granularity, .take = take, .give = give, .map = map, .unmap = unmap, .reserve = reserve, .unreserve = unreserve };
+    }
+
+    pub fn available(p: *const Pool) usize {
+        return p.free.items.len;
+    }
+
+    fn of(ctx: *anyopaque) *Pool {
+        return @ptrCast(@alignCast(ctx));
+    }
+    fn take(ctx: *anyopaque) ?u64 {
+        return of(ctx).free.pop();
+    }
+    fn give(ctx: *anyopaque, h: u64) void {
+        of(ctx).free.appendAssumeCapacity(h); // its slot was reserved when the pool grew
+    }
+    fn map(ctx: *anyopaque, va: u64, h: u64) Mapped {
+        const p = of(ctx);
+        if (p.api.map(va, p.granularity, 0, h, 0) != 0) return .failed;
+        const desc: AccessDesc = .{ .loc_id = p.device };
+        if (p.api.setAccess(va, p.granularity, &desc, 1) != 0 or p.d.api.cuMemsetD8_v2(va, 0, p.granularity) != cuda.abi.success) {
+            return if (p.api.unmap(va, p.granularity) == 0) .failed else .stuck;
+        }
+        return .ok;
+    }
+    fn unmap(ctx: *anyopaque, va: u64) bool {
+        const p = of(ctx);
+        return p.api.unmap(va, p.granularity) == 0;
+    }
+    fn reserve(ctx: *anyopaque, len: usize) ?u64 {
+        const p = of(ctx);
+        var va: u64 = 0;
+        if (p.api.reserve(&va, len, p.granularity, 0, 0) != 0) return null;
+        return va;
+    }
+    fn unreserve(ctx: *anyopaque, va: u64, len: usize) void {
+        _ = of(ctx).api.addressFree(va, len);
+    }
+};
+
+/// TF_GLM_SEQ_GROW: "1" on, unset or "0" off; anything else refused by name.
+pub fn asked() !bool {
+    return parse(if (std.c.getenv("TF_GLM_SEQ_GROW")) |v| std.mem.span(v) else null);
+}
+
+fn parse(v: ?[]const u8) !bool {
+    const s = v orelse return false;
+    if (std.mem.eql(u8, s, "0")) return false;
+    if (std.mem.eql(u8, s, "1")) return true;
+    return error.BadSeqGrow;
+}
+
+/// The engine's pool (null: off). Set once at startup, before the first sequence; every State made after draws on it.
+pub var pool: ?*Pool = null;
+
+// -- tests: a fake mapper (addresses and handles only) ---------------------------------------------------------------
+
+const Fake = struct {
+    free: std.ArrayList(u64) = .empty,
+    live: std.AutoHashMapUnmanaged(u64, u64) = .empty, // va -> handle
+    zeroed: usize = 0,
+    refuse_unmap: bool = false, // a driver that will not unmap
+    stick_next: bool = false, // the next map is mapped but unusable (.stuck)
+    next_va: u64 = 1 << 40,
+    gpa: std.mem.Allocator,
+    g: usize,
+
+    fn init(gpa: std.mem.Allocator, g: usize, n: usize) !Fake {
+        var f: Fake = .{ .gpa = gpa, .g = g };
+        try f.free.ensureTotalCapacity(gpa, n);
+        for (0..n) |i| f.free.appendAssumeCapacity(i + 1);
+        return f;
+    }
+    fn deinit(f: *Fake) void {
+        f.free.deinit(f.gpa);
+        f.live.deinit(f.gpa);
+    }
+    fn mapper(f: *Fake) Mapper {
+        return .{ .ctx = f, .granularity = f.g, .take = ftake, .give = fgive, .map = fmap, .unmap = funmap, .reserve = freserve, .unreserve = funreserve };
+    }
+    fn of(ctx: *anyopaque) *Fake {
+        return @ptrCast(@alignCast(ctx));
+    }
+    fn ftake(ctx: *anyopaque) ?u64 {
+        return of(ctx).free.pop();
+    }
+    fn fgive(ctx: *anyopaque, h: u64) void {
+        of(ctx).free.appendAssumeCapacity(h);
+    }
+    fn fmap(ctx: *anyopaque, va: u64, h: u64) Mapped {
+        const f = of(ctx);
+        std.debug.assert(va % f.g == 0);
+        const gop = f.live.getOrPut(f.gpa, va) catch return .failed;
+        std.debug.assert(!gop.found_existing); // never mapped twice
+        gop.value_ptr.* = h;
+        if (f.stick_next) {
+            f.stick_next = false;
+            return .stuck;
+        }
+        f.zeroed += 1;
+        return .ok;
+    }
+    fn funmap(ctx: *anyopaque, va: u64) bool {
+        const f = of(ctx);
+        if (f.refuse_unmap) return false;
+        std.debug.assert(f.live.remove(va));
+        return true;
+    }
+    fn freserve(ctx: *anyopaque, len: usize) ?u64 {
+        const f = of(ctx);
+        const va = f.next_va;
+        f.next_va += std.mem.alignForward(usize, len, f.g) + f.g;
+        return va;
+    }
+    fn funreserve(_: *anyopaque, _: u64, _: usize) void {}
+};
+
+const T = std.testing;
+
+/// A kv8 latent field (codes then scales) of `cap` rows, then an index-key field, as cuda_state lays them out.
+fn testRegion(gpa: std.mem.Allocator, m: Mapper, cap: usize, out: *[3]u64) !Region {
+    const sizes = [_]usize{ 64, cap * (576 + 8), cap * 256 }; // a fixed field (no planes) is given 0 here by the caller
+    const planes = [_]?[2]Plane{ null, .{ .{ .off = 0, .row = 576 }, .{ .off = cap * 576, .row = 8 } }, .{ .{ .off = 0, .row = 256 }, .{ .off = 0, .row = 0 } } };
+    const np = [_]u8{ 0, 2, 1 };
+    var s = sizes;
+    s[0] = 0; // fixed fields live in the State's own arena
+    return Region.init(gpa, m, &s, &planes, &np, out);
+}
+
+test "GLM seq grow: granules follow the rows: each plane's prefix, merged where codes meet scales" {
+    const g: usize = 4096;
+    const cap: usize = 1000;
+    var f = try Fake.init(T.allocator, g, 1000);
+    defer f.deinit();
+    var out: [3]u64 = undefined;
+    var r = try testRegion(T.allocator, f.mapper(), cap, &out);
+    defer r.deinit();
+    try T.expectEqual(@as(u64, 0), out[0]);
+    try T.expect(out[1] % g == 0 and out[2] % g == 0 and out[2] > out[1]);
+    // 10 rows: codes 5,760 B (2 granules), scales at 576,000 .. 576,080 (1 granule), keys 2,560 B (1 granule)
+    try T.expectEqual(@as(usize, 4), r.need(10));
+    try r.ensure(10);
+    try T.expectEqual(@as(usize, 4), r.mapped);
+    try T.expectEqual(@as(usize, 4), f.live.count());
+    // the whole capacity: the field's granules, codes and scales sharing the one they meet in
+    const whole_lat = (cap * (576 + 8) + g - 1) / g;
+    const whole_ik = (cap * 256 + g - 1) / g;
+    try T.expectEqual(whole_lat + whole_ik, r.need(cap));
+    try r.ensure(cap);
+    try T.expectEqual(whole_lat + whole_ik, r.mapped);
+    try T.expectEqual(@as(usize, 1000 - whole_lat - whole_ik), f.free.items.len);
+}
