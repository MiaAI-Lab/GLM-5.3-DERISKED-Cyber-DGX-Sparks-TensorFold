@@ -0,0 +1,91 @@
+//! TF_GLM_SEQ_GROW on a device (TF_SEQ_GROW_GPU=1; skipped without): the real pool's granules mapped, zeroed, kept
+//! across trims, refused when spent, given back. Rows are written and read back through the driver.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const grow = @import("cuda_seq_grow.zig");
+
+const T = std.testing;
+
+fn put(d: *const cuda.Driver, va: u64, bytes: []const u8) !void {
+    try d.check(d.api.cuMemcpyHtoD_v2(va, bytes.ptr, bytes.len), "cuMemcpyHtoD");
+}
+
+fn get(d: *const cuda.Driver, va: u64, out: []u8) !void {
+    try d.check(d.api.cuMemcpyDtoH_v2(out.ptr, va, out.len), "cuMemcpyDtoH");
+}
+
+/// A kv8 latent field (576-byte codes then 8-byte scales) and an index-key field (256 B) of `cap` rows, as cuda_state.
+fn region(gpa: std.mem.Allocator, m: grow.Mapper, cap: usize, out: *[2]u64) !grow.Region {
+    const sizes = [_]usize{ cap * (576 + 8), cap * 256 };
+    const planes = [_]?[2]grow.Plane{ .{ .{ .off = 0, .row = 576 }, .{ .off = cap * 576, .row = 8 } }, .{ .{ .off = 0, .row = 256 }, .{ .off = 0, .row = 0 } } };
+    const np = [_]u8{ 2, 1 };
+    return grow.Region.init(gpa, m, &sizes, &planes, &np, out);
+}
+
+test "GLM seq grow GPU: granules map zeroed, keep their rows across a trim, run out, and come back" {
+    if (std.c.getenv("TF_SEQ_GROW_GPU") == null) return error.SkipZigTest;
+    const gpa = T.allocator;
+    var drv = try cuda.Driver.open();
+    var ctx = try cuda.Context.init(&drv, 0);
+    defer ctx.deinit();
+    const pool = try grow.Pool.open(gpa, &drv);
+    defer pool.close();
+    const cap: usize = 20000;
+    var a_at: [2]u64 = undefined;
+    var a = try region(gpa, pool.mapper(), cap, &a_at);
+    const whole = a.need(cap);
+    try pool.grow(whole); // the pool of one whole region, as the engine makes it
+    try T.expectEqual(whole, pool.available());
+
+    // rows 0..1000 of codes, scales and keys written, read back; the rest of their granules reads zero
+    try a.ensure(1000);
+    const codes = try gpa.alloc(u8, 1000 * 576);
+    defer gpa.free(codes);
+    for (codes, 0..) |*b, i| b.* = @truncate(i *% 31 +% 7);
+    try put(&drv, a_at[0], codes);
+    try put(&drv, a_at[0] + cap * 576, codes[0 .. 1000 * 8]);
+    try put(&drv, a_at[1], codes[0 .. 1000 * 256]);
+    const back = try gpa.alloc(u8, 1000 * 576);
+    defer gpa.free(back);
+    try get(&drv, a_at[0], back);
+    try T.expectEqualSlices(u8, codes, back);
+    const tail = try gpa.alloc(u8, pool.granularity);
+    defer gpa.free(tail);
+    const g = pool.granularity;
+    const past = std.mem.alignForward(usize, 1000 * 576, g) - 1000 * 576; // the codes granule's rest past row 1000
+    try get(&drv, a_at[0] + 1000 * 576, tail[0..past]);
+    for (tail[0..past]) |b| try T.expectEqual(@as(u8, 0), b);
+
+    // a second region on the same pool: A takes the whole window, B has none; A trimmed back to 1000 rows keeps them
+    var b_at: [2]u64 = undefined;
+    var b = try region(gpa, pool.mapper(), cap, &b_at);
+    try a.ensure(cap);
+    try T.expectEqual(@as(usize, 0), pool.available());
+    try T.expectError(error.LaneMemory, b.ensure(10));
+    a.trim(1000);
+    try get(&drv, a_at[0], back);
+    try T.expectEqualSlices(u8, codes, back);
+    const keys = try gpa.alloc(u8, 1000 * 256);
+    defer gpa.free(keys);
+    try get(&drv, a_at[1], keys);
+    try T.expectEqualSlices(u8, codes[0 .. 1000 * 256], keys);
+    var rows_b: usize = 0; // the most rows (in steps of 1000) whose granules A gave back
+    while (rows_b + 1000 <= cap and b.need(rows_b + 1000) <= pool.available()) rows_b += 1000;
+    try T.expect(rows_b >= 1000);
+    try b.ensure(rows_b); // the granules A gave back serve B
+    try T.expectError(error.LaneMemory, b.ensure(cap)); // and no more than those
+    try put(&drv, b_at[0], codes);
+
+    // B's granules given back and mapped again by A: the rows past A's kept ones read zero, not B's bytes
+    b.deinit();
+    try a.ensure(cap);
+    try get(&drv, a_at[0] + 1000 * 576, tail[0..past]);
+    for (tail[0..past]) |x| try T.expectEqual(@as(u8, 0), x);
+    const far = std.mem.alignForward(usize, 1000 * 576, g); // a granule A had given back and mapped again
+    try get(&drv, a_at[0] + far, tail);
+    for (tail) |x| try T.expectEqual(@as(u8, 0), x);
+    a.deinit();
+    try T.expectEqual(whole, pool.available());
+    std.debug.print("GLM seq grow GPU: granule {d} MiB, {d} granules a {d}-row region, refused when spent, rows kept across a trim, remapped granules zeroed\n", .{ g >> 20, whole, cap });
+}
