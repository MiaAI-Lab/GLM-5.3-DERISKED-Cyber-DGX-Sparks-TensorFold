+        const q = self.x.e.seqs.items[0] orelse return 0;
+        const r = q.st.grow orelse return 0;
+        return r.need(@min(self.x.e.capacity, prompt + max_new + max_rows + seq_grow.margin_rows));
+    }
+
+    /// Whether the pool holds `need` more granules on the slot freeSlot gives, beside every other slot's: a live
+    /// stream's charge is the most of what it maps and what it was admitted with; an idle slot's, what it maps (slot
+    /// 0 keeps its last rows for slot resume until its next pass trims them).
+    fn growFits(self: *const Lanes, need: usize) bool {
+        const pool = seq_grow.pool orelse return true;
+        var slots: [64]?seq_grow.Slot = undefined;
+        const seqs = self.x.e.seqs.items;
+        if (seqs.len > slots.len) return false; // more slots than the check holds: refuse rather than guess
+        for (seqs, slots[0..seqs.len], 0..) |q, *x, slot| {
+            const r = (q orelse {
+                x.* = null;
+                continue;
+            }).st.grow orelse {
+                x.* = null;
+                continue;
+            };
+            x.* = .{ .mapped = r.mapped };
+            var it = self.lanes.valueIterator();
+            while (it.next()) |l| if (l.slot == slot) {
+                x.*.?.granted = @max(x.*.?.granted, l.grow_need);
+            };
+        }
+        const f = self.freeSlot();
+        if (f >= seq_grow.max_streams) return false; // TF_GLM_SEQ_GROW_STREAMS: no slot past the cap (the request waits)
+        return seq_grow.admits(pool.total, slots[0..seqs.len], f, need);
+    }
+
