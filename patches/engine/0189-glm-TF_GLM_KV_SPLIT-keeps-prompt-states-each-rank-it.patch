diff --git a/zig/src/families/glm/cuda_kv8_snapshot_test.zig b/zig/src/families/glm/cuda_kv8_snapshot_test.zig
index 4d0d55c80..37e782b70 100644
--- a/zig/src/families/glm/cuda_kv8_snapshot_test.zig
+++ b/zig/src/families/glm/cuda_kv8_snapshot_test.zig
@@ -264,3 +264,107 @@ test "GLM FP8 KV: a dsa int8 state's disk image counts both scale planes of ever
     // int8 rows keep 4 more scale bytes a row than E4M3 in each of the 3 DSA layers (codes as wide either way)
     for ([_]u64{ 2048, 4096 }, 0..) |at, q| try t.expectEqual(3 * at * 4, bytes[1][q] - bytes[0][q]);
 }
+
+// ---- TF_GLM_KV_SPLIT: each rank keeps and restores its own rows (position p on rank p mod W, local row p div W) ----
+
+/// One rank's split state of `world` (int8 codes): its own rows' codes, both scale planes and (split index keys) its
+/// index-key rows filled by position, a prefix of `at` kept through the real Plan and Pool, every row poisoned, the
+/// prefix restored; the bad own rows below `at` counted (codes, scales, keys), and the plan's bytes.
+fn runSplit(world: usize, rank: usize, at: usize, bad: *[3]usize) !usize {
+    const gpa = t.allocator;
+    _ = setenv("TF_GLM_KV8_INT8", "1", 1);
+    defer _ = unsetenv("TF_GLM_KV8_INT8");
+    state.lat_split = world;
+    state.ik_split = true;
+    defer {
+        state.lat_split = 1;
+        state.ik_split = false;
+    }
+    var d = Mem.driver();
+    var w: weights.Weights = undefined;
+    w.config = .{};
+    w.config.dsa = true;
+    w.config.rope = 64;
+    var layers: [3]weights.Layer = undefined;
+    for (&layers) |*l| l.mixer = .{ .mla = undefined };
+    w.layers = &layers;
+    w.share = try shard.Share.of(&w.config, 0, 2);
+    const c = &w.config;
+    const lw: usize = c.kv_lora + c.rope;
+    const sb: usize = 8;
+    const capacity: usize = 4096;
+    var st = try state.State.initHead(gpa, &d, &w, capacity, true, false);
+    defer st.deinit();
+    const local = state.latRows(capacity);
+    const ik_row = st.ring_row;
+    const Fill = struct {
+        fn all(s: *const state.State, cc: *const @TypeOf(w.config), n: usize, lw_: usize, sb_: usize, ikr: usize, W: usize, r_: usize, poison: bool) void {
+            for (s.caches, 0..) |x, j| for (0..n) |lr| {
+                const p = lr * W + r_; // the position this local row holds
+                const code: [*]u8 = @ptrFromInt(x.lc + lr * lw_);
+                for (0..lw_) |i| code[i] = if (poison) 0xA5 else codeByte(j, p, i);
+                const sc: [*]align(1) f32 = @ptrFromInt(x.ls + lr * sb_);
+                for (0..sb_ / 4) |q| sc[q] = if (poison) std.math.nan(f32) else scaleVal(j, p, q);
+                if (state.dsaIndexed(cc, j, s.caches.len)) {
+                    const k: [*]u8 = @ptrFromInt(s.rings[2 * j] + lr * ikr);
+                    for (0..ikr) |i| k[i] = if (poison) 0x5A else codeByte(j + 7, p, i);
+                }
+            };
+        }
+    };
+    Fill.all(&st, c, local, lw, sb, ik_row, world, rank, false);
+    var pool = try pages.Pool.initTiers(gpa, &d, pages.page, 64 * pages.page);
+    defer pool.deinit();
+    const plan = try layout.Plan.init(&st, c, at, null);
+    var lease = try pool.take(plan.len);
+    defer pool.give(&lease);
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    try pool.move(stream, &lease, &plan, true);
+    Fill.all(&st, c, local, lw, sb, ik_row, world, rank, true);
+    try pool.move(stream, &lease, &plan, false);
+    for (st.caches, 0..) |x, j| {
+        var lr: usize = 0;
+        while (lr * world + rank < at) : (lr += 1) {
+            const p = lr * world + rank;
+            const code: [*]const u8 = @ptrFromInt(x.lc + lr * lw);
+            for (0..lw) |i| if (code[i] != codeByte(j, p, i)) {
+                bad[0] += 1;
+                break;
+            };
+            const sc: [*]align(1) const f32 = @ptrFromInt(x.ls + lr * sb);
+            for (0..2) |q| if (@as(u32, @bitCast(sc[q])) != @as(u32, @bitCast(scaleVal(j, p, q)))) {
+                bad[1] += 1;
+                break;
+            };
+            if (state.dsaIndexed(c, j, st.caches.len)) {
+                const k: [*]const u8 = @ptrFromInt(st.rings[2 * j] + lr * ik_row);
+                for (0..ik_row) |i| if (k[i] != codeByte(j + 7, p, i)) {
+                    bad[2] += 1;
+                    break;
+                };
+            }
+        }
+    }
+    return plan.len;
+}
+
+test "GLM FP8 KV: split ownership snapshot poison-restore, every rank's own int8 rows (both scale planes) and index keys" {
+    for ([_]usize{ 2, 4, 6 }) |world| for ([_]usize{ 1536, 1537, 4095 }) |at| {
+        var len0: usize = 0;
+        for (0..world) |rank| {
+            var bad: [3]usize = .{ 0, 0, 0 };
+            const len = try runSplit(world, rank, at, &bad);
+            std.debug.print("GLM FP8 KV split snapshot W={d} rank {d} at {d}: plan {d} bytes; bad own rows: codes {d} scales {d} keys {d}\n", .{ world, rank, at, len, bad[0], bad[1], bad[2] });
+            try t.expectEqual([3]usize{ 0, 0, 0 }, bad);
+            if (rank == 0) len0 = len else try t.expectEqual(len0, len); // every rank keeps the same bytes
+        }
+     };
+}
+
+test "GLM FP8 KV: a split prefix keeps ceil(at / W) rows a cache, about a W-th of the unsplit prefix's latent bytes" {
+    state.lat_split = 4;
+    defer state.lat_split = 1;
+    try t.expectEqual(@as(usize, 384), state.latHeld(1536));
+    try t.expectEqual(@as(usize, 385), state.latHeld(1537));
+    try t.expectEqual(@as(usize, 1537), state.ikHeld(1537)); // index keys stay whole without TF_GLM_KV_SPLIT=2
+}
