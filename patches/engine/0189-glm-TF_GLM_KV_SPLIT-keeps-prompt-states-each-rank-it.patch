diff --git a/zig/src/families/glm/cuda_state.zig b/zig/src/families/glm/cuda_state.zig
index eb5234369..8baa7fe62 100644
--- a/zig/src/families/glm/cuda_state.zig
+++ b/zig/src/families/glm/cuda_state.zig
@@ -57,6 +57,17 @@ pub var lat_split: usize = 1;
 /// TF_GLM_KV_SPLIT=2: the index keys split as the latent rows (their rings hold latRows rows).
 pub var ik_split: bool = false;
 
+/// Latent rows of positions 0 .. at a rank holds (TF_GLM_KV_SPLIT: its own, counted as the most any rank holds,
+/// ceil(at / W), so every rank's kept prefix is the same size); unsplit `at`.
+pub fn latHeld(at: usize) usize {
+    return if (lat_split <= 1) at else (at + lat_split - 1) / lat_split;
+}
+
+/// Index-key rows of positions 0 .. at a rank holds: latHeld with TF_GLM_KV_SPLIT=2, else `at`.
+pub fn ikHeld(at: usize) usize {
+    return if (ik_split) latHeld(at) else at;
+}
+
 /// Latent rows a cache holds for `capacity` tokens.
 pub fn latRows(capacity: usize) usize {
     return if (lat_split <= 1) capacity else @import("cuda_kv_split.zig").localRows(capacity, lat_split);
