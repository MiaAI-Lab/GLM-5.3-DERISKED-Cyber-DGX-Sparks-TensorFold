diff --git a/zig/kernels/cuda/glm_dsa_scores_rows.cuh b/zig/kernels/cuda/glm_dsa_scores_rows.cuh
new file mode 100644
index 000000000..3391e0177
--- /dev/null
+++ b/zig/kernels/cuda/glm_dsa_scores_rows.cuh
@@ -0,0 +1,117 @@
+// tf_glm_dsa_scores_r4 / _r8 (U6.2, GLM policy bit 25): a prompt select block's indexer scores with RB rows a CTA
+// sharing every staged key block. The queries are tf_glm_dsa_qrope's roped rows (as tf_glm_dsa_scores_roped reads
+// them), all RB rows' 32 heads in shared memory; each warp stages its 16 keys of a 64-key block once and scores them
+// for each of the RB rows with that row's fragments, dots, scale, ReLU, head weights and reduction exactly as
+// tf_glm_dsa_scores_roped does for its one row (the same MMA chain over the same bf16 values in the same order), so
+// every score is the same bits. Keys past a row's visible end score -inf as there. Dynamic shared memory:
+// RB x 32 x 128 x 2 bytes of queries, then 4 warps x 2 buffers x 16 keys x 256 bytes.
+#pragma once
+namespace glm_dsa_rows {
+template <int RB>
+__device__ __forceinline__ void scores_rows(const __nv_bfloat16* qr, const __nv_bfloat16* wts, int64_t w_stride,
+                                            const __nv_bfloat16* ik, float* out, const int* pos, int64_t rows,
+                                            int64_t np, int64_t nb, float scale, float wscale, int64_t heads, int loop) {
+  constexpr int D = 128, HP = 32, BP = 64;
+  extern __shared__ __align__(16) unsigned char dsr_smem[];
+  __nv_bfloat16* sq = reinterpret_cast<__nv_bfloat16*>(dsr_smem);        // [RB][HP][D] swizzled like `at`
+  __nv_bfloat16* sk = sq + RB * HP * D;                                    // [4][2][16][D]
+  auto at = [](int row, int u) { return row * D + ((u ^ (row & 7)) << 3); };
+  const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5, g = lane >> 2, q = lane & 3;
+  const int64_t r0 = (int64_t)blockIdx.x * RB;
+  const int nr = (int)(rows - r0 < RB ? rows - r0 : RB);
+  const int64_t nmax = (int64_t)pos[0] + r0 + nr;  // the last row's visible keys
+  for (int idx = threadIdx.x; idx < RB * HP * (D / 8); idx += 128) {
+    const int rr = idx / (HP * (D / 8)), hh = (idx / (D / 8)) % HP, u = idx % (D / 8);
+    const bool ok = rr < nr && hh < heads;
+    glm_attn::cp16(sq + rr * HP * D + at(hh, u), qr + ((r0 + (ok ? rr : 0)) * heads + (ok ? hh : 0)) * D + u * 8, ok);
+  }
+  glm_attn::commit();
+  float wv[RB][4];
+#pragma unroll
+  for (int rr = 0; rr < RB; ++rr)
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const int64_t hh = g + 8 * i;
+      wv[rr][i] = (rr < nr && hh < heads) ? glm_triton::fmul(__bfloat162float(wts[(r0 + rr) * w_stride + hh]), wscale) : 0.0f;
+    }
+  auto stage = [&](int buf, int64_t p0) {
+    const __nv_bfloat16* src = ik + (p0 < nmax ? p0 : 0) * D;
+#pragma unroll
+    for (int t = 0; t < 8; ++t) {
+      const int idx = lane + t * 32, row = idx / (D / 8), u = idx % (D / 8);
+      const int64_t p = p0 + row;
+      const bool ok = p < nmax;
+      glm_attn::cp16(sk + (warp * 2 + buf) * 16 * D + at(row, u), src + (ok ? row : 0) * D + u * 8, ok);
+    }
+  };
+  const int64_t first = (int64_t)blockIdx.y * loop;
+  auto live = [&](int j) { const int64_t pb = first + j; return j < loop && pb < nb && pb * BP < nmax; };
+  glm_attn::wait<0>();
+  __syncthreads();
+  if (live(0)) stage(0, first * BP + warp * 16);
+  glm_attn::commit();
+  for (int j = 0; j < loop; ++j) {
+    const int64_t pb = first + j;
+    if (pb >= nb) break;
+    const int64_t p0 = pb * BP + warp * 16;
+    if (!live(j)) {  // no row sees this block: -inf, as the one-row kernel writes it
+      for (int rr = 0; rr < nr; ++rr)
+        for (int e = lane; e < 16; e += 32)
+          if (p0 + e < np) out[(r0 + rr) * np + p0 + e] = -INFINITY;
+      continue;
+    }
+    if (live(j + 1)) stage((j + 1) & 1, p0 + BP);
+    glm_attn::commit();
+    glm_attn::wait<1>();
+    __syncwarp();
+    const __nv_bfloat16* keys = sk + (warp * 2 + (j & 1)) * 16 * D;
+    uint32_t bk[D / 16][4];
+#pragma unroll
+    for (int kq = 0; kq < D / 16; ++kq)
+      glm_attn::ldm4<false>(bk[kq], keys + at((lane >> 4) * 8 + (lane & 7), kq * 2 + ((lane >> 3) & 1)));
+    __syncwarp();
+#pragma unroll 1
+    for (int rr = 0; rr < nr; ++rr) {
+      const int64_t r = r0 + rr, n = (int64_t)pos[0] + r + 1;
+      const __nv_bfloat16* qs = sq + rr * HP * D;
+      float acc[2][2][4] = {};
+#pragma unroll
+      for (int kq = 0; kq < D / 16; ++kq) {
+        uint32_t aq[2][4];
+#pragma unroll
+        for (int i = 0; i < 2; ++i) glm_attn::ldm4<false>(aq[i], qs + at(i * 16 + (lane & 15), kq * 2 + (lane >> 4)));
+        for (int nt = 0; nt < 2; ++nt)
+          for (int i = 0; i < 2; ++i) glm_router::mma16816(acc[i][nt], aq[i], bk[kq] + 2 * nt);
+      }
+      for (int nt = 0; nt < 2; ++nt)
+        for (int e = 0; e < 2; ++e) {
+          const float v0 = fmaxf(__fmul_rn(acc[0][nt][e], scale), 0.0f),
+                      v1 = fmaxf(__fmul_rn(acc[0][nt][e + 2], scale), 0.0f);
+          const float v2 = fmaxf(__fmul_rn(acc[1][nt][e], scale), 0.0f),
+                      v3 = fmaxf(__fmul_rn(acc[1][nt][e + 2], scale), 0.0f);
+          float s = glm_triton::fmul(wv[rr][1], v1);
+          s = __fmaf_rn(wv[rr][0], v0, s);
+          s = __fmaf_rn(wv[rr][2], v2, s);
+          s = __fmaf_rn(wv[rr][3], v3, s);
+          for (int o = 16; o >= 4; o >>= 1) s = s + __shfl_xor_sync(0xffffffffu, s, o);
+          const int64_t p = p0 + nt * 8 + q * 2 + e;
+          if (g == 0 && p < np) out[r * np + p] = p < n ? s : -INFINITY;
+        }
+    }
+    __syncwarp();
+  }
+}
+}  // namespace glm_dsa_rows
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_dsa_scores_r4(const __nv_bfloat16* qr, const __nv_bfloat16* wts, int64_t w_stride, const __nv_bfloat16* ik,
+                         float* out, const int* pos, int64_t rows, int64_t np, int64_t nb, float scale, float wscale,
+                         int64_t heads, int loop) {
+  glm_dsa_rows::scores_rows<4>(qr, wts, w_stride, ik, out, pos, rows, np, nb, scale, wscale, heads, loop);
+}
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_dsa_scores_r8(const __nv_bfloat16* qr, const __nv_bfloat16* wts, int64_t w_stride, const __nv_bfloat16* ik,
+                         float* out, const int* pos, int64_t rows, int64_t np, int64_t nb, float scale, float wscale,
+                         int64_t heads, int loop) {
+  glm_dsa_rows::scores_rows<8>(qr, wts, w_stride, ik, out, pos, rows, np, nb, scale, wscale, heads, loop);
+}
