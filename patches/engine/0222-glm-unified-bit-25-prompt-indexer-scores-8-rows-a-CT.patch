@@ -191,9 +191,15 @@ pub fn dsaSelect(set: glue.Set, ops: cuda.Module, stream: cuda.Stream, qi: u64,
             q = s.qr;
         }
         const sl = hoist orelse loop;
+        if (hoist != null and n > swift_rows and policy.on(set.policy, .scores_rows)) { // policy bit 25 (U6.2)
+            var ra: cuda.Args = .{};
+            inline for (.{ q, wts + a * stride * 2, @as(i64, @intCast(stride)), ik, s.scores, at, @as(i64, @intCast(n)), @as(i64, @intCast(np)), @as(i64, @intCast(nb)), scale, headScale(heads), @as(i64, @intCast(heads)), @as(c_int, @intCast(sl)) }) |v| ra.add(v);
+            try cuda.launch.launch(set.glue.dsa_scores_r8, .{ .grid = .{ .x = @intCast(cdiv(n, 8)), .y = @intCast(cdiv(nb, sl)) }, .block = .{ .x = 128 }, .shared = glue.Kernels.dsa_scores_r8_smem }, stream, &ra);
+        } else {
         var sa: cuda.Args = .{};
         inline for (.{ q, wts + a * stride * 2, @as(i64, @intCast(stride)), ik, s.scores, at, @as(i64, @intCast(np)), @as(i64, @intCast(nb)), scale, headScale(heads), @as(i64, @intCast(heads)), @as(c_int, @intCast(sl)), inv }) |v| sa.add(v);
         try cuda.launch.launch(if (hoist != null) set.glue.dsa_scores_roped else set.glue.dsa_scores, .{ .grid = .{ .x = @intCast(n), .y = @intCast(cdiv(nb, sl)) }, .block = .{ .x = 128 } }, stream, &sa);
+        }
         stamp.end();
         stamp = prof_mod.span(profile, stream, .index_select);
         if (split == null and topkMulti(policy.on(set.policy, .topk_multi_cta), np, n, s.bits_rows)) {
diff --git a/zig/src/families/glm/policy.zig b/zig/src/families/glm/policy.zig
index 0219f8114..133174632 100644
--- a/zig/src/families/glm/policy.zig
+++ b/zig/src/families/glm/policy.zig
@@ -26,6 +26,7 @@ pub const Bit = enum(u5) {
     scatter_inplace = 22, // U7a: a prompt exchange's reduce-scatter sums added in place into the residual rows and gathered there (R % world == 0)
     absorb_one = 23, // U8b: glm_moe_dsa's prompt absorb_q in one head-batched launch (tf_glm_latent_mma_kn_hs)
     prompt_hoist = 24, // U6.1: a prompt chunk's indexer queries roped once a row (tf_glm_dsa_qrope + tf_glm_dsa_scores_roped)
+    scores_rows = 25, // U6.2: with bit 24, a prompt select block's scores 8 rows a CTA sharing each staged key block (tf_glm_dsa_scores_r8)
 };
 
