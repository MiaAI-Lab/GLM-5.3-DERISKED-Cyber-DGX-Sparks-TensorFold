@@ -120,6 +120,7 @@ pub const Kernels = struct {
     chunks_16_w576_i8: cuda.Function,
     chunks_16_w576_s4_i8: cuda.Function,
     chunks_16_fused_w576_i8: cuda.Function,
+    dsa_scores_r8: cuda.Function, // policy bit 25 (U6.2): 8 prompt rows a CTA on shared key blocks (glm_dsa_scores_rows.cuh)
     l2_paced_stop: cuda.Function, // TF_GLM_L2PF policy bit 16: a paced site that stops at its gather's end (glm_glue_l2.cuh)
     unblock: cuda.Function, // a split [q_a | kv_a]'s gathered column slots back into rows (glm_glue_msa.cuh)
     msa_w576: cuda.Function, // glm_glue_msa.cuh: a prompt row a block over its token list, the rank's heads one m16 tile
@@ -129,6 +130,9 @@ pub const Kernels = struct {
     msa_w576_i8: cuda.Function,
     msa_w576_dense_i8: cuda.Function,
 
+    /// tf_glm_dsa_scores_r8's dynamic shared memory: 8 rows x 32 heads x 128 queries, 4 warps x 2 x 16 keys x 128.
+    pub const dsa_scores_r8_smem: u32 = 8 * 32 * 128 * 2 + 4 * 2 * 16 * 128 * 2;
+
     pub fn load(m: cuda.Module) !Kernels {
         var k: Kernels = undefined;
         inline for (@typeInfo(Kernels).@"struct".field_names) |name| @field(k, name) = try m.function("tf_glm_" ++ name);
@@ -159,6 +163,7 @@ pub const Kernels = struct {
         try k.chunks_16_fused_w576_i8.allowDynamicShared(chunksSmemW(16, dsa_row));
         try k.latent_mma_kn.allowDynamicShared(latent_mma_smem[0]);
         try k.latent_mma_kn_hs.allowDynamicShared(latent_mma_smem[0]);
+        try k.dsa_scores_r8.allowDynamicShared(dsa_scores_r8_smem);
         try k.latent_mma_nk.allowDynamicShared(latent_mma_smem[1]);
         return k;
     }
diff --git a/zig/src/families/glm/cuda_native.zig b/zig/src/families/glm/cuda_native.zig
index e6f509d87..3e46b69f3 100644
--- a/zig/src/families/glm/cuda_native.zig
+++ b/zig/src/families/glm/cuda_native.zig
@@ -539,6 +539,7 @@ fn policyBoot(e: *const engine.Engine) policy.Boot {
     b.offered |= policy.bit(.scatter_inplace); // 22: the prompt exchange's in-place sums and gather (exact)
     b.offered |= policy.bit(.absorb_one); // 23: tf_glm_latent_mma_kn_hs, every rank loads glm_glue
     b.offered |= policy.bit(.prompt_hoist); // 24: the prompt buffers' roped-query block (cuda_state, p[76])
+    b.offered |= policy.bit(.scores_rows); // 25: tf_glm_dsa_scores_r8 (with bit 24)
     std.log.info("request policies on (TF_GLM_POLICY_REQUESTS=1): default 0x{x}, offered 0x{x}", .{ b.default & b.offered, b.offered });
     return b;
 }
