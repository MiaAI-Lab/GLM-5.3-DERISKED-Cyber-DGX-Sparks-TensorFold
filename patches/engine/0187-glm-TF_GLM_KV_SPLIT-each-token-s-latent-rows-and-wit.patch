+    pub fn deinit(x: *Ctx) void {
+        if (x.side) |*sd| {
+            sd.synchronize() catch {};
+            sd.deinit();
+        }
+        if (x.mark) |*e| e.deinit();
+        for (&x.ready) |*e| if (e.*) |*v| v.deinit();
+        x.buf.free();
+    }
+
+    fn hpad(x: *const Ctx) usize {
+        return @intCast(x.t.hpad);
+    }
+
+    fn hr(x: *const Ctx) usize {
+        return @intCast(x.t.n[x.rank]);
+    }
+
+    /// Rows r of the call at pos .. pos + rows that this rank owns, copied from `src` (rows `stride` bytes apart, or
+    /// by position) into the split cache `lc`.
+    fn ownRows(x: *const Ctx, stream: cuda.Stream, src: u64, stride: usize, by_pos: bool, lc: u64, pos: u64, rows: usize) !void {
+        return x.ownRowsOf(stream, src, stride, by_pos, lc, pos, rows, row_bytes);
+    }
+
+    fn ownRowsOf(x: *const Ctx, stream: cuda.Stream, src: u64, stride: usize, by_pos: bool, lc: u64, pos: u64, rows: usize, rb: usize) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ src, @as(i64, @intCast(stride)), @as(c_int, @intFromBool(by_pos)), lc, @as(i64, @intCast(rb)), pos, @as(c_int, @intCast(x.world)), @as(c_int, @intCast(x.rank)) }) |v| a.add(v);
+        try cuda.launch.launch(x.f.own_rows, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 128 } }, stream, &a);
+    }
+
+    /// A prompt chunk at `host_pos` (rows on the device position `pos`): positions 0 .. host_pos of this layer from every
+    /// rank's own rows into the scratch, in pieces.
+    pub fn gatherHistory(x: *Ctx, stream: cuda.Stream, lc: u64, host_pos: usize) !void {
+        return x.gatherRows(stream, lc, host_pos, row_bytes, x.full);
+    }
+
+    /// Rows of `rb` bytes, every rank's own below host_pos (from `src`, local rows), into `dst` at their positions.
+    fn gatherRows(x: *Ctx, stream: cuda.Stream, src: u64, host_pos: usize, rb: usize, dst: u64) !void {
+        return x.gatherRowsOn(stream, x.comm, x.gat, src, host_pos, rb, dst);
+    }
+
+    fn gatherRowsOn(x: *Ctx, stream: cuda.Stream, comm: cuda.nccl.Comm, room: u64, src: u64, host_pos: usize, rb: usize, dst: u64) !void {
+        if (host_pos == 0) return;
+        if (host_pos > x.full_rows) return error.KvSplitRoom;
+        const L = (host_pos + x.world - 1) / x.world;
+        const per = piece_rows * row_bytes / rb; // the gather room's rows of this size a rank
+        var j0: usize = 0;
+        while (j0 < L) : (j0 += per) {
+            const n = @min(per, L - j0);
+            try x.lib.check(x.lib.api.ncclAllGather(src + j0 * rb, room, n * rb, .u8, comm, stream.handle), "ncclAllGather");
+            var a: cuda.Args = .{};
+            inline for (.{ room, dst, @as(i64, @intCast(rb)), @as(i64, @intCast(j0)), @as(i64, @intCast(n)), @as(c_int, @intCast(x.world)), @as(i64, @intCast(host_pos)) }) |v| a.add(v);
