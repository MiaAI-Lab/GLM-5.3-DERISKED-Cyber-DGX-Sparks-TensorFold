+        try cuda.launch.launch(set.glue.chunks_16_w576_s4, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(H / latent.heads_tile), .z = nch }, .block = .{ .x = latent.chunk_threads }, .shared = glue.chunksSmemW(16, glue.dsa_row) }, stream, &ca);
