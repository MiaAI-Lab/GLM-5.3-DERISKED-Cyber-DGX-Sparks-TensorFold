+            .full = p[0],
+            .full_rows = capacity,
+            .gat = p[1],
+            .qslot = p[2],
+            .qgat = p[3],
+            .qall = p[4],
+            .ltok = p[5],
+            .lcnt = p[6],
+            .po = p[7],
+            .pm = p[8],
+            .pl = p[9],
+            .so = p[10],
+            .sm = p[11],
+            .sl = p[12],
+            .ro = p[13],
+            .rm = p[14],
+            .rl = p[15],
+            .index = index,
+            .prefetch = want_pf,
+            .full2 = full2,
+            .fik2 = fik2,
+            .gat2 = gat2,
+            .side = side,
+            .mark = mark,
+            .ready = ready,
