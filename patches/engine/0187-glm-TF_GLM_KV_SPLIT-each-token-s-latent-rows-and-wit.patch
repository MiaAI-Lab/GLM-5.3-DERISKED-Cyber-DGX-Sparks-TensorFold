+                .q_unpack = try ops.function("tf_glm_kvs_q_unpack"),
+                .premerge = try ops.function("tf_glm_kvs_premerge"),
+                .merge = try ops.function("tf_glm_kvs_merge"),
+                .unpack_rows = try ops.function("tf_glm_kvs_unpack_rows"),
