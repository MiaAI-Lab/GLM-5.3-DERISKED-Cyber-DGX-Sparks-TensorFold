+            try lib.check(lib.api.ncclSend(x.sm + q * sb, sb, .u8, peer, x.comm, stream.handle), "ncclSend");
+            try lib.check(lib.api.ncclSend(x.sl + q * sb, sb, .u8, peer, x.comm, stream.handle), "ncclSend");
