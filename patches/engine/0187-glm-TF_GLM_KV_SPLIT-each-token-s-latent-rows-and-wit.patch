+/// The device position pos + by in `at` (an i32 of the scratch), for a block of rows past the call's first.
+fn posAt(k: dsa_block.Kernels, stream: cuda.Stream, pos: u64, by: usize, at: u64) !u64 {
+    var a: cuda.Args = .{};
+    a.add(pos);
+    a.add(@as(c_int, @intCast(by)));
+    a.add(at);
+    try cuda.launch.launch(try k.ops.function("tf_glm_add_i32"), .{ .grid = .{ .x = 1 }, .block = .{ .x = 32 } }, stream, &a);
+    return at;
+}
+
+fn scaleOf(l: dsa_block.Layer) f32 {
+    return @floatCast(std.math.pow(f64, @floatFromInt(l.qk), -0.5));
+}
+
+test "KV split: ownership covers every position once, local rows within localRows" {
+    for ([_]usize{ 2, 3, 4, 6 }) |w| {
+        const cap: usize = 1000;
+        var seen: [1000]bool = @splat(false);
+        for (0..w) |r| {
+            for (0..cap) |p| if (owner(p, w) == r) {
+                const j = localRow(p, w);
+                try std.testing.expect(j < localRows(cap, w));
+                try std.testing.expect(!seen[p]);
+                seen[p] = true;
+                try std.testing.expectEqual(p, j * w + r);
+            };
+        }
+        for (seen) |b| try std.testing.expect(b);
+    }
+}
+
+test "KV split: TP4 and TP6 head tables" {
+    const c = @import("config.zig").dsaWant();
+    const t4 = try headsOf(&c, 4);
+    try std.testing.expectEqual(@as(c_int, 16), t4.hpad);
+    const t6 = try headsOf(&c, 6);
+    try std.testing.expectEqual(@as(c_int, 11), t6.hpad);
+    var sum: c_int = 0;
+    for (0..6) |q| sum += t6.n[q];
+    try std.testing.expectEqual(@as(c_int, 64), sum);
+    try std.testing.expectEqual(@as(usize, 72), @sizeOf(Heads));
+}
+
+test "KV split: the switch" {
+    try std.testing.expectEqual(@as(u8, 0), try parse(null));
+    try std.testing.expectEqual(@as(u8, 0), try parse("0"));
+    try std.testing.expectEqual(@as(u8, 1), try parse("1"));
+    try std.testing.expectEqual(@as(u8, 2), try parse("2"));
+    try std.testing.expectError(error.BadKvSplit, parse("yes"));
+}
