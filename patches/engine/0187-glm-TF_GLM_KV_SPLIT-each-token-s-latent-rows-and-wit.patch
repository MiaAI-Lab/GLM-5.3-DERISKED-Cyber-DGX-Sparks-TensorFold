+        var send = qa;
+        if (x.hr() != hp) {
+            var pa: cuda.Args = .{};
+            inline for (.{ qa, x.qslot, @as(c_int, @intCast(x.hr())), @as(c_int, @intCast(hp)) }) |a| pa.add(a);
+            try cuda.launch.launch(x.f.q_pack, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(hp) }, .block = .{ .x = 96 } }, stream, &pa);
