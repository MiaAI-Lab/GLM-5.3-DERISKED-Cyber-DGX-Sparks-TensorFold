+    /// `bytes` from `send` into slot rank of `recv` on every rank: the mesh's one-shot writes when it takes them
+    /// (TF_GLM_ROCE_MESH, a decode window's sizes), else NCCL.
+    fn allGather(x: *Ctx, stream: cuda.Stream, send: u64, recv: u64, bytes: usize) !void {
+        if (x.use_mesh) if (x.mesh) |m| if (m.fits(bytes)) {
+            const mine = recv + x.rank * bytes;
+            const drv = x.buf.d;
+            try drv.check(drv.api.cuMemcpyDtoDAsync_v2(mine, send, bytes, stream.handle), "cuMemcpyDtoDAsync");
