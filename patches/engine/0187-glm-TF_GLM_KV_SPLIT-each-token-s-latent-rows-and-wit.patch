+    pub fn decode(x: *Ctx, k: dsa_block.Kernels, stream: cuda.Stream, l: dsa_block.Layer, c: dsa_block.Caches, s: dsa_block.Scratch, xin: u64, x_stride: usize, rows: usize, pos: u64, host_pos: usize, proj_done: bool) !void {
