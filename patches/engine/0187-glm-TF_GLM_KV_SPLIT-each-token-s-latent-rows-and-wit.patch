+        var ma: cuda.Args = .{};
+        inline for (.{ x.po, x.pm, x.pl, @as(i64, @intCast(rows)), @as(c_int, @intCast(H)), @as(c_int, nch), x.so, x.sm, x.sl, x.t }) |a| ma.add(a);
+        try cuda.launch.launch(if (x.pbf16) x.f.premerge_b16 else x.f.premerge, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(H) }, .block = .{ .x = 128 } }, stream, &ma);
