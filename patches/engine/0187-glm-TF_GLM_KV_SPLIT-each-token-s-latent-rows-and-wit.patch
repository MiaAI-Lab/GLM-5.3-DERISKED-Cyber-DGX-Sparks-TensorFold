+
+    /// The split attention of `rows` rows: this rank's queries `qa` [rows][hr][576] (roped), the global lists, into
+    /// `ol` bf16 [rows][hr][512].
+    pub fn attend(x: *Ctx, set: glue.Set, stream: cuda.Stream, l: dsa_block.Layer, lc: u64, qa: u64, tokens: u64, counts: u64, sparse_rows: bool, pos: u64, rows: usize, ol: u64) !void {
