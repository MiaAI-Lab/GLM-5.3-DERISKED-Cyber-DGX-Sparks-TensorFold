+    /// TF_GLM_KV_SPLIT=2: a window's picks over split index keys: this rank's scores and best k, the ranks'
+    /// candidates all-gathered, the merge into the global lists (v.tokens, v.counts) — tf_glm_dsa_topk's exactly.
+    fn select(x: *Ctx, stream: cuda.Stream, l: dsa_block.Layer, ik: u64, v: dsa_block.Scratch, pos: u64, host_pos: usize, rows: usize, profile: ?*prof.Prof) !void {
+        const ix = l.index;
+        if (ix.d != 128 or ix.heads != 32) return error.IndexShape;
