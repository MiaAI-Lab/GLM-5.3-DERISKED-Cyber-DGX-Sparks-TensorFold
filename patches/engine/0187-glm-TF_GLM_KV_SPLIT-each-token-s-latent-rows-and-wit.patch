+        var la: cuda.Args = .{};
+        inline for (.{ v.select.scores, @as(i64, @intCast(np_l)), pos, @as(c_int, @intCast(x.world)), @as(c_int, @intCast(x.rank)), @as(c_int, k_picks), x.cand, @as(i64, @intCast(rows)) }) |a| la.add(a);
