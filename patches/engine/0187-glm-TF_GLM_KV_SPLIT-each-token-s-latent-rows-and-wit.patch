index 000000000..579bc4d34
--- /dev/null
+++ b/zig/src/families/glm/cuda_kv_split.zig
@@ -0,0 +1,554 @@
+//! TF_GLM_KV_SPLIT=1 (glm_moe_dsa): each token's 576-wide latent row lives on one rank — position p on rank p mod W at
+//! local row p div W — instead of on every rank, so the same memory holds about W times the context. The indexer and
+//! its keys stay replicated (every rank picks the same top-2048 lists, as unsplit).
+//!
+//! A decode window (cuda_kv_split.attendDecode): each rank's absorbed queries are all-gathered (every head on every
+//! rank), each rank attends its own keys for all heads (the chunk kernels over local token lists), pre-merges each
+//! (row, head)'s chunk partials into one (o, m, l), sends each head's partial to the rank owning that head (NCCL
+//! grouped send/recv, the exchange pattern of TF_GLM_KV_SHARD's owner-computed attention, GLM patch 0118 by Robert
+//! Wojciechowski), and that rank merges the W partials by tf_glm_merge's log-sum-exp sequence. The sums are
+//! reassociated: not bit-identical to unsplit, within its rounding (night/kvsplit/test).
+//!
+//! A prompt chunk (cuda_kv_split.prompt): every rank's own rows below the chunk are all-gathered into a scratch of the
+//! layer's whole rows, the unchanged DSA block attends on it (bit-identical to unsplit), and each rank keeps the
+//! chunk's rows it owns.
+const std = @import("std");
+const cuda = @import("cuda");
+const glue = @import("cuda_glue.zig");
+const latent = @import("cuda_latent.zig");
+const sparse = @import("cuda_sparse.zig");
+const dsa_block = @import("cuda_dsa_block.zig");
+const shard = @import("cuda_shard.zig");
+const prof = @import("cuda_prof.zig");
+
+/// TF_GLM_KV_SPLIT: "1" the latent rows split; "2" and the index keys too (the picks merged across the ranks);
+/// "0" or unset off; anything else refused.
+pub fn parse(raw: ?[]const u8) !u8 {
+    const t = std.mem.trim(u8, raw orelse "", " \t\r\n");
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return 0;
+    if (std.mem.eql(u8, t, "1")) return 1;
+    if (std.mem.eql(u8, t, "2")) return 2;
+    return error.BadKvSplit;
+}
+
+pub const why_bad = "TF_GLM_KV_SPLIT: 0 (off, the default), 1 (latent rows split) or 2 (latent rows and index keys split)";
+
+/// Local latent rows a rank holds for a `capacity`-token sequence over `world` ranks (one spare row).
+pub fn localRows(capacity: usize, world: usize) usize {
+    return (capacity + world - 1) / world + 1;
+}
+
+/// The rank owning position p, and p's local row there.
+pub fn owner(p: usize, world: usize) usize {
+    return p % world;
+}
+pub fn localRow(p: usize, world: usize) usize {
+    return p / world;
+}
+
+/// What the split cannot serve (every rank alike, from agreed inputs).
+pub const Facts = struct { world: usize, dsa: bool, kv8: bool, pages: bool, kv_shard: bool, mtp_drafts: bool, mtp_loaded: bool };
+pub fn refuse(on: bool, f: Facts) !void {
+    if (!on) return;
+    if (f.world < 2) return error.KvSplitNeedsRanks;
+    if (!f.dsa) return error.KvSplitNeedsDsa;
+    if (f.kv8) return error.KvSplitNeedsBf16;
+    if (f.pages) return error.KvSplitWithPages;
+    if (f.kv_shard) return error.KvSplitWithShard;
+    if (f.mtp_drafts or f.mtp_loaded) return error.KvSplitWithMtp;
+}
+
+pub fn why(err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.BadKvSplit => why_bad,
+        error.KvSplitNeedsRanks => "TF_GLM_KV_SPLIT=1 needs two ranks or more",
+        error.KvSplitNeedsDsa => "TF_GLM_KV_SPLIT=1 serves glm_moe_dsa (GLM-5.3) checkpoints only",
+        error.KvSplitNeedsBf16 => "TF_GLM_KV_SPLIT=1 splits BF16 latent rows (KV=bf16); --kv-cache fp8 is not split yet",
+        error.KvSplitWithPages => "TF_GLM_KV_SPLIT=1 does not run on KV pages (KV_PAGES=off)",
+        error.KvSplitWithShard => "TF_GLM_KV_SPLIT=1 and TF_GLM_KV_SHARD=1 exclude each other",
+        error.KvSplitWithMtp => "TF_GLM_KV_SPLIT=1 does not run with the target MTP head (DRAFTER=dspark, dflash2 or none)",
+        error.KvSplitPromptCache => "TF_GLM_KV_SPLIT=1 keeps no prompt states yet (PROMPT_CACHE_GIB=0)",
+        else => null,
+    };
+}
+
+/// glm_kvsplit.cuh's glm_kvs::Heads: rank s's heads [lo[s], lo[s] + n[s]), padded to hpad a rank on the wire.
+pub const Heads = extern struct { lo: [8]c_int = @splat(0), n: [8]c_int = @splat(0), world: c_int, hpad: c_int };
+
+/// The head table of `world` ranks for config `c`.
+pub fn headsOf(c: anytype, world: usize) !Heads {
+    if (world > 8) return error.KvSplitWorld;
+    var t: Heads = .{ .world = @intCast(world), .hpad = 0 };
+    for (0..world) |q| {
+        const s = try shard.Share.of(c, q, world);
+        t.lo[q] = @intCast(s.mla.lo);
+        t.n[q] = @intCast(s.mla.len());
+        t.hpad = @max(t.hpad, t.n[q]);
+    }
+    return t;
+}
