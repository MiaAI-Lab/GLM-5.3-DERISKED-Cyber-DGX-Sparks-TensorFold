From bd32fa8305013f08a3afbb81571435b3afc5694a Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <noreply@miaai.invalid>
Date: Sun, 22 Nov 2026 01:01:59 +0200
Subject: [PATCH 227/230] glm: slot resume re-tap of 512/256/0 rows behind
 policy bits 6/7 (drafter from = resume point)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 zig/src/families/glm/cuda_engine.zig |  3 +++
 zig/src/families/glm/cuda_lanes.zig  |  2 +-
 zig/src/families/glm/cuda_native.zig |  2 ++
 zig/src/families/glm/policy.zig      | 27 ++++++++++++++++++++++++---
 4 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/zig/src/families/glm/cuda_engine.zig b/zig/src/families/glm/cuda_engine.zig
index 923461457..40634f0ff 100644
--- a/zig/src/families/glm/cuda_engine.zig
+++ b/zig/src/families/glm/cuda_engine.zig
@@ -611,6 +611,9 @@ pub const Engine = struct {
         if (try e.shared(if (ok) 0 else 1) > 0) return error.BadResume;
         try e.cur.st.setPos(e.stream, at);
         e.cur.rewound = at;
+        // a shorter re-tap (policy retap bits): the pass taps only rows from `at`, so the drafter's context starts
+        // there (its block reads ring rows max(from, pos - WIN) ..); with the full re-tap every row it reads is retapped
+        if (e.drafter) |dr| if (@import("policy.zig").retapRows(e.cur.policy, @intCast(dflash.WIN)) < @as(usize, @intCast(dflash.WIN))) try dr.restart(e.slot, at);
     }
 
     /// Whether this rank's bound sequence can stand at `at` in place: a glm_moe_dsa sequence of MLA layers alone, just
diff --git a/zig/src/families/glm/cuda_lanes.zig b/zig/src/families/glm/cuda_lanes.zig
index 56df748d5..e009ebe66 100644
--- a/zig/src/families/glm/cuda_lanes.zig
+++ b/zig/src/families/glm/cuda_lanes.zig
@@ -364,7 +364,7 @@ pub const Lanes = struct {
         const standing = self.standingOf(l.slot);
         // where the slot's rows stand for this prompt, read before the begin stamps the slot again
         const point: usize = if (standing) |st| (if (may_resume and self.slot_resume and plain and s.prompt_logprobs == null and self.x.e.pages == null)
-            st.plan(fw.prefill_rows, ids, self.x.e.cur.begun, mask orelse 0, self.drafterTail())
+            st.plan(fw.prefill_rows, ids, self.x.e.cur.begun, mask orelse 0, policy_mod.retapRows(mask orelse 0, self.drafterTail()))
         else
             0) else 0;
         if (standing) |st| st.clear(); // the begin below leaves nothing standing until the pass records it
diff --git a/zig/src/families/glm/cuda_native.zig b/zig/src/families/glm/cuda_native.zig
index 77d898704..faa9f79d2 100644
--- a/zig/src/families/glm/cuda_native.zig
+++ b/zig/src/families/glm/cuda_native.zig
@@ -512,6 +512,8 @@ fn policyBoot(e: *const engine.Engine) policy.Boot {
     if (e.drafter) |dr| if (dr.spark == null) { // DFlash2's selector races keyed drafts; DSpark's does not
         b.offered |= policy.bit(.dflash2_coupled);
     };
+    // the shorter re-tap of a slot resume: host rules on every rank (the resume point, the drafter's first row)
+    if (e.drafter != null) b.offered |= policy.bit(.retap_a) | policy.bit(.retap_b);
     for (e.w.layers) |l| switch (l.mixer) {
         .mla => |a| {
             if (a.dec_n > 0) b.offered |= policy.bit(.qkva_bypass);
diff --git a/zig/src/families/glm/policy.zig b/zig/src/families/glm/policy.zig
index 7f737c7d2..915d8b9e0 100644
--- a/zig/src/families/glm/policy.zig
+++ b/zig/src/families/glm/policy.zig
@@ -16,6 +16,9 @@ pub const Bit = enum(u5) {
     topk_multi_cta = 3, // multi-CTA top-2048 selection
     owner_rows = 4, // prefill q_a/kv_a (and indexer query) on owner rows, then gather
     qkva_bypass = 5, // a decode window's [q_a | kv_a] on the replicated projection, not the split slices
+    retap_a = 6, // slot resume beside a drafter: re-tap 512 rows at the prompt's end, not the drafter's 2,048 (b: 256; both: 0)
+    retap_b = 7,
+    dsa_pdl = 8, // the decode DSA chain (attention, index scores and selection, norms) as dependent launches
     // the unified-opt run's candidates (night/unified): bits 16-27, each off unless a request (or the default) asks
     l2pf_v2 = 16, // U1: TF_GLM_L2PF's sites read what the window reads next (proj_dec, q_b, shared expert, head), stop at the gather's end
     dflash_mesh = 17, // U2: DFlash2's gathers and greedyRows over the RoCE mesh, not NCCL
@@ -31,15 +34,33 @@ pub const Bit = enum(u5) {
     prompt_topk_multi = 27, // U6.3: prompt select blocks past 131,072 keys on tf_glm_dsa_tscan / tmerge
 };
 
-pub const reserved: Mask = 0x3f;
+pub const reserved: Mask = 0x1ff;
 /// The unified run's bits (16-27): offered where their kernels and tables loaded.
 pub const unified: Mask = 0x0fff_0000;
 /// The mask of the forward now running on this rank's thread (set at each forward's start; 0 outside one): the bits
 /// read deep in shared kernel tables (glm_mm's decode table, the EXL3 experts) without threading the mask through.
 pub var live: Mask = 0;
 
-/// Bits a stream uses on its own (rank 0's drafting), not in a forward: a shared forward never mixes over them.
-pub const per_stream: Mask = 1 << @backingInt(Bit.dflash2_coupled);
+/// Bits a stream uses on its own (rank 0's drafting, the resume point), not in a forward: a shared forward never mixes
+/// over them.
+pub const per_stream: Mask = 1 << @backingInt(Bit.dflash2_coupled) | 1 << @backingInt(Bit.retap_a) | 1 << @backingInt(Bit.retap_b);
+
+/// The rows a slot resume re-taps at the prompt's end beside a drafter of window `win` under mask `m`: the window
+/// itself (the boot's rule) unless a retap bit asks for 512, 256 or 0 rows.
+pub fn retapRows(m: Mask, win: usize) usize {
+    const a = on(m, .retap_a);
+    const b = on(m, .retap_b);
+    const rows: usize = if (a and b) 0 else if (a) 512 else if (b) 256 else win;
+    return @min(rows, win);
+}
+
+test "GLM policy: retap bits pick 512, 256 or 0 rows, never more than the window" {
+    try std.testing.expectEqual(@as(usize, 2048), retapRows(0, 2048));
+    try std.testing.expectEqual(@as(usize, 512), retapRows(bit(.retap_a), 2048));
+    try std.testing.expectEqual(@as(usize, 256), retapRows(bit(.retap_b), 2048));
+    try std.testing.expectEqual(@as(usize, 0), retapRows(bit(.retap_a) | bit(.retap_b), 2048));
+    try std.testing.expectEqual(@as(usize, 100), retapRows(bit(.retap_a), 100));
+}
 
 pub fn bit(b: Bit) Mask {
     return @as(Mask, 1) << @backingInt(b);
