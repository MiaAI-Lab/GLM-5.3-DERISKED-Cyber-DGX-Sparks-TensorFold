+    /// TF_GLM_SEQ_GROW: unmaps an idle slot's VMM granules and clears its begin stamp so no stale standing rows remain.
+    pub fn trimSlot(e: *Engine, slot: u32) !void {
+        if (slot >= e.seqs.items.len) return;
+        const q = e.seqs.items[slot] orelse return;
+        const r = q.st.grow orelse return;
+        if (r.mapped == 0) return;
+        try e.stream.synchronize();
+        r.trim(0);
+        q.begun = 0;
+    }
