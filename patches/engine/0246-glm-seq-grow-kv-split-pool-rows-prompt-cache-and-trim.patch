+        const r = q.st.grow orelse return;
+        const want = @min(self.x.e.capacity, target_rows);
+        const miss = r.missing(want);
+        if (miss == 0) return;
+        while (pool.available() < miss) {
+            const victim = self.lruIdleMappedSlot(slot) orelse return error.LaneMemory;
+            if (self.standingOf(victim)) |st| st.clear();
+            try self.x.trimSlot(victim);
+        }
+    }
