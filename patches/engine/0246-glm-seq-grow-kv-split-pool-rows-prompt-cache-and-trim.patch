diff --git a/zig/src/families/glm/cuda_kv8_snapshot_test.zig b/zig/src/families/glm/cuda_kv8_snapshot_test.zig
index 37e782b..460cb63 100644
--- a/zig/src/families/glm/cuda_kv8_snapshot_test.zig
+++ b/zig/src/families/glm/cuda_kv8_snapshot_test.zig
@@ -368,3 +368,132 @@ test "GLM FP8 KV: a split prefix keeps ceil(at / W) rows a cache, about a W-th o
     try t.expectEqual(@as(usize, 385), state.latHeld(1537));
     try t.expectEqual(@as(usize, 1537), state.ikHeld(1537)); // index keys stay whole without TF_GLM_KV_SPLIT=2
 }
+
+test "GLM FP8 KV: seq_grow with KV_SPLIT=2 builds valid snapshot Plan across VMM region and arena" {
+    const seq_grow = @import("cuda_seq_grow.zig");
+    const gpa = t.allocator;
+    _ = setenv("TF_GLM_KV8_INT8", "1", 1);
+    defer _ = unsetenv("TF_GLM_KV8_INT8");
+    state.lat_split = 4;
+    state.ik_split = true;
+    defer {
+        state.lat_split = 1;
+        state.ik_split = false;
+    }
+    var d = Mem.driver();
+    var w: weights.Weights = undefined;
+    w.config = .{};
+    w.config.dsa = true;
+    w.config.rope = 64;
+    var layers: [3]weights.Layer = undefined;
+    for (&layers) |*l| l.mixer = .{ .mla = undefined };
+    w.layers = &layers;
+    w.share = try shard.Share.of(&w.config, 0, 4);
+    const capacity: usize = 4096;
+    const at: usize = 1536;
+
+    // Build a real Region backed by host memory via a mock VMM mapper
+    const HostVmm = struct {
+        gpa: std.mem.Allocator,
+        g: usize = 4096,
+        next_h: u64 = 1,
+        free_h: std.ArrayList(u64) = .empty,
+        backing: std.AutoHashMapUnmanaged(u64, []align(4096) u8) = .empty,
+
+        fn init(al: std.mem.Allocator, count: usize) !@This() {
+            var v: @This() = .{ .gpa = al };
+            try v.free_h.ensureTotalCapacity(al, count);
+            for (0..count) |i| v.free_h.appendAssumeCapacity(i + 1);
+            return v;
+        }
+        fn deinit(v: *@This()) void {
+            var it = v.backing.valueIterator();
+            while (it.next()) |buf| v.gpa.free(buf.*);
+            v.backing.deinit(v.gpa);
+            v.free_h.deinit(v.gpa);
+        }
+        fn of(ctx: *anyopaque) *@This() { return @ptrCast(@alignCast(ctx)); }
+        fn take(ctx: *anyopaque) ?u64 { return of(ctx).free_h.pop(); }
+        fn give(ctx: *anyopaque, h: u64) void { of(ctx).free_h.appendAssumeCapacity(h); }
+        fn map(_: *anyopaque, va: u64, _: u64) seq_grow.Mapped {
+            @memset(@as([*]u8, @ptrFromInt(va))[0..4096], 0);
+            return .ok;
+        }
+        fn unmap(_: *anyopaque, _: u64) bool { return true; }
+        fn reserve(ctx: *anyopaque, len: usize) ?u64 {
+            const v = of(ctx);
+            const buf = v.gpa.alignedAlloc(u8, std.mem.Alignment.fromByteUnits(4096), len) catch return null;
+            const addr: u64 = @intFromPtr(buf.ptr);
+            v.backing.put(v.gpa, addr, buf) catch {
+                v.gpa.free(buf);
+                return null;
+            };
+            return addr;
+        }
+        fn unreserve(ctx: *anyopaque, va: u64, _: usize) void {
+            const v = of(ctx);
+            if (v.backing.fetchRemove(va)) |kv| v.gpa.free(kv.value);
+        }
+        fn mapper(v: *@This()) seq_grow.Mapper {
+            return .{ .ctx = v, .granularity = v.g, .take = take, .give = give, .map = map, .unmap = unmap, .reserve = reserve, .unreserve = unreserve };
+        }
+    };
+
+    // Exercise Plan with a non-grow KV_SPLIT=2 state vs a grow-backed state with identical rows
+    var plain = try state.State.initHead(gpa, &d, &w, capacity, true, false);
+    defer plain.deinit();
+    const plain_plan = try layout.Plan.init(&plain, &w.config, at, null);
+
+    var hv = try HostVmm.init(gpa, 2000);
+    defer hv.deinit();
+    // Build a grow-backed State whose arena only holds the fixed prefix + tail (as growRegion zeroes lc/ik in arena).
+    var st = try state.State.initHead(gpa, &d, &w, capacity, true, false);
+    defer st.deinit();
+    const prefix_len = plain.caches[0].lc - plain.arena.buf.ptr;
+    const tail_len = (plain.arena.buf.ptr + plain.arena.buf.len) - plain.mtp_pos_dev;
+    // Shrink logical arena window to fixed prefix + tail (real State.make allocates only prefix + tail when grow != null).
+    st.mtp_pos_dev = st.arena.buf.ptr + prefix_len;
+    st.arena.buf.len = @intCast(prefix_len + tail_len);
+    const lw: usize = w.config.kv_lora + w.config.rope;
+    const lrows = state.latRows(capacity);
+    var sizes: [6]usize = undefined;
+    var planes: [6]?[2]seq_grow.Plane = undefined;
+    var nps: [6]u8 = undefined;
+    var divs: [6]usize = undefined;
+    var addrs: [6]u64 = undefined;
+    for (0..3) |j| {
+        sizes[2 * j] = try latent.cacheBytes(lrows, lw, true);
+        planes[2 * j] = .{ .{ .off = 0, .row = lw }, .{ .off = lrows * lw, .row = latent.scaleBytes(lw) } };
+        nps[2 * j] = 2;
+        divs[2 * j] = 4;
+        sizes[2 * j + 1] = lrows * w.config.i_dim * 2;
+        planes[2 * j + 1] = .{ .{ .off = 0, .row = w.config.i_dim * 2 }, .{ .off = 0, .row = 0 } };
+        nps[2 * j + 1] = 1;
+        divs[2 * j + 1] = 4;
+    }
+    const r = try gpa.create(seq_grow.Region);
+    r.* = try seq_grow.Region.initDiv(gpa, hv.mapper(), &sizes, &planes, &nps, &divs, &addrs);
+    st.grow = r; // freed by st.deinit()
+    for (st.caches, 0..) |*x, j| {
+        x.lc = addrs[2 * j];
+        x.ls = addrs[2 * j] + lrows * lw;
+        x.ik = addrs[2 * j + 1];
+        st.rings[2 * j] = addrs[2 * j + 1];
+    }
+    try r.ensure(at);
+    const grow_plan = try layout.Plan.init(&st, &w.config, at, null);
+    try t.expectEqual(plain_plan.len, grow_plan.len);
+    // Roundtrip copy through snapshot pool
+    var pool = try pages.Pool.initTiers(gpa, &d, pages.page, 64 * pages.page);
+    defer pool.deinit();
+    var lease = try pool.take(grow_plan.len);
+    defer pool.give(&lease);
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    const lat_held = state.latHeld(at);
+    fillOrPoison(&st, st.caches, lat_held, lw, 8, false);
+    try pool.move(stream, &lease, &grow_plan, true);
+    fillOrPoison(&st, st.caches, lat_held, lw, 8, true);
+    try pool.move(stream, &lease, &grow_plan, false);
+    const res = check(&st, st.caches, lat_held, lw, 8);
+    try t.expectEqual(Result{}, res);
+}
