@@ -573,6 +578,59 @@ pub const Lanes = struct {
         return seq_grow.admits(pool.total, slots[0..seqs.len], target_slot, need);
     }
 
+    /// Find the least-recently-used idle slot holding mapped VMM granules, excluding `skip_slot`.
+    fn lruIdleMappedSlot(self: *const Lanes, skip_slot: ?u32) ?u32 {
+        var victim: ?u32 = null;
+        var age: u64 = std.math.maxInt(u64);
+        for (self.x.e.seqs.items, 0..) |q, i| {
+            const slot: u32 = @intCast(i);
+            if (skip_slot != null and slot == skip_slot.?) continue;
+            if (self.slotTaken(slot)) continue;
+            const r = (q orelse continue).st.grow orelse continue;
+            if (r.mapped == 0) continue;
+            const u = self.slotUsed(slot);
+            if (victim == null or u < age) {
+                victim = slot;
+                age = u;
+            }
+        }
+        return victim;
+    }
+
+    /// Trim LRU idle slots across all ranks until `target_slot` fits `need` granules (never trimming a matched slot).
+    fn prepareGrowSlot(self: *Lanes, target_slot: u32, need: usize, matched: bool) !bool {
+        if (seq_grow.pool == null) return true;
+        while (!self.growFitsSlot(target_slot, need)) {
+            const victim = self.lruIdleMappedSlot(target_slot) orelse break;
+            if (self.standingOf(victim)) |st| st.clear();
+            try self.x.trimSlot(victim);
+        }
+        if (self.growFitsSlot(target_slot, need)) return true;
+        if (!matched and target_slot < self.x.e.seqs.items.len) {
+            if (self.x.e.seqs.items[target_slot]) |q| if (q.st.grow) |r| if (r.mapped > need) {
+                if (self.standingOf(target_slot)) |st| st.clear();
+                try self.x.trimSlot(target_slot);
+            };
+        }
+        return self.growFitsSlot(target_slot, need);
+    }
+
