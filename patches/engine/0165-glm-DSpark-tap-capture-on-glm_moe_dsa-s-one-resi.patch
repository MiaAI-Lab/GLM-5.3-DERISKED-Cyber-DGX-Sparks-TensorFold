diff --git a/zig/src/families/glm/cuda_taps.zig b/zig/src/families/glm/cuda_taps.zig
index 01d0f4a..03ed574 100644
--- a/zig/src/families/glm/cuda_taps.zig
+++ b/zig/src/families/glm/cuda_taps.zig
@@ -1,4 +1,5 @@
 //! DFlash2's taps on the target's forward: after each tapped layer, its rows' 4-stream mean into one tap slot.
+const std = @import("std");
 const cuda = @import("cuda");
 
 /// The target layers DFlash2 reads (incoai/GLM-5.3-Flash-DFlash2's target_layer_ids), in tap-slot order.
@@ -13,13 +14,34 @@ pub fn slot(j: usize) ?i32 {
     return null;
 }
 
-/// Where a forward's taps go: rows [R][5 * hidden] bf16 at `out`, through glm_dflash's df_tap.
+/// glm_moe_dsa's taps (DSpark, RedHatAI/GLM-5.3-speculator.dspark): its aux_hidden_state_layer_ids 2, 20, 39, 58, 75
+/// are layer INPUTS, so the residual after 0-based layers 1, 19, 38, 57, 74, in tap-slot order.
+pub const dsa_layers = [_]usize{ 1, 19, 38, 57, 74 };
+
+/// Layer `j`'s DSA tap slot, or null.
+pub fn dsaSlot(j: usize) ?usize {
+    for (dsa_layers, 0..) |l, i| if (l == j) return i;
+    return null;
+}
+
+/// Where a forward's taps go: rows [R][5 * hidden] bf16 at `out`, through glm_dflash's df_tap; or (`dsa` > 0, the
+/// hidden size of glm_moe_dsa's one residual stream) each tapped layer's whole rows copied into their slot of
+/// [R][5 * dsa] bf16 (a strided device copy: no mean, no norm).
 pub const Taps = struct {
     f: cuda.Function,
     out: u64,
+    dsa: usize = 0,
 
-    /// After layer `j` (nothing off the tapped layers): rows lo..lo + n of residual `x` (bf16 [rows][4][hidden]).
+    /// After layer `j` (nothing off the tapped layers): rows lo..lo + n of residual `x` (bf16 [rows][4][hidden], or
+    /// on the dsa [rows][dsa]).
     pub fn at(t: Taps, s: cuda.Stream, j: usize, x: u64, lo: usize, n: usize) !void {
+        if (t.dsa != 0) {
+            const k = dsaSlot(j) orelse return;
+            if (n == 0) return;
+            const row = t.dsa * 2;
+            const p: cuda.abi.Memcpy2D = .{ .src = x + lo * row, .src_pitch = row, .dst = t.out + lo * dsa_layers.len * row + k * row, .dst_pitch = dsa_layers.len * row, .width = row, .height = n };
+            return s.d.check(s.d.api.cuMemcpy2DAsync_v2(&p, s.handle), "cuMemcpy2DAsync");
+        }
         const k = slot(j) orelse return;
         if (n == 0) return;
         var a: cuda.Args = .{};
@@ -30,3 +52,59 @@ pub const Taps = struct {
         try cuda.launch.launch(t.f, .{ .grid = .{ .x = @intCast(n), .y = hidden / 1024 }, .block = .{ .x = 256 } }, s, &a);
     }
 };
+
+/// TF_GLM_TAP_DUMP=<file> (glm_moe_dsa, no drafter): every prompt chunk's DSpark taps, for the NumPy twin
+/// (scripts/tests/dspark_twin.py). Every rank taps (so every rank runs tapped chunks whole, the same collectives);
+/// rank 0 appends one record a chunk: "TAPS" u32 magic, i64 start, i32 rows, i32 hidden, i32 ids [rows],
+/// bf16 taps [rows][5][hidden].
+pub const Dump = struct {
+    d: *const cuda.Driver,
+    buf: cuda.DeviceBuffer,
+    host: []u8,
+    rows: usize,
+    hidden: usize,
+    path: ?[*:0]const u8, // rank 0's file (records appended, the file closed after each)
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, rows: usize, width: usize, rank: usize) !?*Dump {
+        const path = std.c.getenv("TF_GLM_TAP_DUMP") orelse return null;
+        const x = try gpa.create(Dump);
+        errdefer gpa.destroy(x);
+        const bytes = rows * dsa_layers.len * width * 2;
+        x.* = .{ .d = d, .buf = try cuda.DeviceBuffer.alloc(d, bytes), .host = try gpa.alloc(u8, if (rank == 0) bytes else 0), .rows = rows, .hidden = width, .path = null };
+        if (rank == 0) {
+            const f = std.c.fopen(path, "wb") orelse return error.DumpOpen;
+            _ = std.c.fclose(f);
+            x.path = path;
+        }
+        return x;
+    }
+
+    pub fn deinit(x: *Dump, gpa: std.mem.Allocator) void {
+        gpa.free(x.host);
+        x.buf.free();
+        gpa.destroy(x);
+    }
+
+    pub fn taps(x: *const Dump) Taps {
+        return .{ .f = undefined, .out = x.buf.ptr, .dsa = x.hidden };
+    }
+
+    /// After a chunk's forward on `s`: its rows' taps to the file (rank 0).
+    pub fn write(x: *Dump, s: cuda.Stream, start: usize, ids: []const i32) !void {
+        const path = x.path orelse return;
+        const n = @min(ids.len, x.rows);
+        const bytes = n * dsa_layers.len * x.hidden * 2;
+        try s.synchronize();
+        try x.d.check(x.d.api.cuMemcpyDtoH_v2(@ptrCast(x.host.ptr), x.buf.ptr, bytes), "cuMemcpyDtoH");
+        var head: [20]u8 = undefined;
+        @memcpy(head[0..4], "TAPS");
+        std.mem.writeInt(i64, head[4..12], @intCast(start), .little);
+        std.mem.writeInt(i32, head[12..16], @intCast(n), .little);
+        std.mem.writeInt(i32, head[16..20], @intCast(x.hidden), .little);
+        const idb = std.mem.sliceAsBytes(ids[0..n]);
+        const f = std.c.fopen(path, "ab") orelse return error.DumpOpen;
+        defer _ = std.c.fclose(f);
+        if (std.c.fwrite(&head, 1, head.len, f) != head.len or std.c.fwrite(idb.ptr, 1, idb.len, f) != idb.len or
+            std.c.fwrite(x.host.ptr, 1, bytes, f) != bytes) return error.DumpWrite;
+    }
+};
