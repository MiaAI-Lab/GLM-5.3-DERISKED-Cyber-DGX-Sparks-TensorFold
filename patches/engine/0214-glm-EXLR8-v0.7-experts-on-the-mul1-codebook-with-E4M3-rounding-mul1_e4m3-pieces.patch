     for (int i = threadIdx.x; i < n; i += GROUP_THREADS) sh_pick[i] = a.pick[i];
     __syncthreads();
     group_rows(sh_pick, n, a.slots, a.experts, a.maxm, a.uids, a.ucount, a.members);
