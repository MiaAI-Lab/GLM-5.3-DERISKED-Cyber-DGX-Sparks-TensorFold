index 000000000..0c54cfaaf
--- /dev/null
+++ b/zig/tests/exl3_mul1_e4m3_check.cu
@@ -0,0 +1,187 @@
+// EXLR8 v0.7 (mul1 experts): in the e4m3 images' build (TF_EXL3_MCG_E4M3=1 and, new, TF_EXL3_MUL1_E4M3=1), the mul1
+// decode sites round to E4M3 the way FORMAT.md's Codebook and Decode sections define ("v -> E4M3 (nearest even,
+// clamp +-448) -> fp32"): decode2<CB_MUL1> (exl3_decode.cuh, aliased to CB_MUL1_E4M3 by the define — the grouped
+// experts' path, tf_exl3_grouped_2) and decode2<CB_MUL1_E4M3> itself must equal, bit for bit for all 65,536 states
+// in both slots of a pair, a host reference implementing FORMAT.md's mul1 literally: x = (state·0x83DCD12D) mod 2^32,
+// v = fp16(1024 + Σb)·c + d with c = fp16 0x1EEE, d = fp16 0xC931 in the definition's fp16 operation order (one fp16
+// rounding — exact in float, as exl3_format.zig's codebookValue does it in float64), then the E4M3 round-trip through
+// CUDA's host conversions (satfinite E4M3). Host pre-checks prove the rounding step itself before the device run:
+// a first-principles E4M3 RNE reference agrees with CUDA's host conversion on every finite fp16 pattern, and so does
+// the device fallback's integer algorithm (exl3_decode.cuh's e4m3_round1, the sub-sm_89 path of mul1_e4m3_finish;
+// its host copy here must stay in step with it). Controls: the unrounded mul1 must differ from the reference on most
+// states (the rounding is active, not vacuous), the decoded values must be non-zero (mul1's constants put v at
+// (Σb − 510)·c, never near zero), and mcg must be untouched: decode2<CB_MCG> still equals exlr8.cu's tf_exlr8_pair.
+// Built without TF_EXL3_MUL1_E4M3=1 (the pre-change e4m3 image) the decode2<CB_MUL1> check must fail (the control:
+// CB_MUL1 is then the unrounded EXL3 mul1).
+// nvcc -O2 -std=c++17 --expt-relaxed-constexpr -arch=sm_121 -I kernels/cuda -DTF_EXL3_MCG_E4M3=1 -DTF_EXL3_MUL1_E4M3=1 tests/exl3_mul1_e4m3_check.cu
+// (from zig/; the control, which must fail the decode2<CB_MUL1> check, drops -DTF_EXL3_MUL1_E4M3=1)
+#include <cstdio>
+#include <cstdlib>
+#include <cuda_fp8.h>
+#include "exl3_experts.cu"  // the experts module as built (its grouped and prompt headers in their context)
+#include "exlr8.cu"
+
+// ---- the E4M3 round-trip, three ways on the host ----
+
+// A first-principles E4M3 RNE reference: the nearest of the 127 finite codes (ties to the even mantissa lsb),
+// subnormals m·2^-9 under 2^-6, satfinite clamp to +-448 above.
+static uint16_t e4m3_roundtrip_ref(uint16_t h) {
+    const uint16_t s = h & 0x8000u;
+    const uint32_t a = h & 0x7FFFu;
+    if (a >= 0x7C00u) return (uint16_t)(a > 0x7C00u ? (s | 0x7E00u) : (s | 0x5F00u));  // nan; +-inf satfinite
+    const double v = __half2float(__ushort_as_half(h));
+    const double av = v < 0 ? -v : v;
+    uint32_t best = 0;
+    double bestd = 1e300;
+    for (uint32_t c = 0; c <= 126; ++c) {
+        const double val = c < 8 ? ldexp((double)c, -9) : ldexp((double)(8 + (c & 7)), (int)(c >> 3) - 10);
+        const double dist = av > val ? av - val : val - av;
+        if (dist < bestd || (dist == bestd && (c & 1) == 0 && (best & 1) == 1)) {
+            bestd = dist;
+            best = c;
+        }
+    }
+    if (best < 8) {  // subnormal: best·2^-9, exact in fp16
+        if (best == 0) return s;
+        uint32_t hb = 0;
+        while ((1u << (hb + 1)) <= best) ++hb;
+        return (uint16_t)(s | ((hb + 6u) << 10) | ((best - (1u << hb)) << (10 - hb)));
+    }
+    return (uint16_t)(s | (((best >> 3) + 8u) << 10) | ((best & 7u) << 7));  // 1.m·2^(field-7), exact in fp16
+}
+
+// The same through CUDA's host conversions (the documented RNE satfinite E4M3).
+static uint16_t e4m3_roundtrip_cuda(uint16_t h) {
+    const float f = __half2float(__ushort_as_half(h));
+    const __nv_fp8_storage_t e = __nv_cvt_float_to_fp8(f, __NV_SATFINITE, __NV_E4M3);
+    return __half_as_ushort(__half(__nv_cvt_fp8_to_halfraw(e, __NV_E4M3)));
+}
+
+// A host copy of exl3_decode.cuh's e4m3_round1 (mul1_e4m3_finish's sub-sm_89 fallback): keep the two in step.
+static uint16_t e4m3_round1_host(uint16_t h) {
+    const uint16_t s = h & 0x8000u;
+    const uint32_t a = h & 0x7FFFu;
+    if (a >= 0x7C00u) return (uint16_t)(a > 0x7C00u ? (s | 0x7E00u) : (s | 0x5F00u));
+    if (a < 0x0400u) return s;
+    const uint32_t f16e = a >> 10, sig = (a & 0x3FFu) | 0x400u;
+    uint32_t code;
+    if (f16e >= 9) {
+        uint32_t q = sig >> 7, r = sig & 0x7Fu;
+        if (r > 0x40u || (r == 0x40u && (q & 1u))) q++;
+        const int e = (int)f16e - 15 + (q == 16u ? 1 : 0);
+        if (q == 16u) q = 8u;
+        if (e > 8 || (e == 8 && q == 15u)) return (uint16_t)(s | 0x5F00u);
+        code = ((uint32_t)(e + 7) << 3) | (q & 7u);
+    } else {
+        const uint32_t sh = 16u - f16e;
+        uint32_t q = sig >> sh, r = sig & ((1u << sh) - 1u);
+        if (r > (1u << (sh - 1)) || (r == (1u << (sh - 1)) && (q & 1u))) q++;
+        code = q;
+    }
+    if (code < 8u) {
+        if (code == 0u) return s;
+        uint32_t hb = 0;
+        while ((1u << (hb + 1)) <= code) ++hb;
+        return (uint16_t)(s | ((hb + 6u) << 10) | ((code - (1u << hb)) << (10 - hb)));
+    }
+    return (uint16_t)(s | (((code >> 3) + 8u) << 10) | ((code & 7u) << 7));
+}
+
+// FORMAT.md's mul1, literally, on the host: the byte sum, fp16(1024 + Σb), the definition's fp16 operation order —
+// h·c + d with one fp16 rounding, exact in float (h·c = hM·2^-18, h < 2^11 and M the 11-bit significand of c, and
+// d = N·2^-7: the exact sum K·2^-18 has |K| < 2^23, so every float step is exact and __float2half_rn rounds once) —
+// then the E4M3 round-trip through CUDA's host conversion.
+static uint16_t mul1_ref(uint16_t state) {
+    const uint32_t x = (uint32_t)state * 0x83DCD12Du;
+    const unsigned sum = (x & 255u) + ((x >> 8) & 255u) + ((x >> 16) & 255u) + ((x >> 24) & 255u);
+    const float h = __half2float(__float2half_rn((float)(1024 + sum)));
+    const float c = __half2float(__ushort_as_half(0x1EEE)), d = __half2float(__ushort_as_half(0xC931));
+    // exact in fp32 (see below); kindlingai's reference loader (loader/exlr8.py) rounds this sum ONCE to fp16
+    // ((1024 + byte_sum) * C + D).half(), then to E4M3: the fp16 rounding must not be skipped.
+    const float v = __half2float(__float2half_rn(h * c + d));
+    const __nv_fp8_storage_t e = __nv_cvt_float_to_fp8(v, __NV_SATFINITE, __NV_E4M3);
+    return __half_as_ushort(__half(__nv_cvt_fp8_to_halfraw(e, __NV_E4M3)));
+}
+
+// The unrounded mul1 (the pre-change decode2<CB_MUL1> body), for the control that the rounding is active.
+__device__ __forceinline__ uint32_t mul1_raw(uint32_t s0, uint32_t s1) {
+    const uint32_t x0 = s0 * 0x83DCD12Du, x1 = s1 * 0x83DCD12Du;
+    const uint32_t h0 = __dp4a(x0, 0x01010101u, 0x6400u);
+    const uint32_t h1 = __dp4a(x1, 0x01010101u, 0x6400u);
+    const uint32_t hh = (h0 & 0xffffu) | (h1 << 16);
+    const half2 r = __hfma2(*reinterpret_cast<const half2*>(&hh), __half2half2(__ushort_as_half(0x1eee)),
+                            __half2half2(__ushort_as_half(0xc931)));
+    return *reinterpret_cast<const uint32_t*>(&r);
+}
+
+// Every 16-bit state in both slots of a pair (two partners a state, so a defect limited to one state or one slot is
+// caught): the aliased decode2<CB_MUL1> and the explicit decode2<CB_MUL1_E4M3> against the host reference; the raw
+// decode against the rounded one (the rounding must change most states); and mcg against tf_exlr8_pair (untouched).
+__global__ void sites(const uint16_t* ref, unsigned* bad, unsigned* raw_diff, unsigned* zeros) {
+    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= 65536) return;
+    const unsigned partners[2] = {i ^ 0xA5A5u, __brev(i) >> 16};
+    for (unsigned p : partners) {
+        for (int slot = 0; slot < 2; ++slot) {
+            const unsigned s0 = slot ? p : i, s1 = slot ? i : p;
+            const uint32_t want = (uint32_t)ref[s1] << 16 | ref[s0];
+            if (tf_exl3::decode2<tf_exl3::CB_MUL1>(s0, s1) != want) atomicAdd(bad, 1u);
+            if (tf_exl3::decode2<tf_exl3::CB_MUL1_E4M3>(s0, s1) != want) atomicAdd(bad + 1, 1u);
+            if (mul1_raw(s0, s1) != tf_exl3::decode2<tf_exl3::CB_MUL1_E4M3>(s0, s1)) atomicAdd(raw_diff, 1u);
+            if ((tf_exl3::decode2<tf_exl3::CB_MUL1_E4M3>(s0, s1) & 0x7FFF7FFFu) == 0) atomicAdd(zeros, 1u);
+        }
+    }
+    const __half2 r = tf_exlr8_pair(i, partners[0]);
+    const uint32_t want = *reinterpret_cast<const uint32_t*>(&r);
+    if (tf_exl3::decode2<tf_exl3::CB_MCG>(i, partners[0]) != want) atomicAdd(bad + 2, 1u);
+}
+
+int main() {
+    // The rounding step itself, exhaustively over every finite fp16 pattern (both signs), before anything runs:
+    // the first-principles reference and the fallback's algorithm must both match CUDA's host conversion.
+    long ref_vs_cuda = 0, emul_vs_cuda = 0;
+    for (uint32_t h = 0; h < 0x7C00u; ++h)
+        for (int sign = 0; sign < 2; ++sign) {
+            const uint16_t bits = (uint16_t)(h | (sign ? 0x8000u : 0u));
+            const uint16_t rc = e4m3_roundtrip_cuda(bits);
+            ref_vs_cuda += e4m3_roundtrip_ref(bits) != rc;
+            emul_vs_cuda += e4m3_round1_host(bits) != rc;
+        }
+    printf("host E4M3 RNE round-trip over all finite fp16: %ld of 63488 differ from CUDA's conversion (reference), "
+           "%ld (the fallback's algorithm)\n",
+           ref_vs_cuda, emul_vs_cuda);
+    long hbits_bad = 0;
+    for (unsigned sum = 0; sum <= 1020; ++sum)
+        hbits_bad += __half_as_ushort(__float2half_rn((float)(1024 + sum))) != (uint16_t)(0x6400u | sum);
+    printf("fp16(1024 + sum) = bits 0x6400 | sum: %ld of 1021 wrong\n", hbits_bad);
+
+    uint16_t ref[65536];
+    for (uint32_t i = 0; i < 65536; ++i) ref[i] = mul1_ref((uint16_t)i);
+
+    uint16_t* dref;
+    unsigned* dout;
+    unsigned hbad[3] = {0, 0, 0}, hraw = 0, hzeros = 0;
+    if (cudaMalloc(&dref, sizeof ref) != cudaSuccess || cudaMalloc(&dout, sizeof hbad + 8) != cudaSuccess) return 2;
+    cudaMemcpy(dref, ref, sizeof ref, cudaMemcpyHostToDevice);
+    cudaMemset(dout, 0, sizeof hbad + 8);
+    sites<<<256, 256>>>(dref, dout, dout + 3, dout + 4);
+    if (cudaDeviceSynchronize() != cudaSuccess) { printf("FAIL launch\n"); return 2; }
+    cudaMemcpy(hbad, dout, sizeof hbad, cudaMemcpyDeviceToHost);
+    cudaMemcpy(&hraw, dout + 3, 4, cudaMemcpyDeviceToHost);
+    cudaMemcpy(&hzeros, dout + 4, 4, cudaMemcpyDeviceToHost);
+
+    int fails = 0;
+    printf("decode2<CB_MUL1> (exl3_decode.cuh, aliased by TF_EXL3_MUL1_E4M3) %s: %u of 262144 differ from the reference\n",
+           hbad[0] == 0 ? "PASS" : "FAIL", hbad[0]);
+    printf("decode2<CB_MUL1_E4M3> (exl3_decode.cuh) %s: %u of 262144 differ from the reference\n",
+           hbad[1] == 0 ? "PASS" : "FAIL", hbad[1]);
+    printf("decode2<CB_MCG> still EXLR8's (TF_EXL3_MCG_E4M3) %s: %u of 65536 differ from tf_exlr8_pair\n",
+           hbad[2] == 0 ? "PASS" : "FAIL", hbad[2]);
+    printf("control, the unrounded mul1 differs from the reference on %u of 262144 pairs %s\n", hraw,
+           hraw > 131072 ? "(PASS)" : "(FAIL: the rounding is not active)");
+    printf("control, %u zero values %s\n", hzeros, hzeros == 0 ? "(PASS)" : "(FAIL)");
+    fails += ref_vs_cuda != 0 || emul_vs_cuda != 0 || hbits_bad != 0;
+    fails += hbad[0] != 0 || hbad[1] != 0 || hbad[2] != 0 || hraw <= 131072 || hzeros != 0;
+    printf("TF_EXL3_MUL1_E4M3=%d TF_EXL3_MCG_E4M3=%d: %d failing checks\n", TF_EXL3_MUL1_E4M3, TF_EXL3_MCG_E4M3, fails);
+    return fails ? 1 : 0;
+}
