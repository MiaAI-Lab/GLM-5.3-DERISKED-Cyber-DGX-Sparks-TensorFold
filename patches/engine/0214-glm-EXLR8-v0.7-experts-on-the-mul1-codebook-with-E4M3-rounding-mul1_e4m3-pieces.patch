diff --git a/zig/kernels/cuda/exl3_decode.cuh b/zig/kernels/cuda/exl3_decode.cuh
index 4925bdc22..9ed1d94c9 100644
--- a/zig/kernels/cuda/exl3_decode.cuh
+++ b/zig/kernels/cuda/exl3_decode.cuh
@@ -10,7 +10,7 @@ namespace tf_exl3 {
 
 // CB_MCG_E4M3: EXLR8 (kindlingai's exlr8-e4m3-v2 scheme): the mcg codebook value rounded to E4M3 (nearest even), the
 // format's weight values; tiles, streams and placement are EXL3's, so only the value step differs (patch 0205).
-enum Codebook : int { CB_3INST = 0, CB_MCG = 1, CB_MUL1 = 2, CB_MCG_E4M3 = 3 };
+enum Codebook : int { CB_3INST = 0, CB_MCG = 1, CB_MUL1 = 2, CB_MCG_E4M3 = 3, CB_MUL1_E4M3 = 4 };
 
 // TF_EXL3_MCG_E4M3=1 builds a module whose every mcg decode is EXLR8's (the exl3_experts_e4m3 image, patch 0205): the
 // same kernels, the mcg sum taken at 2^-8 (xor MCG_XOR) and finished by mcg_e4m3_finish. 0 (every other image): unchanged.
@@ -19,6 +19,13 @@ enum Codebook : int { CB_3INST = 0, CB_MCG = 1, CB_MUL1 = 2, CB_MCG_E4M3 = 3 };
 #endif
 constexpr uint32_t MCG_XOR = TF_EXL3_MCG_E4M3 ? 0x1B601B60u : 0x3B603B60u;
 
+// TF_EXL3_MUL1_E4M3=1 (the e4m3 images, beside TF_EXL3_MCG_E4M3) builds the module for EXLR8 v0.7's mul1 experts too
+// (FORMAT.md's mul1 codebook): decode2<CB_MUL1> aliases to decode2<CB_MUL1_E4M3>, mul1's value with the format's E4M3
+// rounding, the way TF_EXL3_MCG_E4M3 aliases CB_MCG. 0 (every other image): CB_MUL1 stays the unrounded EXL3 mul1.
+#ifndef TF_EXL3_MUL1_E4M3
+#define TF_EXL3_MUL1_E4M3 0
+#endif
+
 // An mcg pair summed at 2^-8 (xor 0x1B60), rounded to E4M3 at bit 7 (nearest even, subnormals included) and scaled back
 // by 2^8: exlr8.cu's tf_exlr8_pair after its sum.
 __device__ __forceinline__ uint32_t mcg_e4m3_finish(uint32_t b) {
@@ -27,6 +34,57 @@ __device__ __forceinline__ uint32_t mcg_e4m3_finish(uint32_t b) {
     return *reinterpret_cast<const uint32_t*>(&r);
 }
 
+// One fp16 lane rounded to E4M3 and back to fp16, the value the format stores: nearest even on the E4M3 grid,
+// subnormals included, saturating at +-448 like cvt.rn.satfinite. Below sm_89 (the release fatbins also carry
+// sm_80/86, where the e4m3 conversions do not assemble) the same rounding in integers: the significand rounded to
+// four bits at bit 7 with the carry into the next binade, the subnormal grid of 2^-9 steps under 2^-6, the
+// satfinite clamp of the top binade's non-finite code. Proved bit-exact against the hardware path, CUDA's host
+// conversion and a first-principles reference for all 65536 fp16 patterns (tests/exl3_mul1_e4m3_check.cu).
+__device__ __forceinline__ uint16_t e4m3_round1(uint16_t h) {
+    const uint16_t s = h & 0x8000u;
+    const uint32_t a = h & 0x7fffu;
+    if (a >= 0x7C00u) return (uint16_t)(a > 0x7C00u ? (s | 0x7E00u) : (s | 0x5F00u));   // nan; +-inf satfinite -> +-448
+    if (a < 0x0400u) return s;   // an fp16 subnormal is under half the smallest E4M3 subnormal (2^-10): zero
+    const uint32_t f16e = a >> 10, sig = (a & 0x3FFu) | 0x400u;   // value = sig · 2^(f16e - 25)
+    uint32_t code;
+    if (f16e >= 9) {   // 2^-6 and up: the E4M3 normals, four significand bits at bit 7
+        uint32_t q = sig >> 7, r = sig & 0x7Fu;
+        if (r > 0x40u || (r == 0x40u && (q & 1u))) q++;   // nearest even; q = 16 carries into the next binade
+        const int e = (int)f16e - 15 + (q == 16u ? 1 : 0);
+        if (q == 16u) q = 8u;
+        if (e > 8 || (e == 8 && q == 15u)) return (uint16_t)(s | 0x5F00u);   // satfinite: 480 and up clamp to 448
+        code = ((uint32_t)(e + 7) << 3) | (q & 7u);
+    } else {   // under 2^-6: the E4M3 subnormals, 2^-9 steps (8 of them is 2^-6, the smallest normal)
+        const uint32_t sh = 16u - f16e;   // 1 - e, e = f16e - 15 <= -7
+        uint32_t q = sig >> sh, r = sig & ((1u << sh) - 1u);
+        if (r > (1u << (sh - 1)) || (r == (1u << (sh - 1)) && (q & 1u))) q++;   // nearest even at 2^-9
+        code = q;
+    }
+    if (code < 8u) {   // subnormal: code · 2^-9, exact in fp16
+        if (code == 0u) return s;
+        const uint32_t hb = 31u - __clz(code);
+        return (uint16_t)(s | ((hb + 6u) << 10) | ((code - (1u << hb)) << (10 - hb)));
+    }
+    return (uint16_t)(s | (((code >> 3) + 8u) << 10) | ((code & 7u) << 7));   // 1.m · 2^(field - 7), exact
+}
+
+// A mul1 pair's fp16 values rounded to E4M3 (nearest even, subnormals included, saturating at +-448) and back to
+// fp16: FORMAT.md's Decode rounding ("v -> E4M3 (nearest even, clamp +-448) -> fp32"), which every codebook's value
+// takes. sm_89 up (the e4m3 images' SASS from sm_120 on; the target is sm_121) takes the hardware conversions, lane
+// for lane; older targets e4m3_round1 per lane.
+__device__ __forceinline__ uint32_t mul1_e4m3_finish(uint32_t hh) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 890
+    unsigned short e2;
+    asm("cvt.rn.satfinite.e4m3x2.f16x2 %0, %1;" : "=h"(e2) : "r"(hh));
+    uint32_t r;
+    asm("cvt.rn.f16x2.e4m3x2 %0, %1;" : "=r"(r) : "h"(e2));
+    return r;
+#else
+    const uint16_t lo = e4m3_round1((uint16_t)hh), hi = e4m3_round1((uint16_t)(hh >> 16));
+    return (uint32_t)lo | ((uint32_t)hi << 16);
+#endif
+}
+
 // 32-bit words of a tile: 256 values of K2 / 2 bits.
 template <int K2>
 __host__ __device__ constexpr int tile_words() {
@@ -108,7 +166,19 @@ __device__ __forceinline__ void lane_states(const uint32_t (&w)[lane_words<K2>()
 // Two codebook values from two 16-bit states, as a half2 in a uint32 (the first state in the low half).
 template <int CB>
 __device__ __forceinline__ uint32_t decode2(uint32_t s0, uint32_t s1) {
-    if constexpr (CB == CB_MUL1) {
+    if constexpr (CB == CB_MUL1_E4M3 || (CB == CB_MUL1 && TF_EXL3_MUL1_E4M3)) {
+        // mul1 with the format's E4M3 rounding (EXLR8 v0.7's experts; the e4m3 images, TF_EXL3_MUL1_E4M3): the mul1
+        // value as below, then mul1_e4m3_finish. FORMAT.md's Codebook rounds every codebook's value to E4M3, and
+        // mul1's fp16 operation order matters because of that rounding — the __hfma2 is the definition's single
+        // fp16 rounding of (1024 + Σb)·c + d (exl3_format.zig's codebookValue does it as one float64 multiply-add).
+        const uint32_t x0 = s0 * 0x83DCD12Du, x1 = s1 * 0x83DCD12Du;
+        const uint32_t h0 = __dp4a(x0, 0x01010101u, 0x6400u);    // fp16 bits of 1024 + the byte sum
+        const uint32_t h1 = __dp4a(x1, 0x01010101u, 0x6400u);
+        const uint32_t hh = (h0 & 0xffffu) | (h1 << 16);
+        const half2 r = __hfma2(*reinterpret_cast<const half2*>(&hh), __half2half2(__ushort_as_half(0x1eee)),
+                                __half2half2(__ushort_as_half(0xc931)));
+        return mul1_e4m3_finish(*reinterpret_cast<const uint32_t*>(&r));
+    } else if constexpr (CB == CB_MUL1) {
         const uint32_t x0 = s0 * 0x83DCD12Du, x1 = s1 * 0x83DCD12Du;
         const uint32_t h0 = __dp4a(x0, 0x01010101u, 0x6400u);    // fp16 bits of 1024 + the byte sum
         const uint32_t h1 = __dp4a(x1, 0x01010101u, 0x6400u);
