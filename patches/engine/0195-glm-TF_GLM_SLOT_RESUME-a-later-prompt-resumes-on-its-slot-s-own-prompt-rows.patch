+    // TF_GLM_SLOT_RESUME (default on, 0 off): a later prompt resumes on its slot's own rows (slot_resume.zig); glm_moe_dsa
+    // on its own windows only (Engine.rewindable refuses the rest on every rank)
+    own.lanes.slot_resume = @import("slot_resume.zig").enabled() and own.e.c.dsa and !set.pages;
+    std.log.info("slot resume: {s} (TF_GLM_SLOT_RESUME{s})", .{ if (own.lanes.slot_resume) "on, a later prompt resumes on its slot's own prompt rows" else "off", if (own.e.c.dsa) "" else "; glm_moe_dsa only" });
     const extra: u64 = (if (own.e.drafter) |dr| dr.ringBytes() else 0) + if (own.e.images) |v| v.streamBytes() else @as(usize, 0);
     own.layout = if (set.pages) try pages_mod.layout(gpa, own.e, extra) else null;
     return .{
diff --git a/zig/src/families/glm/slot_resume.zig b/zig/src/families/glm/slot_resume.zig
new file mode 100644
index 000000000..bc3c61bc0
--- /dev/null
+++ b/zig/src/families/glm/slot_resume.zig
@@ -0,0 +1,204 @@
+//! TF_GLM_SLOT_RESUME (glm_moe_dsa, default on; 0 turns it off): a later prompt on a slot resumes where the rows that
+//! slot's last prompt pass left stand, nothing copied and no memory set aside. The idea is TensorFold's Metal qwen27 slot
+//! resume (native/qwen27_resume.zig, TF_QWEN27_SLOT_RESUME: "a later prompt resumes where slot 0 stands"); this is a new
+//! implementation of it for the CUDA GLM path, whose sequence is all MLA (no recurrent state to rewind): the latent rows
+//! (int8 codes and both scale planes), the DSA index keys (the rings span the capacity, so they never rebase) and the
+//! pooled keys are positional, so rows below a point stay what the pass that wrote them left.
+//!
+//! The rows a resume may reuse follow the prompt cache's rules (cuda_snapshots, cuda_native.snap_grid):
+//!   - only prompt rows, never a reply's (decode wrote those in other passes);
+//!   - only at a chunk start of the pass that wrote them (the 4,096-row grid kept states are cut on), every chunk
+//!     before it a whole chunk taken alone (a busy step's or a batched pass's rows are not counted);
+//!   - with the prompt's tokens the same up to the point, and the same request policy mask (a kernel bit could change
+//!     the rows' bits), and nothing else begun on the slot since (its begin stamp);
+//!   - beside a drafter (DFlash2, DSpark) at least the drafter's window (dflash.WIN) short of the new prompt's end, so
+//!     the pass re-taps every context row a fresh pass ingests and the drafter restarts from 0 as a fresh one does;
+//!   - at least one row short of the prompt's end (the first token is drawn from the last row's logits).
+const std = @import("std");
+
+/// TF_GLM_SLOT_RESUME: on unless it is "0" (read once at startup).
+pub fn enabled() bool {
+    const v = std.c.getenv("TF_GLM_SLOT_RESUME") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(v), "0");
+}
+
+/// What a slot's last prompt pass left standing: its prompt, how far its rows may be reused, and what they were made
+/// under (rank 0 alone keeps it; every rank's rows are the same pass's).
+pub const Standing = struct {
+    tokens: std.ArrayList(u32) = .empty,
+    whole: usize = 0, // rows [0, whole) reusable: a chunk start of the pass, every chunk before it whole and alone
+    stamp: u64 = 0, // the slot's begin stamp of that pass (Engine.begun); another begin since: nothing stands
+    policy: u32 = 0,
+    plain: bool = false, // text only (an image prompt's rows go by its images, not its ids)
+
+    pub fn deinit(st: *Standing, gpa: std.mem.Allocator) void {
+        st.tokens.deinit(gpa);
+        st.* = .{};
+    }
+
+    /// Nothing stands (a pass is about to begin, or failed to).
+    pub fn clear(st: *Standing) void {
+        st.tokens.clearRetainingCapacity();
+        st.whole = 0;
+        st.stamp = 0;
+        st.plain = false;
+    }
+
+    /// A pass began (stamp `stamp`) on `ids`, its rows below `at` already standing (a resume's point, a kept state's
+    /// restored position, or 0). Out of memory: nothing stands.
+    pub fn open(st: *Standing, gpa: std.mem.Allocator, ids: []const u32, at: usize, stamp: u64, policy: u32, plain: bool) void {
+        st.clear();
+        st.tokens.appendSlice(gpa, ids) catch return;
+        st.whole = if (at < ids.len) at else 0;
+        st.stamp = stamp;
+        st.policy = policy;
+        st.plain = plain;
+    }
+
+    /// A step of the pass took `rows` rows from `start`; it extends what stands only when it is the whole chunk at the
+    /// point reached so far and another chunk of the prompt follows it (its end is then a chunk start of the pass).
+    pub fn stepped(st: *Standing, grid: usize, start: usize, rows: usize) void {
+        if (!st.plain or start != st.whole or start % grid != 0 or rows != grid) return;
+        if (start + rows < st.tokens.items.len) st.whole = start + rows;
+    }
+
+    /// A whole pass (Engine.prefill: every chunk whole, one at a time) ran from `from` to the prompt's end.
+    pub fn ran(st: *Standing, grid: usize, from: usize) void {
+        const len = st.tokens.items.len;
+        if (!st.plain or from != st.whole or from % grid != 0 or len == 0) return;
+        st.whole = @max(from, (len - 1) / grid * grid);
+    }
+
+    /// Where a prompt `ids` resumes on this slot (0: from the start): the stamp the slot holds now (`stamp`), the
+    /// request's policy mask, the rows a drafter re-taps at the prompt's end (`tail`: dflash.WIN, 0 without one).
+    pub fn plan(st: *const Standing, grid: usize, ids: []const u32, stamp: u64, policy: u32, tail: usize) usize {
+        if (!st.plain or st.whole == 0 or stamp == 0 or stamp != st.stamp or policy != st.policy) return 0;
+        const same = commonPrefix(st.tokens.items[0..st.whole], ids);
+        const limit = @min(same, ids.len -| @max(tail, 1));
+        return limit / grid * grid;
+    }
+};
+
+/// The tokens `a` and `b` both start with.
+pub fn commonPrefix(a: []const u32, b: []const u32) usize {
+    return std.mem.findDiff(u32, a, b) orelse @min(a.len, b.len);
+}
+
+const t = std.testing;
+const G: usize = 4; // a small grid for the tests (the engine's is fw.prefill_rows, 4,096)
+
+fn seq(comptime n: usize, comptime base: u32) [n]u32 {
+    var x: [n]u32 = undefined;
+    for (&x, 0..) |*v, i| v.* = base + @as(u32, @intCast(i));
+    return x;
+}
+
+/// A pass over `ids` from `at`, a whole chunk a step (as Leader.chunk takes them alone).
+fn pass(st: *Standing, ids: []const u32, at: usize) void {
+    var s = at;
+    while (s < ids.len) : (s += G) st.stepped(G, s, @min(G, ids.len - s));
+}
+
+test "GLM slot resume: a next turn extending the last prompt resumes at the last chunk start below the shared tokens" {
+    var st: Standing = .{};
+    defer st.deinit(t.allocator);
+    const a = seq(14, 100); // chunks at 0, 4, 8, 12 (the last two rows short)
+    st.open(t.allocator, &a, 0, 7, 0, true);
+    pass(&st, &a, 0);
+    try t.expectEqual(@as(usize, 12), st.whole); // 12 is a chunk start of the pass; its last chunk's end is not
+    const b = a ++ seq(6, 500); // the reply's tokens and a tool result after the whole prompt
+    try t.expectEqual(@as(usize, 12), st.plan(G, &b, 7, 0, 0));
+    var c = b;
+    c[10] = 9; // the prompt changed at row 10: back to the chunk start below it
+    try t.expectEqual(@as(usize, 8), st.plan(G, &c, 7, 0, 0));
+    c[2] = 9; // inside the first chunk: nothing to resume
+    try t.expectEqual(@as(usize, 0), st.plan(G, &c, 7, 0, 0));
+}
+
+test "GLM slot resume: only prompt rows of whole chunks, never past the last chunk start of the pass" {
+    var st: Standing = .{};
+    defer st.deinit(t.allocator);
+    const a = seq(16, 100); // four whole chunks, the last ending the prompt
+    st.open(t.allocator, &a, 0, 3, 0, true);
+    pass(&st, &a, 0);
+    try t.expectEqual(@as(usize, 12), st.whole); // the prompt's end is no chunk start, though the chunk was whole
+    const reply = a ++ seq(9, 900); // the reply's rows were decoded: a prompt repeating them resumes below them
+    try t.expectEqual(@as(usize, 12), st.plan(G, &reply, 3, 0, 0));
+    // a busy step (part of a chunk beside a decoder) stops what stands at its start
+    st.open(t.allocator, &a, 0, 4, 0, true);
+    st.stepped(G, 0, G);
+    st.stepped(G, 4, 2); // TF_GLM_CHUNK rows of the chunk at 4
+    st.stepped(G, 6, 2);
+    st.stepped(G, 8, G);
+    try t.expectEqual(@as(usize, 4), st.whole);
+    try t.expectEqual(@as(usize, 4), st.plan(G, &reply, 4, 0, 0));
+    // a whole pass (TF_GLM_PROMPT_STEPS=0) from a resumed point stands at its last chunk start
+    st.open(t.allocator, &a, 4, 5, 0, true);
+    st.ran(G, 4);
+    try t.expectEqual(@as(usize, 12), st.whole);
+    st.open(t.allocator, &a, 0, 5, 0, true);
+    st.ran(G, 4); // not where it stands: nothing new
+    try t.expectEqual(@as(usize, 0), st.whole);
+}
+
+test "GLM slot resume: another begin on the slot, another policy, images or nothing left to prefill refuse" {
+    var st: Standing = .{};
+    defer st.deinit(t.allocator);
+    const a = seq(14, 100);
+    const b = a ++ seq(6, 500);
+    st.open(t.allocator, &a, 0, 7, 2, true);
+    pass(&st, &a, 0);
+    try t.expectEqual(@as(usize, 12), st.plan(G, &b, 7, 2, 0));
+    try t.expectEqual(@as(usize, 0), st.plan(G, &b, 8, 2, 0)); // the slot began another pass since
+    try t.expectEqual(@as(usize, 0), st.plan(G, &b, 0, 2, 0)); // a sequence made again (never begun)
+    try t.expectEqual(@as(usize, 0), st.plan(G, &b, 7, 3, 0)); // another policy mask
+    try t.expectEqual(@as(usize, 8), st.plan(G, a[0..12], 7, 2, 0)); // a row past the point must be left to draw from
+    try t.expectEqual(@as(usize, 12), st.plan(G, a[0..13], 7, 2, 0));
+    st.open(t.allocator, &a, 0, 7, 2, false); // an image prompt: its rows are not its ids'
+    pass(&st, &a, 0);
+    try t.expectEqual(@as(usize, 0), st.whole);
+    try t.expectEqual(@as(usize, 0), st.plan(G, &b, 7, 2, 0));
+    st.open(t.allocator, &a, 8, 7, 2, false); // even rows restored below 8 of an image prompt are never reused
+    try t.expectEqual(@as(usize, 0), st.plan(G, &b, 7, 2, 0));
+    st.clear();
+    try t.expectEqual(@as(usize, 0), st.plan(G, &b, 0, 2, 0));
+}
+
+test "GLM slot resume: beside a drafter the drafter's window at the prompt's end is prefilled again" {
+    var st: Standing = .{};
+    defer st.deinit(t.allocator);
+    const a = seq(30, 100);
+    st.open(t.allocator, &a, 0, 1, 0, true);
+    pass(&st, &a, 0);
+    try t.expectEqual(@as(usize, 28), st.whole);
+    const b = a ++ seq(3, 700); // 33 ids
+    try t.expectEqual(@as(usize, 28), st.plan(G, &b, 1, 0, 0));
+    try t.expectEqual(@as(usize, 28), st.plan(G, &b, 1, 0, 5)); // the window's rows 28-32 all prefilled again
+    try t.expectEqual(@as(usize, 24), st.plan(G, &b, 1, 0, 6)); // 27: back to 24
+    try t.expectEqual(@as(usize, 20), st.plan(G, &b, 1, 0, 10)); // 23: back to 20
+    try t.expectEqual(@as(usize, 0), st.plan(G, &b, 1, 0, 40)); // a prompt shorter than the window
+}
+
+test "GLM slot resume: a resumed pass stands where it resumed, and on from there" {
+    var st: Standing = .{};
+    defer st.deinit(t.allocator);
+    const a = seq(14, 100);
+    st.open(t.allocator, &a, 0, 1, 0, true);
+    pass(&st, &a, 0);
+    const b = a ++ seq(7, 500); // 21 ids
+    const at = st.plan(G, &b, 1, 0, 0);
+    try t.expectEqual(@as(usize, 12), at);
+    st.open(t.allocator, &b, at, 2, 0, true);
+    try t.expectEqual(@as(usize, 12), st.whole);
+    pass(&st, &b, at); // chunks at 12 and 16, then 20 (the last)
+    try t.expectEqual(@as(usize, 20), st.whole);
+    const c = b ++ seq(9, 800);
+    try t.expectEqual(@as(usize, 20), st.plan(G, &c, 2, 0, 0));
+    try t.expectEqual(@as(usize, 0), st.plan(G, &c, 1, 0, 0)); // the earlier stamp
+}
+
+test "GLM slot resume: the common prefix" {
+    try t.expectEqual(@as(usize, 3), commonPrefix(&.{ 1, 2, 3 }, &.{ 1, 2, 3, 4 }));
+    try t.expectEqual(@as(usize, 1), commonPrefix(&.{ 1, 2, 3 }, &.{ 1, 5, 3 }));
+    try t.expectEqual(@as(usize, 0), commonPrefix(&.{}, &.{1}));
+}
