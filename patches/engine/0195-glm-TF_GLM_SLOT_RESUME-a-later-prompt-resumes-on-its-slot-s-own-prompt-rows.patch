+    /// TF_GLM_SLOT_RESUME: the sequence just begun stands at `at` on its own rows on every rank (Engine.rewind, agreed);
+    /// false when a rank refused it, every rank then still at 0.
+    pub fn rewind(x: Leader, at: usize) !bool {
+        try x.flush();
