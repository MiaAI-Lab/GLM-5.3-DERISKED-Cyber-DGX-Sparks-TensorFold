+    /// TF_GLM_SLOT_RESUME (slot_resume.zig): the sequence just begun stands at `at` on its own rows, which the slot's
+    /// last prompt pass left there as a fresh pass would (rank 0's rule); its pass starts there. Agreed on every rank
+    /// (one all-reduce): should any rank refuse, none moves (error.BadResume) and the pass starts at 0 as before.
+    /// Nothing is copied: glm_moe_dsa's rows (latent codes and both int8 scale planes, the index keys on rings that
+    /// span the capacity, the pooled keys) are positional, and rows past `at` are rewritten before any read, as after
+    /// State.reset. The drafter restarted from 0 at the begin, as a fresh pass's does (rank 0 resumes only where the
+    /// pass re-taps the drafter's whole window).
+    pub fn rewind(e: *Engine, at: usize) !void {
+        const ok = e.rewindable(at);
+        if (try e.shared(if (ok) 0 else 1) > 0) return error.BadResume;
+        try e.cur.st.setPos(e.stream, at);
+        e.cur.rewound = at;
+    }
+
+    /// Whether this rank's bound sequence can stand at `at` in place: a glm_moe_dsa sequence of MLA layers alone, just
+    /// begun, on its own window (no KV pages, no shard), its index rings unbased, on the chunk grid, no image rows, and
+    /// no target MTP head whose caches a prompt would fill (beside a drafter they stay empty).
+    fn rewindable(e: *const Engine, at: usize) bool {
+        const st = &e.cur.st;
+        if (!e.c.dsa or st.kda_layers != 0 or st.table != 0 or st.hold != null or e.settings.kv_shard.on) return false;
+        if (st.pos != 0 or st.mtp_len != 0 or st.pending != 0 or st.base != 0 or st.mtp_base != 0 or e.cur.begun == 0) return false;
+        if (at == 0 or at % fw.prefill_rows != 0 or at + fw.window_rows > st.capacity) return false;
+        if (e.mtp and e.drafter == null) return false;
+        if (e.images) |v| if (v.rowCount() > 0) return false;
+        return true;
     }
 
