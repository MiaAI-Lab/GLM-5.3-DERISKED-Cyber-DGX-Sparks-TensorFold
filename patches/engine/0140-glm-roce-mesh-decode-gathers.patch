index 0000000..fd36790
--- /dev/null
+++ b/zig/src/families/glm/cuda_mesh.zig
@@ -0,0 +1,94 @@
+//! TF_GLM_ROCE_MESH=1 at three ranks or more (six Sparks on a switch): a decode window's small all-gathers as
+//! one-shot RoCE writes, each rank's shard posted once to every peer (fabric/tp's multirank gather), where NCCL's ring
+//! took W - 1 hops; prompt chunks and every larger exchange stay on NCCL. Measured on six GB10s over one 200G switch
+//! (tf-tp-test suite, world 6): 16 / 32 / 64 KiB a rank 23 / 28 / 36 us against NCCL's 52 / 80 / 86.
+//!
+//! Its bootstrap and HCA pick are fabric/tp's (TF_TP_MASTER, TF_TP_PORT, TF_TP_ROCE_HCA, TF_TP_MAILBOX_MAX_KB), its
+//! kernel the mailbox fatbin at TF_TP_KERNEL_IMAGE. Every rank keeps it or none does: a failed setup, or a probe
+//! gather whose bytes are not every rank's pattern, on any rank leaves every rank on NCCL.
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+
+pub const Mesh = tp.roce_multi.Roce;
+
+const probe_bytes = 64 * 1024;
+
+pub fn wanted() bool {
+    const v = std.c.getenv("TF_GLM_ROCE_MESH") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// The mesh for rank `rank` of `world`, or null (not wanted, under three ranks, or any rank could not bring it up).
+pub fn open(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, rank: usize, world: usize, stream: cuda.Stream) !?*Mesh {
+    if (!wanted() or world < 3) return null;
+    var cfg = try tp.Config.fromEnv();
+    cfg.rank = @intCast(rank);
+    cfg.world = @intCast(world);
+    cfg = cfg.resolved();
+    const path = std.c.getenv("TF_TP_KERNEL_IMAGE") orelse {
+        std.log.warn("glm mesh: TF_GLM_ROCE_MESH=1 without TF_TP_KERNEL_IMAGE (the mailbox fatbin); NCCL keeps the gathers", .{});
+        return null;
+    };
+    // the driver keeps its own copy of a loaded image; these bytes live as long as the process (a few hundred KiB)
+    const image = try std.Io.Dir.cwd().readFileAllocOptions(io, std.mem.span(path), gpa, .limited(1 << 26), .@"16", null);
+    var b = try tp.Bootstrap.open(cfg);
+    defer b.close();
+    var specs: [tp.roce_verbs.max_hcas]tp.roce_verbs.HcaSpec = undefined;
+    var n: usize = 0;
+    var ok = true;
+    n = tp.roce_pick.resolve(cfg, &b, &specs) catch blk: {
+        ok = false;
+        break :blk 0;
+    };
+    if (!try agree(&b, ok)) return null;
+    const r: ?*Mesh = Mesh.init(d, &b, image, .{ .wire = .verbs, .hcas = specs[0..n], .traffic_class = cfg.roce_tc, .cpu = cfg.roce_cpu, .max_bytes = cfg.mailbox_max_bytes, .timeout_ns = cfg.mailbox_timeout_ns, .fast = cfg.roce_fast, .blocks = cfg.roce_blocks }) catch |e| blk: {
+        std.log.warn("glm mesh: rank {d}: RoCE setup failed ({s})", .{ rank, @errorName(e) });
+        break :blk null;
+    };
+    if (!try agree(&b, r != null)) {
+        if (r) |x| x.deinit();
+        return null;
+    }
+    const good = probe(gpa, d, r.?, rank, world, stream) catch |e| blk: {
+        std.log.warn("glm mesh: rank {d}: probe failed ({s})", .{ rank, @errorName(e) });
+        break :blk false;
+    };
+    if (!try agree(&b, good)) {
+        r.?.deinit();
+        return null;
+    }
+    std.log.info("glm mesh: rank {d} of {d}: decode all-gathers up to {d} KiB a rank by RoCE writes", .{ rank, world, cfg.mailbox_max_bytes / 1024 });
+    return r.?;
+}
+
+/// Every rank's `mine` over the bootstrap: true only when all are.
+fn agree(b: *tp.Bootstrap, mine: bool) !bool {
+    var blobs: [tp.bootstrap.max_ranks][]const u8 = undefined;
+    var buf: [tp.bootstrap.max_ranks]u8 = undefined;
+    var all = true;
+    for (try b.allGather(&.{@intFromBool(mine)}, &buf, &blobs)) |x| all = all and x.len == 1 and x[0] == 1;
+    return all;
+}
+
+/// One gather of probe_bytes a rank, byte (rank * 131 + i * 7) mod 251 + 1, checked on the host in rank order.
+fn probe(gpa: std.mem.Allocator, d: *const cuda.Driver, r: *Mesh, rank: usize, world: usize, stream: cuda.Stream) !bool {
+    const host = try gpa.alloc(u8, world * probe_bytes);
+    defer gpa.free(host);
+    var dev: cuda.abi.DevicePtr = 0;
+    try d.check(d.api.cuMemAlloc_v2(&dev, world * probe_bytes), "cuMemAlloc");
+    defer _ = d.api.cuMemFree_v2(dev);
+    for (host[0..probe_bytes], 0..) |*x, i| x.* = pattern(rank, i);
+    const mine = dev + rank * probe_bytes;
+    try d.check(d.api.cuMemcpyHtoD_v2(mine, host.ptr, probe_bytes), "cuMemcpyHtoD");
+    try r.allGatherBytes(mine, dev, probe_bytes, stream.handle);
+    try stream.synchronize();
+    try r.check();
+    try d.check(d.api.cuMemcpyDtoH_v2(host.ptr, dev, world * probe_bytes), "cuMemcpyDtoH");
+    for (0..world) |q| for (0..probe_bytes) |i| if (host[q * probe_bytes + i] != pattern(q, i)) return false;
+    return true;
+}
+
+fn pattern(rank: usize, i: usize) u8 {
+    return @intCast((rank * 131 + i * 7) % 251 + 1);
+}
