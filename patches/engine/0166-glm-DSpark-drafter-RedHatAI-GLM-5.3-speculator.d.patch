diff --git a/zig/kernels/cuda/glm_dspark.cu b/zig/kernels/cuda/glm_dspark.cu
new file mode 100644
index 0000000..1b5e5a1
--- /dev/null
+++ b/zig/kernels/cuda/glm_dspark.cu
@@ -0,0 +1,202 @@
+// DSpark drafter kernels (RedHatAI/GLM-5.3-speculator.dspark on glm_moe_dsa): Qwen3 per-head norms and neox RoPE for
+// the context rows (into a stream's ring) and the block rows, and the block's multi-head attention over the ring's
+// window and the block itself. Written for this engine after the owner's 3x recipe patch 0114 (dspark.py, its
+// _block_attn_kernel and DFlash2's _taps_compute; MiaAI-Lab/GLM-5.3-EXL3-3x-DGX-Sparks-TensorFold), which adapted the
+// model definition from vllm-project/speculators and vLLM (Apache-2.0); the layout follows glm_dflash.cu (ours).
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+namespace glm_dspark {
+constexpr int HD = 64;          // head dim
+constexpr int H = 64;           // heads (query = KV heads: multi-head)
+constexpr int HW = H * HD;      // 4096: a row of q, k or v
+constexpr int WIN = 2048;       // the sliding window (and a ring's slots)
+constexpr int BLOCK = 8;        // a block's rows
+constexpr int CK = 128;         // keys a chunk of the attention
+constexpr int CH = WIN / CK;    // window chunks (16); chunk CH is the block's own keys
+
+__device__ __forceinline__ float bf(__nv_bfloat16 x) { return __bfloat162float(x); }
+
+// One head of 64 (a warp: dims d and d + 32, the rotate-half pair): RMSNorm with weight w, then neox RoPE at pos.
+__device__ __forceinline__ void norm_rope(const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ w,
+                                          long long pos, float eps, float theta, __nv_bfloat16* __restrict__ out) {
+  const int d = threadIdx.x & 31;
+  const float a = bf(x[d]), b = bf(x[d + 32]);
+  float ss = a * a + b * b;
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+  const float r = rsqrtf(ss / HD + eps);
+  // the norm and the rotation in fp32, one bf16 rounding at the end (as the NumPy twin, dspark_twin.py)
+  const float na = a * r * bf(w[d]), nb = b * r * bf(w[d + 32]);
+  const double inv = pow((double)theta, -2.0 * d / HD);
+  const double ang = (double)pos * inv;
+  const float c = (float)cos(ang), s = (float)sin(ang);
+  out[d] = __float2bfloat16_rn(na * c - nb * s);
+  out[d + 32] = __float2bfloat16_rn(nb * c + na * s);
+}
+
+// The ring of one layer: K then V, [WIN][HW] each, layers one after another.
+__device__ __forceinline__ __nv_bfloat16* ring_k(__nv_bfloat16* ring, int layer) { return ring + (size_t)layer * 2 * WIN * HW; }
+__device__ __forceinline__ __nv_bfloat16* ring_v(__nv_bfloat16* ring, int layer) { return ring_k(ring, layer) + (size_t)WIN * HW; }
+}  // namespace glm_dspark
+
+using namespace glm_dspark;
+
+// Context rows' [k | v] (kv [N][2 HW]): k_norm and RoPE at pos[r] into ring rings[r] slot pos % WIN of `layer`, v as it
+// is. grid (N, H), 32 threads.
+extern "C" __global__ void __launch_bounds__(32)
+    ds_ctx_kv(const __nv_bfloat16* __restrict__ kv, const __nv_bfloat16* __restrict__ kn, const long long* __restrict__ pos,
+              const unsigned long long* __restrict__ rings, int layer, float eps, float theta) {
+  const int r = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
+  const long long p = pos[r];
+  __nv_bfloat16* ring = reinterpret_cast<__nv_bfloat16*>(rings[r]);
+  const size_t slot = (size_t)(p % WIN) * HW + (size_t)h * HD;
+  norm_rope(kv + (size_t)r * 2 * HW + h * HD, kn, p, eps, theta, ring_k(ring, layer) + slot);
+  const __nv_bfloat16* v = kv + (size_t)r * 2 * HW + HW + h * HD;
+  ring_v(ring, layer)[slot + d] = v[d];
+  ring_v(ring, layer)[slot + d + 32] = v[d + 32];
+}
+
+// The block rows' fused [q | k | v] (qkv [M][3 HW]): q_norm / k_norm and RoPE at pos[r] into q and kb, v into vb.
+// grid (M, 2 H), 32 threads: y < H a query head, else a key head (and its value).
+extern "C" __global__ void __launch_bounds__(32)
+    ds_block_qkv(const __nv_bfloat16* __restrict__ qkv, const __nv_bfloat16* __restrict__ qn,
+                 const __nv_bfloat16* __restrict__ kn, const int* __restrict__ pos, float eps, float theta,
+                 __nv_bfloat16* __restrict__ q, __nv_bfloat16* __restrict__ kb, __nv_bfloat16* __restrict__ vb) {
+  const int r = blockIdx.x, y = blockIdx.y, d = threadIdx.x;
+  const __nv_bfloat16* row = qkv + (size_t)r * 3 * HW;
+  if (y < H) {
+    norm_rope(row + y * HD, qn, pos[r], eps, theta, q + (size_t)r * HW + y * HD);
+    return;
+  }
+  const int h = y - H;
+  norm_rope(row + HW + h * HD, kn, pos[r], eps, theta, kb + (size_t)r * HW + h * HD);
+  vb[(size_t)r * HW + h * HD + d] = row[2 * HW + h * HD + d];
+  vb[(size_t)r * HW + h * HD + d + 32] = row[2 * HW + h * HD + d + 32];
+}
+
+// The block attention, split: stream s, head h, chunk c (grid (S, H, CH + 1), 128 threads, a thread a key). The block's
+// 8 queries (q [S BLOCK][HW]) see the ring's window positions lo .. start - 1, lo = max(from, start - WIN) (chunk c: its
+// keys lo + c CK ..), and chunk CH the block's own keys kb / vb, causal (query m: keys 0 .. m). Per chunk and query: the
+// running max pm, sum pl and unnormalized output pacc [S BLOCK][H][CH + 1][HD] (fp32), merged by ds_attn_merge.
+extern "C" __global__ void __launch_bounds__(128)
+    ds_attn_part(const __nv_bfloat16* __restrict__ q, const __nv_bfloat16* __restrict__ kb,
+                 const __nv_bfloat16* __restrict__ vb, const unsigned long long* __restrict__ rings,
+                 const long long* __restrict__ starts, const long long* __restrict__ froms, int layer, float scale,
+                 float* __restrict__ pm, float* __restrict__ pl, float* __restrict__ pacc) {
+  const int s = blockIdx.x, h = blockIdx.y, c = blockIdx.z, t = threadIdx.x;
+  __shared__ float qs[BLOCK][HD];
+  __shared__ float ps[BLOCK][CK];
+  __shared__ float vs[CK][HD + 1];
+  __shared__ float red[BLOCK][4];
+  for (int i = t; i < BLOCK * HD; i += 128) qs[i / HD][i % HD] = bf(q[((size_t)s * BLOCK + i / HD) * HW + h * HD + i % HD]);
+  const long long start = starts[s];
+  const long long lo = max(froms[s], start - (long long)WIN);
+  const bool own = c == CH;
+  const long long key = own ? (long long)t : lo + (long long)c * CK + t;  // own: block slot t (< BLOCK)
+  const bool live = own ? t < BLOCK : key < start;
+  const __nv_bfloat16* krow = nullptr;
+  const __nv_bfloat16* vrow = nullptr;
+  if (live) {
+    if (own) {
+      krow = kb + ((size_t)s * BLOCK + t) * HW + h * HD;
+      vrow = vb + ((size_t)s * BLOCK + t) * HW + h * HD;
+    } else {
+      __nv_bfloat16* ring = reinterpret_cast<__nv_bfloat16*>(rings[s]);
+      const size_t slot = (size_t)(key % WIN) * HW + (size_t)h * HD;
+      krow = ring_k(ring, layer) + slot;
+      vrow = ring_v(ring, layer) + slot;
+    }
+  }
+  __syncthreads();
+  float sc[BLOCK];
+#pragma unroll
+  for (int m = 0; m < BLOCK; ++m) sc[m] = -INFINITY;
+  if (live) {
+    float kr[HD];
+#pragma unroll
+    for (int d = 0; d < HD; ++d) kr[d] = bf(krow[d]);
+#pragma unroll
+    for (int m = 0; m < BLOCK; ++m) {
+      if (own && t > m) continue;  // causal inside the block
+      float acc = 0.f;
+#pragma unroll
+      for (int d = 0; d < HD; ++d) acc = fmaf(qs[m][d], kr[d], acc);
+      sc[m] = acc * scale;
+    }
+#pragma unroll
+    for (int d = 0; d < HD; ++d) vs[t][d] = bf(vrow[d]);
+  } else {
+#pragma unroll
+    for (int d = 0; d < HD; ++d) vs[t][d] = 0.f;
+  }
+  // per query: the chunk's max over its 128 keys (warp, then the 4 warps)
+  const int lane = t & 31, w = t >> 5;
+#pragma unroll
+  for (int m = 0; m < BLOCK; ++m) {
+    float v = sc[m];
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) v = fmaxf(v, __shfl_xor_sync(0xffffffffu, v, o));
+    if (lane == 0) red[m][w] = v;
+  }
+  __syncthreads();
+  float mx[BLOCK];
+#pragma unroll
+  for (int m = 0; m < BLOCK; ++m) mx[m] = fmaxf(fmaxf(red[m][0], red[m][1]), fmaxf(red[m][2], red[m][3]));
+  __syncthreads();
+#pragma unroll
+  for (int m = 0; m < BLOCK; ++m) {
+    const float p = sc[m] == -INFINITY ? 0.f : __expf(sc[m] - mx[m]);
+    ps[m][t] = p;
+    float v = p;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+    if (lane == 0) red[m][w] = v;
+  }
+  __syncthreads();
+  const size_t base = ((size_t)s * BLOCK) * H * (CH + 1);
+  if (t < BLOCK) {
+    const size_t at = base + ((size_t)t * H + h) * (CH + 1) + c;
+    pm[at] = mx[t];
+    pl[at] = red[t][0] + red[t][1] + red[t][2] + red[t][3];
+  }
+  // unnormalized output: thread t -> query t / 16, dims (t % 16) * 4 .. + 3
+  const int m = t / 16, d0 = (t % 16) * 4;
+  float o[4] = {0.f, 0.f, 0.f, 0.f};
+  for (int k = 0; k < CK; ++k) {
+    const float p = ps[m][k];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) o[j] = fmaf(p, vs[k][d0 + j], o[j]);
+  }
+  float* out = pacc + ((base + ((size_t)m * H + h) * (CH + 1) + c) * HD) + d0;
+#pragma unroll
+  for (int j = 0; j < 4; ++j) out[j] = o[j];
+}
+
+// The chunks of row r (stream r / BLOCK, query r % BLOCK), head h into out[r][h] (bf16). grid (S BLOCK, H), 64 threads.
+extern "C" __global__ void __launch_bounds__(64)
+    ds_attn_merge(const float* __restrict__ pm, const float* __restrict__ pl, const float* __restrict__ pacc,
+                  __nv_bfloat16* __restrict__ out) {
+  const int r = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
+  const size_t at = ((size_t)r * H + h) * (CH + 1);
+  float m = -INFINITY;
+  for (int c = 0; c <= CH; ++c) m = fmaxf(m, pm[at + c]);
+  float l = 0.f, o = 0.f;
+  for (int c = 0; c <= CH; ++c) {
+    const float cm = pm[at + c];
+    if (cm == -INFINITY) continue;
+    const float f = __expf(cm - m);
+    l = fmaf(pl[at + c], f, l);
+    o = fmaf(pacc[(at + c) * HD + d], f, o);
+  }
+  out[(size_t)r * HW + h * HD + d] = __float2bfloat16_rn(o / l);
+}
+
+// x += y, bf16 rows of n (grid (R, n / 1024), 256 threads: 4 a thread).
+extern "C" __global__ void __launch_bounds__(256) ds_add(__nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ y, int n) {
+  const size_t r = blockIdx.x;
+  const int c = blockIdx.y * 1024 + threadIdx.x * 4;
+  if (c >= n) return;
+#pragma unroll
+  for (int j = 0; j < 4; ++j) x[r * n + c + j] = __float2bfloat16_rn(bf(x[r * n + c + j]) + bf(y[r * n + c + j]));
+}
