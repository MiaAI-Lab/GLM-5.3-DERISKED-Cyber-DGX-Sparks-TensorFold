diff --git a/zig/src/families/glm/dspark.zig b/zig/src/families/glm/dspark.zig
new file mode 100644
index 0000000..2401264
--- /dev/null
+++ b/zig/src/families/glm/dspark.zig
@@ -0,0 +1,504 @@
+//! DSpark drafts on glm_moe_dsa (--drafter <folder of RedHatAI/GLM-5.3-speculator.dspark>): a DFlash-style parallel
+//! block pass over the target's taps, then a sequential low-rank Markov bias and a learned confidence a draft, on rank 0.
+//! Ported to Zig from the owner's 3x recipe patches 0114 / 0125 (dspark.py; MiaAI-Lab/GLM-5.3-EXL3-3x-DGX-Sparks-
+//! TensorFold), which adapted the model definition (MarkovHead, ConfidenceHead, the anchored-block forward and mask)
+//! from vllm-project/speculators @ 36a19ca and the sequential top-k Markov sampling from vLLM @ 5f30fc7 (Apache-2.0).
+//! The engine side is DFlash2's (dflash.zig, TensorFold): the same slots, rings, taps, requests and lanes; a Drafter
+//! with `spark` set runs these passes instead of DFlash2's.
+//!
+//! The model: context row j = hidden_norm(fc(concat taps_j)) (taps: the residual after layers 1, 19, 38, 57, 74);
+//! per layer K_j = RoPE(k_norm(k_proj c_j), j), V_j = v_proj c_j into the stream's ring; the block [anchor, mask x 7]
+//! at p .. p + 7 through 3 Qwen3 layers (64 heads of 64, neox RoPE theta 8e6), each slot over the context rows
+//! [p - 2048, p) and block slots 0..itself; h = norm(x); the verifier's head (its 4-bit draft head) gives each rank's
+//! 16 best a slot; rank 0 chains them: score = base + W2[c] . W1[prev] (prev_0 = anchor), confidence
+//! sigmoid(w_h . h + w_m . W1[prev] + b). Slot k predicts p + k + 1; the first 7 slots are drafts.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("cuda_mm.zig");
+const q4 = @import("cuda_q4.zig");
+const glue = @import("cuda_glue.zig");
+const df = @import("dflash.zig");
+const dl = @import("dflash_load.zig");
+
+pub const D: usize = 6144;
+pub const H: usize = 64;
+pub const HD: usize = 64;
+pub const HW: usize = H * HD; // 4096
+pub const FF: usize = 12288;
+pub const LAYERS: usize = 3;
+pub const AUX: usize = 5;
+pub const RANK: usize = 256;
+pub const THETA: f32 = 8e6;
+pub const EPS: f32 = 1e-5;
+pub const SCALE: f32 = 0.125; // 64^-0.5
+pub const CH: usize = 16; // the window's 128-key chunks (glm_dspark.cu: ds_attn_part's chunk CH is the block's own keys)
+pub const TAP_ROW: usize = AUX * D * 2;
+pub const CTX: usize = df.MAX_CTX; // context rows one ingest takes (a prompt chunk's)
+pub const DRAFTS: usize = df.BLOCK - 1; // slots 0..6: 7 drafts a pass (the lanes' max_held)
+
+/// Device bytes a stream's context ring takes (K and V of every layer, WIN slots).
+pub const ring_bytes: u64 = LAYERS * 2 * @as(u64, @intCast(df.WIN)) * HW * 2;
+
+/// glm_dspark's functions.
+pub const Kernels = struct {
+    ctx_kv: cuda.Function,
+    block_qkv: cuda.Function,
+    attn_part: cuda.Function,
+    attn_merge: cuda.Function,
+    add: cuda.Function,
+
+    pub fn load(m: cuda.Module) !Kernels {
+        var k: Kernels = undefined;
+        inline for (@typeInfo(Kernels).@"struct".field_names) |n| @field(k, n) = try m.function("ds_" ++ n);
+        return k;
+    }
+};
+
+pub const LayerW = struct { in_norm: u64, post_norm: u64, qn: u64, kn: u64, qkv: df.Lin, kv: df.Lin, o: df.Lin, gu: df.Lin, down: mm.Tiled };
+
+/// DSpark's own half of a Drafter: weights, kernels, the host chain's tables, its scratch.
+pub const Spark = struct {
+    module: cuda.Module,
+    k: Kernels,
+    weights: cuda.DeviceBuffer,
+    layers: [LAYERS]LayerW = undefined,
+    fc: df.Lin = undefined,
+    hnorm: u64 = 0,
+    norm: u64 = 0,
+    w1: []u16 = &.{}, // the Markov head's bf16 [vocab][RANK] tables (host, rank 0)
+    w2: []u16 = &.{},
+    conf_h: []f32 = &.{}, // the confidence head: hidden part [D], Markov part [RANK], bias
+    conf_m: [RANK]f64 = undefined,
+    conf_b: f64 = 0,
+    vocab: usize = 0,
+    scratch: cuda.DeviceBuffer = undefined,
+    x: u64 = 0,
+    y: u64 = 0,
+    qkv: u64 = 0,
+    q: u64 = 0,
+    kb: u64 = 0,
+    vb: u64 = 0,
+    att: u64 = 0,
+    a: u64 = 0,
+    gu: u64 = 0,
+    act: u64 = 0,
+    hn: u64 = 0,
+    xs: u64 = 0,
+    logits: u64 = 0,
+    c1: u64 = 0,
+    ctx: u64 = 0,
+    ckv: u64 = 0,
+    pm: u64 = 0,
+    pl: u64 = 0,
+    pacc: u64 = 0,
+    h_hn: []u16 = &.{}, // the block rows' normed h (rank 0 reads it back for the confidences)
+    last_conf: [DRAFTS]f64 = @splat(0),
+
+    pub fn deinit(s: *Spark, gpa: std.mem.Allocator) void {
+        s.scratch.free();
+        s.weights.free();
+        s.module.unload();
+        gpa.free(s.w1);
+        gpa.free(s.w2);
+        gpa.free(s.conf_h);
+        gpa.free(s.h_hn);
+        gpa.destroy(s);
+    }
+};
+
+/// Whether `dir` holds a DSpark speculator (config.json's speculators_model_type).
+pub fn isSpark(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) bool {
+    const path = std.fs.path.join(gpa, &.{ dir, "config.json" }) catch return false;
+    defer gpa.free(path);
+    const text = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20)) catch return false;
+    defer gpa.free(text);
+    const p = std.json.parseFromSlice(std.json.Value, gpa, text, .{}) catch return false;
+    defer p.deinit();
+    const t = p.value.object.get("speculators_model_type") orelse return false;
+    return t == .string and std.mem.eql(u8, t.string, "dspark");
+}
+
+/// The checkpoint is the one this port reads (G0's checks).
+pub fn checkConfig(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !void {
+    const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+    defer gpa.free(path);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+    defer gpa.free(text);
+    const p = try std.json.parseFromSlice(std.json.Value, gpa, text, .{});
+    defer p.deinit();
+    const o = p.value.object;
+    const t = (o.get("transformer_layer_config") orelse return error.NotDSpark).object;
+    const int = struct {
+        fn f(x: ?std.json.Value) i64 {
+            return if (x) |v| (if (v == .integer) v.integer else -1) else -1;
+        }
+    }.f;
+    const ok = int(t.get("hidden_size")) == D and int(t.get("num_hidden_layers")) == LAYERS and
+        int(t.get("num_attention_heads")) == H and int(t.get("num_key_value_heads")) == H and int(t.get("head_dim")) == HD and
+        int(t.get("intermediate_size")) == FF and int(t.get("sliding_window")) == df.WIN and
+        int(o.get("block_size")) == df.BLOCK and int(o.get("mask_token_id")) == df.MASK and int(o.get("markov_rank")) == RANK;
+    if (!ok) return error.DrafterConfigUnexpected;
+    const aux = (o.get("aux_hidden_state_layer_ids") orelse return error.DrafterConfigUnexpected).array.items;
+    const want = [_]i64{ 2, 20, 39, 58, 75 };
+    if (aux.len != want.len) return error.DrafterConfigUnexpected;
+    for (aux, want) |a, w| if (a.integer != w) return error.DrafterConfigUnexpected;
+    const sfa = o.get("sample_from_anchor") orelse return error.DrafterConfigUnexpected;
+    if (sfa != .bool or !sfa.bool) return error.DrafterConfigUnexpected;
+}
+
+fn layerName(b: *[96]u8, li: usize, s: []const u8) ![]const u8 {
+    return std.fmt.bufPrint(b, "layers.{d}.{s}", .{ li, s });
+}
+
+fn bf(x: u16) f32 {
+    return @bitCast(@as(u32, x) << 16);
+}
+
+/// The DSpark drafter from `dir` for rank `rank` of `world` on engine `e`: a Drafter whose `spark` is set. Every
+/// rank holds the whole body (4 bits, fc bf16) and its own slice of the verifier's draft head; rank 0 the chain's tables.
+pub fn load(gpa: std.mem.Allocator, io: std.Io, e: anytype, dir: []const u8, rank: usize, world: usize, bits: u8) !*df.Drafter {
+    if (bits != 0 and bits != 4) return error.BadDrafterBits;
+    try checkConfig(gpa, io, dir);
+    const d = e.d;
+    const head = e.w.draft_head orelse return error.DrafterNeedsDraftHead;
+    const path = try std.fs.path.join(gpa, &.{ dir, "model.safetensors" });
+    defer gpa.free(path);
+    const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    var lenb: [8]u8 = undefined;
+    _ = try file.readPositionalAll(io, &lenb, 0);
+    const hlen = std.mem.readInt(u64, &lenb, .little);
+    if (hlen > 1 << 20) return error.BadDrafterHeader;
+    const text = try gpa.alloc(u8, hlen);
+    defer gpa.free(text);
+    _ = try file.readPositionalAll(io, text, 8);
+    const hdr = try std.json.parseFromSlice(std.json.Value, gpa, text, .{});
+    defer hdr.deinit();
+    var ents = std.StringHashMap(dl.Ent).init(gpa);
+    defer ents.deinit();
+    var it = hdr.value.object.iterator();
+    while (it.next()) |x| {
+        if (std.mem.eql(u8, x.key_ptr.*, "__metadata__")) continue;
+        if (!std.mem.eql(u8, x.value_ptr.object.get("dtype").?.string, "BF16")) return error.DrafterNotBf16;
+        const offs = x.value_ptr.object.get("data_offsets").?.array.items;
+        try ents.put(x.key_ptr.*, .{ .off = 8 + hlen + @as(u64, @intCast(offs[0].integer)), .n = @intCast(offs[1].integer - offs[0].integer) });
+    }
+    // weights: per layer [q | k | v], [k | v] again (the context rows'), o, [gate | up] at `bits`, down bf16; fc bf16
+    const per: u64 = if (bits == 4) 1 else 4; // quarter-bytes a weight
+    const lin_elems: u64 = 3 * HW * D + 2 * HW * D + D * HW + 2 * FF * D;
+    const total: u64 = LAYERS * (lin_elems * per / 2 + lin_elems / 16 + D * FF * 2 + 2 * D * 2 + 2 * HD * 2 + 16 * 256) + AUX * D * D * 2 + 2 * D * 2 + 64 * 256;
+    var wbuf = try cuda.DeviceBuffer.alloc(d, total);
+    errdefer wbuf.free();
+    var tmp = try cuda.DeviceBuffer.alloc(d, AUX * D * D * 2); // the largest linear as stored (fc)
+    defer tmp.free();
+    const nk: usize = 2 * FF * D; // the largest 4-bit linear ([gate | up])
+    var raw = try cuda.DeviceBuffer.alloc(d, if (bits == 4) nk / 2 + 2 * nk / 16 + 1024 else 256);
+    defer raw.free();
+    var module = try cuda.Module.load(d, cuda.kernels.glm_dspark);
+    errdefer module.unload();
+    var dfmod = try cuda.Module.load(d, cuda.kernels.glm_dflash);
+    errdefer dfmod.unload();
+    var l: dl.Loader = .{ .gpa = gpa, .io = io, .file = file, .ents = &ents, .w = &wbuf, .tmp = &tmp, .mk = &e.m.mm, .qk = &e.m.quant, .pk = &e.m.q4, .qraw = &raw, .bits = bits, .stream = e.stream };
+    defer {
+        l.buf.deinit(gpa);
+        l.sub.deinit(gpa);
+    }
+    const sp = try gpa.create(Spark);
+    errdefer gpa.destroy(sp);
+    sp.* = .{ .module = module, .k = try Kernels.load(module), .weights = wbuf, .vocab = head.n * world };
+    defer @import("cuda_load_owner.zig").drain(e.stream, d);
+    var nb: [4][96]u8 = undefined;
+    for (&sp.layers, 0..) |*lw, i| {
+        lw.in_norm = try l.raw(try layerName(&nb[0], i, "input_layernorm.weight"), D * 2);
+        lw.post_norm = try l.raw(try layerName(&nb[0], i, "post_attention_layernorm.weight"), D * 2);
+        lw.qn = try l.raw(try layerName(&nb[0], i, "self_attn.q_norm.weight"), HD * 2);
+        lw.kn = try l.raw(try layerName(&nb[0], i, "self_attn.k_norm.weight"), HD * 2);
+        const q = try layerName(&nb[1], i, "self_attn.q_proj.weight");
+        const kq = try layerName(&nb[2], i, "self_attn.k_proj.weight");
+        const v = try layerName(&nb[3], i, "self_attn.v_proj.weight");
+        lw.qkv = try l.linear(&.{ q, kq, v }, &.{ HW, HW, HW }, D, null);
+        lw.kv = try l.linear(&.{ kq, v }, &.{ HW, HW }, D, null);
+        lw.o = try l.linear(&.{try layerName(&nb[1], i, "self_attn.o_proj.weight")}, &.{D}, HW, null);
+        const gate = try layerName(&nb[1], i, "mlp.gate_proj.weight");
+        const up = try layerName(&nb[2], i, "mlp.up_proj.weight");
+        lw.gu = try l.linear(&.{ gate, up }, &.{ FF, FF }, D, null);
+        lw.down = try l.linearB(&.{try layerName(&nb[3], i, "mlp.down_proj.weight")}, &.{D}, FF, null);
+    }
+    sp.fc = .{ .bf16 = try l.linearB(&.{"fc.weight"}, &.{D}, AUX * D, null) };
+    sp.hnorm = try l.raw("hidden_norm.weight", D * 2);
+    sp.norm = try l.raw("norm.weight", D * 2);
+    if (l.at > total) return error.DrafterLayout;
+    // rank 0's chain: the Markov tables and the confidence head on the host
+    const V = sp.vocab;
+    if (rank == 0) {
+        sp.w1 = try gpa.alloc(u16, V * RANK);
+        sp.w2 = try gpa.alloc(u16, V * RANK);
+        @memcpy(std.mem.sliceAsBytes(sp.w1), try l.read("markov_head.markov_w1.weight", V * RANK * 2));
+        @memcpy(std.mem.sliceAsBytes(sp.w2), try l.read("markov_head.markov_w2.weight", V * RANK * 2));
+        const cw: []const u16 = @alignCast(std.mem.bytesAsSlice(u16, try l.read("confidence_head.proj.weight", (D + RANK) * 2)));
+        sp.conf_h = try gpa.alloc(f32, D);
+        for (sp.conf_h, cw[0..D]) |*o, x| o.* = bf(x);
+        for (&sp.conf_m, cw[D..][0..RANK]) |*o, x| o.* = bf(x);
+        const cb: []const u16 = @alignCast(std.mem.bytesAsSlice(u16, try l.read("confidence_head.proj.bias", 2)));
+        sp.conf_b = bf(cb[0]);
+    }
+    sp.h_hn = try gpa.alloc(u16, df.MAX_M * D);
+    try carve(sp, d, head.n);
+    // the Drafter: DFlash2's bookkeeping (slots, rings, taps, candidates) at DSpark's sizes; its own pass is `spark`
+    const dr = try gpa.create(df.Drafter);
+    errdefer gpa.destroy(dr);
+    dr.* = .{ .gpa = gpa, .d = d, .module = dfmod, .k = try df.Kernels.load(dfmod), .weights = try cuda.DeviceBuffer.alloc(d, 0), .split = false, .ff = FF, .rank = rank, .world = world, .spark = sp, .tap_row = TAP_ROW, .ring_size = ring_bytes };
+    try carveCommon(dr, d, head.n);
+    dr.h_cpos = try gpa.alloc(i64, CTX);
+    dr.h_crings = try gpa.alloc(u64, CTX);
+    dr.cand = try gpa.alloc(i32, @import("dflash_candidates.zig").Layout.init(world, df.MAX_M, df.CW).host);
+    if (std.c.getenv("TF_GLM_DFLASH2_LOG")) |v| dr.log = std.fmt.parseInt(u64, std.mem.span(v), 10) catch 0;
+    if (std.c.getenv("TF_GLM_DFLASH2_PROF") != null) dr.prof = io;
+    std.log.info("dspark: drafter from {s} (RedHatAI/GLM-5.3-speculator.dspark), linears at {d} bits, fc bf16, {d:.2} GiB weights + {d:.2} GiB scratch on the device", .{ dir, if (bits == 0) 16 else bits, @as(f64, @floatFromInt(l.at)) / (1 << 30), @as(f64, @floatFromInt(sp.scratch.len + dr.scratch.len)) / (1 << 30) });
+    return dr;
+}
+
+/// DSpark's pass scratch, every field one carved piece of one buffer.
+fn carve(sp: *Spark, d: *const cuda.Driver, head_n: usize) !void {
+    const M: u64 = df.MAX_M;
+    const C: u64 = CTX;
+    const fields = .{
+        .{ "x", M * D * 2 },       .{ "y", M * D * 2 },          .{ "qkv", M * 3 * HW * 2 }, .{ "q", M * HW * 2 },
+        .{ "kb", M * HW * 2 },     .{ "vb", M * HW * 2 },        .{ "att", M * HW * 2 },     .{ "a", M * D * 2 },
+        .{ "gu", M * 2 * FF * 2 }, .{ "act", M * FF * 2 },       .{ "hn", M * D * 2 },       .{ "xs", C * (AUX * D / 64) * 4 },
+        .{ "logits", M * head_n * 2 }, .{ "c1", C * D * 2 },      .{ "ctx", C * D * 2 },      .{ "ckv", C * 2 * HW * 2 },
+        .{ "pm", M * H * (CH + 1) * 4 }, .{ "pl", M * H * (CH + 1) * 4 }, .{ "pacc", M * H * (CH + 1) * HD * 4 },
+    };
+    var at: u64 = 0;
+    inline for (fields) |f| {
+        @field(sp, f[0]) = at;
+        at += std.mem.alignForward(u64, f[1], 256);
+    }
+    sp.scratch = try cuda.DeviceBuffer.alloc(d, at);
+    errdefer sp.scratch.free();
+    inline for (fields) |f| @field(sp, f[0]) += sp.scratch.ptr;
+    try d.check(d.api.cuMemsetD8_v2(sp.scratch.ptr, 0, at), "cuMemsetD8");
+}
+
+/// The Drafter's shared scratch at DSpark's sizes (taps, context tables, block tables, candidates, the linears' partials).
+fn carveCommon(dr: *df.Drafter, d: *const cuda.Driver, head_n: usize) !void {
+    const M: u64 = df.MAX_M;
+    const C: u64 = CTX;
+    const chunks: u64 = (head_n + 4095) / 4096;
+    var part: u64 = 16;
+    const sp = dr.spark.?;
+    for (sp.layers) |l| {
+        for ([_]df.Lin{ l.qkv, l.kv, l.o, l.gu }) |w| if (w == .bf16) {
+            part = @max(part, mm.partBytes(64, w.bf16));
+        };
+        part = @max(part, mm.partBytes(64, l.down));
+    }
+    part = @max(part, mm.partBytes(64, sp.fc.bf16));
+    const fields = .{
+        .{ "part", part },                   .{ "gs", C * (AUX * D / 64) * 4 }, .{ "cin", C * TAP_ROW },         .{ "taps_step", df.STEP_ROWS * TAP_ROW },
+        .{ "taps_prefill", C * TAP_ROW },    .{ "ids", M * 4 },                 .{ "bpos", M * 4 },              .{ "rings", df.MAX_S * 8 },
+        .{ "starts", df.MAX_S * 8 },         .{ "froms", df.MAX_S * 8 },        .{ "cpos", C * 8 },              .{ "crings", C * 8 },
+        .{ "gtk", @import("dflash_candidates.zig").Layout.init(dr.world, M, df.CW).device * 4 }, .{ "pv", M * chunks * df.TOPK * 4 }, .{ "pi", M * chunks * df.TOPK * 4 },
+    };
+    var at: u64 = 0;
+    inline for (fields) |f| {
+        @field(dr, f[0]) = at;
+        at += std.mem.alignForward(u64, f[1], 256);
+    }
+    dr.scratch = try cuda.DeviceBuffer.alloc(d, at);
+    errdefer dr.scratch.free();
+    inline for (fields) |f| @field(dr, f[0]) += dr.scratch.ptr;
+    try d.check(d.api.cuMemsetD8_v2(dr.scratch.ptr, 0, at), "cuMemsetD8");
+}
+
+fn go(f: cuda.Function, grid: cuda.Dim3, threads: u32, e: anytype, a: *cuda.Args) !void {
+    try cuda.launch.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, e.stream, a);
+}
+
+fn set(e: anytype) glue.Set {
+    return .{ .glue = &e.m.glue, .mm = &e.m.mm };
+}
+
+/// out[m, n] = x[m, k] . w^T (bf16): 4 bits 16 rows a launch (the input's 64-group sums first), or glm_mm.
+fn lin(dr: *const df.Drafter, e: anytype, x: u64, w: df.Lin, out: u64, m: usize) !void {
+    switch (w) {
+        .bf16 => |t| try mm.matmul(&e.m.mm, e.stream, x, t.k, t, out, dr.part, m, false, false),
+        .q4 => |q| {
+            var a: cuda.Args = .{};
+            a.add(x);
+            a.add(@as(i32, @intCast(q.k)));
+            a.add(@as(i32, @intCast(q.k)));
+            a.add(dr.gs);
+            try go(dr.k.gsum, .{ .x = @intCast(m) }, 128, e, &a);
+            var r0: usize = 0;
+            while (r0 < m) : (r0 += 16) {
+                const rows = @min(16, m - r0);
+                try q4.matmul(&e.m.q4, e.stream, x + r0 * q.k * 2, q.k, dr.gs + r0 * (q.k / 64) * 4, q, out + r0 * q.n * 2, rows);
+            }
+        },
+        .q4g32 => return error.DrafterLayout,
+    }
+}
+
+fn add(sp: *const Spark, e: anytype, x: u64, y: u64, m: usize, n: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(y);
+    a.add(@as(i32, @intCast(n)));
+    try go(sp.k.add, .{ .x = @intCast(m), .y = @intCast((n + 1023) / 1024) }, 256, e, &a);
+}
+
+/// `N` context rows (cin, cpos, crings uploaded) through fc, the hidden norm and each layer's [k | v] into the rings.
+pub fn ingestPass(dr: *df.Drafter, e: anytype, N: usize) !void {
+    const sp = dr.spark.?;
+    try lin(dr, e, dr.cin, sp.fc, sp.c1, N);
+    try glue.rmsnorm(set(e), e.stream, sp.c1, D, sp.hnorm, sp.ctx, D, null, EPS, N, D);
+    for (sp.layers, 0..) |l, li| {
+        try lin(dr, e, sp.ctx, l.kv, sp.ckv, N);
+        var a: cuda.Args = .{};
+        a.add(sp.ckv);
+        a.add(l.kn);
+        a.add(dr.cpos);
+        a.add(dr.crings);
+        a.add(@as(i32, @intCast(li)));
+        a.add(EPS);
+        a.add(THETA);
+        try go(sp.k.ctx_kv, .{ .x = @intCast(N), .y = H }, 32, e, &a);
+    }
+}
+
+/// Every rank's `bytes` at buf + rank * bytes into every rank's buf, rank order (the engine's gathers' route).
+fn gather(e: anytype, buf: u64, bytes: usize) !void {
+    if (e.spans.len == 1) return;
+    if (e.group) |g| return g.allGather(e.stream, buf + e.share.rank * bytes, buf, bytes);
+    try e.lib.check(e.lib.api.ncclAllGather(buf + e.share.rank * bytes, buf, bytes, .u8, e.comm, e.stream.handle), "ncclAllGather");
+}
+
+/// The block pass for `S` streams (tables uploaded): embed, 3 layers, norm, each rank's 16 best a row, gathered.
+pub fn pass(dr: *df.Drafter, e: anytype, S: usize) !void {
+    const sp = dr.spark.?;
+    const M = S * df.BLOCK;
+    try glue.embedB16(set(e), e.stream, dr.ids, e.w.embed, sp.x, M, D, 1);
+    for (sp.layers, 0..) |l, li| {
+        try glue.rmsnorm(set(e), e.stream, sp.x, D, l.in_norm, sp.y, D, null, EPS, M, D);
+        try lin(dr, e, sp.y, l.qkv, sp.qkv, M);
+        {
+            var a: cuda.Args = .{};
+            for ([_]u64{ sp.qkv, l.qn, l.kn, dr.bpos }) |p| a.add(p);
+            a.add(EPS);
+            a.add(THETA);
+            for ([_]u64{ sp.q, sp.kb, sp.vb }) |p| a.add(p);
+            try go(sp.k.block_qkv, .{ .x = @intCast(M), .y = 2 * H }, 32, e, &a);
+        }
+        {
+            var a: cuda.Args = .{};
+            for ([_]u64{ sp.q, sp.kb, sp.vb, dr.rings, dr.starts, dr.froms }) |p| a.add(p);
+            a.add(@as(i32, @intCast(li)));
+            a.add(SCALE);
+            for ([_]u64{ sp.pm, sp.pl, sp.pacc }) |p| a.add(p);
+            try go(sp.k.attn_part, .{ .x = @intCast(S), .y = H, .z = CH + 1 }, 128, e, &a);
+            var b: cuda.Args = .{};
+            for ([_]u64{ sp.pm, sp.pl, sp.pacc, sp.att }) |p| b.add(p);
+            try go(sp.k.attn_merge, .{ .x = @intCast(M), .y = H }, HD, e, &b);
+        }
+        try lin(dr, e, sp.att, l.o, sp.a, M);
+        try add(sp, e, sp.x, sp.a, M, D);
+        try glue.rmsnorm(set(e), e.stream, sp.x, D, l.post_norm, sp.y, D, null, EPS, M, D);
+        try lin(dr, e, sp.y, l.gu, sp.gu, M);
+        {
+            var a: cuda.Args = .{};
+            a.add(sp.gu);
+            a.add(sp.act);
+            a.add(@as(i32, @intCast(FF)));
+            try go(dr.k.swiglu, .{ .x = @intCast(M), .y = @intCast((FF + 1023) / 1024) }, 256, e, &a);
+        }
+        try lin(dr, e, sp.act, .{ .bf16 = l.down }, sp.a, M);
+        try add(sp, e, sp.x, sp.a, M, D);
+    }
+    // h = norm(x) through the verifier's 4-bit draft head (this rank's vocabulary), its 16 best a row, gathered
+    try glue.rmsnorm(set(e), e.stream, sp.x, D, sp.norm, sp.hn, D, sp.xs, EPS, M, D);
+    const head = e.w.draft_head.?;
+    var r0: usize = 0;
+    while (r0 < M) : (r0 += 16) {
+        const rows = @min(16, M - r0);
+        try q4.matmul(&e.m.q4, e.stream, sp.hn + r0 * D * 2, D, sp.xs + r0 * (D / 64) * 4, head, sp.logits + r0 * head.n * 2, rows);
+    }
+    const chunks = (head.n + 4095) / 4096;
+    const nw = M * df.CW;
+    {
+        var a: cuda.Args = .{};
+        a.add(sp.logits);
+        a.add(@as(i32, @intCast(head.n)));
+        a.add(@as(i32, @intCast(e.share.vocab.lo)));
+        a.add(dr.pv);
+        a.add(dr.pi);
+        try go(dr.k.top16_part, .{ .x = @intCast(M), .y = @intCast(chunks) }, 256, e, &a);
+        var b: cuda.Args = .{};
+        b.add(dr.pv);
+        b.add(dr.pi);
+        b.add(@as(i32, @intCast(chunks)));
+        b.add(dr.gtk + e.share.rank * nw * 4);
+        try go(dr.k.top16_merge, .{ .x = @intCast(M) }, 256, e, &b);
+    }
+    try gather(e, dr.gtk, nw * 4);
+}
+
+const Cand = struct { v: f32, id: u32 };
+
+fn better(_: void, a: Cand, b: Cand) bool {
+    return if (a.v != b.v) a.v > b.v else a.id < b.id;
+}
+
+/// Stream i's drafts (rank 0, after the pass's candidates and h are read back): every rank's 16 best of slots 0..6
+/// merged (value descending, id ascending), then left to right from the anchor the Markov score and confidence.
+pub fn select(dr: *const df.Drafter, i: usize, M: usize, q: df.Req) void {
+    const sp = dr.spark.?;
+    const out = q.out.?;
+    var prev: usize = q.anchor;
+    var alive: f64 = 1;
+    _ = &alive;
+    for (0..DRAFTS) |t| {
+        const r = i * df.BLOCK + t;
+        var c: [df.TOPK * 8]Cand = undefined;
+        var n: usize = 0;
+        for (0..dr.world) |rk| {
+            const blk = dr.cand[rk * M * df.CW + r * df.CW ..][0..df.CW];
+            for (0..df.TOPK) |j| {
+                if (blk[j] < 0 or n == c.len) continue;
+                c[n] = .{ .v = @bitCast(blk[df.TOPK + j]), .id = @intCast(blk[j]) };
+                n += 1;
+            }
+        }
+        std.mem.sort(Cand, c[0..n], {}, better);
+        n = @min(n, df.TOPK);
+        // the Markov embedding of prev, in f64 (0125: bf16 rows kept, products in f64)
+        var emb: [RANK]f64 = undefined;
+        for (&emb, sp.w1[prev * RANK ..][0..RANK]) |*o, x| o.* = bf(x);
+        var best: usize = 0;
+        var best_s: f64 = -std.math.inf(f64);
+        for (0..n) |m| {
+            var dot: f64 = 0;
+            for (sp.w2[@as(usize, c[m].id) * RANK ..][0..RANK], emb) |w, x| dot += @as(f64, bf(w)) * x;
+            const s = @as(f64, c[m].v) + dot;
+            if (s > best_s) {
+                best_s = s;
+                best = m;
+            }
+        }
+        // the confidence: sigmoid(w_h . h + w_m . W1[prev] + b)
+        var z: f64 = sp.conf_b;
+        for (sp.conf_h, sp.h_hn[r * D ..][0..D]) |w, h| z += @as(f64, w) * bf(h);
+        for (sp.conf_m, emb) |w, x| z += w * x;
+        const conf = 1.0 / (1.0 + @exp(-z));
+        if (n == 0) { // no candidate (cannot happen with a whole vocabulary): the anchor repeated, chance 0
+            for (t..DRAFTS) |k| {
+                out[k] = @intCast(prev);
+                if (q.probs) |p| p[k] = 0;
+            }
+            return;
+        }
+        prev = c[best].id;
+        out[t] = @intCast(prev);
+        if (q.probs) |p| p[t] = conf;
+    }
+}
