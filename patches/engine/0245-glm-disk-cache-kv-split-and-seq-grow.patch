+    const cap: usize = 4096;
+    var st = try State.initHead(a, &d, &w, cap, true, false);
+    defer st.deinit();
+    const sh = try image.Shape.of(&st, &w.config, cap, false);
+    try expectEqual(@as(u32, 4), sh.lat_split);
+    try expect(sh.ik_split);
+    const at: u32 = 4096;
+    const plan = try Plan.init(&st, &w.config, at, null);
+    try expectEqual(@as(u64, plan.len), image.leaseBytes(sh, at, 0));
+
+    const prefixes = [_]u64{ sh.prefix, sh.prefix, sh.prefix, sh.prefix };
+    var list: std.ArrayList(image.Part) = .empty;
+    defer list.deinit(a);
+    try image.storeParts(sh, &prefixes, at, &list, a);
+    var total: u64 = 0;
+    var row_parts: usize = 0;
+    for (list.items) |p| {
+        total += p.bytes;
+        if (p.row > 0) {
+            row_parts += 1;
+            try expect(256 % p.per == 0);
+            try expectEqual(@as(u64, at / p.per) * p.row, p.bytes);
+        }
+    }
+    try expectEqual(image.storeImageBytes(sh, &prefixes, at), total);
+    // 4 ranks * 3 layers * (latent + scales + ik) = 36 block-deduplicated row parts!
+    try expectEqual(@as(usize, 4 * 3 * 3), row_parts);
+
+    // Roundtrip gatherWith -> scatterWith over 4 ranks with distinct per-rank bytes
+    const rank_img_len: usize = @intCast(image.imageBytes(sh, at));
+    var src_ranks: [4][]u8 = undefined;
+    var dst_ranks: [4][]u8 = undefined;
+    for (0..4) |r| {
+        src_ranks[r] = try a.alloc(u8, rank_img_len);
+        dst_ranks[r] = try a.alloc(u8, rank_img_len);
+        @memset(dst_ranks[r], 0);
+        for (src_ranks[r], 0..) |*b, idx| b.* = @truncate((r + 1) * 53 +% idx *% 17);
+    }
+    defer for (0..4) |r| {
+        a.free(src_ranks[r]);
+        a.free(dst_ranks[r]);
+    };
+    const MockIo = struct {
+        src: [4][]u8,
+        dst: [4][]u8,
+        pub fn take(io: @This(), rank: u32, off: u64, out: []u8) !void {
+            @memcpy(out, io.src[rank][@intCast(off)..][0..out.len]);
+        }
+        pub fn put(io: @This(), rank: u32, off: u64, bytes: []const u8) !void {
+            @memcpy(io.dst[rank][@intCast(off)..][0..bytes.len], bytes);
+        }
+    };
+    const mock: MockIo = .{ .src = src_ranks, .dst = dst_ranks };
+    const buf = try a.alloc(u8, @intCast(total));
+    defer a.free(buf);
+    const R = struct { off: u64, len: u64 };
+    const ranges = [_]R{ .{ .off = 0, .len = total / 3 }, .{ .off = total / 3, .len = total - total / 3 } };
+    try ranks_mod.gatherWith(mock, sh, &prefixes, at, null, &ranges, buf, a);
+    try ranks_mod.scatterWith(mock, sh, &prefixes, at, null, &ranges, buf, a);
+    for (0..4) |r| {
+        try std.testing.expectEqualSlices(u8, src_ranks[r][image.Words.bytes..], dst_ranks[r][image.Words.bytes..]);
+    }
+}
