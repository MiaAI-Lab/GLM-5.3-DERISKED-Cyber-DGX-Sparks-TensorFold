+test "GLM disk image: KV_SPLIT=2 matches Plan.len, validates 256-token blocks, and routes all 4 ranks disjointly" {
+    const state_mod = @import("cuda_state.zig");
+    const ranks_mod = @import("cuda_disk_ranks.zig");
+    const a = std.testing.allocator;
+    state_mod.lat_split = 4;
+    state_mod.ik_split = true;
+    defer {
+        state_mod.lat_split = 1;
+        state_mod.ik_split = false;
+    }
+    var layers: [3]weights.Layer = undefined;
+    for (&layers) |*l| l.mixer = .{ .mla = undefined };
+    var w: weights.Weights = undefined;
+    w.config = .{};
+    w.config.dsa = true;
+    w.config.rope = 64;
+    w.share = try shard.Share.of(&w.config, 0, 4);
+    w.layers = &layers;
+
