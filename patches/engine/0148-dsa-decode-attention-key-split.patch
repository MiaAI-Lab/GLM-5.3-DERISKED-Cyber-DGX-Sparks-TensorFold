From e4fdab8268873bd6ce8ea431cd03ac371dd1e9ac Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <MiaAI-Lab@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:58:24 +0200
Subject: [PATCH] glm_moe_dsa: a decode window's sparse attention in 128-key
 chunks

A decode window of a few rows launched rows x 1 head tile x 4 chunks of
512 picked keys: 8 blocks for two rows on GB10's 48 SMs. Its sparse rows
now run in 16 chunks of 128 keys (tf_glm_chunks_16_w576_s4, the chunk
kernel with a chunk-length template parameter), merged over 16 chunks,
when the partials hold them. TF_GLM_DSA_KSPLIT=0 keeps 512-key chunks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UQVvNktFCvQrvpNUbqtqBX
---
 zig/kernels/cuda/glm_glue_attn.cuh      | 17 ++++++++++++++---
 zig/src/families/glm/cuda_dsa_block.zig |  2 ++
 zig/src/families/glm/cuda_glue.zig      |  2 ++
 zig/src/families/glm/cuda_latent.zig    | 16 ++++++++++++++++
 4 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/zig/kernels/cuda/glm_glue_attn.cuh b/zig/kernels/cuda/glm_glue_attn.cuh
index 7641c65..2df1f6a 100644
--- a/zig/kernels/cuda/glm_glue_attn.cuh
+++ b/zig/kernels/cuda/glm_glue_attn.cuh
@@ -63,7 +63,8 @@ constexpr int wide_smem() {
 
 // PAGED8: an E4M3 cache on KV pages (pt, pstep bytes apart): a dense chunk is one page, a sparse key's logical token goes
 // through the table to its page; codes and scales then load as on a window, so the arithmetic is the window's.
-template <int HB, bool FP8 = false, bool PAGED8 = false, int LWV = LW>
+// CHL: the keys a chunk covers (CH; glm_moe_dsa's decode windows split a row's 2,048 picks finer, CH / 4, for blocks)
+template <int HB, bool FP8 = false, bool PAGED8 = false, int LWV = LW, int CHL = CH>
 __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, const int* pos, const int* tok,
                             const int* cnt, float* po, float* pm, float* pl, int64_t rows, int64_t heads, int64_t w,
                             float scale, int sparse, const int* pt, int64_t pstep, const float* scales = nullptr,
@@ -81,7 +82,7 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
   const int kg = warp & 3, hh = warp >> 2;
   // a segment-batched launch passes the block's row and chunk within its segment (rr, cc)
   const int64_t r = rr >= 0 ? rr : (int64_t)blockIdx.x, h0 = (int64_t)blockIdx.y * HB, c = cc >= 0 ? cc : (int64_t)blockIdx.z;
-  const int64_t n = sparse ? cnt[r] : 0, limit = sparse ? 0 : (int64_t)pos[0] + r, start = c * CH;
+  const int64_t n = sparse ? cnt[r] : 0, limit = sparse ? 0 : (int64_t)pos[0] + r, start = c * CHL;
   const bool live = sparse ? start < n : start <= limit;
   // a dense chunk's 512 keys are one page, its rows from that page's; a sparse key's row comes as the token list has it
   const __nv_bfloat16* keys_at = !FP8 && pt && !sparse && live ? lc + ((int64_t)pt[c] * (pstep / 2) - start * LWV) : lc;
@@ -167,7 +168,8 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
   for (int i = 0; i < MT; ++i)
     for (int j = 0; j < 8; ++j)
       for (int e = 0; e < 4; ++e) o[i][j][e] = 0.0f;
-  constexpr int tiles = CH / KT;
+  static_assert(CHL % KT == 0 && CH % CHL == 0, "whole key tiles a chunk");
+  constexpr int tiles = CHL / KT;
   if (live) {
     for (int idx = t; idx < HB * (LWV / 8); idx += blockDim.x) {
       const int hd = idx / (LWV / 8), u = idx % (LWV / 8);
@@ -658,6 +660,15 @@ extern "C" __global__ void __launch_bounds__(256)
   glm_attn::chunks_wide<16, false, false, glm_attn::DSA_LW>(qa, lc, pos, tok, cnt, po, pm, pl, rows, heads, w, scale,
                                                             sparse, pt, pstep);
 }
+// glm_moe_dsa's decode windows: the same chunks over 128 keys each (16 a row's 2,048 picks), four times the blocks of
+// a few-row window, merged by tf_glm_merge over 16 chunks (sparse rows only; the dense pass keeps tf_glm_chunks_16_w576)
+extern "C" __global__ void __launch_bounds__(256)
+    tf_glm_chunks_16_w576_s4(const __nv_bfloat16* qa, const __nv_bfloat16* lc, const int* pos, const int* tok,
+                             const int* cnt, float* po, float* pm, float* pl, int64_t rows, int64_t heads, int64_t w,
+                             float scale, int sparse, const int* pt, int64_t pstep) {
+  glm_attn::chunks_wide<16, false, false, glm_attn::DSA_LW, glm_attn::CH / 4>(qa, lc, pos, tok, cnt, po, pm, pl, rows,
+                                                                            heads, w, scale, sparse, pt, pstep);
+}
 extern "C" __global__ void __launch_bounds__(256)
     tf_glm_chunks_16_fused_w576(const __nv_bfloat16* qa, const __nv_bfloat16* lc, const int* tok, const int* cnt,
                                 __nv_bfloat16* out, int64_t rows, int64_t heads, int64_t w, float scale, int nch,
diff --git a/zig/src/families/glm/cuda_dsa_block.zig b/zig/src/families/glm/cuda_dsa_block.zig
index 17b68c7..cbb9068 100644
--- a/zig/src/families/glm/cuda_dsa_block.zig
+++ b/zig/src/families/glm/cuda_dsa_block.zig
@@ -199,6 +199,8 @@ pub fn attend(k: Kernels, stream: cuda.Stream, l: Layer, c: Caches, s: Scratch,
         defer stamp.end();
         const w: usize = if (l.rope != 0) sparse.dsa_width else sparse.width;
         if (msa) return msaSparse(set, stream, l, c, v, rows, scale);
+        // a decode window: its few rows' picks in 16 chunks a row rather than 4 (more blocks on the SMs)
+        if (l.rope != 0 and rows < 64) if (try latent.sparseDsaSplit(set, stream, v.qa, c.lc, latTable(l, c), v.tokens, v.counts, w, v.partials, v.ol, rows, l.heads, l.rowW(), scale)) return;
         if (l.rope != 0) { // the fused w576 merge drops distant picks: 512-row calls always fit the partials
             var ro: usize = 0;
             while (ro < rows) : (ro += prompt_att_rows) {
diff --git a/zig/src/families/glm/cuda_glue.zig b/zig/src/families/glm/cuda_glue.zig
index 80a0a59..2b739e0 100644
--- a/zig/src/families/glm/cuda_glue.zig
+++ b/zig/src/families/glm/cuda_glue.zig
@@ -106,6 +106,7 @@ pub const Kernels = struct {
     dsa_topk: cuda.Function, // and each row's best 2048 of them (select_row's unpooled, i32 form)
     chunks_16_w576: cuda.Function, // the chunk kernels over the dsa's 576-wide rows (512 latent + the 64 rope);
     chunks_16_fused_w576: cuda.Function, // 16-head blocks only: the 32-head block's 113 KB passes no GB10
+    chunks_16_w576_s4: cuda.Function, // a decode window's dsa rows in chunks of 128 keys (16 a row: four times the blocks)
     msa_w576: cuda.Function, // glm_glue_msa.cuh: a prompt row a block over its token list, the rank's heads one m16 tile
     msa_w576_dense: cuda.Function, // and a dense prompt row over keys 0 .. its position (the implicit list)
 
@@ -129,6 +130,7 @@ pub const Kernels = struct {
         try k.chunks_32_fp8_paged_fused.allowDynamicShared(chunksSmem(32));
         try k.chunks_16_w576.allowDynamicShared(chunksSmemW(16, dsa_row));
         try k.chunks_16_fused_w576.allowDynamicShared(chunksSmemW(16, dsa_row));
+        try k.chunks_16_w576_s4.allowDynamicShared(chunksSmemW(16, dsa_row));
         try k.latent_mma_kn.allowDynamicShared(latent_mma_smem[0]);
         try k.latent_mma_nk.allowDynamicShared(latent_mma_smem[1]);
         return k;
diff --git a/zig/src/families/glm/cuda_latent.zig b/zig/src/families/glm/cuda_latent.zig
index 7d9b8bd..f902edf 100644
--- a/zig/src/families/glm/cuda_latent.zig
+++ b/zig/src/families/glm/cuda_latent.zig
@@ -169,6 +169,22 @@ pub fn sparseAttentionFormat(set: glue.Set, stream: cuda.Stream, qa: u64, cache:
     try merge(set, stream, p, out, counts, rows, heads, lw, nch, true);
 }
 
+/// glm_moe_dsa's decode rows (TF_GLM_DSA_KSPLIT, default on; 0: 512-key chunks): its sparse lists in chunks of 128
+/// keys, 16 a row's 2,048, then the merge over them; false (nothing launched) when the partials hold fewer rows.
+pub fn sparseDsaSplit(set: glue.Set, stream: cuda.Stream, qa: u64, cache: u64, t: Table, tokens: u64, counts: u64, w: usize, p: Partials, out: u64, rows: usize, heads: usize, lw: usize, scale: f32) !bool {
+    if (lw != glue.dsa_row or t.pt != 0 or w != 2048) return false;
+    if (std.c.getenv("TF_GLM_DSA_KSPLIT")) |v| if (std.mem.eql(u8, std.mem.span(v), "0")) return false;
+    const nch = 4 * chunksFor(w);
+    if (p.rows == 0 or nch * rows > p.rows) return false;
+    var a: cuda.Args = .{};
+    a.add(qa);
+    a.add(cache);
+    inline for (.{ @as(u64, 0), tokens, counts, p.po, p.pm, p.pl, @as(i64, @intCast(rows)), @as(i64, @intCast(heads)), @as(i64, @intCast(w)), scale, @as(c_int, 1), t.pt, @as(i64, @intCast(t.ps)) }) |v| a.add(v);
+    try cuda.launch.launch(set.glue.chunks_16_w576_s4, .{ .grid = .{ .x = @intCast(rows), .y = cdiv(heads, heads_tile), .z = @intCast(nch) }, .block = .{ .x = chunk_threads }, .shared = glue.chunksSmemW(heads_tile, glue.dsa_row) }, stream, &a);
+    try merge(set, stream, p, out, counts, rows, heads, lw, nch, true);
+    return true;
+}
+
 /// Whether a sparse call of `rows` rows over `nch` chunks merges in the kernel: its partials would not fit `p`.
 pub fn fuses(p: Partials, nch: usize, rows: usize) bool {
     return p.rows != 0 and nch * rows > p.rows;
