new file mode 100644
index 000000000..4c262f50c
--- /dev/null
+++ b/zig/tests/cuda/exl3_prompt_once_tests.zig
@@ -0,0 +1,266 @@
+//! TF_GLM_PF_EXPERTS_ONCE (patch 0206): the prompt path with tf_exl3_prompt_gu_once (rotation fused into gate/up)
+//! against rot_in + tf_exl3_prompt_gu, byte for byte, on GLM-5.3's TP4 shapes (width 6144, a rank's expert width 512,
+//! 8 picks a row): synthetic layers (random trellis words and scales, skewed picks with empty, single-item and
+//! many-item experts) and, given a directory, one real K4 layer with real routes (x9a extract.py's layer.bin).
+//! `tf-cuda-test exl3-prompt-once [dir]`; every case must PASS and the closing line counts them (no vacuous pass).
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const qr = @import("quant_ref_tests.zig");
+const t6 = @import("exl3_prompt_k6_tests.zig");
+const Gpu = check.Gpu;
+const ex = cuda.exl3_experts;
+const h = qr.helpers;
+const Bufs = t6.Bufs;
+
+const D = 6144; // model width
+const N = ex.prompt.once_width; // one rank's expert width at TP4
+const K = 8; // picks a row
+const ES = 64; // synthetic experts
+const tile_words = 8 * 8; // int16 words of a 4-bit 16x16 tile
+
+const Ctx = struct {
+    gpu: Gpu,
+    a: std.mem.Allocator,
+    s: cuda.Stream,
+    exp: *const ex.Experts,
+    router: cuda.grouped.Router,
+    cases: usize = 0,
+};
+
+/// A layer's device tensors (4-bit mcg gate, up and down) and the host suh of gate, for the mutation check.
+const Set = struct {
+    l: ex.Layer,
+    sg_host: []f16,
+};
+
+fn plan(b: *Bufs, pairs: usize, experts: usize) !cuda.grouped.Plan {
+    const wide = pairs > cuda.grouped.small;
+    return .{ .members = try b.alloc(pairs * 4), .items = try b.alloc(cuda.grouped.maxItems(pairs, experts, ex.prompt.tile) * 12), .counts = try b.alloc(8), .rank = try b.alloc((if (wide) pairs else 1) * 4), .hist = try b.alloc((if (wide) (pairs + 1023) / 1024 * experts else 1) * 4) };
+}
+
+fn download(c: *Ctx, ptr: u64, out: []u8) !void {
+    try c.s.synchronize();
+    const buf: cuda.DeviceBuffer = .{ .d = c.gpu.d, .ptr = ptr, .len = out.len };
+    try buf.download(0, out);
+}
+
+/// One prompt call as GLM makes it (bf16 slot rows, K + 1 a row): xd [pairs][N] and y [rows][K + 1][D] bf16, and
+/// whether xu was left as allocated (0xff: no rotated copies written).
+const Out = struct { xd: []u8, y: []u8, xu_untouched: bool };
+fn runOnce(c: *Ctx, l: ex.Layer, x: u64, stride: usize, pk: u64, rows: usize, once: bool) !Out {
+    var b: Bufs = .{ .d = c.gpu.d, .gpa = c.gpu.gpa };
+    defer b.deinit();
+    var sc = try ex.prompt.scratchFor(try b.alloc(try ex.prompt.bytesFor(l, rows, K, false)), l, rows, K, false);
+    sc.y = try b.alloc(rows * (K + 1) * D * 2);
+    sc.yrow = K + 1;
+    sc.y_bf16 = true;
+    sc.once = once;
+    const p = try plan(&b, rows * K, l.experts);
+    try c.exp.prompt.run(c.exp, c.router, c.s, l, x, stride, pk, rows, sc, p);
+    const out: Out = .{ .xd = try c.a.alloc(u8, rows * K * N * 2), .y = try c.a.alloc(u8, rows * (K + 1) * D * 2), .xu_untouched = true };
+    try download(c, sc.xd, out.xd);
+    try download(c, sc.y, out.y);
+    var probe: [64]u8 = undefined;
+    try download(c, sc.xu, &probe);
+    const xu_ff = std.mem.allEqual(u8, &probe, 0xff);
+    try download(c, sc.xu + rows * K * D * 2 - 64, &probe);
+    return .{ .xd = out.xd, .y = out.y, .xu_untouched = xu_ff and std.mem.allEqual(u8, &probe, 0xff) };
+}
+
+/// The once path's xd and y equal the old path's byte for byte, and the once path wrote no rotated copies.
+fn same(c: *Ctx, name: []const u8, l: ex.Layer, x: u64, stride: usize, pk: u64, rows: usize) !void {
+    try check.expect(ex.prompt.onceEligible(l, x, stride) and ex.prompt.onceFits(l, rows, K) and c.exp.prompt.gateup_once != null, "{s}: the once kernel does not take this layer", .{name});
+    const want = try runOnce(c, l, x, stride, pk, rows, false);
+    const got = try runOnce(c, l, x, stride, pk, rows, true);
+    try check.expect(!want.xu_untouched, "{s}: the old path left xu unwritten (the probe proves nothing)", .{name});
+    try check.expect(got.xu_untouched, "{s}: the once path wrote rotated copies (rot_in ran)", .{name});
+    var what: [160]u8 = undefined;
+    try check.sameBytes(try std.fmt.bufPrint(&what, "{s}: xd (gate/up activations)", .{name}), got.xd, want.xd);
+    try check.sameBytes(try std.fmt.bufPrint(&what, "{s}: y (down slot rows)", .{name}), got.y, want.y);
+    c.cases += 1;
+    check.pass("{s}: {d} rows, xd and y byte-identical to rot_in + gu", .{ name, rows });
+}
+
+fn scales(c: *Ctx, rng: std.Random, n: usize, scale: f32) ![]f16 {
+    const out = try c.a.alloc(f16, n);
+    for (out) |*v| v.* = @floatCast((if (rng.boolean()) scale else -scale) * (0.5 + rng.float(f32)));
+    return out;
+}
+
+fn trellis(c: *Ctx, b: *Bufs, rng: std.Random, experts: usize, kt: usize, nt: usize) !u64 {
+    const per = kt * nt * tile_words;
+    const all = try c.a.alloc(i16, experts * per);
+    rng.bytes(std.mem.sliceAsBytes(all));
+    const base = try b.put(std.mem.sliceAsBytes(all));
+    const table = try c.a.alloc(u64, experts);
+    for (table, 0..) |*t, e| t.* = base + e * per * 2;
+    return b.put(std.mem.sliceAsBytes(table));
+}
+
+fn synthetic(c: *Ctx, b: *Bufs, rng: std.Random, limit: f32, act_mode: i32) !Set {
+    const k2: [ES]i32 = @splat(8);
+    const k2p = try b.put(std.mem.sliceAsBytes(&k2));
+    const sg = try scales(c, rng, ES * D, 1.0);
+    return .{ .sg_host = sg, .l = .{
+        .gate = try trellis(c, b, rng, ES, D / 16, N / 16),
+        .up = try trellis(c, b, rng, ES, D / 16, N / 16),
+        .down = try trellis(c, b, rng, ES, N / 16, D / 16),
+        .gate_k2 = k2p,
+        .up_k2 = k2p,
+        .down_k2 = k2p,
+        .suh_g = try b.put(std.mem.sliceAsBytes(sg)),
+        .suh_u = try b.put(std.mem.sliceAsBytes(try scales(c, rng, ES * D, 1.0))),
+        .svh_g = try b.put(std.mem.sliceAsBytes(try scales(c, rng, ES * N, 0.02))),
+        .svh_u = try b.put(std.mem.sliceAsBytes(try scales(c, rng, ES * N, 0.02))),
+        .suh_d = try b.put(std.mem.sliceAsBytes(try scales(c, rng, ES * N, 1.0))),
+        .svh_d = try b.put(std.mem.sliceAsBytes(try scales(c, rng, ES * D, 0.02))),
+        .experts = ES,
+        .dims = D,
+        .width = N,
+        .codebook = .mcg,
+        .uniform_k2 = 8,
+        .uniform_k2_gu = 8,
+        .uniform_k2_d = 8,
+        .limit = limit,
+        .act_mode = act_mode,
+    } };
+}
+
+/// bf16 rows (stride `stride`, the tail garbage) and each row's 8 distinct picks: expert 5 in about 30% of the rows
+/// (many items), experts 0-2 never (empty), the rest uniform.
+fn inputs(c: *Ctx, rng: std.Random, rows: usize, stride: usize) !struct { x: []u16, pk: []i32 } {
+    const x = try c.a.alloc(u16, rows * stride);
+    for (x) |*v| v.* = h.bf16Of(rng.float(f32) * 4 - 2);
+    const pk = try c.a.alloc(i32, rows * K);
+    for (0..rows) |row| {
+        var seen: [ES]bool = @splat(false);
+        seen[0] = true;
+        seen[1] = true;
+        seen[2] = true;
+        for (0..K) |j| {
+            var e: usize = if (j == 0 and rng.uintLessThan(u32, 10) < 3) 5 else rng.uintLessThan(usize, ES);
+            while (seen[e]) e = rng.uintLessThan(usize, ES);
+            seen[e] = true;
+            pk[row * K + j] = @intCast(e);
+        }
+    }
+    return .{ .x = x, .pk = pk };
+}
+
+pub fn run(gpu: Gpu, dir: ?[]const u8) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var exp = try ex.Experts.load(gpu.d);
+    defer exp.unload();
+    var pm = try cuda.Module.load(gpu.d, cuda.kernels.experts);
+    defer pm.unload();
+    var c: Ctx = .{ .gpu = gpu, .a = arena.allocator(), .s = stream, .exp = &exp, .router = try cuda.grouped.Router.resolve(pm) };
+    try check.expect(exp.prompt.gateup_once != null, "tf_exl3_prompt_gu_once is not in the experts image", .{});
+    var prng = std.Random.DefaultPrng.init(0x0206);
+    const rng = prng.random();
+    var want_cases: usize = 0;
+    {
+        var b: Bufs = .{ .d = gpu.d, .gpa = gpu.gpa };
+        defer b.deinit();
+        const set = try synthetic(&c, &b, rng, 0, 0);
+        const in = try inputs(&c, rng, 4096, D);
+        const dx = try b.put(std.mem.sliceAsBytes(in.x));
+        const dpk = try b.put(std.mem.sliceAsBytes(in.pk));
+        for ([_]usize{ 1, 9, 64, 777, 4096 }) |rows| {
+            try same(&c, "synthetic bf16 SwiGLU, no clamp", set.l, dx, D, dpk, rows);
+            want_cases += 1;
+        }
+        var l = set.l;
+        l.limit = 7.0;
+        try same(&c, "synthetic, SwiGLU clamp 7", l, dx, D, dpk, 4096);
+        l.act_mode = 1;
+        try same(&c, "synthetic, fp32 SwiGLU (act_mode 1), clamp 7", l, dx, D, dpk, 1000);
+        want_cases += 2;
+        // rows wider than the layer (stride D + 128, the tail garbage): the raw copies read only the row's own columns
+        const wide = try inputs(&c, rng, 1500, D + 128);
+        try same(&c, "synthetic, x stride D + 128", set.l, try b.put(std.mem.sliceAsBytes(wide.x)), D + 128, try b.put(std.mem.sliceAsBytes(wide.pk)), 1500);
+        want_cases += 1;
+        // sensitivity: one suh value of the many-item expert changed for the once path only must change its output
+        // (so the comparisons above would see a rotation that read the wrong scale)
+        {
+            const rows = 777;
+            const base = try runOnce(&c, set.l, dx, D, dpk, rows, false);
+            const sg = try c.a.dupe(f16, set.sg_host);
+            sg[5 * D + 300] = -sg[5 * D + 300];
+            var lm = set.l;
+            lm.suh_g = try b.put(std.mem.sliceAsBytes(sg));
+            const got = try runOnce(&c, lm, dx, D, dpk, rows, true);
+            try check.expect(!std.mem.eql(u8, got.xd, base.xd), "mutation: a flipped suh of expert 5 left the once path's xd unchanged", .{});
