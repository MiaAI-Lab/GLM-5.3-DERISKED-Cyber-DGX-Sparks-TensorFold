+            want_cases += 1;
+            check.pass("mutation: a flipped gate suh value of expert 5 changes the once path's xd (the comparison sees it)", .{});
+        }
+    }
+    if (dir) |path| {
+        try real(&c, path);
+        want_cases += 1;
+    }
+    try check.expect(c.cases == want_cases, "exl3-prompt-once: {d} cases ran, {d} expected", .{ c.cases, want_cases });
+    check.pass("exl3-prompt-once: {d}/{d} cases (tf_exl3_prompt_gu_once byte-identical to rot_in + tf_exl3_prompt_gu)", .{ c.cases, want_cases });
+}
+
+/// x9a extract.py's layer: rank 0 of a real K4 layer (TP4 cut) and 4,096 tap rows with their real top-8 routes.
+fn real(c: *Ctx, dir: []const u8) !void {
+    const io = c.gpu.io;
+    const d = try std.Io.Dir.cwd().openDir(io, dir, .{});
+    defer d.close(io);
+    const manifest = try d.readFileAlloc(io, "layer.json", c.a, .limited(1 << 20));
+    const blob = try d.readFileAlloc(io, "layer.bin", c.a, .limited(4 << 30));
+    const Arr = struct { name: []const u8, offset: usize, bytes: usize };
+    const M = struct { layer: u32, rows: usize, experts: usize, dims: usize, width: usize, arrays: []const Arr };
+    const m = try std.json.parseFromSliceLeaky(M, c.a, manifest, .{ .ignore_unknown_fields = true });
+    try check.expect(m.dims == D and m.width == N and m.rows == 4096, "real layer: dims {d} width {d} rows {d}", .{ m.dims, m.width, m.rows });
+    var b: Bufs = .{ .d = c.gpu.d, .gpa = c.gpu.gpa };
+    defer b.deinit();
+    const get = struct {
+        fn f(mm: M, bb: []const u8, name: []const u8) ![]const u8 {
+            for (mm.arrays) |a| if (std.mem.eql(u8, a.name, name)) return bb[a.offset..][0..a.bytes];
+            return error.MissingArray;
+        }
+    }.f;
+    const E = m.experts;
+    const tables = struct {
+        fn f(cc: *Ctx, bb: *Bufs, bytes: []const u8, experts: usize) !u64 {
+            const base = try bb.put(bytes);
+            const t = try cc.a.alloc(u64, experts);
+            for (t, 0..) |*v, e| v.* = base + e * (bytes.len / experts);
+            return bb.put(std.mem.sliceAsBytes(t));
+        }
+    }.f;
+    const k2 = try c.a.alloc(i32, E);
+    @memset(k2, 8);
+    const k2p = try b.put(std.mem.sliceAsBytes(k2));
+    const l: ex.Layer = .{
+        .gate = try tables(c, &b, try get(m, blob, "gate_proj.trellis"), E),
+        .up = try tables(c, &b, try get(m, blob, "up_proj.trellis"), E),
+        .down = try tables(c, &b, try get(m, blob, "down_proj.trellis"), E),
+        .gate_k2 = k2p,
+        .up_k2 = k2p,
+        .down_k2 = k2p,
+        .suh_g = try b.put(try get(m, blob, "gate_proj.suh")),
+        .suh_u = try b.put(try get(m, blob, "up_proj.suh")),
+        .svh_g = try b.put(try get(m, blob, "gate_proj.svh")),
+        .svh_u = try b.put(try get(m, blob, "up_proj.svh")),
+        .suh_d = try b.put(try get(m, blob, "down_proj.suh")),
+        .svh_d = try b.put(try get(m, blob, "down_proj.svh")),
+        .experts = E,
+        .dims = D,
+        .width = N,
+        .codebook = .mcg,
+        .uniform_k2 = 8,
+        .uniform_k2_gu = 8,
+        .uniform_k2_d = 8,
+        .limit = 0,
+        .act_mode = 0,
+    };
+    var name: [64]u8 = undefined;
+    try same(c, try std.fmt.bufPrint(&name, "real K4 layer {d} (rank 0 of TP4), real routes", .{m.layer}), l, try b.put(try get(m, blob, "x.bf16")), D, try b.put(try get(m, blob, "picks")), m.rows);
+}
