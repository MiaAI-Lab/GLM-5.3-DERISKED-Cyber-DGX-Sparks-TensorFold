diff --git a/zig/kernels/cuda/exl3_prompt_once.cuh b/zig/kernels/cuda/exl3_prompt_once.cuh
new file mode 100644
index 000000000..b2e68275a
--- /dev/null
+++ b/zig/kernels/cuda/exl3_prompt_once.cuh
@@ -0,0 +1,288 @@
+// Routed experts' prompt gate/up with the input rotation fused into the activation load (TF_GLM_PF_EXPERTS_ONCE,
+// patch 0206, MiaAI-Lab). The same xd, bit for bit, as tf_exl3_experts_rot_in followed by tf_exl3_prompt_gu:
+//  - each member row's rotation (bf16 x * fp16 suh, fwht128 in fp32, * 1/sqrt(128), fp16) is rot_in's arithmetic in
+//    rot_in's order (FMUL, the butterflies of tf_exl3::fwht128, FMUL, round), computed in shared memory a 128-wide k
+//    block at a time from the raw token row: no per-route copies through DRAM;
+//  - every sum is the same chain of mma.m16n8k16 over the ascending k tiles from zero, with the same decoded A
+//    fragments (decode_a8) and the same B values, so the same fp32 bits; the epilogue is tgateup_n's, line for line.
+// A block takes one matrix (gate or up: blockIdx.x) of one plan item (<= 64 members of an expert: blockIdx.y), all
+// N = 512 columns (32 tiles, 4 a warp), so each member row is rotated once per matrix (rot_in's work, without its
+// DRAM round trip) and each weight tile is decoded once an item. Its fp32 sums go to a scratch S [2][pairs][N]; the
+// item's second block to finish (an atomic count an item, zeroed before the launch) runs the epilogue over both.
+#pragma once
+#include "exl3_prompt.cuh"
+
+namespace tf_exl3_once {
+using namespace tf_exl3_prompt;
+
+constexpr int OM = TPM;                 // members a block: one plan item
+constexpr int OW = 8, OT = OW * 32;     // warps, threads
+constexpr int ON = 512;                 // columns (one rank's expert width at TP4)
+constexpr int OTMT = ON / 16 / OW;      // 16-column tiles a warp
+constexpr int OKB = 128;                // k of a rotation block (fwht128's)
+constexpr int OKT = OKB / 16;           // k tiles a rotation block
+constexpr int OXS = OKB + 8;            // halves a rotated row in shared memory (ldmatrix rows 16 bytes apart mod 128)
+constexpr int OXH = OM * OXS;           // halves of one block's rotated rows
+constexpr int OWS = 8;                  // weight stages, one k tile each (a warp streams its own tiles)
+constexpr int ORD = OWS - 2;            // k tiles ahead a raw row's copy is issued (landed by the weight wait)
+constexpr int ORS = 8;                  // raw row slots a warp (256 bytes: 32 lanes x 4 bf16)
+constexpr int OTW = tile_words<8>();    // 32 words a 4-bit tile
+constexpr int OWB = OW * OTMT * OTW * 4;   // bytes a weight stage: 32 tiles
+constexpr int OSU = OKB * 2;            // bytes of a block's suh
+constexpr int smem_bytes() { return 2 * OXH * 2 + OWS * OWB + OW * ORS * 256 + 2 * OSU; }
+static_assert(OTMT == 4 && OKT == OW, "4 tiles a warp; a block's rotations one a k tile a warp");
+static_assert(ORS > ORD && (ORS & (ORS - 1)) == 0 && OKT % ORS == 0, "raw slots by k tile");
+static_assert(smem_bytes() <= 99 * 1024, "one block a multiprocessor");
+
+// One lane's 4 values of a member row's k block rotated as fp16 (raw: the lane's 4 bf16 of the row's block, s: its 4
+// suh). rot_in's arithmetic: FMUL (no contraction), fwht128 (as fwht128f: the same butterflies, each an exact FFMA of
+// +-1, so the same bits), FMUL, round to fp16. A dead row (no member): zeros.
+__device__ __forceinline__ uint2 rot_one(uint2 raw, bool live, const half* s, int lane) {
+    const __nv_bfloat162 x01 = *reinterpret_cast<const __nv_bfloat162*>(&raw.x);
+    const __nv_bfloat162 x23 = *reinterpret_cast<const __nv_bfloat162*>(&raw.y);
+    const float xv[4] = {__low2float(x01), __high2float(x01), __low2float(x23), __high2float(x23)};
+    const uint2 sw = *reinterpret_cast<const uint2*>(s);
+    const half2 s01 = *reinterpret_cast<const half2*>(&sw.x), s23 = *reinterpret_cast<const half2*>(&sw.y);
+    const float sv[4] = {__low2float(s01), __high2float(s01), __low2float(s23), __high2float(s23)};
+    float v[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] = __fmul_rn(xv[j], sv[j]);
+    fwht128f(v, lane);
+    half2 o01 = __halves2half2(__float2half_rn(__fmul_rn(v[0], HAD_SCALE)), __float2half_rn(__fmul_rn(v[1], HAD_SCALE)));
+    half2 o23 = __halves2half2(__float2half_rn(__fmul_rn(v[2], HAD_SCALE)), __float2half_rn(__fmul_rn(v[3], HAD_SCALE)));
+    if (!live) o01 = o23 = __float2half2_rn(0.f);
+    uint2 o;
+    o.x = *reinterpret_cast<const uint32_t*>(&o01);
+    o.y = *reinterpret_cast<const uint32_t*>(&o23);
+    return o;
+}
+
+// tgateup_n's epilogue, line for line, for member p's 128-column block cb from its gate and up sums (gs, us: the
+// lane's 4 columns, read through L2: the other block of the item wrote one of them).
+__device__ __forceinline__ void epi_member(const float* gs, const float* us, int p, int lane, int e, int cb, const half* __restrict__ svh_g,
+        const half* __restrict__ svh_u, const half* __restrict__ suh_d, half* __restrict__ xd, int N, float limit, int act_mode) {
+    const int n = cb * 128 + 4 * lane;
+    const float4 g4 = __ldcg(reinterpret_cast<const float4*>(gs + n)), u4 = __ldcg(reinterpret_cast<const float4*>(us + n));
+    float gv[4] = {g4.x, g4.y, g4.z, g4.w}, uv[4] = {u4.x, u4.y, u4.z, u4.w};
+    fwht128f(gv, lane);
+    fwht128f(uv, lane);
+    float v[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        float gg = gv[j] * HAD_SCALE * __half2float(svh_g[(size_t)e * N + n + j]);
+        float uu = uv[j] * HAD_SCALE * __half2float(svh_u[(size_t)e * N + n + j]);
+        if (act_mode == 0) { gg = bf16r(gg); uu = bf16r(uu); }
+        if (limit > 0) { gg = upTo(gg, limit); uu = within(uu, limit); }
+        float act = gg / (1.f + expf(-gg));
+        if (act_mode == 0) act = bf16r(act);
+        act *= uu;
+        if (act_mode == 0) act = bf16r(act);
+        v[j] = act * __half2float(suh_d[(size_t)e * N + n + j]);
+    }
+    fwht128f(v, lane);
+    const half2 o01 = __halves2half2(__float2half_rn(v[0] * HAD_SCALE), __float2half_rn(v[1] * HAD_SCALE));
+    const half2 o23 = __halves2half2(__float2half_rn(v[2] * HAD_SCALE), __float2half_rn(v[3] * HAD_SCALE));
+    uint2 packed;
+    packed.x = *reinterpret_cast<const uint32_t*>(&o01);
+    packed.y = *reinterpret_cast<const uint32_t*>(&o23);
+    *reinterpret_cast<uint2*>(xd + (size_t)p * N + n) = packed;
+}
+
+// Matrix `mat` of an item (expert e, cnt members rows_sh, their token rows tok_sh): the fp32 sums into S[mat][p][:].
+template <int NBA>
+__device__ __forceinline__ void sums_n(const __nv_bfloat16* __restrict__ x, int x_stride, const uint64_t* __restrict__ T,
+        const half* __restrict__ suh, float* __restrict__ S, int K, unsigned char* smem, const int* rows_sh, const int* tok_sh, int e) {
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int kts = K >> 4, blocks = K / OKB;
+    half* Xb = reinterpret_cast<half*>(smem);                        // two blocks' rotated rows
+    const uint32_t sbase = (uint32_t)__cvta_generic_to_shared(smem);
+    const uint32_t wbase = sbase + (uint32_t)(2 * OXH * 2);           // the weight ring
+    // each warp streams its own 4 tiles (no block barrier a k tile): the lane's 16 bytes `part` of tile q
+    const int q = warp * OTMT + (lane >> 3), part = lane & 7;
+    const uint32_t* wsrc = reinterpret_cast<const uint32_t*>(T[e]) + (size_t)q * OTW + part * 4;
+    const size_t wstep = (size_t)(ON / 16) * OTW;                     // words a k tile row of tiles
+    const uint32_t wdst = wbase + (uint32_t)(q * OTW * 4 + part * 16);
+    uint32_t wfill = 0;   // the ring slot (byte offset) the next weight stage goes to
+    int wnext = 0;        // the next weight stage's k tile
+    auto wissue = [&]() {  // past the last k tile: an empty copy (src-size 0) of a valid address, so no branch
+        const bool in = wnext < kts;
+        cp16s(wdst + wfill, wsrc + (size_t)(in ? wnext : 0) * wstep, in ? 16 : 0);
+        wfill = wfill + OWB == (uint32_t)(OWS * OWB) ? 0u : wfill + OWB;
+        ++wnext;
+    };
+    // row j * 8 + warp's raw lane pointer (null: no member, the row is zeros)
+    auto rawp = [&](int j) -> const __nv_bfloat16* {
+        const int t = tok_sh[j * 8 + warp];
+        return t < 0 ? nullptr : x + (size_t)t * x_stride + 4 * lane;
+    };
+    // the raw rows' ring: this lane's 8 bytes of slot s (a copy issued ORD k tiles ahead of its rotation)
+    const uint32_t rbase = wbase + (uint32_t)(OWS * OWB) + (uint32_t)(warp * ORS * 256 + lane * 8);
+    auto rawcopy = [&](int slot, int j, int blk) {   // row j * 8 + warp of block blk; no member: zeros (src-size 0)
+        const __nv_bfloat16* src = rawp(j);
+        asm volatile("cp.async.ca.shared.global [%0], [%1], 8, %2;\n" ::"r"(rbase + (uint32_t)(slot * 256)), "l"(src ? src + blk * OKB : x),
+                     "r"(src ? 8 : 0));
+    };
+    auto ldsraw = [&](int slot) -> uint2 {
+        uint2 v;
+        asm volatile("ld.shared.v2.u32 {%0, %1}, [%2];\n" : "=r"(v.x), "=r"(v.y) : "r"(rbase + (uint32_t)(slot * 256)));
+        return v;
+    };
+    // the suh of the block the rotations write, two slots (a block's copy issued a block ahead by warp 0, lanes 0-15)
+    const uint32_t ubase = wbase + (uint32_t)(OWS * OWB + OW * ORS * 256);
+    const half* ush = reinterpret_cast<const half*>(smem + (ubase - sbase)) + 4 * lane;
+    auto suhcopy = [&](int blk) {
+        if (warp == 0 && lane < OSU / 16) cp16s(ubase + (uint32_t)((blk & 1) * OSU + lane * 16), suh + (size_t)e * K + blk * OKB + lane * 8, 16);
+    };
+    float acc[OTMT][NBA][4];
+#pragma unroll
+    for (int i = 0; i < OTMT; ++i)
+#pragma unroll
+        for (int j = 0; j < NBA; ++j)
+#pragma unroll
+            for (int c = 0; c < 4; ++c) acc[i][j][c] = 0.f;
+    // the raw rows of k tiles 0 .. ORD - 1's rotations (block 1, rows j * 8 + warp) and block 1's suh, with stage 0
+    const int b1 = blocks > 1 ? 1 : 0;
+#pragma unroll
+    for (int j = 0; j < ORD; ++j)
+        if (j < NBA) rawcopy(j & (ORS - 1), j, b1);
+    suhcopy(b1);
+#pragma unroll
+    for (int s = 0; s < OWS - 1; ++s) {
+        wissue();
+        cp_commit();
+    }
+    // block 0's rows, before the loop
+    const half* sg0 = suh + (size_t)e * K + 4 * lane;
+#pragma unroll
+    for (int j = 0; j < NBA; ++j) {
+        const __nv_bfloat16* src = rawp(j);
+        const uint2 raw = src ? __ldg(reinterpret_cast<const uint2*>(src)) : make_uint2(0u, 0u);
+        *reinterpret_cast<uint2*>(Xb + (size_t)(j * 8 + warp) * OXS + 4 * lane) = rot_one(raw, src != nullptr, sg0, lane);
+    }
+    const uint32_t xlane = (uint32_t)((((lane & 7) + ((lane >> 4) & 1) * 8) * OXS + ((lane >> 3) & 1) * 8) * 2);
+    const uint32_t wwarp = (uint32_t)(warp * OTMT * OTW * 4);
+    uint32_t wo[2];
+    {
+        int word, offset;
+        lane_start<8>(lane, word, offset);
+#pragma unroll
+        for (int i = 0; i < 2; ++i) wo[i] = (uint32_t)(((word + i) % OTW) * 4);
+    }
+    auto decode = [&](uint32_t tile, uint32_t (&a)[4]) { decode_a8(lds32(tile + wo[1]), lds32(tile + wo[0]), a); };
+    cp_wait<OWS - 2>();
+    __syncwarp();
+    uint32_t A[2][OTMT][4];
+#pragma unroll
+    for (int i = 0; i < OTMT; ++i) decode(wbase + wwarp + (uint32_t)(i * OTW * 4), A[0][i]);
+    uint32_t wdec = OWB;   // the slot of the k tile decoded next (k tile 1)
+    for (int b = 0; b < blocks; ++b) {
+        __syncthreads();   // block b's rows and suh are in; every warp is past block b - 1 (whose buffers block b + 1 takes)
+        const int rb = b + 1 < blocks ? b + 1 : b;   // the block this one's rotations write (the last: a dead copy)
+        half* Xn = Xb + ((b + 1) & 1) * OXH;
+        const uint32_t xb = sbase + (uint32_t)((b & 1) * OXH * 2) + xlane;
+        const half* us = ush + (rb & 1) * OKB;
+#pragma unroll
+        for (int j = 0; j < OKT; ++j) {
+            uint32_t (&Ac)[OTMT][4] = A[j & 1];
+            uint32_t (&An)[OTMT][4] = A[(j & 1) ^ 1];
+            cp_wait<OWS - 3>();   // this warp's stage kt + 1 landed, and the raw row of this k tile's rotation
+            __syncwarp();         // all its lanes' pieces; the slot the next stage takes was decoded two k tiles ago
+            {   // the raw row of k tile kt + ORD's rotation (block b3 + 1, row j3 * 8 + warp), in this k tile's group
+                const int j3 = (j + ORD) % OKT, carry = (j + ORD) / OKT;   // compile-time once unrolled
+                if (j3 < NBA) {
+                    const int b3 = b + carry + 1;
+                    rawcopy((j + ORD) & (ORS - 1), j3, b3 < blocks ? b3 : blocks - 1);
+                }
+            }
+            if (j == 0 && b + 2 < blocks) suhcopy(b + 2);   // landed, and seen by every warp, at block b + 1's barrier
+            wissue();
+            cp_commit();
+            if (j < NBA)   // the next block's row j * 8 + warp (compile-time j: no branch)
+                *reinterpret_cast<uint2*>(Xn + (size_t)(j * 8 + warp) * OXS + 4 * lane) =
+                    rot_one(ldsraw(j & (ORS - 1)), tok_sh[j * 8 + warp] >= 0, us, lane);
+            // the next k tile's A (past the last: a stale slot, decoded and never used)
+#pragma unroll
+            for (int i = 0; i < OTMT; ++i) decode(wbase + wdec + wwarp + (uint32_t)(i * OTW * 4), An[i]);
+            wdec = wdec + OWB == (uint32_t)(OWS * OWB) ? 0u : wdec + OWB;
+            const uint32_t xk = xb + (uint32_t)(j * 32);
+#pragma unroll
+            for (int jp = 0; jp < (NBA + 1) / 2; ++jp) {
+                const uint32_t xa = xk + (uint32_t)(jp * 16 * OXS * 2);
+                if (2 * jp + 1 < NBA) {
+                    uint32_t r[4];
+                    ldsm4(r, xa);
+                    const uint32_t bl[2] = {r[0], r[1]}, bh[2] = {r[2], r[3]};
+#pragma unroll
+                    for (int i = 0; i < OTMT; ++i) {
+                        mma16816(acc[i][2 * jp], Ac[i], bl);
+                        mma16816(acc[i][2 * jp + 1], Ac[i], bh);
+                    }
+                } else {
+                    uint32_t r[2];
+                    ldsm2(r, xa);
+#pragma unroll
+                    for (int i = 0; i < OTMT; ++i) mma16816(acc[i][2 * jp], Ac[i], r);
+                }
+            }
+        }
+    }
+    cp_wait<0>();
+    // the sums: S[p][col], col = (warp * 4 + i) * 16 + g (+ 8), members of the NBA blocks below the count
+    const int g = lane >> 2, t = lane & 3;
+#pragma unroll
+    for (int nb = 0; nb < NBA; ++nb) {
+        const int m0 = nb * 8 + 2 * t;
+        const int p0 = rows_sh[m0], p1 = rows_sh[m0 + 1];
+#pragma unroll
+        for (int i = 0; i < OTMT; ++i) {
+            const int col = (warp * OTMT + i) * 16 + g;
+            if (p0 >= 0) {
+                S[(size_t)p0 * ON + col] = acc[i][nb][0];
+                S[(size_t)p0 * ON + col + 8] = acc[i][nb][2];
+            }
+            if (p1 >= 0) {
+                S[(size_t)p1 * ON + col] = acc[i][nb][1];
+                S[(size_t)p1 * ON + col + 8] = acc[i][nb][3];
+            }
+        }
+    }
+}
+
+}  // namespace tf_exl3_once
+
+// Block (matrix: 0 gate, 1 up; item). S: fp32 [2][pairs][512] scratch; done: int [items], zero at launch (the caller
+// zeroes it). Dynamic shared memory: tf_exl3_once::smem_bytes(). 4-bit gate and up, N = 512.
+extern "C" __global__ void __launch_bounds__(256, 1) tf_exl3_prompt_gu_once(const __nv_bfloat16* __restrict__ x, int x_stride, int slots,
+        const uint64_t* __restrict__ Tg, const uint64_t* __restrict__ Tu, const half* __restrict__ suh_g, const half* __restrict__ suh_u,
+        const int* __restrict__ items, const int* __restrict__ counts, const int* __restrict__ members, const half* __restrict__ svh_g,
+        const half* __restrict__ svh_u, const half* __restrict__ suh_d, half* __restrict__ xd, float* __restrict__ S, int* __restrict__ done,
+        int pairs, int K, float limit, int act_mode) {
+    using namespace tf_exl3_once;
+    extern __shared__ __align__(16) unsigned char once_smem[];
+    __shared__ int rows_sh[OM], tok_sh[OM], last_sh;
+    const int mat = blockIdx.x, item = blockIdx.y;
+    if (item >= counts[0]) return;
+    const int e = items[3 * item], first = items[3 * item + 1], cnt = items[3 * item + 2];
+    if (threadIdx.x < OM) {
+        const int p = (int)threadIdx.x < cnt ? members[first + threadIdx.x] : -1;
+        rows_sh[threadIdx.x] = p;
+        tok_sh[threadIdx.x] = p < 0 ? -1 : p / slots;   // the member's token row (rot_in's p / slots)
+    }
+    __syncthreads();
+    float* Sm = S + (size_t)mat * pairs * ON;
+#define TF_EXL3_ONCE_SUMS(NBA) \
+    sums_n<NBA>(x, x_stride, mat ? Tu : Tg, mat ? suh_u : suh_g, Sm, K, once_smem, rows_sh, tok_sh, e)
+    TF_EXL3_PROMPT_NBA(cnt, TF_EXL3_ONCE_SUMS)
+#undef TF_EXL3_ONCE_SUMS
+    __threadfence();   // the sums, before the count says so
+    __syncthreads();
+    if (threadIdx.x == 0) last_sh = atomicAdd(done + item, 1);
+    __syncthreads();
+    if (last_sh != 1) return;   // the first block of the item: the second runs the epilogue
+    __threadfence();
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    for (int w = warp; w < cnt * (ON / 128); w += OW) {
+        const int i = w >> 2, cb = w & 3, p = rows_sh[i];
+        epi_member(S + (size_t)p * ON, S + ((size_t)pairs + p) * ON, p, lane, e, cb, svh_g, svh_u, suh_d, xd, ON, limit, act_mode);
+    }
+}
diff --git a/zig/src/cuda/exl3_prompt.zig b/zig/src/cuda/exl3_prompt.zig
index f00ade22b..e0f191e16 100644
--- a/zig/src/cuda/exl3_prompt.zig
+++ b/zig/src/cuda/exl3_prompt.zig
@@ -11,7 +11,9 @@ pub const tile = 64;
 /// `y` [pairs][dims] fp32 when `yrow` is 0; with `yrow` set the caller points `y` at its own slot rows ([rows][yrow][dims],
 /// pair p = row * slots + slot at row * yrow + slot) and the down kernel writes there, so no copy follows.
