+    /// Every rank's `bytes` at gathered + rank x bytes into every rank's gathered buffer, rank order (on f.stream).
+    fn gatherBytes(f: *const Forward, bytes: usize) !void {
         switch (f.exchange) {
             .local => for (f.ranks) |to| for (f.ranks) |from| {
                 if (to.w.share.rank == from.w.share.rank) continue;
@@ -266,12 +269,42 @@ pub const Forward = struct {
                 // a decode window's gathers (not a prompt chunk's) go by the mesh's RoCE writes when they fit its slot
                 if (n.mesh) |m| if (!r.b.prefill and m.fits(bytes)) return m.allGatherBytes(r.b.gathered + r.w.share.rank * bytes, r.b.gathered, bytes, f.stream.handle);
                 if (n.group) |g| return g.allGather(f.stream, r.b.gathered + r.w.share.rank * bytes, r.b.gathered, bytes);
-                const count = rows * c.hidden;
-                try n.lib.check(n.lib.api.ncclAllGather(r.b.gathered + r.w.share.rank * bytes, r.b.gathered, count, .f32, n.comm, f.stream.handle), "ncclAllGather");
+                if (bytes % 4 == 0) {
+                    try n.lib.check(n.lib.api.ncclAllGather(r.b.gathered + r.w.share.rank * bytes, r.b.gathered, bytes / 4, .f32, n.comm, f.stream.handle), "ncclAllGather");
+                } else try n.lib.check(n.lib.api.ncclAllGather(r.b.gathered + r.w.share.rank * bytes, r.b.gathered, bytes, .u8, n.comm, f.stream.handle), "ncclAllGather");
             },
         }
     }
 
+    const max_embed_ranks = 16; // in-process ranks of a local check
+
+    /// The embeddings of the R ids in r.b.ids into `out` [R][copies x D]. A column-sharded table (TF_GLM_EMBED_SHARD,
+    /// w.embed_cols): every rank embeds its columns into its slot of the gathered room, the slots are gathered (the
+    /// decode mesh for a window, the main communicator for a prompt chunk), and unblock puts them back into rows: the
+    /// same bf16 values a whole table gives.
+    pub fn embedRows(f: *const Forward, R: usize, copies: usize, outs: []const u64) !void {
+        const c = &f.ranks[0].w.config;
+        const cw = f.ranks[0].w.embed_cols;
+        if (cw == 0) {
+            for (f.ranks, outs) |r, out| try glue.embedB16(f.set(), f.stream, r.b.ids, r.w.embed, out, R, c.hidden, copies);
+            return;
+        }
+        if (copies != 1) return error.EmbedShard;
+        const sbytes = R * cw * 2;
+        for (f.ranks, outs) |r, out| {
+            _ = out;
+            if (r.w.embed_cols != cw or r.w.share.world * cw != c.hidden) return error.EmbedShard;
+            if (r.w.share.world * sbytes > r.w.share.world * r.b.rows * c.hidden * 4) return error.EmbedShard;
+            try glue.embedB16(f.set(), f.stream, r.b.ids, r.w.embed, r.b.gathered + r.w.share.rank * sbytes, R, cw, 1);
+        }
+        try f.gatherBytes(sbytes);
+        for (f.ranks, outs) |r, out| {
+            var u: cuda.Args = .{};
+            inline for (.{ r.b.gathered, out, @as(c_int, @intCast(R)), @as(c_int, @intCast(cw)), @as(c_int, @intCast(c.hidden)), @as(i64, @intCast(c.hidden)) }) |v| u.add(v);
+            try cuda.launch.launch(f.m.glue.unblock, .{ .grid = .{ .x = @intCast(R) }, .block = .{ .x = 256 } }, f.stream, &u);
+        }
+    }
+
     fn slot(r: Rank, rows: usize) u64 {
         return r.b.gathered + r.w.share.rank * rows * r.w.config.hidden * 4;
     }
@@ -503,7 +536,12 @@ pub const Forward = struct {
         const c = &f.ranks[0].w.config;
         const embed_stamp = prof_mod.span(f.prof, f.stream, .embed);
         // glm_moe_dsa keeps one residual stream (no mHC): its embedding lands in b.hidden, not the s x d x
-        for (f.ranks) |r| try glue.embedB16(f.set(), f.stream, r.b.ids, r.w.embed, if (c.dsa) r.b.hidden else r.b.x, R, c.hidden, if (c.dsa) 1 else c.hc);
+        {
+            var outs: [max_embed_ranks]u64 = undefined;
+            if (f.ranks.len > max_embed_ranks) return error.BadWindow;
+            for (f.ranks, 0..) |r, i| outs[i] = if (c.dsa) r.b.hidden else r.b.x;
+            try f.embedRows(R, if (c.dsa) 1 else c.hc, outs[0..f.ranks.len]);
+        }
         if (f.images) |im| for (f.ranks) |r| try im.v.splice(f.stream, im.slot, r.st.pos, r.st.pos + R, if (c.dsa) r.b.hidden else r.b.x, if (c.dsa) 1 else c.hc);
         embed_stamp.end();
         if (f.prof) |p| p.mark(f.stream, .embed);
@@ -817,7 +855,9 @@ pub const Forward = struct {
             if (h != r.b.hin) try f.d.check(f.d.api.cuMemcpyDtoDAsync_v2(r.b.hin, h, n * D * 2, f.stream.handle), "cuMemcpyDtoDAsync");
             const m = r.w.mtp.?;
             const b = r.b;
-            try glue.embedB16(f.set(), f.stream, b.ids, r.w.embed, b.me, n, D, 1);
+            if (r.w.embed_cols == 0) {
+                try glue.embedB16(f.set(), f.stream, b.ids, r.w.embed, b.me, n, D, 1);
+            } else if (f.ranks.len == 1) try f.embedRows(n, 1, &.{b.me}) else return error.EmbedShard; // (embedRows gathers every rank's at once)
             // the head reads each row's next token: an image's rows one place on
             if (f.images) |im| try im.v.splice(f.stream, im.slot, r.st.mtp_len + 1, r.st.mtp_len + 1 + n, b.me, 1);
             if (r.st.mtp_len == 0) try f.d.check(f.d.api.cuMemsetD8Async(b.me, 0, D * 2, f.stream.handle), "cuMemsetD8Async"); // position 0's embedding is zeroed
