diff --git a/zig/src/families/glm/cuda_forward.zig b/zig/src/families/glm/cuda_forward.zig
index ba7fee4e..ae3e5c37 100644
--- a/zig/src/families/glm/cuda_forward.zig
+++ b/zig/src/families/glm/cuda_forward.zig
@@ -253,8 +253,11 @@ pub const Forward = struct {
     fn gather(f: *const Forward, rows: usize) !void {
         const stamp = prof_mod.span(f.prof, f.stream, .all_gather);
         defer stamp.end();
-        const c = &f.ranks[0].w.config;
-        const bytes = rows * c.hidden * 4;
+        try f.gatherBytes(rows * f.ranks[0].w.config.hidden * 4);
+    }
