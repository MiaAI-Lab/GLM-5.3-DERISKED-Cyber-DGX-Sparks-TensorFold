+/// TF_GLM_EMBED_SHARD (default on; =0 keeps the whole table on every rank): glm_moe_dsa's embedding table held as
+/// column shards, D / world columns a rank, when that is a whole number of 16-byte pieces. Returns the slice width.
+/// Every rank decides alike (the recipe passes TF_* to all ranks), so every rank gathers or none does.
+pub fn embedShard(c: cfg.Config, world: usize) ?usize {
+    if (!c.dsa or world < 2 or c.hidden % world != 0 or (c.hidden / world) % 8 != 0) return null;
+    if (std.c.getenv("TF_GLM_EMBED_SHARD")) |v| if (std.mem.eql(u8, std.mem.span(v), "0")) return null;
+    return c.hidden / world;
+}
+
 /// weights.load without the MTP head: embedding, layers, final norm, the rank's head rows (bf16, MXFP8); `pack_dense`.
 pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream, tools: Tools, dir: []const u8, c: cfg.Config, share: shard.Share, layers: []const u32, heads: Heads) !Weights {
     var w: Weights = .{ .gpa = gpa, .config = c, .share = share };
@@ -819,7 +829,10 @@ pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: c
         L.inv = try L.put("glm.dsa.inv", .{});
     }
     try @import("cuda_load_ahead.zig").layers(&L, L.pfx, layers, w.layers);
-    try L.whole(try L.get("embed_tokens.weight", .{}), .bf16);
+    if (embedShard(c, share.world)) |cw| { // each rank holds its columns of the table; embeddings gathered (cuda_forward.embedRows)
+        try L.cols(try L.get("embed_tokens.weight", .{}), share.rank * cw, (share.rank + 1) * cw, .bf16);
+        w.embed_cols = cw;
+    } else try L.whole(try L.get("embed_tokens.weight", .{}), .bf16);
     w.embed = try L.put("embed", .{});
     w.norm = try L.norm("norm.weight", .{}, "norm");
     const vocab: formats.Part = .{ .rel = "lm_head", .rows = .{ share.vocab.lo, share.vocab.hi } };
diff --git a/zig/src/families/glm/dflash_block.zig b/zig/src/families/glm/dflash_block.zig
index 69e70fed..107d02b0 100644
--- a/zig/src/families/glm/dflash_block.zig
+++ b/zig/src/families/glm/dflash_block.zig
@@ -80,6 +80,21 @@ fn gather(e: anytype, buf: u64, bytes: usize) !void {
     try e.lib.check(e.lib.api.ncclAllGather(buf + e.share.rank * bytes, buf, bytes, .u8, e.comm, e.stream.handle), "ncclAllGather");
 }
 
+/// The block rows' embeddings of `ids` into out [M][d]. A column-sharded table (e.w.embed_cols, TF_GLM_EMBED_SHARD):
+/// this rank's columns into its slot of `tmp` (M x d bf16, free until the pass's first norm writes it), every rank's
+/// slots gathered, then unblocked into rows: the same values the whole table gives.
+pub fn embed(e: anytype, ids: u64, out: u64, tmp: u64, M: usize, d: usize) !void {
+    const cw = e.w.embed_cols;
+    if (cw == 0) return glue.embedB16(set(e), e.stream, ids, e.w.embed, out, M, d, 1);
+    if (cw * e.share.world != d) return error.EmbedShard;
+    const sbytes = M * cw * 2;
+    try glue.embedB16(set(e), e.stream, ids, e.w.embed, tmp + e.share.rank * sbytes, M, cw, 1);
+    try gather(e, tmp, sbytes);
+    var u: cuda.Args = .{};
+    inline for (.{ tmp, out, @as(c_int, @intCast(M)), @as(c_int, @intCast(cw)), @as(c_int, @intCast(d)), @as(i64, @intCast(d)) }) |v| u.add(v);
+    try go(e.m.glue.unblock, .{ .x = @intCast(M) }, 256, e, &u);
+}
+
 /// `N` context rows (cin, cpos, crings uploaded) through fc, the hidden norm and each layer's k, v into the rings.
 pub fn ingestPass(dr: *Drafter, e: anytype, N: usize) !void {
     try lin(dr, e, dr.cin, dr.fc, dr.c1, N, false);
@@ -112,7 +127,7 @@ fn conv(dr: *const Drafter, e: anytype, z: u64, which: i32, base: u64, out: u64,
 /// The block pass for `S` streams (tables uploaded): embed, 5 layers, norm, each rank's 16 best a row, gathered.
 pub fn pass(dr: *Drafter, e: anytype, S: usize, rank0: bool) !void {
     const M = S * BLOCK;
-    try glue.embedB16(set(e), e.stream, dr.ids, e.w.embed, dr.x, M, D, 1);
+    try embed(e, dr.ids, dr.x, dr.y, M, D); // (dr.y: the first norm's output, written next)
     for (dr.layers, 0..) |l, li| {
         // attention, wrapped in the attention conv
         try glue.rmsnorm(set(e), e.stream, dr.x, D, l.in_norm, dr.y, D, null, df.EPS, M, D);
