+/// TF_GLM_TP6_BAL (default on at world == 6; =0 disables): balances uneven TP6 shards across all 6 ranks via
+/// per-expert 384/256 EXL3 rotation, layer-rotated 11/10 MLA heads, and counter-rotated 384/320 shared experts.
+pub fn balOn(world: usize) bool {
+    if (world != 6) return false;
+    if (std.c.getenv("TF_GLM_TP6_BAL")) |v| return !std.mem.eql(u8, std.mem.span(v), "0");
+    return true;
