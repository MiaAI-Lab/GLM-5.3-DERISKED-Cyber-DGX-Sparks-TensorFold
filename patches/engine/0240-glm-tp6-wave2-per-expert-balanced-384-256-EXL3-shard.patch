+
+/// Layer `layer_idx`'s MLA head span on this rank (rotated across ranks at TP6 so every rank holds 52x11 + 26x10 heads).
+pub fn mlaSpan(c: *const Config, s: Share, layer_idx: usize) Span {
+    if (balOn(s.world) and c.mla_heads % s.world != 0) {
+        const vrank = (s.rank + (layer_idx % 3) * 2) % 6;
+        return span(c.mla_heads, 1, vrank, 6) catch s.mla;
+    }
+    return s.mla;
+}
+
+/// Layer `layer_idx`'s shared-expert span on this rank (counter-rotated vs MLA heads at TP6: ranks with 10 heads get 384).
+pub fn sharedSpan(c: *const Config, s: Share, layer_idx: usize) Span {
+    if (balOn(s.world) and (c.shared_inter / unit) % s.world != 0) {
+        const vrank = (s.rank + ((layer_idx % 3) * 2 + 2)) % 6;
+        return span(c.shared_inter, unit, vrank, 6) catch s.shared;
+    }
+    return s.shared;
