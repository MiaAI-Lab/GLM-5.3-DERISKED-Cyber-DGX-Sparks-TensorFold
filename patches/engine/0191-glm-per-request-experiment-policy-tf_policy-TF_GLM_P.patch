diff --git a/zig/src/families/glm/policy.zig b/zig/src/families/glm/policy.zig
new file mode 100644
index 000000000..3aa430a72
--- /dev/null
+++ b/zig/src/families/glm/policy.zig
@@ -0,0 +1,116 @@
+//! A request's experiment policy (TF_GLM_POLICY_REQUESTS=1): one u32 mask that picks, per request, between exact kernels
+//! every rank loaded at startup, so one boot A/B's them request by request. Rank 0 takes the mask from the request
+//! ("tf_policy"), sends it with the request's begin step (follow.Header.a) and every rank keeps it on the sequence for
+//! the whole request: nothing reads an environment or a file mid-request. Off (the default): every mask is 0 on the
+//! wire and each switch keeps its boot setting, as before. The bits and their owners: night/swift/POLICY.md.
+
+const std = @import("std");
+
+pub const Mask = u32;
+
+/// The reserved bits. A bit means "the candidate", its absence the boot's baseline path.
+pub const Bit = enum(u5) {
+    dflash2_coupled = 0, // DFlash2's drafts race under the target's keyed noise (TF_GLM_DFLASH2_COUPLED's rule), rank 0
+    router_small = 1, // small-row router kernel (1-9 rows)
+    rope_hoist = 2, // indexer query RoPE once per row
+    topk_multi_cta = 3, // multi-CTA top-2048 selection
+    owner_rows = 4, // prefill q_a/kv_a (and indexer query) on owner rows, then gather
+    qkva_bypass = 5, // a decode window's [q_a | kv_a] on the replicated projection, not the split slices
+};
+
+pub const reserved: Mask = 0x3f;
+
+/// Bits a stream uses on its own (rank 0's drafting), not in a forward: a shared forward never mixes over them.
+pub const per_stream: Mask = 1 << @backingInt(Bit.dflash2_coupled);
+
+pub fn bit(b: Bit) Mask {
+    return @as(Mask, 1) << @backingInt(b);
+}
+
+/// The one accessor every kernel site uses: whether `m` asks for bit `b`.
+pub fn on(m: Mask, b: Bit) bool {
+    return m & bit(b) != 0;
+}
+
+/// What a forward over several sequences runs: a kernel bit only where every sequence asks for it (shared verify
+/// windows, batched prompts). Exact kernels make the outputs the same either way; Boot.mixed counts such forwards.
+pub fn common(masks: []const Mask) Mask {
+    var m: Mask = std.math.maxInt(Mask);
+    for (masks) |x| m &= x;
+    return if (masks.len == 0) 0 else m;
+}
+
+/// The boot's policy settings, read once at startup (rank 0's are the ones that count: the mask crosses the wire).
+pub const Boot = struct {
+    requests: bool = false, // TF_GLM_POLICY_REQUESTS=1: a request's "tf_policy" is taken
+    default: Mask = 0, // a request without the field: TF_GLM_POLICY_DEFAULT, else bit 0 from TF_GLM_DFLASH2_COUPLED=1
+    offered: Mask = 0, // bits this boot can honour (their kernels and weights resident); the rest are dropped
+
+    pub fn read(get: *const fn ([:0]const u8) ?[]const u8) Boot {
+        var b: Boot = .{};
+        if (get("TF_GLM_POLICY_REQUESTS")) |v| b.requests = std.mem.eql(u8, v, "1");
+        if (get("TF_GLM_DFLASH2_COUPLED")) |v| if (!std.mem.eql(u8, v, "0")) {
+            b.default |= bit(.dflash2_coupled);
+        };
+        if (get("TF_GLM_POLICY_DEFAULT")) |v| b.default = parse(v) orelse b.default;
+        return b;
+    }
+
+    /// The mask a request runs with: null when requests are off (every path as the boot set it, nothing logged);
+    /// else the request's mask (or the default), less the bits this boot does not offer.
+    pub fn effective(b: Boot, asked: ?Mask) ?Mask {
+        if (!b.requests) return null;
+        return (asked orelse b.default) & b.offered & reserved;
+    }
+};
+
+/// A mask as text: decimal, or 0x hex.
+pub fn parse(text: []const u8) ?Mask {
+    const t = std.mem.trim(u8, text, " ");
+    if (std.mem.startsWith(u8, t, "0x") or std.mem.startsWith(u8, t, "0X")) return std.fmt.parseInt(Mask, t[2..], 16) catch null;
+    return std.fmt.parseInt(Mask, t, 10) catch null;
+}
+
+fn envOf(comptime pairs: anytype) *const fn ([:0]const u8) ?[]const u8 {
+    return struct {
+        fn get(name: [:0]const u8) ?[]const u8 {
+            inline for (pairs) |p| if (std.mem.eql(u8, name, p[0])) return p[1];
+            return null;
+        }
+    }.get;
+}
+
+test "GLM policy: off unless TF_GLM_POLICY_REQUESTS=1, and then the request's mask less what the boot cannot honour" {
+    const t = std.testing;
+    const off = Boot.read(envOf(.{}));
+    try t.expect(!off.requests);
+    try t.expectEqual(@as(?Mask, null), off.effective(0x21));
+    try t.expectEqual(@as(?Mask, null), off.effective(null));
+    try t.expectEqual(@as(?Mask, null), Boot.read(envOf(.{.{ "TF_GLM_POLICY_REQUESTS", "0" }})).effective(1));
+    var b = Boot.read(envOf(.{.{ "TF_GLM_POLICY_REQUESTS", "1" }}));
+    b.offered = bit(.dflash2_coupled) | bit(.qkva_bypass);
+    try t.expectEqual(@as(?Mask, 0), b.effective(null)); // no field: the default (0)
+    try t.expectEqual(@as(?Mask, 0x21), b.effective(0x21));
+    try t.expectEqual(@as(?Mask, 0x20), b.effective(0x20 | bit(.router_small) | 0x8000_0000)); // not offered: dropped
+    // the coupled env names the default arm; TF_GLM_POLICY_DEFAULT overrides it
+    var c = Boot.read(envOf(.{ .{ "TF_GLM_POLICY_REQUESTS", "1" }, .{ "TF_GLM_DFLASH2_COUPLED", "1" } }));
+    c.offered = reserved;
+    try t.expectEqual(@as(?Mask, 1), c.effective(null));
+    try t.expectEqual(@as(?Mask, 0), c.effective(0));
+    var d = Boot.read(envOf(.{ .{ "TF_GLM_POLICY_REQUESTS", "1" }, .{ "TF_GLM_DFLASH2_COUPLED", "1" }, .{ "TF_GLM_POLICY_DEFAULT", "0x20" } }));
+    d.offered = reserved;
+    try t.expectEqual(@as(?Mask, 0x20), d.effective(null));
+}
+
+test "GLM policy: the accessor, the bits' places and a shared forward's common mask" {
+    const t = std.testing;
+    try t.expectEqual(@as(Mask, 1), bit(.dflash2_coupled));
+    try t.expectEqual(@as(Mask, 0x20), bit(.qkva_bypass));
+    for (std.enums.values(Bit)) |b| try t.expect(bit(b) & reserved != 0);
+    try t.expect(on(0x21, .qkva_bypass) and on(0x21, .dflash2_coupled) and !on(0x21, .router_small));
+    try t.expectEqual(@as(Mask, 0x20), common(&.{ 0x21, 0x30 }));
+    try t.expectEqual(@as(Mask, 0), common(&.{}));
+    try t.expectEqual(@as(?Mask, 33), parse("33"));
+    try t.expectEqual(@as(?Mask, 0x21), parse("0x21"));
+    try t.expectEqual(@as(?Mask, null), parse("-1"));
+}
diff --git a/zig/src/families/glm/policy_test.zig b/zig/src/families/glm/policy_test.zig
new file mode 100644
index 000000000..aff90b1f2
--- /dev/null
+++ b/zig/src/families/glm/policy_test.zig
@@ -0,0 +1,373 @@
+//! Request policies on the host (policy.zig): the begin step's mask on every rank, the switches' off state as before,
+//! bit 5's projection choice, and DFlash2's coupled drafts per request: the reply's tokens are the target's alone
+//! (coupled or not, drafts on or off), and the drafter's keyed race is the target's own seed and positions.
+
+const std = @import("std");
+const lanes = @import("lanes");
+const policy = @import("policy.zig");
+const follow = @import("cuda_follow.zig");
+const sampler = @import("cuda_sampler.zig");
+const fw = @import("cuda_forward.zig");
+const weights = @import("cuda_weights.zig");
+const glm_lanes = @import("cuda_lanes.zig");
+const rule = @import("draft_rule.zig");
+const df = @import("dflash.zig");
+const select = @import("dflash_select.zig");
+
+const t = std.testing;
+const Header = follow.Header;
+
+/// Rank 0's begin step as it crosses (Link.send's one-broadcast path: the header's 16 words, then the ids) and as each
+/// other rank reads it back (Link.receive), bytes for bytes.
+fn crossed(h: Header, ids: []const u32) struct { h: Header, ids: [follow.put_ids]u32, n: usize } {
+    var hh = h;
+    hh.n = @intCast(ids.len);
+    var w: follow.Words = undefined;
+    @memcpy(w.w[0..16], std.mem.bytesAsSlice(u32, std.mem.asBytes(&hh)));
+    @memcpy(w.w[16..][0..ids.len], ids);
+    var wire: [follow.head_bytes]u8 = undefined;
+    @memcpy(&wire, std.mem.asBytes(&w));
+    var first: follow.Words = undefined;
+    @memcpy(std.mem.asBytes(&first), &wire);
+    var got: Header = undefined;
+    @memcpy(std.mem.asBytes(&got), std.mem.sliceAsBytes(first.w[0..16]));
+    var out: [follow.put_ids]u32 = undefined;
+    @memcpy(out[0..got.n], first.w[16..][0..got.n]);
+    return .{ .h = got, .ids = out, .n = got.n };
+}
+
+/// The begin header as Leader.beginOn built it before request policies (75e07d0c7), for the off-state comparison.
+fn headerBefore(c: ?sampler.Sampling, twins: u32) Header {
+    var h: Header = .{ .kind = @backingInt(follow.Kind.begin) };
+    h.depth = twins;
+    if (c) |v| {
+        h.flags = 1;
+        h.seed = v.seed;
+        h.temperature = v.temperature;
+        h.top_p = v.top_p;
+        h.min_p = v.min_p;
+        h.top_k = v.top_k;
+    }
+    return h;
+}
+
+test "GLM policy: the begin step carries the request's mask to every rank, and each rank begins with rank 0's sampling and mask" {
+    const samplings = [_]?sampler.Sampling{ null, .{ .seed = 0xDEAD_BEEF_0123_4567, .temperature = 0.7, .top_p = 0.95, .top_k = 20 }, .{ .seed = 7, .temperature = 1.0, .top_p = 1.0, .top_k = 0, .min_p = 0.05 } };
+    const masks = [_]policy.Mask{ 0, 1, 0x20, 0x21, 0x3f, 0xFFFF_FFFF };
+    const pages = [_]u32{ 3, 9, 27, 81 };
+    var checked: usize = 0;
+    for (samplings) |c| for (masks) |m| for ([_]u32{ 0, 2 }) |twins| {
+        const sent = follow.beginHeader(c, twins, m);
+        // every follower reads the same broadcast: four ranks, one decode each, all equal to rank 0's own values
+        for (1..4) |_| {
+            const got = crossed(sent, &pages);
+            try t.expectEqualSlices(u8, std.mem.asBytes(&sent)[8..], std.mem.asBytes(&got.h)[8..]); // past kind and n
+            try t.expectEqualSlices(u32, &pages, got.ids[0..got.n]);
+            const b = follow.beginOf(got.h);
+            try t.expectEqual(m, b.policy);
+            try t.expectEqual(c == null, b.sampling == null);
+            if (c) |v| try t.expectEqual(v, b.sampling.?);
+            checked += 1;
+        }
+    };
+    try t.expectEqual(samplings.len * masks.len * 2 * 3, checked);
+}
+
+test "GLM policy: off (no env, or no field), the begin step's bytes are the ones sent before" {
+    const samplings = [_]?sampler.Sampling{ null, .{ .seed = 42, .temperature = 0.6, .top_p = 0.9, .top_k = 40, .min_p = 0.01 } };
+    for (samplings) |c| for ([_]u32{ 0, 1, 5 }) |twins| {
+        const before = headerBefore(c, twins);
+        const now = follow.beginHeader(c, twins, 0); // Lanes.opening sends `effective orelse 0`: requests off -> 0
+        try t.expectEqualSlices(u8, std.mem.asBytes(&before), std.mem.asBytes(&now));
+    };
+    // the boot without TF_GLM_POLICY_REQUESTS: every request, with or without "tf_policy", runs null (mask 0 on the
+    // wire, coupled from TF_GLM_DFLASH2_COUPLED as before, nothing in the done line)
+    const off: policy.Boot = .{ .offered = policy.reserved };
+    for ([_]?policy.Mask{ null, 0, 1, 0x21, 0xFFFF_FFFF }) |asked| try t.expectEqual(@as(?policy.Mask, null), off.effective(asked));
+}
+
+test "GLM policy: a lane's coupled arm and calibration: its request's bit 0 with policies on, else the boot's knob" {
+    var l: glm_lanes.Lane = .{ .slot = 0 };
+    for ([_]bool{ false, true }) |env| {
+        var k: rule.Knobs = .{};
+        k.coupled = env;
+        l.policy = null; // requests off: the knob, as before
+        try t.expectEqual(env, glm_lanes.Lanes.coupledOf(&k, &l));
+        l.policy = 0;
+        try t.expect(!glm_lanes.Lanes.coupledOf(&k, &l));
+        l.policy = policy.bit(.dflash2_coupled);
+        try t.expect(glm_lanes.Lanes.coupledOf(&k, &l));
+        l.policy = policy.bit(.qkva_bypass);
+        try t.expect(!glm_lanes.Lanes.coupledOf(&k, &l));
+    }
+    // the keyed race: a sampled stream's own seed, 1 / T and top_p; greedy streams never race
+    var s: lanes.Stream = undefined;
+    s.sampling = .{ .seed = 99, .temperature = 0.5, .top_p = 0.9 };
+    const k = glm_lanes.Lanes.keyedOf(&s, true).?;
+    try t.expectEqual(@as(u64, 99), k.seed);
+    try t.expectEqual(@as(f32, 2.0), k.inv_t);
+    try t.expectEqual(@as(f32, 0.9), k.top_p);
+    try t.expect(glm_lanes.Lanes.keyedOf(&s, false) == null);
+    s.sampling = null;
+    try t.expect(glm_lanes.Lanes.keyedOf(&s, true) == null);
+    s.sampling = .{ .seed = 1, .temperature = 0 };
+    try t.expect(glm_lanes.Lanes.keyedOf(&s, true) == null);
+}
+
+test "GLM policy: bit 5 picks the replicated [q_a | kv_a] for a decode window and nothing else changes" {
+    // splitProj's rule before request policies (75e07d0c7): split unless a prompt chunk, no slice, or several ranks here
+    const before = struct {
+        fn wanted(prefill: bool, dec_n: usize, ranks: usize) bool {
+            return !(prefill or dec_n == 0 or ranks != 1);
+        }
+    }.wanted;
+    var cases: usize = 0;
+    for ([_]bool{ false, true }) |prefill| for ([_]usize{ 0, 512, 704 }) |dec_n| for ([_]usize{ 1, 2 }) |ranks| {
+        for ([_]policy.Mask{ 0, 1, 0x1e, 0x1f }) |m| { // every mask without bit 5: the old rule
+            try t.expectEqual(before(prefill, dec_n, ranks), fw.Forward.splitWanted(prefill, dec_n, ranks, m));
+            try t.expect(!fw.Forward.splitWanted(prefill, dec_n, ranks, m | policy.bit(.qkva_bypass)));
+            cases += 1;
+        }
+    };
+    try t.expectEqual(@as(usize, 48), cases);
+    // the loader's cut (qkvaSlice) is the one it made inline before, at every world size, for GLM-5.3's 2,624 rows
+    const q_lora = 2048;
+    const qkva = 2048 + 512 + 64;
+    for (1..9) |world| for (0..world) |rank| {
+        const cw_old = (qkva / 64 + world - 1) / world * 64;
+        const on_old = world >= 3 and (world - 1) * cw_old < qkva;
+        const got = weights.qkvaSlice(q_lora, qkva, world, rank);
+        try t.expectEqual(on_old, got != null);
+        const sl = got orelse continue;
+        const lo = rank * cw_old;
+        const hi = @min(qkva, lo + cw_old);
+        try t.expectEqual(lo, sl.lo);
+        try t.expectEqual(hi, sl.hi);
+        try t.expectEqual(cw_old, sl.cw);
+        var rows: usize = 0;
+        for (sl.parts[0..sl.n]) |p| rows += p.hi - p.lo;
+        try t.expectEqual(hi - lo, rows);
+        if (lo < q_lora) try t.expect(!sl.parts[0].kv and sl.parts[0].lo == lo);
+        if (hi > q_lora) try t.expect(sl.parts[sl.n - 1].kv and sl.parts[sl.n - 1].hi == hi - q_lora);
+    };
+    try t.expectEqual(@as(usize, 704), weights.qkvaSlice(q_lora, qkva, 4, 0).?.cw); // K4 at TP4: 704, 704, 704, 512
+    try t.expectEqual(@as(usize, 512), weights.qkvaSlice(q_lora, qkva, 4, 3).?.hi - weights.qkvaSlice(q_lora, qkva, 4, 3).?.lo);
+}
+
+test "GLM policy: a shared forward runs its sequences' common bits, and a stream counts the forwards it shared with another mask" {
+    try t.expectEqual(@as(policy.Mask, 0x20), policy.common(&.{ 0x21, 0x20 }));
+    try t.expectEqual(@as(policy.Mask, 0), policy.common(&.{ 0x21, 0 }));
+    try t.expectEqual(@as(policy.Mask, 0x21), policy.common(&.{0x21}));
+}
+
+// -- DFlash2 coupled drafts: exactness and the keyed race's alignment -------------------------------------------------
+
+const V: usize = 64; // the toy vocabulary
+const window: usize = df.BLOCK - 1; // a block's drafts
+
+/// The toy target's logits at sequence index `pos` after token `prev` (a Markov model keyed by both: a draft that changed
+/// the context the target reads would change its later rows); `markov` false: by position alone, so a drafter given
+/// the target's logits is an oracle whatever it picked before (the alignment check).
+var markov = true;
+fn targetLogits(out: *[V]f32, pos: usize, prev_in: u32) void {
+    const prev: u32 = if (markov) prev_in else 0;
+    var r = std.Random.DefaultPrng.init(@as(u64, pos) *% 0x9E37_79B9 ^ (@as(u64, prev) << 32) ^ 0x5eed);
+    const g = r.random();
+    for (out) |*v| v.* = @floatCast(g.floatNorm(f64) * 2.0);
+    out[(pos * 7 + prev) % V] += 3.0; // a likely token, so drafts can land
+}
+
+/// The target's token at index `pos` after `prev`: the lane core's host reference of tf_draw (gpu_full.draw: the
+/// keyed race at the absolute position, the sampler the engine runs; test-glm-sampling holds it to the GPU's).
+fn targetToken(pos: usize, prev: u32, s: ?lanes.Sampling) !u32 {
+    var l: [V]f32 = undefined;
+    targetLogits(&l, pos, prev);
+    return lanes.gpu_full.draw(t.allocator, &l, s, @intCast(pos), null);
+}
+
+const Arm = struct { coupled: bool, drafts: bool = true, noise: f64 = 0, shift: i64 = 0 };
+const Run = struct { tokens: [400]u32 = undefined, n: usize = 0, rounds: usize = 0, drafted: usize = 0, accepted: usize = 0 };
+
+/// A reply decoded the way the engine's rounds decode it: the anchor at index `n` (the committed length: Engine.draftBlock's
+/// q.pos), the drafter's 7 drafts by dflash_select.select (keyed by Lanes.keyedOf when coupled), the verify window's row r
+/// drawn at n + 1 + r (Engine.verify: `at + 1`), its drafts kept to the first miss plus the target's token there.
+/// `shift` moves the drafter's key position (a misaligned drafter, for the control).
+fn decode(dr: *df.Drafter, prompt_last: u32, prompt_len: usize, s: ?lanes.Sampling, arm: Arm, len: usize) !Run {
+    var out: Run = .{};
+    var noise = std.Random.DefaultPrng.init(0xd1f7);
+    var stream: lanes.Stream = undefined;
+    stream.sampling = s;
+    const keyed = glm_lanes.Lanes.keyedOf(&stream, arm.coupled);
+    var n = prompt_len; // the first reply token's index: keyed at the prompt length (the lane core's first())
+    var anchor = try targetToken(n, prompt_last, s);
+    out.tokens[0] = anchor;
+    out.n = 1;
+    while (out.n < len) {
+        out.rounds += 1;
+        var drafts: [window]u32 = undefined;
+        var k: usize = 0;
+        if (arm.drafts) {
+            // the drafter's block rows: each row t's candidates are the target's logits one step down the drafter's own
+            // greedy chain (a block pass sees the anchor, not its picks), with optional noise: 16 best by value
+            var prev = anchor;
+            for (1..df.BLOCK) |tt| {
+                var l: [V]f32 = undefined;
+                targetLogits(&l, n + tt, prev);
+                for (&l) |*v| v.* += @floatCast(noise.random().floatNorm(f64) * arm.noise);
+                var order: [V]u32 = undefined;
+                for (&order, 0..) |*o, i| o.* = @intCast(i);
+                std.mem.sort(u32, &order, &l, struct {
+                    fn more(w: *const [V]f32, a: u32, b: u32) bool {
+                        return w[a] > w[b] or (w[a] == w[b] and a < b);
+                    }
+                }.more);
+                const blk = dr.cand[tt * df.CW ..][0..df.CW];
+                for (0..df.TOPK) |j| {
+                    blk[j] = @intCast(order[j]);
+                    blk[df.TOPK + j] = @bitCast(l[order[j]]);
+                }
+                prev = order[0];
+            }
+            var probs: [window]f64 = undefined;
+            const q: df.Req = .{ .slot = 0, .pos = @intCast(@as(i64, @intCast(n)) + arm.shift), .n = 0, .anchor = anchor, .out = &drafts, .probs = &probs, .keyed = keyed };
+            select.select(dr, 0, df.BLOCK, q);
+            k = window;
+        }
+        // the verify window: rows [anchor, d1..dk]; row r's draw is the token at index n + 1 + r after row r's input
+        var landed: usize = 0;
+        var prev = anchor;
+        var r: usize = 0;
+        while (true) : (r += 1) {
+            const tok = try targetToken(n + 1 + r, prev, s);
+            if (out.n < len) {
+                out.tokens[out.n] = tok;
+                out.n += 1;
+            }
+            if (r < k and drafts[r] == tok) {
+                landed += 1;
+                prev = tok;
+                continue;
+            }
+            anchor = tok;
+            break;
+        }
+        out.drafted += k;
+        out.accepted += landed;
+        n += landed + 1;
+    }
+    return out;
+}
+
+fn drafter(gpa: std.mem.Allocator) !df.Drafter {
+    var dr: df.Drafter = .{ .gpa = gpa, .d = undefined, .module = undefined, .k = undefined, .weights = undefined, .split = false, .ff = df.FF, .rank = 0, .world = 1 };
+    dr.pred = try gpa.alloc(u16, V * df.RANK);
+    dr.succ = try gpa.alloc(u16, V * df.RANK);
+    @memset(dr.pred, 0); // no codebook pull: a draft is its candidate's value (and the keyed noise when coupled)
+    @memset(dr.succ, 0);
+    dr.gh = try gpa.alloc(f32, df.BLOCK * df.RANK);
+    @memset(dr.gh, 0);
+    dr.cand = try gpa.alloc(i32, df.BLOCK * df.CW);
+    @memset(dr.cand, -1);
+    return dr;
+}
+
+fn freeDrafter(gpa: std.mem.Allocator, dr: *df.Drafter) void {
+    gpa.free(dr.pred);
+    gpa.free(dr.succ);
+    gpa.free(dr.gh);
+    gpa.free(dr.cand);
+}
+
+test "GLM policy: the drafter's keyed noise is the target's (sample.cu's race_uniform, bit for bit)" {
+    var r = std.Random.DefaultPrng.init(17);
+    for (0..200_000) |_| {
+        const seed = r.random().int(u64);
+        const pos = r.random().int(u32);
+        const id = r.random().uintLessThan(u32, df.VOCAB);
+        try t.expectEqual(@as(u32, @bitCast(lanes.gpu_full.raceUniform(seed, pos, id))), @as(u32, @bitCast(select.uniform(seed, pos, id))));
+    }
+}
+
+test "GLM policy: DFlash2 coupled or not, drafts on or off, a sampled reply's tokens are the target's alone" {
+    const gpa = t.allocator;
+    var dr = try drafter(gpa);
+    defer freeDrafter(gpa, &dr);
+    const len = 400;
+    const samplings = [_]?lanes.Sampling{
+        null, // greedy: no keyed race either way
+        .{ .seed = 1234, .temperature = 1.0, .top_k = 0, .top_p = 0.95 },
+        .{ .seed = 0xFEED_FACE_CAFE_0001, .temperature = 0.7, .top_k = 20, .top_p = 0.9 },
+        .{ .seed = 5, .temperature = 1.0, .top_k = 0, .top_p = 1.0, .min_p = 0.02 },
+    };
+    markov = true;
+    for (samplings) |s| {
+        const serial = try decode(&dr, 11, 37, s, .{ .coupled = false, .drafts = false }, len);
+        try t.expectEqual(@as(usize, len), serial.n);
+        for ([_]f64{ 0, 1.0 }) |noise| for ([_]bool{ false, true }) |coupled| for ([_]i64{ 0, 1 }) |shift| {
+            const run = try decode(&dr, 11, 37, s, .{ .coupled = coupled, .noise = noise, .shift = shift }, len);
+            try t.expectEqualSlices(u32, serial.tokens[0..len], run.tokens[0..len]); // exact: the target's tokens only
+            try t.expect(run.rounds < serial.rounds); // drafts landed
+        };
+    }
+}
+
+test "GLM policy: coupled drafts land only at the target's own positions (a drafter keyed one off lands as an uncoupled one)" {
+    const gpa = t.allocator;
+    var dr = try drafter(gpa);
+    defer freeDrafter(gpa, &dr);
+    const s: lanes.Sampling = .{ .seed = 77, .temperature = 1.0, .top_k = 0, .top_p = 1.0 };
+    const len = 400;
+    markov = false;
+    defer markov = true;
+    const serial = try decode(&dr, 3, 50, s, .{ .coupled = false, .drafts = false }, len);
+    var acc: [4]f64 = undefined;
+    for ([_]Arm{ .{ .coupled = true }, .{ .coupled = false }, .{ .coupled = true, .shift = 1 }, .{ .coupled = true, .shift = -1 } }, &acc) |arm, *a| {
+        const run = try decode(&dr, 3, 50, s, arm, len);
+        try t.expectEqualSlices(u32, serial.tokens[0..len], run.tokens[0..len]); // misaligned or not: still exact
+        a.* = @as(f64, @floatFromInt(run.accepted)) / @as(f64, @floatFromInt(run.drafted));
+    }
+    // with the target's own logits as the drafter's (top_p 1: the drafter's 16 hold nearly all the mass), the aligned
+    // race picks the target's token wherever it is among them; one position off it is an independent draw
+    std.debug.print("coupled alignment (oracle drafter, T 1, top_p 1): coupled {d:.3}, uncoupled {d:.3}, keyed +1 {d:.3}, keyed -1 {d:.3}\n", .{ acc[0], acc[1], acc[2], acc[3] });
+    try t.expect(acc[0] > 0.5 and acc[0] > 4 * acc[1]); // a chain lands to its first miss: ~0.9 a draft (the 16 miss ~1 in 10)
+    try t.expect(acc[2] < acc[0] - 0.3 and acc[3] < acc[0] - 0.3);
+    try t.expect(@abs(acc[2] - acc[1]) < 0.15);
+}
+
+test "GLM policy: each arm learns its own landing rates (greedy, sampled, coupled sampled)" {
+    const k: rule.Knobs = .{};
+    var l: glm_lanes.Lane = .{ .slot = 0 };
+    // policies off and TF_GLM_DFLASH2_COUPLED off: sampled streams feed calibration 1 as before; on: calibration 2,
+    // which starts from the same prior, so a boot with one arm runs the rates it ran before
+    const L = glm_lanes.Lanes;
+    l.policy = null;
+    try t.expectEqual(@as(usize, 1), L.armOf(true, L.coupledOf(&k, &l)));
+    try t.expectEqual(@as(usize, 0), L.armOf(false, L.coupledOf(&k, &l)));
+    l.policy = 1;
+    try t.expectEqual(@as(usize, 2), L.armOf(true, L.coupledOf(&k, &l)));
+    try t.expectEqual(@as(usize, 0), L.armOf(false, L.coupledOf(&k, &l)));
+    l.policy = 0;
+    try t.expectEqual(@as(usize, 1), L.armOf(true, L.coupledOf(&k, &l)));
+}
+
+test "GLM policy: a shared round counts a forward as mixed only when its streams' kernel bits differ" {
+    var s: [2]lanes.Stream = undefined;
+    var l: [2]glm_lanes.Lane = .{ .{ .slot = 0 }, .{ .slot = 1 } };
+    const held = [_]*glm_lanes.Lane{ &l[0], &l[1] };
+    var w: [2]lanes.backend.Window = undefined;
+    for (&w, &s) |*x, *y| x.stream = y;
+    const cases = [_]struct { a: ?policy.Mask, b: ?policy.Mask, mixed: u32 }{
+        .{ .a = null, .b = null, .mixed = 0 }, // requests off: never counted
+        .{ .a = 0x20, .b = 0x20, .mixed = 0 },
+        .{ .a = 0x21, .b = 0x20, .mixed = 0 }, // bit 0 is each stream's own drafting
+        .{ .a = 0x20, .b = 0x00, .mixed = 1 },
+        .{ .a = 0x01, .b = 0x21, .mixed = 1 },
+    };
+    for (cases) |c| {
+        for (&s) |*x| x.policy_mixed = 0;
+        l[0].policy = c.a;
+        l[1].policy = c.b;
+        glm_lanes.Lanes.mixedPolicies(&w, &held);
+        for (s) |x| try t.expectEqual(c.mixed, x.policy_mixed);
+    }
+}
