diff --git a/zig/tests/cuda/glm_qkva_split_bits.zig b/zig/tests/cuda/glm_qkva_split_bits.zig
new file mode 100644
index 000000000..e0323f45d
--- /dev/null
+++ b/zig/tests/cuda/glm_qkva_split_bits.zig
@@ -0,0 +1,129 @@
+//! `glm-qkva-split-bits <ckpt>`: TF_GLM_DSA_SPLIT_QKVA's slices against the replicated [q_a | kv_a], bit for bit.
+//! A decode window's projection runs on the replicated weight (TF_GLM_DSA_SPLIT_QKVA=0, or request policy bit 5) or on
+//! each rank's slice (the default); both are packed from the checkpoint as the loader packs them (the slices by
+//! cuda_weights.qkvaSlice) and run through the forward's own call (qlinear decode, bf16 out). Every output of every
+//! rank's slice must equal the replicated projection's same column in every row count a window takes (1-32), so a
+//! request may pick either path and get the other's bits. Two controls show the comparison sees a difference.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+const reference = @import("quant_ref_tests.zig");
+const Rig = reference.RigT;
+const fp8pb = glm.weights.formats.fp8pb;
+
+const max_rows = 32; // shared windows' rows (cuda_engine.shared_rows), a lone window's at most
+
+/// `parts` packed for the lane (cuda_formats.fp8g's packing) and uploaded.
+fn upload(r: *Rig, parts: []const fp8pb.Share) !cuda.qmmf.Weight {
+    const z = try fp8pb.sizes(parts);
+    const codes = try r.a.alloc(u8, z.codes);
+    const tiles = try r.a.alloc(f32, z.scales);
+    try fp8pb.pack(r.a, parts, codes, tiles);
+    return cuda.fp8.weight(try r.dev(codes), try r.dev(std.mem.sliceAsBytes(tiles)), z.n, z.k);
+}
+
+/// x [m][k] times `w` as cuda_proj.matmul runs a block-FP8 projection: the lane's decode, bf16 out; host copy.
+fn project(r: *Rig, lane: *const cuda.qmmf.Lane, w: cuda.qmmf.Weight, x: u64, m: usize, out: []u16) !void {
+    var y = try cuda.DeviceBuffer.alloc(r.gpu.d, m * w.n * 2);
+    defer {
+        cuda.completion.drain(r.gpu.d, r.s, "qkva split output released before completion");
+        y.free();
+    }
+    try y.fill8(0xff, r.s.handle);
+    if (lane.partBytes(m, w) != 0) return error.SlicePartialsNotHeld;
+    const linear: cuda.qlinear.Linear = .{ .lane = lane };
+    try linear.decode(r.s, .{ .fp8g = w }, .{ .x = x, .ldx = w.k }, y.ptr, m);
+    try r.s.synchronize();
+    try y.download(0, std.mem.sliceAsBytes(out[0 .. m * w.n]));
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, try std.fs.path.join(a, &.{ dir, "config.json" }), a, .limited(1 << 24));
+    const c = try glm.config.parse(gpu.gpa, text);
+    const qkva: usize = c.q_lora + c.kv_lora + c.rope;
+    var ck = try core.Checkpoint.openModel(gpu.gpa, gpu.io, dir);
+    defer ck.close();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0x9ca_5b17);
+    var r: Rig = .{ .gpu = gpu, .a = a, .s = s, .rng = prng.random() };
+    defer {
+        cuda.completion.drain(gpu.d, s, "qkva split inputs released before completion");
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var lane = try cuda.qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+    defer lane.unload();
+    const D: usize = c.hidden;
+    // the decode window's normed rows: bf16 [32][hidden], one draw for every check
+    const x_host = try r.bfs(max_rows * D, 1.0);
+    const x = try r.dev(std.mem.sliceAsBytes(x_host));
+    var x_bump = try r.a.dupe(u16, x_host);
+    x_bump[5] ^= 1; // one input's last mantissa bit: a control
+    const xb = try r.dev(std.mem.sliceAsBytes(x_bump));
+    const full_out = try r.a.alloc(u16, max_rows * qkva);
+    const bump_out = try r.a.alloc(u16, max_rows * qkva);
+    const part_out = try r.a.alloc(u16, max_rows * qkva);
+    var outputs: usize = 0;
+    var layers_seen: usize = 0;
+    var shift_misses: usize = 0;
+    var bump_misses: usize = 0;
+    for ([_]u32{ 3, 40, 77 }) |layer| {
+        var nb: [128]u8 = undefined;
+        var kb: [128]u8 = undefined;
+        const q_name = try std.fmt.bufPrint(&nb, "model.layers.{d}.self_attn.q_a_proj", .{layer});
+        const kv_name = try std.fmt.bufPrint(&kb, "model.layers.{d}.self_attn.kv_a_proj_with_mqa", .{layer});
+        const qa = fp8pb.Fp8pb.read(gpu.gpa, &ck, q_name) catch |err| {
+            std.debug.print("layer {d}: {s} not in the checkpoint ({s}); skipped\n", .{ layer, q_name, @errorName(err) });
+            continue;
+        };
+        defer qa.deinit(gpu.gpa);
+        const kva = try fp8pb.Fp8pb.read(gpu.gpa, &ck, kv_name);
+        defer kva.deinit(gpu.gpa);
+        try check.expect(qa.n == c.q_lora and kva.n == c.kv_lora + c.rope and qa.k == D, "layer {d}: q_a {d} x {d}, kv_a {d}", .{ layer, qa.n, qa.k, kva.n });
+        layers_seen += 1;
+        // the replicated projection as cutProj packs [q_a | kv_a] whole
+        const full = try upload(&r, &.{ .{ .p = &qa, .lo = 0, .hi = qa.n, .klo = 0, .khi = D }, .{ .p = &kva, .lo = 0, .hi = kva.n, .klo = 0, .khi = D } });
+        for ([_]usize{ 3, 4, 6 }) |world| for (0..world) |rank| {
+            const sl = glm.weights.qkvaSlice(c.q_lora, qkva, world, rank) orelse return error.NoSlice;
+            var parts: [2]fp8pb.Share = undefined;
+            for (sl.parts[0..sl.n], parts[0..sl.n]) |q, *p| p.* = .{ .p = if (q.kv) &kva else &qa, .lo = q.lo, .hi = q.hi, .klo = 0, .khi = D };
+            const w = try upload(&r, parts[0..sl.n]);
+            const n = sl.hi - sl.lo;
+            for (1..max_rows + 1) |m| {
+                try project(&r, &lane, full, x, m, full_out);
+                try project(&r, &lane, w, x, m, part_out);
+                var bad: usize = 0;
+                for (0..m) |row| for (0..n) |col| {
+                    if (full_out[row * qkva + sl.lo + col] != part_out[row * n + col]) bad += 1;
+                };
+                try check.expect(bad == 0, "layer {d} TP{d} rank {d} rows {d}: {d} of {d} outputs differ from the replicated projection", .{ layer, world, rank, m, bad, m * n });
+                outputs += m * n;
+                // control 1: the slice against the replicated columns one 64-row unit over must differ
+                if (sl.lo >= 64) {
+                    var miss: usize = 0;
+                    for (0..m) |row| for (0..n) |col| {
+                        if (full_out[row * qkva + sl.lo - 64 + col] != part_out[row * n + col]) miss += 1;
+                    };
+                    if (miss > 0) shift_misses += 1 else return error.ControlBlind;
+                }
+                // control 2: one input bit flipped moves some outputs of row 0
+                if (rank == 0 and m == 1) {
+                    try project(&r, &lane, full, xb, 1, bump_out);
+                    var miss: usize = 0;
+                    for (0..qkva) |col| {
+                        if (bump_out[col] != full_out[col]) miss += 1;
+                    }
+                    if (miss > 0) bump_misses += 1 else return error.ControlBlind;
+                }
+            }
+        };
+    }
+    try check.expect(layers_seen > 0, "no layer's [q_a | kv_a] in {s}", .{dir});
+    check.pass("glm-qkva-split-bits: {d} layers, TP3/4/6 every rank, rows 1-32: all {d} slice outputs equal the replicated projection's bits; controls differ ({d} shifted, {d} bumped)", .{ layers_seen, outputs, shift_misses, bump_misses });
+}
