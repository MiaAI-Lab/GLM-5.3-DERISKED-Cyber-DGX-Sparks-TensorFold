diff --git a/zig/src/families/glm/swift_krn_gpu_test.zig b/zig/src/families/glm/swift_krn_gpu_test.zig
new file mode 100644
index 000000000..239b41f4a
--- /dev/null
+++ b/zig/src/families/glm/swift_krn_gpu_test.zig
@@ -0,0 +1,141 @@
+//! SW-KRN's GPU check of glm_moe_dsa's decode select through sparse.dsaSelect itself (the engine's launches and
+//! arguments): with policy bits 2 and 3 set (rope_hoist, topk_multi_cta) the scores, token lists and counts are the
+//! bytes of the pass with them clear, and the queries stay unroped. Skipped unless TF_KRN_GPU names
+//! a directory holding glm_glue.fatbin and glm_ops.fatbin built from this tree (a GPU host only).
+const std = @import("std");
+const cuda = @import("cuda");
+const glue = @import("cuda_glue.zig");
+const sparse = @import("cuda_sparse.zig");
+const policy = @import("policy.zig");
+
+const H = 32;
+const D = 128;
+const cap = 245760;
+const max_rows = 16;
+
+fn bf16(f: f32) u16 {
+    const u: u32 = @bitCast(f);
+    return @truncate((u + 0x7FFF + ((u >> 16) & 1)) >> 16);
+}
+
+const Dev = struct {
+    d: *const cuda.Driver,
+    fn alloc(x: Dev, bytes: usize) !u64 {
+        var p: u64 = 0;
+        try x.d.check(x.d.api.cuMemAlloc_v2(&p, bytes), "cuMemAlloc");
+        return p;
+    }
+    fn put(x: Dev, dst: u64, src: []const u8) !void {
+        try x.d.check(x.d.api.cuMemcpyHtoD_v2(dst, src.ptr, src.len), "cuMemcpyHtoD");
+    }
+    fn get(x: Dev, dst: []u8, src: u64) !void {
+        try x.d.check(x.d.api.cuMemcpyDtoH_v2(dst.ptr, src, dst.len), "cuMemcpyDtoH");
+    }
+    /// On the test's stream (a non-blocking stream: a legacy-stream memset would race its kernels).
+    fn fill(x: Dev, st: cuda.Stream, dst: u64, byte: u8, n: usize) !void {
+        try x.d.check(x.d.api.cuMemsetD8Async(dst, byte, n, st.handle), "cuMemsetD8Async");
+    }
+};
+
+test "GLM swift KRN GPU: dsaSelect with the candidates on gives the bytes of it with them off" {
+    const dir = std.c.getenv("TF_KRN_GPU") orelse return error.SkipZigTest;
+    const gpa = std.testing.allocator;
+    var drv = try cuda.Driver.open();
+    var ctx = try cuda.Context.init(&drv, 0);
+    defer ctx.deinit();
+    const x: Dev = .{ .d = &drv };
+    var mods: [2]cuda.Module = undefined;
+    for ([_][]const u8{ "glm_glue.fatbin", "glm_ops.fatbin" }, 0..) |name, i| {
+        const path = try std.fmt.allocPrint(gpa, "{s}/{s}", .{ std.mem.span(dir), name });
+        defer gpa.free(path);
+        const image = try std.Io.Dir.cwd().readFileAllocOptions(std.testing.io, path, gpa, .limited(1 << 28), .@"16", null);
+        defer gpa.free(image);
+        mods[i] = try cuda.Module.load(&drv, image);
+    }
+    const kern = try glue.Kernels.load(mods[0]);
+    const base: glue.Set = .{ .glue = &kern };
+    var stream = try cuda.Stream.init(&drv, true);
+    defer stream.deinit();
+
+    var prng = std.Random.DefaultPrng.init(0x5eed);
+    const rnd = prng.random();
+    const qi_bytes = max_rows * H * D * 2;
+    const qi = try x.alloc(qi_bytes);
+    const kw = try x.alloc(max_rows * (D + H) * 2);
+    const ik = try x.alloc(cap * D * 2);
+    const inv = try x.alloc(32 * 4);
+    const pos = try x.alloc(4);
+    const s: sparse.Scratch = .{ .scores = try x.alloc(max_rows * cap * 4), .ls = try x.alloc(sparse.bitsBytes(max_rows, cap)), .li = try x.alloc(max_rows * 4096), .pools = try x.alloc(max_rows * 4096), .at = try x.alloc(4), .bits_rows = max_rows, .qr = try x.alloc(qi_bytes) };
+    const tokens = try x.alloc(max_rows * sparse.dsa_width * 4);
+    const counts = try x.alloc(max_rows * 4);
+
+    const q_host = try gpa.alloc(u16, max_rows * H * D);
+    defer gpa.free(q_host);
+    const kw_host = try gpa.alloc(u16, max_rows * (D + H));
+    defer gpa.free(kw_host);
+    const keys = try gpa.alloc(u16, cap * D);
+    defer gpa.free(keys);
+    for (q_host) |*v| v.* = bf16(rnd.floatNorm(f32));
+    for (kw_host) |*v| v.* = bf16(rnd.floatNorm(f32) * 0.5);
+    var freqs: [32]f32 = undefined;
+    for (&freqs, 0..) |*f, i| f.* = std.math.pow(f32, 10000.0, -2.0 * @as(f32, @floatFromInt(i)) / 64.0);
+    try x.put(qi, std.mem.sliceAsBytes(q_host));
+    try x.put(kw, std.mem.sliceAsBytes(kw_host));
+    try x.put(inv, std.mem.sliceAsBytes(&freqs));
+
+    const out_scores = try gpa.alloc(u8, max_rows * cap * 4);
+    defer gpa.free(out_scores);
+    const ref_scores = try gpa.alloc(u8, max_rows * cap * 4);
+    defer gpa.free(ref_scores);
+    var out_tok: [max_rows * sparse.dsa_width * 4]u8 = undefined;
+    var ref_tok: [max_rows * sparse.dsa_width * 4]u8 = undefined;
+    var out_cnt: [max_rows * 4]u8 = undefined;
+    var ref_cnt: [max_rows * 4]u8 = undefined;
+    const q_after = try gpa.alloc(u8, qi_bytes);
+    defer gpa.free(q_after);
+
+    const lens = [_]usize{ 2047, 2049, 8193, 12288, 24576, 30000, 60000, 100000, 200000, 245760 };
+    const rows_set = [_]usize{ 1, 2, 3, 4, 5, 6, 9, 16 };
+    var cases: usize = 0;
+    var hoisted: usize = 0;
+    var multi: usize = 0;
+    for (0..2) |kind| { // 0: random keys; 1: every 3rd key a copy of key 5 (equal scores, ties at the floor)
+        for (keys) |*v| v.* = bf16(rnd.floatNorm(f32));
+        if (kind == 1) {
+            var p: usize = 0;
+            while (p < cap) : (p += 3) @memcpy(keys[p * D ..][0..D], keys[5 * D ..][0..D]);
+        }
+        try x.put(ik, std.mem.sliceAsBytes(keys));
+        for (lens) |len| for (rows_set) |rows| {
+            if (rows > len) continue;
+            const host_pos = len - rows;
+            const np = len;
+            const p32: i32 = @intCast(host_pos);
+            try x.put(pos, std.mem.asBytes(&p32));
+            for (0..2) |on| {
+                var set = base;
+                set.policy = if (on == 1) policy.bit(.rope_hoist) | policy.bit(.topk_multi_cta) else 0;
+                try x.fill(stream, s.scores, 0x7B, rows * np * 4);
+                try x.fill(stream, tokens, 0xA5, max_rows * sparse.dsa_width * 4);
+                try x.fill(stream, counts, 0xA5, max_rows * 4);
+                try x.fill(stream, s.qr, 0xEE, qi_bytes);
+                try x.fill(stream, s.ls, 0xC3, sparse.bitsBytes(max_rows, cap));
+                try sparse.dsaSelect(set, mods[1], stream, qi, kw + D * 2, inv, ik, pos, host_pos, rows, H, D, s, tokens, counts, null, null);
+                try stream.synchronize();
+                try x.get((if (on == 1) out_scores else ref_scores)[0 .. rows * np * 4], s.scores);
+                try x.get((if (on == 1) &out_tok else &ref_tok)[0 .. rows * sparse.dsa_width * 4], tokens);
+                try x.get((if (on == 1) &out_cnt else &ref_cnt)[0 .. rows * 4], counts);
+            }
+            try x.get(q_after, qi);
+            try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(q_host), q_after); // qi left unroped
+            try std.testing.expectEqualSlices(u8, ref_scores[0 .. rows * np * 4], out_scores[0 .. rows * np * 4]);
+            try std.testing.expectEqualSlices(u8, ref_tok[0 .. rows * sparse.dsa_width * 4], out_tok[0 .. rows * sparse.dsa_width * 4]);
+            try std.testing.expectEqualSlices(u8, ref_cnt[0 .. rows * 4], out_cnt[0 .. rows * 4]);
+            cases += 1;
+            if (sparse.hoistLoop(true, rows, np, host_pos + rows - 1) != null) hoisted += 1;
+            if (sparse.topkMulti(true, np, rows, s.bits_rows)) multi += 1;
+        };
+    }
+    std.debug.print("GLM swift KRN GPU: {d} cases identical (scores, lists, counts, qi), {d} hoisted, {d} multi-CTA top-k\n", .{ cases, hoisted, multi });
+    try std.testing.expect(hoisted > 0 and multi > 0);
+}
