diff --git a/zig/kernels/cuda/glm_dsa_topk_multi.cuh b/zig/kernels/cuda/glm_dsa_topk_multi.cuh
new file mode 100644
index 000000000..46d59e8b1
--- /dev/null
+++ b/zig/kernels/cuda/glm_dsa_topk_multi.cuh
@@ -0,0 +1,188 @@
+// glm_moe_dsa's top-2048 of a decode window's long rows on many CTAs (TF_GLM_DSA_TOPK_MULTI, swift policy bit 3):
+// tf_glm_dsa_topk's token lists and counts, bit for bit. The scheme of tf_glm_dsel_scan / tf_glm_dsel_merge (patch
+// 0067, glm_index_decode.cuh) over glm_moe_dsa's per-token keys: no pools, each row's range its own visible tokens
+// [0, max(pos + r + 1, K)) clipped to np (tf_glm_dsa_topk's limit, not Flash's visible / 4).
+// tf_glm_dsa_tscan: every CTA of a row takes the same floor (the need-th best of 4,096 evenly sampled keys, need the
+// target's share of them: speed only) and marks its span's tokens above it (gt) and equal to it (eq) as bit words.
+// tf_glm_dsa_tmerge, a CTA a row, from the exact counts of those words:
+//   - fewer than K above the floor and at least K at or above it: the K-th best key is the floor itself, so the picks
+//     are every gt token and the first K - |gt| eq tokens in position order (no select);
+//   - at most CAP candidates (gt and eq, or gt alone when it holds K): the radix select over them (select_core);
+//   - otherwise (the floor overshot, or far too many above it): the radix select over the whole row (the fallback:
+//     tf_glm_dsa_topk's own computation on one CTA).
+// Every path emits the K best keys (sparse._order_key: -0 as +0), ties to the lower position, positions ascending, and
+// the count K past the all-visible prefix, 0 within it. Rows of at most CAP tokens are selected whole by the merge.
+#pragma once
+
+#include "glm_index_decode.cuh"
+
+namespace glm_dsa_multi {
+
+constexpr int CAP = 8192;  // candidates the merge holds (dynamic shared memory: key and position each)
+
+struct Merge {
+  uint32_t key[CAP];
+  int idx[CAP];
+  glm_dsel::Sel<glm_dsel::T2> sel;
+};
+static_assert(sizeof(Merge) == 8192 * 8 + 1288, "cuda_glue.dsa_tmerge_smem");
+
+// Row r's selection range [0, NP): its visible tokens, at least K, at most np (tf_glm_dsa_topk's limit).
+__device__ __forceinline__ int row_limit(int64_t np, const int* pos, int64_t r, int K) {
+  const int64_t vis = (int64_t)pos[0] + r + 1;
+  return (int)min(np, max(vis, (int64_t)K));
+}
+
+}  // namespace glm_dsa_multi
+
+// Scores [R][np] fp32; grid (cdiv(the last row's NP, SPAN), R). Row r's gt and eq bit words at bits[r][0][..] and
+// bits[r][1][..] (words a part; bit b of word w is token 32 w + b). Rows of NP <= CAP mark nothing (the merge takes
+// them whole); each CTA writes only its span's words below its row's NP.
+extern "C" __global__ void __launch_bounds__(glm_dsel::T1)
+    tf_glm_dsa_tscan(const float* __restrict__ S, int64_t np, const int* __restrict__ pos, int K, int target,
+                     uint32_t* __restrict__ bits, int64_t words) {
+  using namespace glm_dsel;
+  __shared__ int hist[256];
+  __shared__ uint32_t sh_prefix;
+  __shared__ int sh_need;
+  const int64_t r = blockIdx.y;
+  const int NP = glm_dsa_multi::row_limit(np, pos, r, K);
+  const int64_t p0 = (int64_t)blockIdx.x * SPAN;
+  if (NP <= glm_dsa_multi::CAP || p0 >= NP) return;
+  const float* row = S + r * np;
+  const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+  // The floor: the need-th largest of the sampled keys. Speed only: the merge's counts decide.
+  constexpr int PT = NS8 / T1;
+  uint32_t u[PT];
+#pragma unroll
+  for (int j = 0; j < PT; ++j) {
+    const int s = t + j * T1;
+    const int64_t i = (int64_t)(s / 8) * NP / (NS8 / 8) / 8 * 8 + s % 8;
+    u[j] = order_key(i < NP ? row[i] : 0.0f);
+  }
+  uint32_t prefix = 0, fixed = 0;
+  int need = max((int)((int64_t)target * NS8 / NP), 1);
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    hist[t] = 0;  // T1 == 256 bins
+    __syncthreads();
+#pragma unroll
+    for (int j = 0; j < PT; ++j) hist_add(hist, (u[j] & fixed) == prefix ? (int)((u[j] >> shift) & 0xFF) : 256);
+    __syncthreads();
+    if (warp == 0) digit_of(hist, need, prefix, shift, &sh_prefix, &sh_need);
+    __syncthreads();
+    prefix = sh_prefix;
+    need = sh_need;
+    fixed |= 0xFFu << shift;
+  }
+  const uint32_t lo = prefix;
+  // The span's words, a warp's every 8th: its tokens above and at the floor.
+  constexpr int WARPS = T1 / 32, WPW = SPAN / 32 / WARPS;
+  const int64_t w0 = p0 / 32;
+  const int nwc = (int)min((int64_t)(SPAN / 32), ((int64_t)NP + 31) / 32 - w0);
+  float v[WPW];
+#pragma unroll
+  for (int m = 0; m < WPW; ++m) {
+    const int wi = warp + m * WARPS;
+    const int64_t i = (w0 + wi) * 32 + lane;
+    v[m] = wi < nwc && i < NP ? row[i] : 0.0f;
+  }
+  uint32_t* gt = bits + r * 2 * words;
+#pragma unroll
+  for (int m = 0; m < WPW; ++m) {
+    const int wi = warp + m * WARPS;
+    const int64_t i = (w0 + wi) * 32 + lane;
+    const bool in = wi < nwc && i < NP;
+    const uint32_t k = order_key(v[m]);
+    const unsigned g = __ballot_sync(0xffffffffu, in && k > lo), e = __ballot_sync(0xffffffffu, in && k == lo);
+    if (lane == 0 && wi < nwc) {
+      gt[w0 + wi] = g;
+      gt[words + w0 + wi] = e;
+    }
+  }
+}
+
+// The picks of tf_glm_dsa_tscan's rows: scores [R][np], out [R][K] int32 ascending, counts [R]; grid (R), dynamic
+// shared memory sizeof(glm_dsa_multi::Merge). PATH null or [R] int32: 0 the whole row in one select (NP <= CAP), 1 the
+// candidates, 2 the whole row after the candidates missed (the fallback), 3 ties at the floor.
+extern "C" __global__ void __launch_bounds__(glm_dsel::T2)
+    tf_glm_dsa_tmerge(const float* __restrict__ S, int* __restrict__ OUT, int64_t np, const int* __restrict__ pos, int K,
+                      const uint32_t* __restrict__ bits, int64_t words, int* __restrict__ counts, int* __restrict__ PATH) {
+  using namespace glm_dsel;
+  extern __shared__ __align__(16) unsigned char dsm[];
+  glm_dsa_multi::Merge& sm = *reinterpret_cast<glm_dsa_multi::Merge*>(dsm);
+  constexpr int CAP = glm_dsa_multi::CAP;
+  const int64_t r = blockIdx.x;
+  const int NP = glm_dsa_multi::row_limit(np, pos, r, K);
+  const float* row = S + r * np;
+  int* out = OUT + r * K;
+  const int t = threadIdx.x;
+  if (t == 0) {
+    const int64_t n = (int64_t)pos[0] + r + 1;
+    counts[r] = n > K ? K : 0;
+  }
+  const RowSrc whole{row, NP, (reinterpret_cast<uintptr_t>(row) & 15) == 0};
+  if (NP <= CAP) {
+    select_core<T2>(sm.sel, whole, NP, K, out);
+    if (PATH != nullptr && t == 0) PATH[r] = 0;
+    return;
+  }
+  const uint32_t* gt = bits + r * 2 * words;
+  const uint32_t* eq = gt + words;
+  const int nw = (NP + 31) / 32, per = (nw + T2 - 1) / T2;
+  const int wa = min(nw, t * per), wb = min(nw, wa + per);  // this thread's words, in position order
+  int cg = 0, ce = 0;
+  for (int w = wa; w < wb; ++w) {
+    cg += __popc(gt[w]);
+    ce += __popc(eq[w]);
+  }
+  int n_gt, n_eq;
+  const int gt_before = block_scan<T2>(cg, sm.sel.wsum, 0, &n_gt);
+  const int eq_before = block_scan<T2>(ce, sm.sel.wsum, 1, &n_eq);
+  const int n_ge = n_gt + n_eq;
+  int path;
+  if (n_gt < K && K <= n_ge) {
+    // The K-th best key is the floor: every gt token, and the eq tokens of eq rank under K - n_gt, in position order.
+    const int need = K - n_gt;
+    int seen = eq_before, cs = 0;
+    for (int w = wa; w < wb; ++w) {
+      const uint32_t e = eq[w];
+      uint32_t take = 0, m = e;
+      for (int q = min(__popc(e), max(0, need - seen)); q > 0; --q) {
+        take |= m & (0u - m);
+        m &= m - 1;
+      }
+      cs += __popc(gt[w] | take);
+      seen += __popc(e);
+    }
+    int all;
+    int at = block_scan<T2>(cs, sm.sel.wsum, 0, &all);
+    seen = eq_before;
+    for (int w = wa; w < wb; ++w) {
+      const uint32_t e = eq[w];
+      uint32_t take = 0, m = e;
+      for (int q = min(__popc(e), max(0, need - seen)); q > 0; --q) {
+        take |= m & (0u - m);
+        m &= m - 1;
+      }
+      seen += __popc(e);
+      for (uint32_t s = gt[w] | take; s != 0; s &= s - 1) out[at++] = w * 32 + (__ffs(s) - 1);
+    }
+    path = 3;
+  } else if ((K <= n_ge && n_ge <= CAP) || (K <= n_gt && n_gt <= CAP)) {
+    // Every token at or above the floor (or above it, when those hold K) in position order: the K best are among them.
+    const bool with_eq = n_ge <= CAP;
+    const int n = with_eq ? n_ge : n_gt;
+    int at = with_eq ? gt_before + eq_before : gt_before;
+    for (int w = wa; w < wb; ++w)
+      for (uint32_t s = gt[w] | (with_eq ? eq[w] : 0u); s != 0; s &= s - 1) sm.idx[at++] = w * 32 + (__ffs(s) - 1);
+    __syncthreads();  // then their keys, spread over the threads (candidates may crowd a few threads' words)
+    for (int c = t; c < n; c += T2) sm.key[c] = order_key(row[sm.idx[c]]);
+    __syncthreads();
+    select_core<T2>(sm.sel, CandSrc{sm.key, sm.idx, n}, n, K, out);
+    path = 1;
+  } else {
+    select_core<T2>(sm.sel, whole, NP, K, out);
+    path = 2;
+  }
+  if (PATH != nullptr && t == 0) PATH[r] = path;
+}
