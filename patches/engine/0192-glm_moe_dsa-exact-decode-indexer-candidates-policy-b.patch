diff --git a/zig/kernels/cuda/glm_glue_attn.cuh b/zig/kernels/cuda/glm_glue_attn.cuh
index 2efde529b..7465d74f6 100644
--- a/zig/kernels/cuda/glm_glue_attn.cuh
+++ b/zig/kernels/cuda/glm_glue_attn.cuh
@@ -1045,3 +1045,118 @@ extern "C" __global__ void __launch_bounds__(128)
       }
   }
 }
+
+// TF_GLM_DSA_ROPE_HOIST (swift policy bit 2): tf_glm_dsa_scores on queries tf_glm_dsa_qrope roped once a row (`qi`
+// here is that private scratch; `inv` unused, kept for the same arguments). Its code line for line but for the rope
+// block and its two barriers: the shared rows hold the same bf16 values the in-place rope leaves, so the fragments,
+// dots, scale, ReLU, head weights and reduction see the same values. (A copy, not a template: tf_glm_dsa_scores
+// keeps its own SASS.)
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_dsa_scores_roped(const __nv_bfloat16* qi, const __nv_bfloat16* wts, int64_t w_stride,
+                            const __nv_bfloat16* ik,
+                            float* out, const int* pos, int64_t np, int64_t nb, float scale, float wscale,
+                            int64_t heads, int loop, const float* inv) {
+  constexpr int D = 128, HP = 32, BP = 64;
+  __shared__ __align__(16) __nv_bfloat16 sm[4 * 2 * 16 * D];  // q's 32 rows (roped), then each warp's two 16-key buffers
+  auto at = [](int row, int u) { return row * D + ((u ^ (row & 7)) << 3); };
+  const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5, g = lane >> 2, q = lane & 3;
+  const int64_t r = blockIdx.x, n = (int64_t)pos[0] + r + 1;
+  for (int idx = threadIdx.x; idx < HP * (D / 8); idx += 128) {
+    const int hh = idx / (D / 8), u = idx % (D / 8);
+    const bool ok = hh < heads;
+    glm_attn::cp16(sm + at(hh, u), qi + (r * heads + (ok ? hh : 0)) * D + u * 8, ok);
+  }
+  glm_attn::commit();
+  float wv[4];
+  for (int i = 0; i < 4; ++i) {
+    const int64_t hh = g + 8 * i;
+    wv[i] = hh < heads ? glm_triton::fmul(__bfloat162float(wts[r * w_stride + hh]), wscale) : 0.0f;
+  }
+  // A block's keys for this warp: rows p0 .. p0 + 15 of the index cache, 16 chunks of 16 bytes, 8 a lane.
+  auto stage = [&](int buf, int64_t p0) {
+    const __nv_bfloat16* src = ik + (p0 < n ? p0 : 0) * D;
+#pragma unroll
+    for (int t = 0; t < 8; ++t) {
+      const int idx = lane + t * 32, row = idx / (D / 8), u = idx % (D / 8);
+      const int64_t p = p0 + row;
+      const bool ok = p < n;
+      glm_attn::cp16(sm + (warp * 2 + buf) * 16 * D + at(row, u), src + (ok ? row : 0) * D + u * 8, ok);
+    }
+  };
+  const int64_t first = (int64_t)blockIdx.y * loop;
+  // Blocks that score: those under nb with visible keys (pb * BP < n); the rest only write -inf.
+  auto live = [&](int j) { const int64_t pb = first + j; return j < loop && pb < nb && pb * BP < n; };
+  glm_attn::wait<0>();
+  __syncthreads();
+  uint32_t aq[D / 16][2][4];
+#pragma unroll
+  for (int kq = 0; kq < D / 16; ++kq)
+#pragma unroll
+    for (int i = 0; i < 2; ++i) glm_attn::ldm4<false>(aq[kq][i], sm + at(i * 16 + (lane & 15), kq * 2 + (lane >> 4)));
+  __syncthreads();  // q's fragments are in registers: the key buffers take its place
+  if (live(0)) stage(0, first * BP + warp * 16);
+  glm_attn::commit();
+  for (int j = 0; j < loop; ++j) {
+    const int64_t pb = first + j;
+    if (pb >= nb) break;
+    const int64_t p0 = pb * BP + warp * 16;
+    if (!live(j)) {
+      for (int e = lane; e < 16; e += 32)
+        if (p0 + e < np) out[r * np + p0 + e] = -INFINITY;
+      continue;
+    }
+    if (live(j + 1)) stage((j + 1) & 1, p0 + BP);
+    glm_attn::commit();
+    glm_attn::wait<1>();
+    __syncwarp();
+    float acc[2][2][4] = {};
+    const __nv_bfloat16* keys = sm + (warp * 2 + (j & 1)) * 16 * D;
+#pragma unroll
+    for (int kq = 0; kq < D / 16; ++kq) {
+      uint32_t b[4];
+      glm_attn::ldm4<false>(b, keys + at((lane >> 4) * 8 + (lane & 7), kq * 2 + ((lane >> 3) & 1)));
