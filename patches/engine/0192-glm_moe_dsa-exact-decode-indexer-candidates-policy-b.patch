+    dst[hh * D + ROPE / 2 + i] = __float2bfloat16_rn(o.y);
+  }
+  for (int idx = threadIdx.x; idx < heads * (D - ROPE) / 8; idx += blockDim.x) {
+    const int hh = idx / ((D - ROPE) / 8), u = idx % ((D - ROPE) / 8);
