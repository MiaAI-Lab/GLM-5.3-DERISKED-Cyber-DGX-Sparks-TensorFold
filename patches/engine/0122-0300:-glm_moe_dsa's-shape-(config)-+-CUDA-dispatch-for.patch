+    c.routed_scale = 2.5;
+    c.mla_heads = 64;
+    c.nope = 192;
+    c.rope = 64;
+    c.v_dim = 256;
+    c.q_lora = 2048;
+    c.kv_lora = 512;
+    c.i_heads = 32;
+    c.i_dim = 128;
+    c.i_topk = 2048;
+    c.kpool = 1;
+    c.hc = 0;
+    c.mtp = 1;
+    c.mla = std.StaticBitSet(max_layers).empty;
+    var all: usize = 0;
+    while (all < max_layers) : (all += 1) c.mla.set(@intCast(all));
+    c.ifull = std.StaticBitSet(max_layers).empty;
+    return c;
+}
