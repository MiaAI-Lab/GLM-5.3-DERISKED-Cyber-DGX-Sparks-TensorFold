+/// GLM-5.3's root-level config.json with the counts given (the widths as the checkpoint has them), for the tests.
+pub fn dsaText(gpa: std.mem.Allocator, layers: u32, fulls: []const u32) ![]u8 {
+    var types: std.ArrayList(u8) = .empty;
+    defer types.deinit(gpa);
+    var next_full: usize = 0;
+    var l: u32 = 0;
+    while (l < layers) : (l += 1) {
+        if (next_full < fulls.len and fulls[next_full] == l) {
+            next_full += 1;
+            try types.appendSlice(gpa, if (l > 0) ", \"full\"" else "\"full\"");
+        } else try types.appendSlice(gpa, if (l > 0) ", \"shared\"" else "\"shared\"");
+    }
+    return std.fmt.allocPrint(gpa,
+        \\{{"model_type": "glm_moe_dsa", "hidden_size": 6144, "num_hidden_layers": {d}, "vocab_size": 154880,
+        \\"rms_norm_eps": 1e-05, "first_k_dense_replace": 3, "intermediate_size": 12288, "n_routed_experts": 256,
+        \\"num_experts_per_tok": 8, "moe_intermediate_size": 2048, "n_shared_experts": 1, "norm_topk_prob": true,
+        \\"routed_scaling_factor": 2.5, "num_attention_heads": 64, "qk_nope_head_dim": 192, "qk_rope_head_dim": 64,
+        \\"v_head_dim": 256, "q_lora_rank": 2048, "kv_lora_rank": 512, "index_n_heads": 32, "index_head_dim": 128,
+        \\"index_topk": 2048, "num_nextn_predict_layers": 1, "scoring_func": "sigmoid", "eos_token_id": [154820],
+        \\"rope_parameters": {{"rope_type": "default", "rope_theta": 8000000.0}}, "indexer_types": [{s}]}}
+    , .{ layers, types.items });
+}
+
+test "glm_moe_dsa's shape parses to the dsa template; other widths do not" {
+    const gpa = std.testing.allocator;
+    const real = try dsaText(gpa, 78, &.{ 0, 4, 8 });
+    defer gpa.free(real);
+    const c = try parse(gpa, real);
+    try std.testing.expect(c.dsa and whole(c));
+    try std.testing.expectEqual(@as(u32, 78), c.countKind(.mla)); // every layer MLA, none KDA
+    try std.testing.expectEqual(@as(u32, 0), c.countKind(.kda));
+    try std.testing.expectEqual(@as(u32, 2048), c.keyWidth()); // per-token keys: i_topk with kpool 1
+    try std.testing.expectEqual(@as(u32, 0), c.hc);
+    try std.testing.expectEqual(@as(u32, 64), c.rope);
+    try std.testing.expectEqual(@as(u32, 12288), c.dense_inter);
+    try std.testing.expectEqual(@as(u32, 16), c.attnBlocks()); // 2048 keys in blocks of attn_span
+    try std.testing.expect(c.ifull.isSet(0) and c.ifull.isSet(4) and !c.ifull.isSet(1));
+    try std.testing.expectEqual(Kind.mla, c.kind(78)); // the MTP layer
+    const small = try dsaText(gpa, 4, &.{0});
+    defer gpa.free(small);
+    const s = try parse(gpa, small);
+    try std.testing.expect(s.dsa and !whole(s)); // a subset checkpoint's config: widths exact, layers fewer
+    try std.testing.expectEqual(@as(u32, 4), s.countKind(.mla));
+    const shared0 = try dsaText(gpa, 78, &.{1}); // layer 0 not full: nothing owns the top-k the shared layers reuse
+    defer gpa.free(shared0);
+    try std.testing.expectError(error.BadConfig, parse(gpa, shared0));
+}
+
+test "glm_moe_dsa splits cleanly at TP4: 16 heads, 3072 dense rows, 2048 moe rows a rank" {
+    var c = dsaWant();
+    try splitHeads(&c, 3, 4);
+    try std.testing.expectEqual(@as(u32, 16), c.mla_heads);
+    try std.testing.expectEqual(@as(u32, 3072), c.dense_inter);
+    try std.testing.expectEqual(@as(u32, 3), c.tp_rank);
+    try splitRows(&c, 3, 4);
+    try std.testing.expectEqual(@as(u32, 512), c.inter[1] - c.inter[0]);
+    try split(&c, 3, 4);
+    try std.testing.expectEqual(@as(u32, 64), c.own[1] - c.own[0]);
+    try std.testing.expectEqual(@as(u32, 38720), c.vocabPart()[1] - c.vocabPart()[0]);
+}
+
 test "a layer subset keeps the MTP layer's place and refuses an empty or oversized count" {
     var c = Config{};
     try subset(&c, 8);
