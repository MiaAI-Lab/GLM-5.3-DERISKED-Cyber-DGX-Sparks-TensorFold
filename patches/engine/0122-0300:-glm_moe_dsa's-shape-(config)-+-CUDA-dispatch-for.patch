+//! GLM-5.3 itself (model_type glm_moe_dsa, no text_config) parses to the second shape: every layer MLA, no KDA,
+//! no mHC, a 64-dim rope plane, per-token indexer keys.
 const std = @import("std");
 
-pub const max_layers = 46;
+pub const max_layers = 96;
 
 pub const Kind = enum { kda, mla };
 
@@ -45,12 +47,17 @@ pub const Config = struct {
     hc_eps: f32 = 1e-6,
     sinkhorn: u32 = 20,
     mtp: u32 = 1,
+    dsa: bool = false, // glm_moe_dsa (full GLM-5.3): no KDA, no mHC, a rope plane, per-token indexer keys
+    rope: u32 = 0, // rotary dims of q and k: 64 on glm_moe_dsa; Flash's attention has none
     tp: u32 = 1, // tensor parallel: the Macs splitting the attention heads
     tp_rank: u32 = 0,
     eos: [3]u32 = .{ 154820, 154827, 154829 },
     eos_n: u32 = 3,
     /// Layer i is MLA (sparse attention) when set; KDA otherwise.
     mla: std.StaticBitSet(max_layers) = defaultMla(),
+    /// Layer i computes its own indexer top-k when set; it reuses the last full layer's otherwise
+    /// (glm_moe_dsa's indexer_types, "full" every fourth layer and "shared" in between). Flash: every layer full.
+    ifull: std.StaticBitSet(max_layers) = defaultIfull(),
 
     pub fn kind(c: *const Config, i: u32) Kind {
         return if (c.mla.isSet(i)) .mla else .kda;
@@ -122,6 +129,48 @@ fn defaultMla() std.StaticBitSet(max_layers) {
     return s;
 }
 
+fn defaultIfull() std.StaticBitSet(max_layers) {
+    var s = std.StaticBitSet(max_layers).empty;
+    var l: usize = 0;
+    while (l <= 45) : (l += 1) s.set(l); // Flash: every layer computes its own indexer top-k
+    return s;
+}
+
+/// GLM-5.3's own shape (model_type glm_moe_dsa): the widths the CUDA port is generated for,
