-fn synthetic(c: *Ctx, b: *Bufs, rng: std.Random) ![2]Set {
+pub fn synthetic(c: *Ctx, b: *Bufs, rng: std.Random) ![2]Set {
     const slot = words(8);
     var ptrs: [3]u64 = undefined;
     var host: [3][]const []const i16 = undefined;
