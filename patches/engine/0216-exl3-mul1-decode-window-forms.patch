 zig/src/cuda/exl3_experts.zig             |  20 ++++-
 zig/tests/cuda/exl3_mul1_decode_tests.zig | 103 ++++++++++++++++++++++
 zig/tests/cuda/exl3_prompt_k6_tests.zig   |   2 +-
 zig/tests/cuda/main.zig                   |   2 +
 5 files changed, 147 insertions(+), 5 deletions(-)
