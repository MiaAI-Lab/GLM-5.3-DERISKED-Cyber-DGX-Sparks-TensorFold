-// A 512-wide bf16 row's 16-byte unit u in shared memory, swizzled by the row so ldmatrix's eight rows hit eight banks.
-__device__ __forceinline__ int wide(int row, int u) { return row * LW + ((u ^ (row & 7)) << 3); }
+// A W-wide bf16 row's 16-byte unit u in shared memory, swizzled by the row so ldmatrix's eight rows hit eight banks.
+// The chunk kernels take their row width as a template argument (LW 512, glm_moe_dsa's DSA_LW 576), so the swizzle is
+// each kernel's local `wof` over it; this file-scope form remains for 512-wide callers outside them.
+__device__ __forceinline__ int wof(int row, int u) { return row * LW + ((u ^ (row & 7)) << 3); }
 // p's [32][32] rows (64 bytes): unit u of row r.
 __device__ __forceinline__ int narrow(int row, int u) { return row * KT + ((u ^ ((row >> 1) & 3)) << 3); }
 
