-    a[2] = mcg2(s & 0xffffu, w >> 16);
-    a[3] = mcg2(__byte_perm(t, 0u, 0x4410), w & 0xffffu);
+    a[0] = dec2<CB>(__byte_perm(s, 0u, 0x4421), (s >> 4) & 0xffffu);
+    a[1] = dec2<CB>(__byte_perm(t, 0u, 0x4421), __byte_perm(w, 0u, 0x4421));
+    a[2] = dec2<CB>(s & 0xffffu, w >> 16);
+    a[3] = dec2<CB>(__byte_perm(t, 0u, 0x4410), w & 0xffffu);
 }
