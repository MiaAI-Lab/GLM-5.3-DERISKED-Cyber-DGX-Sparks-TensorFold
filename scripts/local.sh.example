#!/usr/bin/env bash
# Copy to scripts/local.sh (gitignored). Exported environment values take precedence over it.
# Every setting and its default is in scripts/config.sh; the README's settings table explains them.

# --- the six Sparks (a switch) -----------------------------------------------------------------------------------------
# This Spark (spark1) serves rank 0 and the API; WORKER..WORKER5 run ranks 1-5 on spark2..spark6. Key-based ssh,
# no password prompt. On a switch any order works; rank i runs on WORKER<i>'s host (WORKER is rank 1, no suffix).
WORKER=mia@spark2              # rank 1
WORKER2=mia@spark3             # rank 2
WORKER3=mia@spark4             # rank 3
WORKER4=mia@spark5             # rank 4
WORKER5=mia@spark6             # rank 5
# FABRIC_TOPOLOGY=ring: four Sparks cabled in a ring, no switch. WORKER..WORKER3 follow the cables (rank 1 is the
# Spark on this Spark's port 0); WORKER_WEIGHTS=check and ROCE_MESH=0 are the ring defaults. README the ring section.
# FABRIC_TOPOLOGY=ring
# WORKER_WEIGHTS=check   # the ring default: every Spark holds its own checkpoint copy (copied over the CX7 cables)
# MASTER_ADDR=                # this Spark's CX-7 address every worker reaches (found from the route to WORKER when empty)
# NCCL_SOCKET_IFNAME=         # this Spark's CX-7 netdev (found when empty)
# TF_ROCE_HCA=                # RDMA devices for the link (found when empty; a Spark's QSFP port gives two)
PORT=8020

# --- weights (NFS from spark1) -----------------------------------------------------------------------------------------
# nvidia/GLM-5.3-NVFP4 lives in this Spark's default HF cache; every worker mounts it read-only over NFS.
#   hf download nvidia/GLM-5.3-NVFP4
# Export the WHOLE cache directory (snapshot files are symlinks into blobs/) and mount it at the same absolute path on
# spark2..spark6. start-tp6.sh creates read-only Docker NFS volumes on the workers and verifies each can read the
# checkpoint before any rank starts.
WORKER_WEIGHTS=nfs             # rsync: send this Spark's copy instead; check: the workers must already have it
# MODEL_DIR=/path/to/snapshot  # else $HF_CACHE_DIR/snapshots/<MODEL_REVISION or refs/main>
# NFS_MODEL_PATH=              # the path the NFS server exports, when it differs from MODEL_DIR
# NFS_SERVER=mia-spark1        # this Spark's address as the workers reach it (auto: this Spark's route address)
# HF_TOKEN=hf_...              # only if the repo ever goes gated; reaches hf, never the ranks

# --- serving ---------------------------------------------------------------------------------------------------------
DRAFTER=mtp                    # the checkpoint's integrated MTP layer 78 | none: no drafts
PARALLEL=4
CONTEXT=auto                   # or a token count up to 1048576
KV=fp8                         # bf16: exact caches on shared KV pages
# MEMORY_RESERVE_GIB=6.5
# THINKING=1
# VISION=0
# SERVE_EXTRA_ARGS='--top-k 20'
# ROCE=off                   # put every exchange on NCCL (the engine's RoCE all-gather path is on by default)

# Keep the engine's digest cache and state outside the checkout:
# DATA_DIR=/mnt/models/glm53nvfp4
# TENSORFOLD_API_KEY and HF_TOKEN may be exported; never commit them.
